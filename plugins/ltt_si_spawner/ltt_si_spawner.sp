       g_cWaitRelax, g_cRelaxMax,
       // ---- v1.22.0：安全屋（起点检查点）内部不刷 + 保底硬上限也参与等待降级 ----
       g_cNoSafeRoom, g_cWdSearchGap, g_cKeepFar, g_cLockCfg,
       // ---- v1.32.0：补员（保持满员）+ 特感突击脉冲 ----
       g_cRefill, g_cRefillGap, g_cAssault, g_cAssaultGap,
       // ---- v1.32.2：单独钉住「自建落点」这一项，好让"挡位 0 + 兜底"能被 A/B ----
       g_cNavSearchLock;

// 【v1.8.2修订9】服务器上的 left4dhooks 有没有导航属性原生。
// 老版本没有的话就跳过"墙里过滤"，绝不能因为缺原生让插件加载失败。
bool g_bHasNavAttr;
// 【v1.8.2修订11】有没有"恐怖导航区生成属性"原生（救生舱/救援车/FINALE 那一套）
bool g_bHasSpawnAttr;
// 【v1.11.0】有没有引擎 PVS 可见性原生（left4dhooks 172346 起才有）
bool g_bHasEngineVis;
// 【v1.15.0】有没有「逐玩家点级可见性」原生（L4D2_IsVisibleToPlayer）。
// 缺了 -> 第二级精判做不了，自动退回区域级 PVS（即 v1.11.0 的行为）。
bool g_bHasVisPlayer;

// 【v1.18.2】人数变化播报用。
// 参照 specialspawner::SetSpawnCount() 的核心判据：**只在生效值真的变了才播报**，
// 否则每次有人进出队伍都会刷一条重复消息。初值 -1 保证"第一次一定播"。
int    g_iLastAnnWave = -1;
int    g_iLastAnnCap  = -1;
int    g_iLastAnnTime = -1;
Handle g_hEffAnnounce = null;   // 合并触发的定时器（防止同时多人进出刷一串）
// 【v1.12.0】有没有真实导航路程原生
bool g_bHasTravel;
// 【v1.22.0】有没有"坐标是否在起点检查点（安全门里）"这个原生（left4dhooks 1740+ 起有）
bool g_bHasCpPos;
// 【v1.24.0】当前地图名（如 c1m1_hotel / zc1_m3）—— 写进日志，方便"同一张图跑第二次"时按图抓问题
char g_sMap[64];
// 【v1.8.2修订11 · 抄 fdxx l4d2_si_spawn_control 的 IsValidFlags】
// 这两类是【密封空间】：救生舱是关着门的密室，救援车是终局载具。
// 刷在里面 = 特感永远出不来，玩家看到的就是"特感卡在某个封闭空间里"。
// 参考实现明确排除它们，我们以前一条都没查。
#define TERROR_NAV_RESCUE_VEHICLE   (1 << 15)
#define TERROR_NAV_RESCUE_CLOSET    (1 << 16)
// ⚠️ TERROR_NAV_FINALE 目前是【故意不使用】的：设计稿 §7「修订11 F 项」记过原因 ——
// 终局图加这道过滤怕把候选池砍空（终局本来就地窄），所以先观察、不启用。
// 保留定义是为了将来要做时不必回头查位号；删掉它反而会丢掉这个"待办锚点"。
#define TERROR_NAV_FINALE           (1 << 6)

// 【v1.8.2修订9】本只特感的候选被拒计数（每次找位重置）
int  g_iHullSkip;            // 因"碰撞盒嵌在实体里"被拒
int  g_iAttrSkip;            // 因"墙里/越界"被拒（引擎路径）
int  g_iCloseSkip;           // 【修订10】因"离其它特感/生还者太近"被硬拒

// 【v1.8.2修订10】本只因为"附近实在没有空位"而放弃（不是槽位问题、不是找不到落点）。
// 队列抽干逻辑据此取消本波剩余，绝不叠加 —— 叠加会炸服。
bool g_bPosTooClose;

// 【v1.8.2修订10 · 炸服修复 第二半】"刚踢完人"的创建冷却。
// 踢人（KickClient）是异步的，同一 tick 里接着建新客户端会让引擎在
// "边销毁边创建"的状态下段错误。冷却期内 SpawnOne 直接返回"等一等"。
float g_flNoSpawnUntil;
bool  g_bSpawnCooldown;
bool  g_bCooldownLogged;      // 【v1.9.0】冷却日志节流（每次冷却只打一条）

// ================= 【v1.8.2修订11】参考实现 specialspawner =================
// 只在【真正调生成的那一瞬间】为 true —— 因为 PreferredSpecialDirection 是
// 导演的全局脚本值，我们不能在刷特窗口之外也去改它（那会影响导演自己的行为）。
bool g_bInSpawnTime;
int  g_iPreferredDir = -1;       // -1=不干预 9=大空间 7=队伍前方 2=终局
int  g_iWaveFail;                // 本波"生成失败/找不到落点"的次数（用于自动切方向）
int  g_iOrigDiscardRange = -1;   // z_discard_range 原值
bool g_bHasDiscard;              // 服务器有没有 z_discard_range

// 【v1.8.2修订10】存活生还者位置快照（与特感快照一起刷新）。
// 硬性最小间距要同时避开生还者，逐个候选去调 GetClientAbsOrigin 太浪费，
// 一次找位刷一遍就够。
float g_fAliveSurv[MAXPLAYERS + 1][3];
int   g_iAliveSurvN;

/** 落点档位。数字越小越优：**0 = 藏点**（掩体后，近距离也合法）、**1 = 可见**。
 *
 *  【v1.18.1 更正】这里原写「修订8 的四段优先级」（藏点·近 / 藏点·远 / 可见·近 / 可见·远）——
 *  那套四档在 v1.10.0 就收敛成两档了：`TIER_VISIBLE_FAR/NEAR` 这两个常量早已不存在，
 *  只剩注释里还在提。远近的区分现在由 `DistBand()` 在档内做，不再占档位。
 *  设计口径不变：**"不凭空刷"优先于"别刷太远"，两者都优先于"间距"**。 */
enum
{
	TIER_HIDDEN       = 0,   // 藏点（掩体后，近距离也合法）
	TIER_VISIBLE      = 1,   // 可见（= 会被看见，必须落在 500~900 带里）
	TIER_NONE         = 9
};

static const char g_sTierName[2][] =
{
	"藏点", "可见"
};

// ------------------------------------------------------------------ 导航网格自建落点
//
// 【为什么需要这个】引擎的 L4D_GetRandomPZSpawnPosition 只认地图里被标记过的
// "可刷特导航区"（对应 left4dhooks 的 L4D_GetNavArea_SpawnAttributes）。那些区一旦
// 被占满、或者地图本身标记得少，引擎就永远返回失败 —— 实测 26 特时 759 次找不到落点。
//
// Neko 多特的「可变模式」扩展文档原话：
//   引擎刷特位置基本在每个地图的特定属性区域，即使前方有障碍物，但不是特定属性区域
//   也不会刷特；算法刷特是前方一切区域均可刷特。
//
// 我们照这个思路做：换图时把所有导航区缓存下来（中心坐标 + ID + 流距离），
// 引擎找不到时自己筛区域、再用 L4D_FindRandomSpot（引擎给女巫用的"在指定导航区内
// 随机取一个可站立点"）取点 —— 它对任意导航区都有效，不看刷特属性。
#define MAX_NAV_CAND 256

// 用 ArrayList 存：这个 SM 版不支持给全局动态数组 `= new float[n]`，
// 而 ResizeArray 又是旧的 Handle API。ArrayList 存 float 位模式、读时 view_as<float> 取回。
ArrayList g_aNavPos;      // 每区 3 个 cell：中心 x/y/z
ArrayList g_aNavFlow;
ArrayList g_aNavAddr;   // 注意：存的是【导航区地址】不是 ID（见下方 L4D_FindRandomSpot 的坑）
int       g_iNavCount;
// 【v1.18.3 · 找位耗时优化】上面三个 ArrayList 的"拍平镜像"。
// 为什么要多这一层：BuildNavCand 每刷一只特感要把全部导航区（本图 1216 个）扫一遍，
// 而每次迭代原本要调 4 次 ArrayList.Get —— 那是 native 调用，一次 1~2µs，
// 4×1216 ≈ 4900 次 ≈ 5~10ms。实测找位中位 13.1ms / P95 23.4ms / 峰 29.7ms，
// 且 456 条里 451 条超过 10ms（=必然吃掉至少一个 tick），数字正好对上。
// 拍平后同样的扫描只剩普通数组读取；**判定逻辑一行没动**，见 BuildNavCand 的说明。
//
// SourcePawn 的**全局不能是动态数组**（error 162），所以用固定大小。
// 8192 远超任何 L4D2 地图的导航区数（本图实测 1216）；万一真的超了，
// g_bNavFlat 置 false，BuildNavCand 会自动退回原来的 ArrayList 读法 ——
// 即"优化失效"而不是"结果变了"。
// 【v1.18.8】8192 → 16384。
// 为什么：实测本服各图导航区数最高到 **11576**（见 2026-09-26 的"导航区缓存 N 个"日志，
//   排序后最大的几个：8658 / 8920 / 8944 / 9076 / 9081 / 9163 / 9864 / 10601 / 11576），
//   而旧上限 8192 会把 10601/11576 那两张图**整个优化关掉** —— errors 日志原话：
//   "导航区数 10601 超出拍平上限 8192（或为 0）→ 本次不启用拍平优化，找位仍走 ArrayList
//    （结果不受影响，只是慢）"。那两张图上每一只特感的找位都退回 native 读 ArrayList。
// 代价：5 个数组 × 16384 × 4 字节 = 320 KB data 段（旧值 160 KB），一次性。
#define MAX_NAV_CACHE 16384
float  g_fNavXs[MAX_NAV_CACHE];
float  g_fNavYs[MAX_NAV_CACHE];
float  g_fNavZs[MAX_NAV_CACHE];
float  g_fNavFl[MAX_NAV_CACHE];
int    g_iNavAddrs[MAX_NAV_CACHE];
bool   g_bNavFlat;      // 镜像可用（导航区数 <= MAX_NAV_CACHE）
bool      g_bNavReady;
int       g_iNavUsed;     // 统计：靠自建落点救回来多少次
bool      g_bNavTimerPending;   // 【v1.8.2】已排了建缓存的定时器，别重复排

// 【v1.30.0】救援关（终局图）不刷特
bool      g_bHasFinaleMap;       // L4D_IsMissionFinalMap 原生是否可用
bool      g_bHasFinaleEscape;    // L4D_IsFinaleEscapeInProgress 原生是否可用
bool      g_bRescueMap;          // 本图是不是救援关（终局图）
bool      g_bRescueBlockedNow;   // 当前是否因救援关而停刷（tick 闸门只读它，不每 tick 调原生）
bool      g_bRescueAnnounced;    // 本图是否已向玩家播报过
bool      g_bFinaleStarted;      // 【v1.30.0】"开启救援"事件已响（只可能在救援关响）
int       g_iNavRetry;        // 【v1.29.1】导航缓存重建重试计数（每图最多 3 次）

// ------------------------------------------------------------------ v1.8.2 落点分散
//
// 【要解决的问题】26 只特感在一波里 ~0.4 秒内连续刷完，领跑者坐标几乎不变，
// 于是 26 只拿到的是同一份候选数组。如果领跑者前方 900 内只有十几个导航区，
// 26 只就会挤在那十几个相邻区里（每区 2~3 只）—— 玩家看到的是"一个点冒出十几只"，
// 然后被一个人架枪清完，多特的乐趣直接消失。
//
// 解法：记住"本波已经用过哪些落点"，取新点时要求与已用点拉开 ltt_sispawn_spread。
// 这就是服主要的"A 点刷几只、B 点刷几只、C 点刷几只"。
ArrayList g_aWavePos;        // 本波已用落点，每只 3 个 cell：x/y/z。每波开始清空

// "间距最大"的备选由 TryNavSpot 内部直接择优，不再需要外部备胎（见 TryNavSpot 注释）。

int   g_iSpreadSkip;         // 统计：本波候选里"没达到 spread 目标"的个数
int   g_iSpreadRelax;        // 统计：本波最终落点没达到 spread 目标的次数
int   g_iWinGrow;            // 统计：本波因为候选池太小而放大窗口的次数
// 【v1.19.0 · 正式版】每图末"质量汇总"用的累计计数器
//   为什么加：这些指标以前只能靠离线解析日志算；写进插件后每张图自己报一次。
//   累加点全部在"本来就要算"的位置（POS 那一段），不额外增加每次刷特的开销。
int   g_iTotSrcSelf;         // 累计：落点来源=自建
int   g_iTotSrcEngine;       // 累计：落点来源=引擎（含档位择优胜出）
int   g_iTotSrcFallback;     // 累计：落点来源=真·保底
int   g_iTotSepN;            // 累计：参与统计的落点数（间距样本数）
float g_fTotSepSum;          // 累计：间距之和（算平均用）
int   g_iTotSepGeSpread;     // 累计：间距 >= ltt_sispawn_spread 的个数（达标）
int   g_iTotSepLt200;        // 累计：间距 < 200 的个数（明显扎堆）
int   g_iTotVis;             // 累计：落点当下可见的次数（allow_visible=0 时应为 0）
int   g_iTotSpreadSkip;      // 累计：因"离已用落点太近"被拒的候选数
int   g_iTotSpreadRelax;     // 累计：最终落点没达到 spread 目标的次数
// 【v1.34.0】累计：最终落点连【硬下限 spread_min】都没达到的次数
//   = 真的和别的特感挤在同一处了。这是判断"是不是堆成一坨"的唯一硬指标，
//   和"没达到 350 目标"完全不是一回事（狭窄地形达不到 350 是正常的）。
int   g_iTotSpreadFloorMiss;
int   g_iTotWinGrow;         // 累计：因候选池太小而放大窗口的次数
int   g_iTotWavePlan;        // 累计：计划刷出的特感数
int   g_iTotWaveGot;         // 累计：实际刷出的特感数
int   g_iTotWaveFull;        // 累计：刷满的波数
int   g_iTotWaveShort;       // 累计：欠刷的波数
int   g_iCurWavePlan;        // 本波计划数量（下一波开头结算进上面的累计）
// ---- 【v1.39.0 · 缺口顺延】----
// 欠账 = 之前各波"计划了但没刷出来"的只数之和，由后面的波次补上（受上限夹取）。
int   g_iCarry;              // 当前累计欠账（只）
int   g_iCarryPeak;          // 本图欠账峰值（只）
int   g_iTotCarryShort;      // 本图累计"欠下"的只数
int   g_iTotCarryUsed;       // 本图累计"补回"的只数
bool  g_bCarrySettled;       // 本波的缺口是否已结算（防每 tick 重复累加）
int   g_iCarryStepped;       // 【v1.40.0】本图因 carry_step 而被"推迟认领"的欠账只数（诊断用）
int   g_iEngForced;          // 【v1.41.0】本图"预算已尽但仍强行跑引擎兜底"的次数（这条修复实际生效了几次）
int   g_iNavCut;             // 【v1.42.0】本图"自建预跑被 nav_pct 子预算截断"的次数
// ---- 【v1.43.0 · 保底护栏 / 最后机会 / 欠账预算】----
int   g_iFbAudit;            // 本图放行的保底/降级点数
int   g_iFbViolation;        // 其中"独立复核没通过硬闸"的个数（>0 = 保底分支漏了闸，属代码漏洞）
int   g_iFbGateInactive;     // 开机自检：本图有几道硬闸因依赖缺失/开关关闭而不生效
int   g_iLastChanceRelax;    // 本图"硬下限被等待降级放宽后仍采纳"的只数（诊断这条杠杆有没有用）
int   g_iCarryBudgetFind;    // 本图"因欠账>0 而放大找位预算"的找位次数
bool  g_bBadNavMap;          // 【v1.44.0】本图命中"坏导航图名单"（.nav 残片，已按图放宽 + 豁免救援闸门）
bool  g_bBadNavLog;          // 【v1.46.0】坏导航图"放行导演特感"只打一条日志（防刷屏）
bool  g_bBnSnap;             // 【v1.49.1】坏导航图档是否已存过"原始值"快照
int   g_iBnSnapI[4];         // 【v1.49.1】已弃用（改为按出厂口径显式还原）
float g_fBnSnapF[2];         // 【v1.49.1】fallbackmax / min
int   g_iForceClass;         // 【v1.48.0】手动点单：>0 时 PickClass() 只返回这个职业（sm_sispawn_class）
int   g_iVisSkip;            // 统计：本波因为"看得见"被拒的候选数（引擎路径，仅 vis_engine=1）
int   g_iLastPosSrc;         // 本只特感的落点来源（供 poslog 用）【v1.14.0 修正标签混用】
                              //   0=引擎(提前收工的最好档) 1=自建
                              //   2=真·保底(引擎最后给的点) 3=引擎备选(过了档位择优的那个)
                              // 修正前 2 同时表示"保底"和"引擎备选"，导致来源统计口径失真
// 【v1.8.2修订8】落点档位与远档使用统计
int   g_iLastPosTier = TIER_NONE;  // 本只选中的档位（TIER_*，供 poslog 用）
// 【v1.18.0 合并】原来有两个计数器，都是三档时代的遗留：
//   g_iFarUsed —— 零自增点、也零清零点 → 日志里恒 0 且从不复位（假指标，比没有更危险）
//   g_iVisNear —— 只有自增、没有任何出口 → 写了没人看
// 档位在 v1.10.0 已收敛成两档（藏点/可见），"可见远 / 可见近"不再可分，
// 所以合并成一个真实指标：**可见档被选中的次数**。
// 这是"凭空刷"在【选点阶段】的直接度量 —— 配合 ltt_sispawn_allow_visible 一起看：
// 该开关为 0 时它应当趋近 0；一旦不趋近 0，就说明有别的路径在放可见点进来。
int   g_iVisibleUsed;
int   g_iRuleSkip;           // 【v1.10.0】统计：被"按视线分档判据"（可见500~900 / 藏点flow<500）硬拒的候选数
// 【v1.10.2】本次找位的失败原因是"位置不合格"（而不是"真的找不到落点"）。
// true → 这一只进【等待队列】：队列下一 tick(0.1 秒) 重试，一旦有合格位置立刻刷，
//        连续 3 秒都等不到才放弃本波剩余（复用已有的 stall 保护）。
// false → 真的找不到落点 → 直接丢掉这一只，不影响本波其余。
bool  g_bPosWait;
int   g_iWaitGiveUp;         // 【v1.13.0】统计：等位等满 3 秒、放弃本波剩余的【次数】
int   g_iWaitGiveUpSI;       // 【v1.13.0】上者丢掉的【特感只数】合计
int   g_iNarrowCount;        // 统计：本波候选区数量不足（地形太窄）的次数

// 【v1.8.2修订4】SpawnOne 刚才是因为"槽位耗尽"失败的（而不是落点问题）。
// 队列抽干逻辑据此判断该重试还是该收手（见 ltt_sispawn_slotstop）。
bool  g_bSlotFull;

// 【v1.8.2修订2 · 关键】当前【存活】特感的位置快照。
//
// 为什么必须加这个：第一版修订只维护"本波已用落点"，而它是【每波清空】的 ——
// 波与波之间互不知情。2026-09-23 真人实测（5 秒一波 × 4~6 只，场上累积到 24 只）：
//   · 同波间距中位 412（好），但【跨波】间距中位只有 106、
//     42% 的新特感落在"前 30 秒内刷出的另一只"80 单位以内。
//   玩家看到的不是"一波"，而是【当前存活的所有特感】，所以观感依然是扎堆。
// 解法：参照系从"本波"改成"当前存活的所有特感"。它们的位置本来就能直接读，
// 不需要额外记账，也不需要在死亡/回收时清理。
#define MAX_ALIVE_SI 40
float g_fAliveSI[MAX_ALIVE_SI][3];
int   g_iAliveSIN;

// 每种特感的存活上限（0=不限）。索引=职业号 1~6。
// 参考 specialspawner 的做法：每种上限之和【大于】总上限，只用来防某一类独大，
// 不是拿来卡总数的（它的每种 2;1;4;1;4;4 = 16，总上限 15）。
int  g_iClassLimit[MAX_CLASS + 1];
int  g_iTankLimit[MAX_CLASS + 1];

// 直连刷特：每个职业一个 NextBotCreatePlayerBot<T> 工厂（索引=1~6 的职业号）
Handle g_hBot[MAX_CLASS + 1];
bool   g_bDirectReady;
float  g_flRecycleAt;         // 下次扫描死亡特感的时间点
float  g_flGuardAt;           // 下次满员守卫扫描的时间点
float  g_flDeadSince[MAXPLAYERS + 1];   // 该槽位从什么时候开始是"死的"（0=活着/未记录）
// KickClient 是异步的：踢完客户端还会在槽位里待一两帧，
// 不记这一笔的话下一轮扫描会对着同一个特感再踢一次（日志里出现过重复踢 #1）。
float  g_flKickAt[MAXPLAYERS + 1];      // 已发出 KickClient 的时刻（0=没在踢）

bool   g_bClassAllowed[MAX_CLASS + 1];
bool   g_bArmed;              // 本回合是否已进入"开始刷特"状态
float  g_flMapStartGame;      // 【v1.49.7】本图 OnMapStart 时的 GetGameTime()（用于 arm_delay）
bool   g_bLttArmDelayLogged;  // 【v1.49.7】本图是否已经打过"武装延后"那行日志
ConVar g_cArmDelay;           // 【v1.49.7】武装延后秒数
ConVar g_cArmDelayMaps;       // 【v1.49.7】需要延后武装的地图名单
ConVar g_cIntroGuard;         // 【v1.49.8】双重保险①：开场过场期间不开刷
ConVar g_cIntroGuardMax;      // 【v1.49.8】过场判定最多挡多少秒（防原生抽风）
bool   g_bHasIntroNative;     // 【v1.49.8】left4dhooks 是否提供 L4D_IsInIntro
bool   g_bLttIntroLogged;     // 【v1.49.8】本图是否已打过"等过场"日志
bool   g_bLttIntroDoneLogged; // 【v1.49.8】本图是否已打过"过场结束"日志
ConVar g_cArmMove;            // 【v1.49.9】"动过"判定阈值（单位），0=关
ConVar g_cArmMoveMax;         // 【v1.49.9】兜底：开图多少秒后不再要求「动过」
bool   g_bLttSomeoneMoved;    // 【v1.49.9】本回合是否已有生还者真的动过
bool   g_bLttMoveLogged;      // 【v1.49.9】是否已打过"还没人动过"日志
bool   g_bLttMoveTimeoutLogged; // 【v1.49.9】是否已打过"兜底放行"日志
float  g_vLttRefPos[MAXPLAYERS + 1][3]; // 【v1.49.9】每人基准位置
bool   g_bLttRefValid[MAXPLAYERS + 1];  // 【v1.49.9】基准位置是否有效
bool   g_bOwnSpawn;           // 重入标志：当前这次生成是本插件自己发起的
bool   g_bLoggedMaxSpecials;  // MaxSpecials 抬高日志是否已打过（该回调每帧触发，必须节流）
// 【v1.18.7】导演脚本 CommonLimit 拦截用（并自 L4D2-Competitive-Rework 的
// `l4d2_director_commonlimit_block.sp`，原作者 Tabun，43 行）。
// g_cCommonLimitRef 只用来读权威值 z_common_limit；g_iCommonLimit 是它的缓存。
ConVar g_cCommonLimitRef;
int    g_iCommonLimit;
bool   g_bLoggedCommonLimit;  // 拦截日志每图只打一次（该回调触发极频繁）
float  g_flNextSpawn;         // 下一波的时间点（GetGameTime）
Handle g_hTick;               // 唯一的常驻定时器

// 引擎原生找位的距离约束（改这两个 cvar 才能真正控制刷多远）
int    g_iOrigSpawnRange = -1;   // z_spawn_range 原值
int    g_iOrigSafeRange  = -1;   // z_spawn_safety_range 原值

// 【v1.18.0】原【下界】也要记。上面 SetBounds(ConVarBound_Lower, true, 0.0) 放宽了下界，
// 而原来的还原只 SetInt 恢复【值】、没有恢复【下界】→ 插件卸载后下界永久停在 0。
// 对照：EnsureEngineLimits 那一组（z_max_player_zombies 等）的 SetBounds 是有配对还原的。
bool   g_bOrigRangeLowerSet;     float g_fOrigRangeLower;
bool   g_bOrigSafeLowerSet;      float g_fOrigSafeLower;
bool   g_bOrigDiscardLowerSet;   float g_fOrigDiscardLower;


// 引擎 cvar 是我们抬上去的，卸载时必须原样还回去。
// v1.6.1：以前这里不还原，长期靠另一个插件 l4d2_si_slot_unlock 兜着 ——
// 但那个插件的前提("引擎把 z_max_player_zombies 钳死在 4")已被实测证伪，
// 是空转的冗余插件，已撤掉。所以还原必须自己管。
#define ENGINE_CVAR_COUNT 3
static const char g_sEngineCvars[ENGINE_CVAR_COUNT][] =
{
	"z_max_player_zombies", "z_minion_limit", "survival_max_specials"
};

bool  g_bEngineTouched[ENGINE_CVAR_COUNT];   // 我们是否动过这个 cvar
bool  g_bEngineHadUpper[ENGINE_CVAR_COUNT];  // 它原本有没有上限
float g_fEngineOldUpper[ENGINE_CVAR_COUNT];  // 原本的上限值
int   g_iEngineOldValue[ENGINE_CVAR_COUNT];  // 原本的值


// 待生成队列（一波内分批生成，防 choke）
int    g_iQueue[64];
int    g_iQueueLen;
int    g_iQueuePos;
// 【v1.18.6】生成节流用的相位计数：只有凑满 ltt_sispawn_spawnevery 才发一批
int    g_iSpawnPhase;
int    g_iTarget;
int    g_iWaveNo;
int    g_iLastSpawned;        // 统计用
int    g_iLastFailed;
int    g_iStallTicks;         // 队列"放不进去"连续了多少个 tick（卡住保护）
int    g_iTankPurge;          // 【v1.31.0】本次坦克出现是否已执行过"策略 3 的清场"（坦克走了归零）
int    g_iFb0Relax;           // 【v1.31.1】挡位 0 下"保底点跳过可见/藏点判据"的次数（按图统计）
// 【v1.32.0】只记一条日志（每次下发都记会把日志刷爆，且没有新信息）
bool   g_bAssaultLogged;
// 【v1.32.0】累计下发过多少次突击脉冲（sm_sispawn_status 里看）
int    g_iAssaultSent;
// 【v1.32.0】本服是否存在 nb_assault（不存在时自动停用，只报一次）
bool   g_bAssaultMissing;
// 【v1.32.1】补员模式下"每波汇总"日志的节流时间戳（只影响日志密度，不影响行为）
float  g_flLastSummary;
int    g_iRetryWait;          // 【v1.18.8】还要等几个 tick 才重试找位（0=本 tick 就试）
// 【v1.18.9 · 找位耗时拆分埋点】把"找位"拆成【扫描】和【评估】两段，用数据决定优化哪边。
// 起因：朋友建议"每 5 秒预扫候选点缓存起来"，但那要先知道扫描占多少 ——
//   现有日志因为"找位>=10ms 或 生成>=10ms 就记一条"的触发条件而无法分辨（见 ㊱）。
// 扫描 = BuildNavCand（纯数组读+算术，零 native，O(导航区数)）
// 评估 = TryNavSpot （tries 次【随机抽样】候选 × native：FindRandomSpot / 可见性 / 碰撞盒 / 路程）
// 【v1.18.10 改名 + 单位纠正 —— 这是一次"名字说谎害死人"的实例，记下来】
//   原来这两个变量名字里带 Ms，但里面装的其实是 **秒**
//   （`GetEngineTime()` 返回 float 秒）。结果 v1.18.9 写的累计汇总行忘了 ×1000，
//   直接把"秒"当"毫秒"打印 ⇒ 日志出现 `n=225 … 总计 1 ms … 平均每只 0.00 ms`
//   这种一眼假的数据（百分比是对的，绝对值小了 1000 倍）。
//   ⇒ 现在名字一律带 Sec，打印处一律显式 ×1000.0 并标 ms。**名字必须说真话。**
float  g_fFindScanSec;        // 本次找位里 BuildNavCand 的累计（秒）
float  g_fFindEvalSec;        // 本次找位里 TryNavSpot 的累计（秒）
// 【为什么还要"本图累计"】GetEngineTime() 是 float 秒；单次十几毫秒的差值量化误差
// 相对不小，累加到大数能把相对误差摊掉。**这两个计数器不按波重置**，与 g_iNarrowCount
// 等既有累计口径一致（它们也是只增不重置，见 ㊱）。
float  g_fTotScanSec;
float  g_fTotEvalSec;
float  g_fTotFindSec;         // 找位总耗时累计（用于算"其余"= 总计 - 扫描 - 评估）
int    g_iTotFindN;           // 被计入累计的找位次数（成功 + 失败：两个分支都要算）
int    g_iTotFindFail;        // 其中【失败】的次数 —— 失败路径原来完全没被量过

// 【v1.18.11 · 把"其余"也拆开】
// 为什么加：v1.18.9/10 的拆分给出的是「扫描 ~10% / 评估 ~23% / **其余 ~67%**」——
// 其余占大头而且**根本不知道是什么**，等于优化方向还是瞎猜。
// 读源码后确认：`FindSpawnPos` 里只有 BuildNavCand（扫描）和 TryNavSpot（评估）被计了时；
//   ①【引擎路径】`for (i<tries) L4D_GetRandomPZSpawnPosition(...)` 整段（引擎自己要做导航查询，
//     而这条路径占全天刷特量的 86%）
//   ②【自建导航路径】`FindSpawnPosByNav()`（两次调用点）
//   ③ `RefreshAliveSIPositions()`、`MinDistToUsed/Survivors`、以及那一串 LogMessage
// 这三块全落在计时块外面 ⇒ 全部被算进"其余"。
// v1.18.11 先把 ① 和 ② 单独计时，剩下的才是 ③。
// ⚠ 单位一律【秒】，打印处 ×1000.0 标 ms。
float  g_fFindEngineSec;      // 本次找位里【引擎路径循环】的累计（秒）
float  g_fFindNavSec;         // 本次找位里【自建导航 FindSpawnPosByNav】的累计（秒）
float  g_fTotEngSec;          // 本图累计（不按波重置）
float  g_fTotNavSec;

// 【v1.18.13 · Timer_Tick 峰值计量】只加计量，不改行为。
// 为什么需要：`stats`/`net_graph` 的 sv 是【最后一帧耗时的倒数】，所以"sv 忽低"= 偶发贵帧。
// 而 Timer_Tick 每 0.1 秒跑一次、一波要刷 5~7 只、每只找位峰值 38 ms
// ⇒ 一波可能占 40~80 ms，那一帧就报 12~25 fps。
// 平均值看不到这个，必须记【单次最大】和【分档计数】。
int    g_iTickCount;          // Timer_Tick 跑了多少次
int    g_iTickOver10;         // >=10ms 的次数（也就是会明显拖帧的那些）
int    g_iTickOver20;
int    g_iTickOver30;
float  g_fTickSumSec;         // 累计（算平均）
float  g_fTickPeakSec;        // 单次最大
int    g_iTickPeakWave;       // 创纪录时的波次
int    g_iTickPeakClients;    // 创纪录时的客户端数
int    g_iTickPeakSI;         // 创纪录时本次 tick 处理了几只（成功+失败）
float  g_fFindPeakSec;        // 单次找位最大耗时
int    g_iFindPeakWave;
bool   g_bFindPeakFail;
float  g_fFindPeakScanMs;     // 那一次的组成（毫秒，直接存好省的再算）
float  g_fFindPeakEvalMs;
float  g_fFindPeakEngMs;
float  g_fFindPeakNavMs;

// —— 诊断追踪：分辨"被打死"还是"被引擎凭空回收" ——
// 问题现象：每波刷 4 只，但下一波开始时场上只剩 1~3 只。
// 必须查清是玩家杀得快，还是引擎把刷出来的特感默默回收了。
int    g_iTrackWave[MAXPLAYERS + 1];    // 该特感是第几波刷的（0=不追踪）
float  g_flTrackTime[MAXPLAYERS + 1];   // 刷出时刻
bool   g_bTrackDone[MAXPLAYERS + 1];    // 已结算过（击杀或消失），避免重复报告
// 【v1.18.3 · "刷墙里 / 凭空死"定位】2026-09-25 三方图实测发现：
// 整场 1818 次特感死亡 **100% 都没有生还者击杀记录**，中位存活仅 8.4 秒，
// 而且是成批同时死（6 只挤在 2 秒内、存活 3.7~5.5 秒）。
// 直接后果：518 波里 278 波开局时场上只有 0~1 只特感（场上=0 出现 167 次）。
// 已排除：引擎回收 0 次（说明都是真实的 entity_killed 事件）、满员守卫仅 8 次。
// 剩下的可能分两大类，下面的埋点就是为了把它们一刀切开：
//   A. 出生点本身非法（刷在墙里/地板下/世界外）→ 位移≈0 且 出生在实心=1
//   B. 出生点合法但别的原因致死            → 位移很大，或出生在实心=0
float  g_fTrackPos[MAXPLAYERS + 1][3];  // 出生坐标
float  g_fTrackTgtDist[MAXPLAYERS + 1]; // 出生时距目标生还者的距离
float  g_fTrackTravel[MAXPLAYERS + 1];  // 【v1.20.0】出生点到目标生还者的**真实导航路程**（<0 = 引擎说走不通）
bool   g_bTrackSolid[MAXPLAYERS + 1];   // 出生点是否落在实心几何内
bool   g_bTrackOutside[MAXPLAYERS + 1]; // 出生点是否已经在世界之外
// 每波累计（打在已有的"累计"行里，一眼看出比例）
int    g_iBornSolid;
int    g_iBornOutside;

// ------------------------------------------------------------------ 【v1.20.0】滞留看门狗
//
// 现象（2026-09-29 服主报"口水和hunter卡住了，然后越卡越多"）：特感刷在生还者身后 800~1240 处，
// 之后 2~4.6 分钟里**几乎不移动**（位移/秒 1.4~5.9，正常跑速 150+），玩家不回头就永远遇不到它，
// 于是场上越积越多（20:51 一度 9 只），后续波次的槽位与上限被这些"站桩"的占住。
//
// 这里的判据刻意用"历史最近距离"而不是"当前距离"：
//   · 只比当前距离的话，一只在原地来回踱步的特感会一会儿"近了"一会儿"远了"，判不出来；
//   · 用"出生以来越靠近越好"的best，语义就变成**"它到底有没有朝玩家走过来过"**，不受抖动影响。
float  g_fWdBest[MAXPLAYERS + 1];       // 出生以来"离最近生还者"的最小距离（0/-1=还没量过）
float  g_fWdBase[MAXPLAYERS + 1];       // 第一次量到的距离（判"有没有靠近"的基准，传送后重置）
float  g_flWdAt[MAXPLAYERS + 1];        // 上次对它动手的时刻
int    g_iWdCount[MAXPLAYERS + 1];      // 已对它处理过几次
// 【v1.33.0】"卡住不动"判据用的三个量：上一次巡检的位置 + 已经静止了多久
float  g_fWdLastPos[MAXPLAYERS + 1][3];
float  g_fWdStill[MAXPLAYERS + 1];      // 连续静止的秒数（每拍没动 +0.5，动过一次就清零）
// 【v1.49.4】与【最近生还者】的高度差【持续】超标了多少秒（每拍超标 +0.5，达标即清零）。
//   与 g_fWdStill 的区别：g_fWdStill 看的是"它自己有没有动"，这个看的是"它和人的高度差是否
//   一直不正常" —— 在坑里/水里持续挪动的特感 still 会被清零，但这条会一直涨。
float  g_fWdVertTime[MAXPLAYERS + 1];   // 【v1.49.4】垂直判据的持续计时
bool   g_bWdPosValid[MAXPLAYERS + 1];   // 上一次位置是否已经采样过
float  g_flWdNextCheck;                 // 下次巡检时刻（0.5 秒一次）
int    g_iTotWdAct;                     // 本图：判定为滞留的次数
int    g_iTotWdMoved;                   // 本图：其中真的传送成功的次数
// 【v1.33.2】本图：因"正在控人"被拦下、没有传送的次数（每次记一行日志）
//   为什么需要节流：WdCheck 每 0.5 秒巡检一次，而"控人"期间特感**每一次巡检都满足**
//   滞留判据（双方静止 + 贴脸）⇒ 不加节流时一次 20 秒的扑击会刷 40 行日志
//   （v1.33.1 刚上线就踩到，见 ltt_si_spawner.sp 文件头 v1.33.2 注释）。
int    g_iTotWdSkipPin;
float  g_flWdSkipLog[MAXPLAYERS + 1];   // 每只特感"跳过日志"的节流时间戳（10 秒一条）
// 【v1.36.0】这只特感最近一次被看到"正在控人"的时刻。
//   用途：控人状态**结束**之后（舌头被砍断 / 被推开 / 人死了）它就不再是 controlling，
//   但它此刻仍然"贴脸 + 一动不动"，于是 6 秒后照样会被「静止+贴脸」判据搬走 ——
//   玩家看到的就是"我把舌头砍断了，Smoker 就凭空消失了"（服主 2026-10-03 转述群友实报）。
//   所以控人结束后要有一段"冷静期"不许搬。
float  g_flWdDomAt[MAXPLAYERS + 1];
ConVar g_cWdAfterDom;
// 【v1.49.4 · 出生点三闸 + 看门狗垂直判据】（创建见 OnPluginStart）
ConVar g_cGateWater;                    // 水面闸总开关
ConVar g_cGateOutside;                  // 世界外闸总开关
ConVar g_cGateVert;                     // 垂直闸高度差上限（0=关）
ConVar g_cWdVert;                       // 看门狗：垂直差阈值（0=关这条判据）
ConVar g_cWdVertStill;                  // 看门狗：垂直差需要持续的秒数
int    g_iTotNoPath;                    // 本图：因"没有真实导航路径"被拒的候选数
int    g_iSafeSkip;                     // 【v1.22.0】本图：因"落在起点安全屋内部"被拒的候选数
// 【v1.49.4 · 出生点三闸】本图被各闸拒掉的候选数（进每图汇总，见 LttGateInWater 上方注释）
int    g_iGateWaterSkip;                // 水面闸：候选点在水里
int    g_iGateOutsideSkip;              // 世界外闸：候选点在世界边界之外
int    g_iGateVertSkip;                 // 垂直闸：与最近生还者高度差超标

// ------------------------------------------------------------------ 【v1.23.0】帧内耗时归因
//
// 目的：回答"sv 下探到底是刷特造成的，还是别的东西"。
//   ① 把我方 Timer_Tick 的耗时按**相位**拆开（找位生成 / 踢人回收 / 看门狗 / 其它）；
//   ② 用 OnGameFrame 记下**两次回调之间的间隔**（即帧/跳间隔），超标时把【上一 tick】
//      我方各相位耗时一起打出来 —— 判读法：
//        · 间隔 ≫ 我方耗时  ⇒ 元凶**不在**刷特（别的插件 / 引擎 / horde）
//        · 间隔 ≈ 我方耗时  ⇒ 就是刷特（再看是哪个相位）
//   ③ 每图汇总里打 `OnGameFrame 次数 / 本图时长 / 平均间隔`，用来自证这个回调的语义
//      （平均 ~10 ms = 每 tick；~1.1 ms = 每帧）—— 免得再靠猜。
float  g_flPhaseSum[4];        // 各相位累计（秒）：0=找位生成 1=踢人回收 2=看门狗 3=其它
float  g_flPhasePeak[4];       // 各相位历史峰值（秒）
int    g_iPhaseOver20[4];      // 各相位 >=20ms 的次数
float  g_flLastPhase[4];       // 上一 tick 各相位累加器（每 tick 清零）
float  g_flPhaseSnap[4];       // 【快照】OnGameFrame 读的是它 —— g_flLastPhase 每 tick 结束都会清零，
                               // 直接读它打日志会全是 0（v1.23.0 初版就是这个 bug）
float  g_flLastTickTotal;      // 上一 tick 我方总耗时（秒）
float  g_flFrameLast;          // OnGameFrame：上次回调时刻
float  g_flFrameSum;           // OnGameFrame：间隔累计（算平均用）
float  g_flFrameMax;           // 本图最大间隔（秒）
int    g_iFrameCount;          // OnGameFrame 调用次数
int    g_iFrameOver25;         // 间隔 >=25ms 次数
int    g_iFrameOver50;         // 间隔 >=50ms 次数
int    g_iFrameLogLeft;        // 本图还能打几条归因日志（限流）
// 【v1.26.0】
float  g_flWdSearchAt;         // 看门狗"找位"这个动作的限流时间点（实测单次可达 108ms）
int    g_iTotFarKeep;          // 本图：保底点超硬上限但被"放出来"的只数（不再丢）

// ---- 【v1.27.0】每图刷特黑名单盒（坐标盒）----
// 动机：2026-10-01 服主报 bdp_bunker04 电梯井里连着刷了 口水/Hunter/舌头/牛 4 只。
// 那些点全是"保底点"（来源=保底 段=无），而保底按设计**不看路径**（宁可刷出来也别断供），
// 所以闸门拦不住，只能靠"这张图这块区域不许刷"的坐标盒兜。三方图适配也用得上。
#define MAX_BLACKBOX 64
float  g_fBlackBox[MAX_BLACKBOX][6];   // x1 y1 z1 x2 y2 z2（加载时排好序）
int    g_iBlackCount;

// ---- 【v1.28.0】找位耗时预算 ----
// 病根（2026-10-01 10:18 bdp_bunker04）：候选荒 → 保底点不合格 → 进等待队列 → 每 0.1 秒重试
// 一次**完整**找位（tries 次 + 窗口放大重扫导航缓存）⇒ 单 tick 我方耗时 35~90 ms，100 tick 直接掉。
// 治法：① 单次找位到点就放弃（ltt_sispawn_searchms）② 每 tick 找位总耗时封顶（ltt_sispawn_tickbudget）。
// 两者的"放弃"都不是丢特感 —— 这一只留到下一 tick 继续试（原有等待队列机制）。
ConVar g_cSearchMs;
ConVar g_cTickBudget;
ConVar g_cNearBias;   // 【v1.28.4】距离偏好开关：1=就近优先 0=关（只比分散）
float  g_flSearchDeadline;    // 本次找位的截止时刻（GetEngineTime）
float  g_flTickWorkMs;        // 本 tick 已花在找位上的毫秒
float  g_flTickWorkStamp;     // 本 tick 的时间戳（隔着 >60ms 就当作新 tick）

bool SearchTimeUp()
{
	return (g_cSearchMs.FloatValue > 0.0 && GetEngineTime() > g_flSearchDeadline);
}

/** 【v1.43.0】欠账>0 时找位预算的放大倍数（§206.4 杠杆4）。
 *  为什么只在欠账时放大：欠账本来就是"条件差、扫不出点"攒出来的 ⇒ 给这点额外预算最可能变成产量；
 *  平时欠账为 0 时完全不生效（不影响绝大多数波次的帧）。 */
float CarryBudgetMul()
{
	if (g_iCarry <= 0 || g_cCarryBudget == null)
		return 1.0;
	float m = g_cCarryBudget.FloatValue;
	return (m > 1.0) ? m : 1.0;
}

/** 【v1.37.0】把引擎的每职业上限 z_*_limit 统一设成 ltt_sispawn_zlimit。
 *
 *  为什么要插件来做：这 6 个是 **cheat cvar（旗标 "sv,cheat"）**，引擎在地图初始化时会把它们
 *  重置回默认值(1)。2026-10-04 实测：写进 server.cfg + sm_cvar 设成 2 之后，**重启服务器就全部回 1**，
 *  日志里既没有别的插件在改，也没有任何 changed cvar 记录 ⇒ 只能每次开图后由插件补设。
 *
 *  语义：`ltt_sispawn_zlimit` = 0 → 设成 0（不限）｜>0 → 设成该值｜<0 → 完全不干预（保持引擎/别的插件的行为）。
 *  ⚠ 它只影响"问引擎要落点"这一步的成功率（我们自己的直连刷特不走导演的职业上限），
 *    导演自身的特感已被 director_no_specials + L4D_OnSpawnSpecial 双重挡掉。
 *  用途：A/B 判定"找不到落点"里 Smoker 占比 3 倍是否由职业上限造成。 */
void ApplyZLimits()
{
	int want = g_cZLimit.IntValue;
	if (want < 0)
		return;                       // -1 = 不干预

	char sOld[96], sNew[96];
	FormatEx(sOld, sizeof(sOld), "%d/%d/%d/%d/%d/%d",
		GetLimit("z_smoker_limit"), GetLimit("z_boomer_limit"), GetLimit("z_hunter_limit"),
		GetLimit("z_spitter_limit"), GetLimit("z_jockey_limit"), GetLimit("z_charger_limit"));

	int changed = 0;
	for (int c = 1; c <= MAX_CLASS; c++)
	{
		char name[32];
		FormatEx(name, sizeof(name), "z_%s_limit", g_sZLimitName[c]);
		ConVar cv = FindConVar(name);
		if (cv == null)
			continue;
		if (cv.IntValue != want)
		{
			cv.SetInt(want);
			changed++;
		}
	}

	FormatEx(sNew, sizeof(sNew), "%d/%d/%d/%d/%d/%d",
		GetLimit("z_smoker_limit"), GetLimit("z_boomer_limit"), GetLimit("z_hunter_limit"),
		GetLimit("z_spitter_limit"), GetLimit("z_jockey_limit"), GetLimit("z_charger_limit"));

	LogMessage("[SISpawn] v%s 引擎职业上限：目标=%d ｜改前 %s → 改后 %s（本次改了 %d 个）｜ltt_sispawn_zlimit=-1 可完全不干预",
		PLUGIN_VERSION, want, sOld, sNew, changed);
}

/** 读一个 z_*_limit 的当前值（读不到返回 -1），只为日志。 */
int GetLimit(const char[] name)
{
	ConVar cv = FindConVar(name);
	return (cv == null) ? -1 : cv.IntValue;
}

/** 【v1.34.0】"以距离换分散"的扩窗门槛：达到硬下限(120)就够了，不必为凑目标(350)反复重扫全图。
 *  下限关掉(0)时退回旧行为（按目标值判断）。 */
float EffGrowSep()
{
	return (g_cSpreadMin.FloatValue > 0.0) ? g_cSpreadMin.FloatValue : g_cSpread.FloatValue;
}

/** 【v1.43.0 · 保底/降级路径通用护栏 —— 启动自检】
 *
 *  为什么要有它：保底路径上的硬闸被"漏掉"已经复发 3 次（修订7 高度过滤 / 修订10 硬性最小间距 /
 *  v1.10.2 视线分档），每一次都是先出现"特感卡在安全门里 / 刷进墙里 / 两个叠一起"这种线上事故，
 *  事后才靠人肉翻日志发现。真正的原因不是谁不小心，而是**闸门依赖的 native 或开关缺了，
 *  闸门就静默变成空转**（例如 `g_bHasSpawnAttr=0` 时"安全屋/救生舱"两道闸一声不响地不生效）。
 *  所以这条自检不复述注释，而是按【真实的依赖状态】逐条打 ✓/✗，开机就把它写在日志里。
 *  返回：不生效的道数（>0 时额外打一条告警）。 */
int FallbackGateSelfCheck()
{
	int bad = 0;
	char s[768];

	// 1) 导航网格：走 SDK 调用，永远可用
	FormatEx(s, sizeof(s), "保底/降级路径硬闸自检（7 道）：导航网格 ✓｜");

	// 2) 可达性（needpath）：原生缺 or 开关关 = 这道闸不生效
	// 【v1.49.0】坏导航图档（badnav）是**故意**把 needpath 设 0 的（残片 .nav 根本走不通，
	//   不放宽就一只都刷不出来）⇒ 这属于"按图设计放宽"，不算失效，也不该报警。
	bool okTravel = (g_bHasTravel && g_cNeedPath.BoolValue);
	bool travelByDesign = (g_bBadNavMap && g_bHasTravel);
	if (!okTravel && !travelByDesign) bad++;
	Format(s, sizeof(s), "%s可达性 %s（原生%s,needpath=%d%s）｜", s,
		okTravel ? "✓" : (travelByDesign ? "✓按图放宽" : "✗"),
		g_bHasTravel ? "有" : "缺", g_cNeedPath.IntValue,
		travelByDesign ? "，坏导航图档故意关" : "");

	// 3) 起点安全屋：属性判据 + 坐标精判，两个都缺才算失效
	bool okSafe = ((g_bHasSpawnAttr || g_bHasCpPos) && g_cNoSafeRoom.BoolValue);
	if (!okSafe) bad++;
	Format(s, sizeof(s), "%s起点安全屋 %s（属性%s/坐标%s,开关=%d）｜", s, okSafe ? "✓" : "✗",
		g_bHasSpawnAttr ? "有" : "缺", g_bHasCpPos ? "有" : "缺", g_cNoSafeRoom.IntValue);

	// 4) 救生舱/救援车密封区：依赖 spawn attr
	bool okSealed = (g_bHasSpawnAttr && g_cNavAttr.BoolValue);
	if (!okSealed) bad++;
	Format(s, sizeof(s), "%s救生舱/救援车 %s（原生%s,属性开关=%d）｜", s, okSealed ? "✓" : "✗",
		g_bHasSpawnAttr ? "有" : "缺", g_cNavAttr.IntValue);

	// 5) 世界外/墙里：依赖 nav attr
	bool okWorld = (g_bHasNavAttr && g_cNavAttr.BoolValue);
	if (!okWorld) bad++;
	Format(s, sizeof(s), "%s世界外/墙里 %s（原生%s,属性开关=%d）｜", s, okWorld ? "✓" : "✗",
		g_bHasNavAttr ? "有" : "缺", g_cNavAttr.IntValue);

	// 6) 黑名单盒：本图 0 个 = 没有盒要管（不算失效），有盒时才算"生效"
	Format(s, sizeof(s), "%s黑名单盒 %d 个｜", s, g_iBlackCount);

	// 7) 碰撞盒：hull 射线是引擎自带，永远可用
	Format(s, sizeof(s), "%s碰撞盒 ✓ ⇒ 结论：%d/7 生效", s, 7 - bad);

	LogMessage("[SISpawn] v%s 地图=%s %s", PLUGIN_VERSION, g_sMap, s);
	if (bad > 0)
		LogMessage("[SISpawn] v%s 地图=%s ⚠ 保底护栏告警：有 %d 道硬闸当前【不生效】（见上一行的 ✗ 及括号里的原因）—— 保底点可能落在不合格位置",
			PLUGIN_VERSION, g_sMap, bad);
	g_iFbGateInactive = bad;
	return bad;
}

/** 【v1.43.0 · 保底护栏 —— 放行前独立复核】
 *
 *  在保底/降级点被真正采纳之前，用**独立的一次调用**把几何/导航类硬闸再走一遍。
 *  与分支里的判据同源（同一批 helper），但**独立成函数**：将来谁把某道闸从保底分支里删掉，
 *  这里就会报出来（这正是"漏了 3 次"的那个失败模式）。
 *  ⚠ 只告警、不改行为：护栏在没被验证过之前不许改变线上行为。 */
void FallbackGateAudit(float pos[3], float target[3], int zclass)
{
	g_iFbAudit++;

	int    v = 0;
	char   why[160];
	why[0] = '\0';

	Address fa = L4D2Direct_GetTerrorNavArea(pos);
	if (fa == Address_Null)
	{
		v++;
		Format(why, sizeof(why), "不在导航网格上");
	}
	else
	{
		int fattr = g_bHasNavAttr ? L4D_GetNavArea_AttributeFlags(fa) : 0;
		int fsa   = g_bHasSpawnAttr ? L4D_GetNavArea_SpawnAttributes(fa) : 0;

		if (g_bHasNavAttr && g_cNavAttr.BoolValue
			&& ((fattr & NAV_BASE_OUTSIDE_WORLD) || (fattr & NAV_BASE_PLAYERCLIP)))
		{
			v++;
			Format(why, sizeof(why), "墙里/地图外(playerclip=%d outside=%d)",
				(fattr & NAV_BASE_PLAYERCLIP) ? 1 : 0, (fattr & NAV_BASE_OUTSIDE_WORLD) ? 1 : 0);
		}
		else if (g_bHasSpawnAttr && g_cNavAttr.BoolValue && fsa != 0
			&& (fsa & (TERROR_NAV_RESCUE_CLOSET | TERROR_NAV_RESCUE_VEHICLE)))
		{
			v++;
			Format(why, sizeof(why), "落在救生舱/救援车密封区");
		}
		else if (IsInStartSafeRoom(pos, fsa))
		{
			v++;
			Format(why, sizeof(why), "落在起点安全屋内部");
		}
	}

	if (v == 0 && !NavPathOk(target, pos))
	{
		v++;
		Format(why, sizeof(why), "导航不可达（needpath）");
	}
	if (v == 0 && IsBlacklisted(pos))
	{
		v++;
		Format(why, sizeof(why), "命中黑名单盒");
	}

	if (v > 0)
	{
		g_iFbViolation++;
		// 前 5 次每次都留痕（这种情况本不该出现，刷屏本身就是信号）
		if (g_iFbViolation <= 5)
			LogMessage("[SISpawn] ⚠ 保底护栏告警：地图=%s %s 放行的保底点未通过硬闸【%s】（坐标 %.0f,%.0f,%.0f）—— 保底分支漏了这道闸，请查代码（护栏只告警、未拦截）",
				g_sMap, g_sClassName[zclass], why, pos[0], pos[1], pos[2]);
	}
}
float  g_fRuleRelax = 1.0;

/** 【v1.43.0 · §206.4 杠杆2「失败前降级重试」】等待降级时，把"同一波内最小间距"的硬下限一起放宽。
 *
 *  【v1.21.0】等待降级：当前这次找位允许放宽的倍数（1.0 = 不放宽），由等待队列按等待时长设置。
 *   【v1.43.0 挪位】原来定义在文件更后面，现在搬到这里（SourcePawn 要求先用后定义）——
 *   因为下面这个函数要读它。
 *  病根：`g_fRuleRelax`（等久了放大到最多 3 倍）原来只放宽 flow 上限与保底硬上限，
 *    **硬下限 spread_min(120) 一步不让** ⇒ 在窄图/候选荒里"所有看得见的候选都判太挤"，
 *    于是整只丢掉（表现就是"本只放弃"）。
 *  现在：硬下限按 `1/relax` 递减，但不低于 `ltt_sispawn_lastchance_floor`（默认 60，
 *    正是服主 §206.4 提的那个数）。`ltt_sispawn_lastchance 0` = 关掉这条（回旧行为）。
 *  ⚠ 统计口径**故意不跟着放宽**：`分散两层口径` 里的「硬下限未达标 N 只」仍按基准值算
 *    （见 TryNavSpot 出口与 PrintQualitySummary），否则这条放宽会把自己的效果洗掉。
 *  ⚠ 只在 `spread>0` 时才有意义，挡位 0（spread=0）行为不变。 */
float EffSpreadFloor()
{
	float base = g_cSpreadMin.FloatValue;
	if (base <= 0.0)
		return 0.0;
	if (g_cLastChance == null || !g_cLastChance.BoolValue || g_fRuleRelax <= 1.01)
		return base;
	float lo = (g_cLastChanceFloor != null) ? g_cLastChanceFloor.FloatValue : base;
	if (lo <= 0.0)
		lo = base;
	float v = base / g_fRuleRelax;
	return (v < lo) ? lo : v;
}

/** 本 tick 的找位预算是否已用完（0=不限）。用"距上次记录 >60ms"来判定新 tick，不用额外定时器。 */
bool TickBudgetUp()
{
	if (g_cTickBudget.FloatValue <= 0.0)
		return false;
	float now = GetEngineTime();
	if (now - g_flTickWorkStamp > 0.06)
	{
		g_flTickWorkStamp = now;
		g_flTickWorkMs = 0.0;
		return false;
	}
	return (g_flTickWorkMs >= g_cTickBudget.FloatValue * CarryBudgetMul());
}

void NoteSearchCost(float ms)
{
	g_flTickWorkMs += ms;
}
// 【v1.21.0】等待降级：当前这次找位允许放宽的倍数（1.0 = 不放宽），由等待队列按等待时长设置
// 【v1.43.0 挪位】它的定义搬到了 EffSpreadFloor() 之前（SourcePawn 要求先用后定义）：
//   现在"硬下限也参与等待降级"要在那个函数里读 g_fRuleRelax。
int    g_iTotRelax;                     // 本图：靠"等待降级"才刷出来的只数

public Plugin myinfo =
{
	name        = "[LTT] SI Spawner",
	author      = "DeepSeek Harness",
	description = "自己掌控的多特刷特核心：可调距离区间、只刷最前玩家、引擎原生找位",
	version     = PLUGIN_VERSION,
	url         = ""
};

// ------------------------------------------------------------------ 启动

bool g_bLttAnnounced = false;   // 【LTT 补丁 2026-10-07】每图只播一次设置摘要（团灭重启不再重复刷）

public void OnPluginStart()
{
	// 【v1.8.2修订9】探测导航属性原生是否可用（老版 left4dhooks 没有）。
	// 缺了只是少一道过滤，绝不能让它影响插件加载。
	g_bHasNavAttr = (GetFeatureStatus(FeatureType_Native, "L4D_GetNavArea_AttributeFlags") == FeatureStatus_Available);
	// 【v1.8.2修订11】生成属性（救生舱/救援车/FINALE）
	g_bHasSpawnAttr = (GetFeatureStatus(FeatureType_Native, "L4D_GetNavArea_SpawnAttributes") == FeatureStatus_Available);
	// 【v1.11.0】引擎 PVS 可见性（left4dhooks 172346 / include 324996 起才有；
	// 老版 left4dhooks 缺这个原生，实测报 "Native ... was not found"，所以必须探测）
	g_bHasEngineVis = (GetFeatureStatus(FeatureType_Native, "L4D_IsPotentiallyVisibleToTeam") == FeatureStatus_Available);
	// 【v1.12.0】真实导航路程（同样要探测，老版 left4dhooks 可能没有）
	g_bHasTravel = (GetFeatureStatus(FeatureType_Native, "L4D2_NavAreaTravelDistance") == FeatureStatus_Available);
	// 【v1.22.0】安全屋位置精判（老版 left4dhooks 没有 → 只靠 NAV_SPAWN_CHECKPOINT 属性）
	g_bHasCpPos = (GetFeatureStatus(FeatureType_Native, "L4D_IsPositionInFirstCheckpoint") == FeatureStatus_Available);
	// 【v1.49.8】开场过场原生（left4dhooks 1.133+ 提供；老版本退化成只用时间闸）
	g_bHasIntroNative = (GetFeatureStatus(FeatureType_Native, "L4D_IsInIntro") == FeatureStatus_Available);

	// 【v1.15.0】点级可见性原生（两级判定的第二级要用）
	g_bHasVisPlayer = (GetFeatureStatus(FeatureType_Native, "L4D2_IsVisibleToPlayer") == FeatureStatus_Available);

	// 【v1.30.0】救援关判定原生（老版 left4dhooks 没有 → 只能靠 ltt_sispawn_rescue_force 手测）
	g_bHasFinaleMap    = (GetFeatureStatus(FeatureType_Native, "L4D_IsMissionFinalMap") == FeatureStatus_Available);
	g_bHasFinaleEscape = (GetFeatureStatus(FeatureType_Native, "L4D_IsFinaleEscapeInProgress") == FeatureStatus_Available);

	g_cEnable   = CreateConVar("ltt_sispawn_enable",  "1",     "总开关 1=开 0=关", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cWave     = CreateConVar("ltt_sispawn_wave",    "4",     "每波刷几只（独立于存活上限）", FCVAR_NOTIFY, true, 1.0, true, 32.0);
	g_cCap      = CreateConVar("ltt_sispawn_cap",     "8",     "同时存活上限。建议约为 wave 的 2 倍，否则上一波剩下的会吃掉下一波额度", FCVAR_NOTIFY, true, 1.0, true, 32.0);
	g_cTime     = CreateConVar("ltt_sispawn_time",    "40.0",  "刷新间隔（秒）", FCVAR_NOTIFY, true, 1.0, true, 300.0);
	g_cFirst    = CreateConVar("ltt_sispawn_first",   "5.0",   "离开安全区后第一波特感的延迟（秒）", FCVAR_NOTIFY, true, 0.0, true, 120.0);
	// 【v1.49.7 · 车主 2026-10-31】没有起点安全屋的自制图：开图后先等一会儿再武装。
	// 背景：这类图 L4D_HasAnySurvivorLeftSafeArea() 一开图就为 true，过场动画还没放完特感就开刷。
	// 只对**名单里的图**生效 ⇒ 官图与其它图行为完全不变。
	g_cArmDelay      = CreateConVar("ltt_sispawn_arm_delay",      "60.0", "【v1.49.7】在 arm_delay_maps 名单里的图：开图后等这么多秒才允许武装/开刷（0=不延后）", FCVAR_NOTIFY, true, 0.0, true, 600.0);
	g_cArmDelayMaps  = CreateConVar("ltt_sispawn_arm_delay_maps", "", "【v1.49.7】需要延后武装的地图名单（逗号分隔，精确地图名，大小写不敏感）", FCVAR_NOTIFY);
	// 【v1.49.8 · 车主 2026-11-01】双重保险①：开场过场（L4D_IsInIntro）期间一律不开刷。
	g_cIntroGuard    = CreateConVar("ltt_sispawn_intro_guard",      "1",     "【v1.49.8】1=开场过场期间不开刷（对所有图生效）｜0=关", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cIntroGuardMax = CreateConVar("ltt_sispawn_intro_guard_max",  "180.0", "【v1.49.8】过场判定最多挡这么多秒（防原生异常导致永不刷特）", FCVAR_NOTIFY, true, 0.0, true, 900.0);
	// 【v1.49.9 · 车主 2026-11-02】"生还者动过"作为武装信号：冻结/过场中动不了 ⇒ 动了就是解冻了。
	g_cArmMove      = CreateConVar("ltt_sispawn_arm_move",     "200.0", "【v1.49.9】生还者位移超过这么多单位才算「动过」（0=关闭这个要求）", FCVAR_NOTIFY, true, 0.0, true, 3000.0);
	g_cArmMoveMax   = CreateConVar("ltt_sispawn_arm_move_max", "180.0", "【v1.49.9】兜底：开图超过这么多秒就不再要求「动过」（防挂机死锁）", FCVAR_NOTIFY, true, 0.0, true, 900.0);
	// 【v1.14.0】描述与默认值对齐：这里的默认值就是 200.0，不是 1。
	//   历史：v1.8.2修订11 曾对齐 fdxx 的 z_spawn_safety_range=1 改成 1；
	//         v1.10.1 按服主要求改回 200（设 1 会贴脸）。线上 cfg 也是 200.0。
	g_cMin      = CreateConVar("ltt_sispawn_min",     "200.0",   "最小刷新距离（离目标生还者）。默认 200。历史：【v1.8.2修订11】曾对齐 fdxx 的 l4d2_si_spawn_control（z_spawn_safety_range=1）改成 1；【v1.10.1】按服主要求改回 200", FCVAR_NOTIFY, true, 0.0);
	// 【v1.14.0】描述与默认值对齐：这里的默认值就是 2000.0，不是 1500。
	//   历史：v1.8.2修订11 曾放宽到 1500；v1.10.1 按服主要求再放宽到 2000
	//         （同时把 ltt_sispawn_engine_range 也设成 2000）。线上 cfg 也是 2000.0。
	g_cMax      = CreateConVar("ltt_sispawn_max",     "2000.0", "最大刷新距离（0=不限）。默认 2000。会通过 ltt_sispawn_engine_range 影响引擎 z_spawn_range，同时是我们自己的取舍窗口上限。历史：【v1.8.2修订11】曾对齐两家参考实现设为 1500；【v1.10.1】按服主要求放宽到 2000", FCVAR_NOTIFY, true, 0.0);
	g_cTries    = CreateConVar("ltt_sispawn_tries",   "10",    "单个特感的找位尝试次数（超距离就重试，不是丢弃）", FCVAR_NOTIFY, true, 1.0, true, 50.0);
	g_cBatch    = CreateConVar("ltt_sispawn_batch",   "1",     "每 0.1 秒生成几只（防一次性生成太多 choke）", FCVAR_NOTIFY, true, 1.0, true, 8.0);
	// 【v1.18.8 · 找位重试节流】
	// 起因：2026-09-26 用 fps_watch.py 采了 294 个样本后确认 —— 服务端 tick 一直是 100.0/s、
	//   5 秒平均一直是 100 fps，但客户端 net_graph 会偶尔显示"服务器帧率 29"。
	//   那个 29 是【单帧瞬时倒数】：1000/34ms = 29.4。也就是说"net_graph 显示的 29"
	//   = "刚刚有一帧花了 34ms"，不是服务器在低速运行。
	// 而这 34ms 里找位是主要贡献者之一：插件自报 找位 中位 13.6ms / P90 20.5 / P99 28.3 / 峰 48.8ms，
	//   且 Timer_Tick 跑在游戏线程上 ⇒ 直接进帧时间。
	// 原来"位置不合格 → 进等待队列 → **每个 tick(0.1秒)** 重跑一次完整找位"，
	//   位置一直不合格时就是 10 次/秒 × 13.6ms ≈ 136ms/秒 全压在游戏线程上。
	// 现在：每 N 个 tick 才重试一次。**只影响重试，不影响正常生成间隔。**
	// 卡住保护仍是"墙钟 3 秒"：跳过期间照样累加 g_iStallTicks（见 Timer_Tick 里的注释），
	//   所以放弃时机不变、只是重试次数少 N 倍。1 = 旧行为（每 tick 重试）。
	g_cRetryGap = CreateConVar("ltt_sispawn_retrygap","3",    "【v1.18.8】位置不合格时每 N 个 tick(0.1秒) 才重试一次找位（1=旧行为每 tick 重试）。只影响重试，不影响正常生成间隔", FCVAR_NOTIFY, true, 1.0, true, 20.0);
	g_cClasses  = CreateConVar("ltt_sispawn_classes", "1,2,3,4,5,6", "【v1.48.2】允许刷的特感职业，两种写法都认：①逗号表 \"1,2,3,4,5,6\"（1烟鬼 2胖子 3猎人 4毒妇 5骑师 6牛）②纯数字位掩码（1烟鬼|2胖子|4猎人|8毒妇|16骑师|32牛，如 63=全六种、53=烟鬼+猎人+骑师+牛）。菜单的\"特感游戏模式\"写的是位掩码", FCVAR_NOTIFY);
	g_cTimeMode = CreateConVar("ltt_sispawn_timemode","0",     "刷特时间模式 0=固定 1=递增(场上越多等越久) 2=递减", FCVAR_NOTIFY, true, 0.0, true, 2.0);
	g_cTimeStep = CreateConVar("ltt_sispawn_timestep","2.0",   "递增/递减模式每次调整的秒数", FCVAR_NOTIFY, true, 0.0, true, 60.0);
	g_cDebug    = CreateConVar("ltt_sispawn_debug",   "1",     "日志级别：0=只记异常 1=常规(每波一条汇总) 2=详细(每只特感都记，排查用)", FCVAR_NOTIFY, true, 0.0, true, 2.0);
	g_cAnnounce = CreateConVar("ltt_sispawn_announce","1",     "1=每回合出门时在聊天框播报当前刷特设置", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cScaling  = CreateConVar("ltt_sispawn_scaling", "1",     "1=按生还者人数自动加特感（>4 人才生效，4 人以内不变）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cPerPlayer= CreateConVar("ltt_sispawn_perplayer","1",    "每多一个生还者（超过 4 人之后），每波多加几只（存活上限同步加 2 倍这个值）", FCVAR_NOTIFY, true, 0.0, true, 8.0);
	g_cSearchMs   = CreateConVar("ltt_sispawn_searchms",   "8.0",  "【v1.28.0】单次找位的耗时上限（毫秒，0=不限）。到点就放弃本次、留到下一 tick 再试", FCVAR_NOTIFY, true, 0.0, true, 200.0);
g_cTickBudget = CreateConVar("ltt_sispawn_tickbudget", "12.0", "【v1.28.0】每个 tick 用于找位的总耗时预算（毫秒，0=不限）。超了就停手，剩下的下一 tick 继续", FCVAR_NOTIFY, true, 0.0, true, 400.0);
g_cFallbackMax = CreateConVar("ltt_sispawn_fallbackmax","1800.0","保底落点的距离硬上限（0=不限）。引擎在附近找不到合法导航点时会给几千单位外的坐标，超过这个值就宁可这一只不刷", FCVAR_NOTIFY, true, 0.0);
	g_cMethod   = CreateConVar("ltt_sispawn_method",  "1",     "刷特方式 1=直连NextBotCreatePlayerBot（可超过9只，默认）0=引擎原生ZombieManager（最多9只）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cReserve  = CreateConVar("ltt_sispawn_reserve", "3",     "给真人进服预留的客户端槽位数。存活上限最多只能到 MaxClients-生还者数-这个值，避免特感把服务器塞满没人进得来", FCVAR_NOTIFY, true, 0.0, true, 20.0);
	g_cRecycle  = CreateConVar("ltt_sispawn_recycle", "1",     "1=自动踢掉死亡的特感假人来腾出槽位（直连方式必须开，否则死一只就永久少一个槽位）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cRecycleDelay = CreateConVar("ltt_sispawn_recycledelay","3.0","特感假人死后多少秒回收（等引擎先自己用一会儿）", FCVAR_NOTIFY, true, 0.0, true, 60.0);
	g_cGuard    = CreateConVar("ltt_sispawn_guard",   "1",     "1=满员守卫：永远留出至少 1 个空客户端槽位（+reserve），否则 CreateFakeClient 建不出人，服务器会死锁在 18/18 谁也刷不出来", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cAhead    = CreateConVar("ltt_sispawn_ahead",   "1",     "1=不许刷在目标生还者身后（按导航流距离判定）。【v1.8.2 更正】引擎给的落点只保证『有合法导航的可刷特区域』，它【不查视线】，所以默认会刷在队伍后面或正面冒出来", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	g_cBalance  = CreateConVar("ltt_sispawn_balance", "1",     "1=职业自动均衡：优先从『场上+队列里数量最少』的职业里挑。防止 26 只里全是牛/全是猎（不设这个的话是纯随机）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cClassLimit = CreateConVar("ltt_sispawn_class_limit", "0,0,0,0,0,0", "每种特感的存活硬上限（烟鬼,胖子,猎人,毒妇,骑师,牛；0=不限）。只防某一类独大，各值之和建议【大于】总上限，否则会把总数卡住", FCVAR_NOTIFY);

	g_cTankAction = CreateConVar("ltt_sispawn_tank_action", "1",   "坦克期策略：0=不干预（照常用普通参数）｜1=坦克期改用下面那套参数（照常刷）｜2=坦克期停刷，坦克走后恢复｜3=坦克期停刷并把场上已有的特感清掉（对应 Neko 的 Special_Spawn_Tank_Alive / _Pro）", FCVAR_NOTIFY, true, 0.0, true, 3.0);
	g_cTankCap    = CreateConVar("ltt_sispawn_tank_cap",    "8",   "坦克期间的存活特感上限（不含坦克本身）", FCVAR_NOTIFY, true, 1.0, true, 32.0);
	g_cTankClasses= CreateConVar("ltt_sispawn_tank_classes","2,2,3,2,3,3", "坦克期间每种特感的存活上限（0=不限）。坦克本来就够凶，这里通常要收紧一点", FCVAR_NOTIFY);

	// ---- v1.32.0 ----
	// 【补员模式】起因：服主 2026-10-04 实测 —— 「这个 4 特 10 秒跟假的一样，
	//   根本没见到同时有 4 只特感」。查日志确认不是刷不出来，而是
	//   **波次节奏 + 秒杀**：POS 行里"场上存活"长期 1~3，特感存活中位数 8.9 秒
	//   （43 只活不到 5 秒）。原逻辑是"每 time 秒开一整波"，特感被瞬间清掉时
	//   要再干等 10 秒才补下一整波 ⇒ 观感就是稀稀拉拉。
	//   补员模式改成"死了就补、只补缺口"，与 time 无关。
	g_cRefill     = CreateConVar("ltt_sispawn_refill", "0", "【v1.32.0】补员/保持满员：0=现状（每 time 秒一整波）｜1=场上少于『每波』就立刻补到该数（不等 time）｜2=补到『上限』。专治『看不到同时 4 只』", FCVAR_NOTIFY, true, 0.0, true, 2.0);
	g_cRefillGap  = CreateConVar("ltt_sispawn_refillgap", "1.5", "【v1.32.0】补员模式的最小补员间隔（秒）。补员不看 time，但也不该每个 tick 都补", FCVAR_NOTIFY, true, 0.3, true, 20.0);
	// 【突击脉冲】起因：服主「特感主动攻击生还者根本没用，有些特感放完技能就跑了」。
	//   我们已有的两层（ltt_si_ai 改脚本值 = 敢不敢上；l4d_target_override = 打谁）
	//   都管不到"放完技能退回去"这一刻。nb_assault 是引擎自己的
	//   "next bot 突击"命令，asiai.sp / AI_HardSI.sp 就是靠它把特感钉在进攻状态。
	//   纯控制台命令 + 官方 CheatCommand 原生，无内存补丁（符合项目底线）。
	g_cAssault    = CreateConVar("ltt_sispawn_assault", "0", "【v1.32.0】特感突击脉冲：定期下发引擎命令 nb_assault，逼特感主动进攻而不是放完技能就退。0=关（默认，先单独验证 ltt_si_ai 的修复效果）｜1=开（做法抄 asiai / AI_HardSI，纯控制台命令、无内存补丁）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cAssaultGap = CreateConVar("ltt_sispawn_assaultgap", "1.0", "【v1.32.0】突击脉冲间隔（秒）。asiai 是出生后发一次；AI_HardSI 是 0.3 秒无限重复。默认 1.0 秒（持续施压，开销可忽略）", FCVAR_NOTIFY, true, 0.3, true, 10.0);

	// 【v1.32.2】只钉住「自建落点」这一项。
	// 背景：服主 2026-10-03 想试"挡位 0（纯引擎点位）不变，但引擎找不到时用自建落点兜底"，
	// 而 ApplyMode() 会按挡位把 navsearch 强制写成 0/1/2（挡位 0 → 0）
	// —— 手改的值每次开图/切挡位/重载都会被静默盖回去（和 §182.3 那次"改了没生效"同类）。
	// 有了这个锁，就能在不改动【挡位 0 定义】的前提下做这项 A/B：
	// 实验完 navsearch_lock 0 + navsearch 0 即可完全回到原样。
	g_cNavSearchLock = CreateConVar("ltt_sispawn_navsearch_lock", "0", "【v1.32.2】1=不按挡位覆盖 ltt_sispawn_navsearch（尊重手改值；用于单独试验『挡位 0 + 自建落点兜底』）｜0=现状（挡位管 navsearch）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cCostLog  = CreateConVar("ltt_sispawn_costlog", "3", "生成耗时埋点阈值(毫秒)：找位段或生成段超过它就打一条日志。0=关闭", FCVAR_NOTIFY, true, 0.0, true, 200.0);
	g_cNavVis   = CreateConVar("ltt_sispawn_navsearch_vis", "1", "自建落点是否也要求『不在生还者视野内』。1=优先挑藏起来的点（挑不到才放宽，绝不丢特感）0=随便挑（特感可能正面冒出来）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cNavSearch = CreateConVar("ltt_sispawn_navsearch", "1", "自建落点：0=关 1=只在引擎找不到时用（推荐）2=优先自己找（更接近 Neko 可变模式，位置更凶）", FCVAR_NOTIFY, true, 0.0, true, 2.0);

	// ---- v1.8.2 ----
	// 【坑】方向 D 原本想做成"navsearch_vis 扩到档位 2"，实测【行不通】：
	// SourceMod 在插件重载时会复用同名 ConVar，新传的 max 和描述【被静默忽略】
	// —— 2026-09-23 18:44 部署后 RCON 查到的 max 仍是 1.000000、描述仍是旧文本，
	// 于是 `if (IntValue >= 2)` 永远不成立、方向 D 静默失效。改用独立 cvar 名字。
	g_cVisEngine = CreateConVar("ltt_sispawn_vis_engine", "0", "【v1.8.2 方向D】1=引擎找位路径【也】做『生还者看不见』检查（专治『凭空刷』）。默认 0=保持 v1.8.1 的引擎路径行为不变。开了之后引擎失败率会上升、更多走自建落点，建议配合 poslog 对比", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cNearBias = CreateConVar("ltt_sispawn_nearbias", "1",
		"【v1.28.4】距离偏好：1=就近优先（<500 → <900 → <1400，特感更贴脸、压迫感高，默认）｜0=关掉（同档位只比分散，分布更平均）",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cSpread   = CreateConVar("ltt_sispawn_spread", "350.0", "【v1.8.2 方向A】同一波内两个落点的最小间距（0=关）。防止 26 只挤在同一小片区域被一个人架枪清完；全部候选都太近时会放宽为『间距最大的那一个』并记日志", FCVAR_NOTIFY, true, 0.0);
	// 【v1.34.0 · 2026-10-03 服主定稿】"分散"的硬下限。
	//   服主原话：「狭窄地形直接不要求特别分散了吧，比如说左边掩体距离右边掩体才 200 距离，
	//   只要不要左边掩体刷十几只就 ok」。
	//   语义分两层：
	//     · ltt_sispawn_spread(350)  = **目标**（择优时越远越好，也是"以距离换分散"的扩窗依据的上限）
	//     · ltt_sispawn_spread_min(120) = **硬下限**（择优时优先保证；扩窗只为它让路，不再为凑 350 反复重扫全图）
	//   为什么必须分开：实测（L20261003 挡位1 一场 336 波）为了凑 350 触发了 **436 次"窗口放大"**，
	//   每次都是一遍全图导航区扫描 ⇒ 找位峰值正好顶在 tickbudget(20ms) 上被掐断 ⇒
	//   「找不到落点，本只放弃」319 次。而 09-30（无预算、tries=10/扩窗 2500）时刷满率 86~88%，
	//   今天只有 55%。
	g_cSpreadMin = CreateConVar("ltt_sispawn_spread_min", "120.0", "【v1.34.0】同一波内两只特感出生点的【硬下限】。低于它的候选只在没有更好的时候才用（防止同一个掩体堆一群）。0=关掉这条（退回旧行为：只按 spread 目标追）", FCVAR_NOTIFY, true, 0.0);
	// 【v1.37.0】引擎每职业上限。为什么要插件设：它们是 cheat cvar，引擎每次开图会把它们重置回 1，
	// 写 server.cfg 也保不住（2026-10-04 实测：写进 cfg + sm_cvar 设 2，重启后全回 1，日志无任何改动静）。
	g_cZLimit = CreateConVar("ltt_sispawn_zlimit", "2", "【v1.37.0】每次开图把引擎的 z_*_limit（每职业存活上限）统一设成这个值：0=不限、>0=该值、-1=完全不干预。用于 A/B 判定「Smoker 找不到落点占比 3 倍」是否由职业上限造成", FCVAR_NOTIFY, true, -1.0, true, 32.0);
	g_cZLimit.AddChangeHook(OnCvarChanged);
	// 【v1.38.0】"就近优先"真正生效的关键开关：只有拿到理想点（藏点+间距达标+<500）才提前收工
	g_cFindBest = CreateConVar("ltt_sispawn_findbest", "1", "【v1.38.0】1=择优时只有拿到「理想点（藏点+间距达标+距目标<500）」才提前收工，否则继续扫出更近的点（让就近优先生效）｜0=旧行为（撞到第一个『藏点+间距达标』的点就返回，不看距离，落点会偏远）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	// 【v1.39.0】缺口顺延：本波没刷出来的名额不丢，累加到下一波的计划里
	g_cCarry = CreateConVar("ltt_sispawn_carry", "1", "【v1.39.0】1=缺口顺延（本波没刷出来的名额加到下一波计划，不丢只数）｜0=旧行为（直接丢掉）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cCarryMax = CreateConVar("ltt_sispawn_carry_max", "8", "【v1.39.0】顺延欠账的累计上限（只）。防止场上长期满导致一次爆一大波", FCVAR_NOTIFY, true, 1.0, true, 64.0);
	g_cCarryStep = CreateConVar("ltt_sispawn_carry_step", "0", "【v1.40.0】每波最多认领几只欠账（0=不限=旧行为，一次全补）。实测单波物理天花板≈8只：计划排到11~16反而只落7.14只/波，所以设成 2~3 让欠账分几波在「甜区」消化，配合 carry_max 抬高可减少换图蒸发", FCVAR_NOTIFY, true, 0.0, true, 32.0);

	// 【v1.49.11】游戏内调试播报（所有人可见）
	g_cDbg = CreateConVar("ltt_sispawn_dbg", "0", "【v1.49.11】游戏内调试播报：0=关｜1=每波汇总（计划/实刷/欠账/场上）｜2=1 的基础上每生成一只再播一行", FCVAR_NOTIFY, true, 0.0, true, 2.0);
	// 【v1.41.0】引擎兜底保底次数：前 N 次尝试不受 searchms/tickbudget 限制
	g_cEngineMin = CreateConVar("ltt_sispawn_engine_min", "3", "【v1.41.0】引擎兜底（保底落点）至少尝试 N 次，不被已被自建预跑烧掉的预算掐断。0=旧行为。病根：searchms 是自建+引擎共用的 deadline，挡位2 在开阔图上自建预跑会烧光 32ms，导致引擎循环一次都不跑、保底候选根本没被记下，整只直接放弃（2026-10-05 bdp_bunker04 开阔防守机关 4 分钟 0 只刷出）", FCVAR_NOTIFY, true, 0.0, true, 20.0);
	// 【v1.42.0】自建预跑的子预算：从根上不让它吃干 searchms
	g_cNavPct = CreateConVar("ltt_sispawn_nav_pct", "60", "【v1.42.0】挡位2 自建预跑最多占 searchms 的百分比，剩下的留给引擎兜底（100=不限，旧行为）。开阔图上预跑会烧光整条预算，导致引擎循环一次都不跑、保底候选缺席 → 整只放弃", FCVAR_NOTIFY, true, 0.0, true, 100.0);
	// 【v1.43.0】失败前降级重试：等待降级时把"同一波内最小间距"的硬下限一起放宽
	g_cLastChance = CreateConVar("ltt_sispawn_lastchance", "1", "【v1.43.0】1=失败前降级重试：等久了（等待降级倍数>1）把『同一波内最小间距』的硬下限一起放宽，让本来要丢掉的那只先挤一点出来｜0=旧行为（硬下限一步不让）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cLastChanceFloor = CreateConVar("ltt_sispawn_lastchance_floor", "60.0", "【v1.43.0】上一条放宽后的地板值（单位）。服主 §206.4 原话是 120→60：低于它就真会堆在同一个掩体上", FCVAR_NOTIFY, true, 0.0, true, 350.0);
	// 【v1.44.0】坏导航图名单（.nav 是残片的三方图）：命中后按图放宽 + 豁免救援闸门
	g_cBadNavMaps = CreateConVar("ltt_sispawn_badnav_maps", "tgxl,tgxlbf", "【v1.44.0】坏导航图名单（逗号分隔）：这些图的 .nav 是残片（实测 tgxl 只有 38 个导航区、97.3% flow<=0），命中后按图放宽 needflow/needpath/可见点/距离并豁免救援关闸门。清空=关掉这条", FCVAR_NOTIFY);
	// 【v1.43.0】欠账累积时临时放宽找位预算（§206.4 杠杆4）
	g_cCarryBudget = CreateConVar("ltt_sispawn_carry_budget", "1.5", "【v1.43.0】欠账>0 时把 searchms/tickbudget 临时乘这个倍数（1.0=关）。只在欠账累积时生效（通用触发条件，不按图）；欠账本来就是'条件差'攒出来的，多给点预算比丢只数划算", FCVAR_NOTIFY, true, 1.0, true, 3.0);
	g_cGrowMax  = CreateConVar("ltt_sispawn_growmax", "0", "【v1.8.2修订3】间距没达标时，把自建落点的搜索窗口直接扩到这个距离再找一次（0=关，保持只按 ltt_sispawn_max）。26 特满员时间距会塌到中位 113，开这个能往外要空间，代价是少量落点会比 ltt_sispawn_max 更远", FCVAR_NOTIFY, true, 0.0);
	g_cSlotStop = CreateConVar("ltt_sispawn_slotstop", "1", "【v1.8.2修订4】1=槽位耗尽时立刻停止本波剩余生成，交给下一波补上（推荐）。0=旧行为：原地每 tick 重试最多 3 秒 —— 实测那会造成「生成失败 434/千只 + 满员守卫踢人 555/千只」", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// 【v1.8.2修订6】挡位：一键切换三套找位策略（服主 2026-09-23 定稿）
	// 设它会连带改 navsearch / vis_engine / spread 三个子 cvar；子 cvar 仍可单独微调，
	// 但下次换图或再改 mode 会被重新覆盖（刻意如此，否则"现在是哪一档"说不清）。
	g_cMode = CreateConVar("ltt_sispawn_mode", "1",
		"【挡位】0=原版引擎点位(复刻 v1.7.1：纯引擎，不查视野、不做分散) 1=引擎+视野+分散(默认,推荐日常) 2=自建落点优先(最凶,接近 Neko 可变模式)",
		FCVAR_NOTIFY, true, 0.0, true, 2.0);

	// 【v1.8.2修订7】高度过滤 —— 修"刷在地下/夹层"
	// 起因：2026-09-24 00:34 一只 Jockey 刷在 z=-373，比同波中位低 230（在地下）。
	// 实测 09/24 全天 228 个落点里有 12 个（5.3%）比同波中位低 150+，
	// **引擎路径和自建路径都有份**（7:5），且 12 个全部"不可见" ——
	// 说明我们的【藏点偏好正在奖励地下点】（地下永远看不见）。
	// 两条路径都加一道高度差检查：
	g_cMaxDZ = CreateConVar("ltt_sispawn_maxdz", "150.0",
		"【v1.8.2修订7】落点允许比目标生还者【低】多少（单位）。0=不限。专治『特感刷在地下/夹层』：地下永远不可见，会被藏点偏好主动选中",
		FCVAR_NOTIFY, true, 0.0);
	g_cMaxDZUp = CreateConVar("ltt_sispawn_maxdz_up", "400.0",
		"【v1.8.2修订7】落点允许比目标生还者【高】多少（单位）。0=不限。向上放宽是因为二层/楼顶通常是合法落点",
		FCVAR_NOTIFY, true, 0.0);

	// 【v1.8.2修订7】强制 flow>0 —— 修掉 ahead 检查的洞
	// 原写法 `if (f > 0.0 && f < targetFlow - 200.0) 拒` 里，**flow==0 的孤立/不可达
	// 导航区（地下导航岛通常就是这种）反而不会被拒**，因为 f>0.0 为假。
	g_cNeedFlow = CreateConVar("ltt_sispawn_needflow", "1",
		"【v1.8.2修订7】1=拒掉 flow<=0 的孤立/不可达导航区（修掉身后检查的漏洞，地下导航岛多为 flow=0）。0=关（退回旧行为）",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// 【v1.8.2修订8】开阔地形凭空刷
	// 起因：2026-09-24 三联图 26特/40秒 实测可见率 28.2%（引擎 0% / 自建 29.6%），
	// 且引擎只贡献 5% 的落点 —— 因为 z_spawn_range 被我们绑死在 ltt_sispawn_max，
	// **引擎自己也只被允许在 200~900 里给候选点**。
	// 数据：可见落点距离中位 659、不可见 870 —— 可见点是"就近妥协"的产物，
	// 它们从没被给过"退到更远再找藏点"的机会。
	g_cEngineRange = CreateConVar("ltt_sispawn_engine_range", "2000.0",
		"【v1.8.2修订8】写进引擎 z_spawn_range 的值（原版默认 1500）。这是【引擎自己的】搜索上限：绑死成 ltt_sispawn_max 会让引擎也只敢在近处找，那批『地图作者标好的天然藏点』就全被丢掉。我们自己的筛选仍按 min/max/farmax，所以放宽它不会让落点变远",
		FCVAR_NOTIFY, true, 0.0);
	g_cFarMax = CreateConVar("ltt_sispawn_farmax", "1500.0",
		"【v1.8.2修订8】『远档』上限：近处(min~max)找不到落点时，往外退到这里再找（1500 是多数刷特插件的默认上限）。0 或小于 max = 关闭远档。择优顺序：档位（藏点优先于可见）→ 距离档 → 同档内比间距",
		FCVAR_NOTIFY, true, 0.0);

	// 【v1.8.2修订9】修"刷在墙里面"
	// 起因：2026-09-24 12:26 三联图 26特，服主报有特感刷在墙里面。
	// 根因同修订7/8：**藏点偏好在奖励不合法的地方** —— 被 playerclip 盖住的导航区
	// （playerclip = 地图作者放的隐形墙）永远看不见 → 在择优里永远排第一。
	// 【v1.11.0】可见性判定用哪套
	//   1 = 引擎 PVS（left4dhooks 的 L4D_IsPotentiallyVisibleToTeam）—— 廉价、口径与引擎一致
	//   0 = 我们自己的射线（每个候选最多 4 条）
	// 缺原生时（老版 left4dhooks）自动退回射线，不受这个值影响。
	// 【v1.12.0】用引擎的【真实导航路程】代替 |Δflow| 近似
	//
	// 我们判"藏点/可见"时用的是 `|区flow - 目标flow|`，那是**沿流图的路程差近似**。
	// left4dhooks 提供 `L4D2_NavAreaTravelDistance(startPos, endPos, ignoreNavBlockers)`，
	// 给的是**真实导航路程**（能走的路有多远）—— 用它替换掉近似，两档门槛
	// （flow_los 900 / flow_nolos 1500）才真正有物理意义。
	// 返回 <= 0 或原生缺失时自动退回 |Δflow|。
	g_cUseTravel = CreateConVar("ltt_sispawn_usetravel", "1",
		"【v1.12.0】1=用引擎真实导航路程（L4D2_NavAreaTravelDistance）判「离生还者多远」 0=退回 |Δflow| 近似。原生缺失时自动退回",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	g_cVisMode = CreateConVar("ltt_sispawn_vis_mode", "2",
		"【v1.15.0】可见性判定口径：0=自打射线（最慢）｜1=引擎PVS·区域级（区里有一小块被看到就算可见，过近似，实测可见率卡 26.7%）｜2=PVS粗筛+逐点精判（推荐：区域潜在可见时，再逐生还者问引擎这个点能不能真被看到）",
		FCVAR_NOTIFY, true, 0.0, true, 2.0);

	g_cVisXCheck = CreateConVar("ltt_sispawn_vis_xcheck", "1",
		"【v1.16.0】1=每个落点额外写一条 VISCHK 日志（点级/面积/射线三套算法各判一次，只用于验证判定可信度，不改变刷特行为）0=关",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	g_cAllowVisible = CreateConVar("ltt_sispawn_allow_visible", "0",
		"【v1.17.0】0=【只刷藏点】找不到藏点就进等待队列、宁可这一只不刷（推荐）｜1=允许把可见点当兜底（v1.16 及以前的行为，实测这些点 100% 落在 500~900，即 10~17 米外当着脸出现）",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	g_cVisStrict = CreateConVar("ltt_sispawn_vis_strict", "1",
		"【v1.17.0】1=可见性严格口径：主判定之外再叠加一道独立几何射线，任一判「可见」即算可见（VISCHK 实测点级原生少报 21.6% 的可见点）｜0=只信主判定",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// 【v1.18.2】生效值镜像（**只读**，由本插件的 Timer_Tick 每 0.1 秒维护）。
	//
	// 为什么要有它：生效值 = 设的值 + 人数缩放，而别的插件（ltt_svote / ltt_si_menu）
	// 只通过 FindConVar 软连接读 cvar。没有镜像时它们只有两条烂路：读到"设的值"
	// （口径不一致 —— `!v 查看本局` 就这么显示的），或者各自复制一遍缩放公式
	// （三份公式必然漂）。发布成 cvar 就让"哪个数字才是真的"只有一个来源，
	// 而且 `sm_cvar ltt_sispawn_effwave` 直接可查。
	//
	// FCVAR_DONTRECORD 很关键：否则 AutoExecConfig 会把它们写进
	// cfg/sourcemod/ltt_si_spawner.cfg，看起来像用户设置项。
	g_cEffWave = CreateConVar("ltt_sispawn_effwave", "0",
		"【v1.18.2 · 只读镜像·不要手改】当前【实际生效】的每波特感数（= ltt_sispawn_wave + 人数缩放）。由 ltt_si_spawner 维护；别的插件用 FindConVar 读它来对齐口径",
		FCVAR_DONTRECORD, true, 0.0, true, 32.0);
	g_cEffCap = CreateConVar("ltt_sispawn_effcap", "0",
		"【v1.18.2 · 只读镜像·不要手改】当前【实际生效】的存活上限（含人数缩放与槽位硬上限）。由 ltt_si_spawner 维护",
		FCVAR_DONTRECORD, true, 0.0, true, 32.0);

	g_cNavAttr = CreateConVar("ltt_sispawn_navattr", "1",
		"【v1.8.2修订9】1=建导航缓存时剔除【被 playerclip 盖住（=墙里）】和【地图外】的导航区。0=不过滤（退回旧行为，会刷墙里）",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cClearance = CreateConVar("ltt_sispawn_clearance", "1",
		"【v1.8.2修订9】1=落点必须放得下特感碰撞盒（用 hull 射线查是否嵌在实体里）。专治『贴墙边刷出来、半个身子在墙里』",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// 【v1.8.2修订10 · 炸服修复 · 安全项，别关】
	// 2026-09-24 12:45:51 服务器 Segmentation fault（/tmp/dumps/crash_20260924124551_60.dmp）。
	// 崩溃前最后两条落点日志是【完全相同的坐标】：
	//     Charger x=7925 y=3225 z=-588 间距=0
	//     Spitter x=7925 y=3225 z=-588 间距=0
	// 原因是那一波 `1500 内只有 5 个候选区`，而本波要 12 只 ——
	// `spread` 是【择优不是拒绝】，池子太小就会反复挑到同一个点，
	// 于是**两个玩家实体被放在同一个坐标上**。L4D2 引擎扛不住这种重叠
	// （那只 Charger 1.6 秒后就被『其他特感』击杀，紧接着引擎段错误）。
	//
	// 所以这里必须加一条**硬拒绝**：任何落点与"其它特感/存活生还者"的距离
	// 小于这个值，直接不要（宁可不刷这一只，也不能叠）。
	g_cMinSI = CreateConVar("ltt_sispawn_minsi", "50.0",
		"【安全项·别设0】落点与【其它特感】和【存活生还者】的硬性最小间距。低于它就放弃这一只，绝不叠加。两个玩家实体重叠会让 L4D2 引擎段错误炸服（2026-09-24 实测）。0=关闭（危险）",
		FCVAR_NOTIFY, true, 0.0);

	// ================= 【v1.8.2修订11 · 参考豆瓣酱 specialspawner v1.3.7】 =================
	//
	// 服主让参考 `JS-MODS\自选-多特感插件(v1.3.7)(Tordecybombo, breezy)\specialspawner.sp`。
	// 读完那份源码的结论：**它是纯引擎刷**（`L4D_GetRandomPZSpawnPosition` + 
	// `L4D2_SpawnSpecial`），全程不碰导航网格，靠三招把落点质量做出来：
	//   ① 距离带 100~1500（`ss_spawnrange_min/max`），并把 `z_discard_range` 设成 spawn_range+500
	//   ② hook `PreferredSpecialDirection` 指挥引擎"往大空间/队伍前方挑"
	//   ③ 出生时 Z+5 且**蹲着出生**（碰撞盒小，贴墙也不嵌）
	// 下面三个 cvar 就是把 ②③ 和 `z_discard_range` 搬过来。
	g_cDiscardRange = CreateConVar("ltt_sispawn_discard_range", "0.0",
		"【修订11】写进引擎 z_discard_range 的值。参考实现 specialspawner 设成 z_spawn_range+500。0=不干预（默认，保持引擎原值）—— 本服实测该值已经是 2500，比参考实现的 2000 还高，所以我们不动它才对",
		FCVAR_NOTIFY, true, 0.0);
	g_cDir = CreateConVar("ltt_sispawn_dir", "3",
		"【修订11】给引擎的 PreferredSpecialDirection（方向偏好）。0=不干预 1=大空间优先(9) 2=队伍前方优先(7) 3=自动（本波已有失败→大空间；有人在跑图→前方），对齐参考实现",
		FCVAR_NOTIFY, true, 0.0, true, 3.0);
	g_cRushDist = CreateConVar("ltt_sispawn_rushdist", "1500.0",
		"【修订11】判定「有人在跑图」的阈值：最前与最后的存活生还者路程差超过它就认为在跑图（参考实现 ss_rush_distance=1500）",
		FCVAR_NOTIFY, true, 0.0);
	g_cCrouch = CreateConVar("ltt_sispawn_crouch", "1",
		"【修订11】1=出生时抬高 5 单位并【蹲着出生】（碰撞盒小，贴墙边不会嵌进去）。学自参考实现 specialspawner，专治『刷在墙里面』。0=关",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// 【v1.9.1】可见距离偏好
	// 实测（18:04 场，728 点）：可见落点 27.9%，其中距离中位 502、`<500` 占 49%
	// —— 一半是"又可见、又在脸上"，手感最差的一档。
	// 服主定稿：`只要特感不是凭空刷就行`（对抗里有个小掩体就能复活，可见可接受），
	// 所以把"远"作为可见档的优先项：既然躲不掉，那就让它在远处出现、跑过来。
	// ================= 【v1.10.0 · 参考 SS_SpawnPositioner 的 IsValidSpawn】 =================
	//
	// 服主定稿：`直接抄，这个仓库插件的服我玩过刷特体感算是比较接近对抗的感觉，
	// 特感近距离也能找位，远距离也能找位，就是不会出现凭空刷`。
	//
	// 它的核心是**把"可见"和"隐藏"拆成两套完全不同的判据**，而不是用同一套距离窗口：
	//
	//     有视线（会被看见 = 凭空刷） → 直线距离必须 > 500，且流距离必须 < 900
	//     无视线（藏在掩体后）       → 只要求流距离 < 500（没有直线下限）
	//
	// 这样：近距离的【藏点】照样合法（服主要的"掩体后近距离特感"），
	// 而【可见】的点被夹在 500~900 这个带里 —— 既不会贴脸，也不会在 1349
	// 那种远处凭空出现。对照我们 v1.9.2 的实测：可见点 median 1349（太远）、
	// 可见近 median 183（太近），两头都漏，就是缺了这条"按视线分档"的判据。
	g_cVisMin = CreateConVar("ltt_sispawn_vis_min", "500.0",
		"【v1.10】有视线时的【直线】距离下限：可见的落点必须比它更远，否则不刷（抄 ss_spawn_proximity_min）。0=不限",
		FCVAR_NOTIFY, true, 0.0);
	g_cFlowLos = CreateConVar("ltt_sispawn_flow_los", "900.0",
		"【v1.10】有视线时的【流距离】上限：可见的落点离生还者的路程差必须小于它，否则太远、不刷（抄 ss_spawn_proximity_flow_dist_LOS）。0=不限",
		FCVAR_NOTIFY, true, 0.0);
	g_cFlowNoLos = CreateConVar("ltt_sispawn_flow_nolos", "500.0",
		"【v1.10】无视线（藏点）时的【流距离】上限（抄 ss_spawn_proximity_flow_dist_no_LOS）。注意藏点没有直线距离下限，所以掩体后的近距离点仍然合法。0=不限",
		FCVAR_NOTIFY, true, 0.0);
	// 【v1.49.6 · A5】从 0/1 升级为三档；默认 **1=精简**（原来是 0=关）
	g_cPosLog   = CreateConVar("ltt_sispawn_poslog", "1",
		"【v1.49.6】落点日志档位：0=关 ｜ 1=精简(默认，每次刷出只留 1 行 POS，含「距最近生还」) ｜ 2=全量(再加 POSNEAR 与 VISCHK 交叉校验，深度排查时开)",
		FCVAR_NOTIFY, true, 0.0, true, 2.0);

	// 【v1.18.4】漏网特感（导演自己刷的）处理策略。
	// 本插件只登记自己刷的特感，导演原来那套刷特并没有被关掉 —— 于是场上会混进
	// 我们不知道、也不计数量的特感，玩家会觉得"到底几特"很混乱。
	//   0（默认）= 只在日志里报告（会打 `!! 漏网检测`，槽位列表里用 * 标出）
	//   1        = 报告之后顺手把它们踢掉，让场上只剩本插件刷的
	// 先设 0，等实测确认漏网有多严重再决定要不要开 —— 别没量就先砍。
	g_cPurgeForeign = CreateConVar("ltt_sispawn_purge_foreign", "0", "【v1.18.4】1=每波开始时把【不是本插件刷的】特感踢掉（导演自己刷的），只留本插件刷的。0=只报告不处理", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// 【v1.18.6】生成节流 —— 削"一整波在 1 秒内出完"造成的掉帧尖峰。
	//
	// 背景（2026-09-26 13:31 实测）：每波 11 只特感在约 1 秒内刷完（tick 间隔 0.1 秒 ×
	// batch 1），同一时刻 framelog 记到 **428ms 单帧**。而 vprof 抓到的事实是：
	// 本服 CPU 最大头是【网络快照编码】（SV_ComputeClientPacks/SendSnapshot/
	// SendTable_Encode/CalcTableDelta），它随「实体数 × 客户端数」增长；
	// 那张三方图 zc1_m4 有 1755 个实体（c1m1_hotel 只有 833）。再叠上每只特感
	// 出生时的 NavAreaBuildPath（实测单次峰值 20ms），就成了一个爆发尖峰。
	//
	// 用法：设 N 表示【每 N 个 tick 才发一批】（N=1 = 旧行为，每 0.1 秒发一批）。
	//   N=3 → 11 只摊到约 3.3 秒；N=5 → 约 5.5 秒。数值越大越平滑，但"这一波出齐"
	//   也越慢。默认 1，保持原来的手感，觉得卡再往上调。
	g_cSpawnEvery = CreateConVar("ltt_sispawn_spawnevery", "1", "【v1.18.6】每几个生成 tick 才发一批（1=旧行为，每 0.1 秒一批）。调大=把一整波摊平、削掉瞬间生成太多造成的掉帧尖峰", FCVAR_NOTIFY, true, 1.0, true, 20.0);

	// 【v1.18.7 · 并自 L4D2-Competitive-Rework 的 l4d2_director_commonlimit_block】
	// 原插件（Tabun，43 行）无条件生效；这里做成可开关，因为改的是"小僵尸数量"这件事，
	// 会动到游戏手感，得让人能对比。
	//
	// 它治什么：地图脚本能用导演脚本值 `CommonLimit` 把 z_common_limit 抬上去，
	// 于是小僵尸数量超出你设的上限。多特服里小僵尸和特感**抢同一批导航点**——
	// 这正是设计稿 §7-11 挂起的那条，当时的挂起理由是"小僵尸好像不影响特感找位，
	// 也不知道怎么量"。有了这道拦截，z_common_limit 就成了权威值，
	// **"能不能量"这个问题本身就不成立了**：把 z_common_limit 调低再开这个开关，
	// 就是一次干净的 A/B。
	//
	// 只压【比 cvar 更高】的脚本值（与原插件行为一致）：脚本想让小僵尸更少，不拦。
	// 默认 0 = 完全不干预，行为与 v1.18.6 一模一样。
	g_cCommonLimitBlock = CreateConVar("ltt_sispawn_commonlimit_block", "0", "【v1.18.7】1=拦截导演脚本对 z_common_limit 的抬高（脚本值 ≥ 该 cvar 时压回它）。治『地图脚本偷偷把普通僵尸上限抬上去』；默认 0=不干预", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	g_cCommonLimitRef = FindConVar("z_common_limit");
	if (g_cCommonLimitRef != null)
	{
		g_iCommonLimit = g_cCommonLimitRef.IntValue;
		g_cCommonLimitRef.AddChangeHook(OnCommonLimitChanged);
	}

	// 【v1.18.7 补充】MaxSpecials 抬高的 A/B 开关。默认 1 = 保持旧行为（不改变现状）。
	// 设 0 后我们不再把导演的 MaxSpecials 抬到 cap，让导演保留它自己的值。
	// 依据见 L4D2_OnGetScriptValueInt 里那段长注释（实测原值是 2 不是 -1，
	// 抬高会让导演的 UpdateSpecialSpawns() 白烧 CPU —— vprof 实测 1236ms/61秒）。
	g_cRaiseMaxSpecials = CreateConVar("ltt_sispawn_raise_maxspecials", "1", "【v1.18.7】1=照旧把导演偏低的 MaxSpecials 上限抬到我们的 cap（旧行为）｜0=完全不干预，让导演保留它自己的值（本服是 2）。设 0 可做 A/B：预期导演 UpdateSpecialSpawns 的 CPU 开销显著下降", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// ---- v1.30.0：救援关（终局图）不刷特 ----
	//
	// 服主 2026-10-03 定的：大家都不爱打救援关 ⇒ 进救援关就别刷特感了，美美通关。
	// 命中时我们不光自己停刷，还会把【引擎并发上限 / 找位区间】还原成原值 ——
	// 只停自己那一路的话，导演（自己会刷特的那套）还按我们抬高的上限刷，等于没关干净。
	g_cRescueOff = CreateConVar("ltt_sispawn_rescue_off", "1",
		"【v1.30.0】救援关（终局图）不刷特：0=关（照旧刷）｜1=整张救援关不刷（默认）｜2=救援关照常刷，但从『救援开始（逃生进行中）』起不刷",
		FCVAR_NOTIFY, true, 0.0, true, 2.0);
	g_cRescueForce = CreateConVar("ltt_sispawn_rescue_force", "0",
		"【v1.30.0·测试用】1=强制把当前图当作救援关（只为空服实测开关是否生效，平时保持 0）",
		FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// ---- v1.20.0：导航可达性 + 滞留看门狗 ----
	//
	// 【needpath 为什么要单独一个开关】原来 `TravelDistTo` 在引擎返回 <=0（走不通/不在导航网格上）时
	// 会**退回 |Δflow| 近似继续用**，而 |Δflow| 只看"流图上的先后"，看不出"中间是不是断的"。
	// 于是"绕一大圈、甚至根本到不了"的点也会被判合格 —— 这正是滞留特感（玩家回头才打死）的来源。
	// 但三方图/自制图的导航数据质量参差，一旦这条过滤太狠会直接掉刷满率，所以：
	//   · 默认 1（治滞留），但**保底点不设这条**（保底是"宁可刷出来也别断供"）；
	//   · 被它拒掉的候选数进"每图质量汇总"，掉刷满率能立刻看见，一个字就能关。
	g_cNeedPath = CreateConVar("ltt_sispawn_needpath", "1", "【v1.20.0】1=候选点必须有真实导航路径（原生可用时路程<=0 直接拒）｜0=旧行为（退回 |Δflow| 近似放行）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cWatchdog = CreateConVar("ltt_sispawn_watchdog", "1", "【v1.20.0】1=开滞留看门狗（刷出来一直不朝生还者走的特感会被传送到合格落点）｜0=关", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cWdAfter  = CreateConVar("ltt_sispawn_wd_after", "25.0", "【v1.20.0】存活满这么多秒还没靠近过 → 判滞留（默认 25）", FCVAR_NOTIFY, true, 5.0, true, 180.0);
	g_cWdGain   = CreateConVar("ltt_sispawn_wd_gain", "250.0", "【v1.20.0】相对出生点至少得缩短这么多单位才算「在靠近」（默认 250）", FCVAR_NOTIFY, true, 0.0, true, 3000.0);
	g_cWdFar    = CreateConVar("ltt_sispawn_wd_far", "1000.0", "【v1.20.0】现在距最近生还者大于它才处理（已经离得近的不打扰，默认 1000）", FCVAR_NOTIFY, true, 300.0, true, 6000.0);
	g_cWdCool   = CreateConVar("ltt_sispawn_wd_cooldown", "20.0", "【v1.20.0】同一只两次处理的最小间隔（秒，默认 20）", FCVAR_NOTIFY, true, 3.0, true, 300.0);
	g_cWdMax    = CreateConVar("ltt_sispawn_wd_max", "2", "【v1.20.0】同一只最多处理几次（默认 2）", FCVAR_NOTIFY, true, 1.0, true, 10.0);
	g_cWdAct    = CreateConVar("ltt_sispawn_wd_act", "1", "【v1.20.0】1=真的传送过去｜0=只记账不动作（先观察一局再开）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cWdLog    = CreateConVar("ltt_sispawn_wd_log", "1", "【v1.20.0】1=每次滞留处理写一行日志（A/B 靠它）", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// ---- v1.33.0：滞留判据补一条「卡住不动」----
	// 起因（服主 2026-10-03 增城实报）：一个 Smoker **在生还者前面卡住不动**，
	// 而原来两条判据正好把它排除在外：
	//   ③ 现距必须 > wd_far(1000) ⇒ 贴着生还者的直接跳过；
	//   ② 只要「历史最近距离」比基准缩短过 wd_gain(250) 就算「靠近过」——
	//      而生还者朝他走过去时距离**自然**缩短 ⇒ 也被跳过。
	// ⇒ 新增：按**特感自己的位移**判"静止"，再看它是「被整队超过」还是「贴脸」。
	//    ⚠ 这条与距离无关，所以无论卡在生还者前面还是后面都管用。
	g_cWdStill  = CreateConVar("ltt_sispawn_wd_still", "6.0", "【v1.33.0】静止满这么多秒 → 判「卡住」并在满足下面任一条件时处理（0=关这条判据）", FCVAR_NOTIFY, true, 0.0, true, 120.0);
	g_cWdMove   = CreateConVar("ltt_sispawn_wd_move", "60.0", "【v1.33.0】每次巡检（0.5 秒）位移小于它就算「这一拍没动」（默认 60 ≈ 120 单位/秒；正常跑速 150+ 不会误判）", FCVAR_NOTIFY, true, 1.0, true, 1000.0);
	g_cWdPassed = CreateConVar("ltt_sispawn_wd_passed", "1", "【v1.33.0】1=「已经被整队超过」（按导航路程算）且静止 → 处理。不误伤前方蹲点的特感", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cWdNear   = CreateConVar("ltt_sispawn_wd_near", "500.0", "【v1.33.0】距最近生还者小于它且静止 → 处理（治「当面卡住」；0=关这条）。⚠ 调大可能误伤真在蹲点等埋伏的特感", FCVAR_NOTIFY, true, 0.0, true, 3000.0);
	// 【v1.36.0】控人结束后的冷静期（见 g_flWdDomAt 上方注释）。
	//   为什么需要：舌头被砍断的瞬间，Smoker 就不再"正在控人"（m_tongueVictim 归零），
	//   而它此刻仍然是"贴脸 + 静止"（引擎还没让它跑），6 秒后就会被搬走 ⇒
	//   玩家看到"砍断舌头它就不见了"。同理会发生在：被推开的 Hunter、刚放开的 Jockey。
	//   默认 20 秒：足够它跑开或重新组织进攻；真卡死的特感多等 20 秒代价可接受。
	g_cWdAfterDom = CreateConVar("ltt_sispawn_wd_afterdom", "20.0", "【v1.36.0】这只特感「刚控过人」结束后的冷静期（秒）：期间一律不搬它（0=关掉这条保护）", FCVAR_NOTIFY, true, 0.0, true, 300.0);

	// ==================================================================================
	// 【v1.49.4 · 出生点三闸】（车主 2026-10-07 指定"三闸先做"）
	//
	// 依据一：10-06 c3 丛林整场 —— Smoker 出生 z=-574/-593/-444/-205，死亡 z=-255
	//   （这批图的世界底部处死面），且这些点 `出生于路程=-1`（引擎说路根本走不通）。
	// 依据二：全量 145845 条 POS 行的 z 分布 = -2000 … +6400 都有 ⇒ **绝对高度阈值不可用**
	//   （各图地面本身就在不同高度），垂直判据只能相对人算。
	// 依据三：查代码发现两个"算了但从没用过"：
	//   ① `g_bTrackOutside`（TR_PointOutsideWorld）只在结算日志里算了，**从未参与拒绝**；
	//   ② 水面一次都没查过 —— 全文件不存在 water/WaterLevel 判断。
	//
	// 三闸都在【候选评估】阶段生效，与既有 硬间距/碰撞盒 同层级，且和它们一样放在
	// `hasLast` 赋值【之前】（遵守本文件反复强调的"凡硬约束一律放在 hasLast 之前"规则，
	// 否则保底支路会绕过三闸 —— 那个后门已经导致过 4 次事故）。
	// 代价：极端情况下（tries 次抽样全部落在水里）这一只不刷；有三闸拒绝计数进每图汇总，
	//  Jungle 类图掉刷满率时一条 rcon 即可关：`ltt_sispawn_gate_water 0`。
	// ==================================================================================
	g_cGateWater   = CreateConVar("ltt_sispawn_gate_water", "1", "【v1.49.4·三闸①水面闸】1=拒绝落在水里的出生点（TR_GetPointContents 命中 MASK_WATER）｜0=关", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cGateOutside = CreateConVar("ltt_sispawn_gate_outside", "1", "【v1.49.4·三闸②世界外闸】1=拒绝世界边界之外的出生点（TR_PointOutsideWorld）｜0=关", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cGateVert    = CreateConVar("ltt_sispawn_gate_vert", "200.0", "【v1.49.4·三闸③垂直闸】落点与【最近生还者】的高度差上限（0=关）。原有高度闸只对【目标】生效（下150/上400），目标自己也在低处时挡不住地底点", FCVAR_NOTIFY, true, 0.0);
	g_cWdVert      = CreateConVar("ltt_sispawn_wd_vert", "200.0", "【v1.49.4·看门狗垂直判据】特感与最近生还者的高度差超过它，且持续 vertstill 秒 → 判滞留（0=关这条）", FCVAR_NOTIFY, true, 0.0);
	g_cWdVertStill = CreateConVar("ltt_sispawn_wd_vertstill", "10.0", "【v1.49.4】垂直判据需要【持续】这么多秒才处理（防刚出生就搬走）", FCVAR_NOTIFY, true, 0.0, true, 120.0);

	// ---- v1.21.0：等待降级（治"保底点也不合格 → 等到放弃"，见 RuleRelaxFromWait 的注释）----
	g_cWaitRelax = CreateConVar("ltt_sispawn_waitrelax", "1", "【v1.21.0】1=等待队列等久了就按时间放宽「太远」的上限（先把特感放出来，位置差一点也认）｜0=旧行为（守到 3 秒放弃、丢掉这只）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cRelaxMax  = CreateConVar("ltt_sispawn_relax_max", "3.0", "【v1.21.0】降级上限倍数（默认 3.0 = 最多把「太远」上限放大到 3 倍）。等 0.8 秒后开始，每 1 秒 +1.0", FCVAR_NOTIFY, true, 1.0, true, 10.0);

	// ---- v1.22.0：安全屋内部不刷 ----
	g_cWdSearchGap = CreateConVar("ltt_sispawn_wd_searchgap", "5.0", "【v1.26.0】看门狗两次「找位」之间的最小间隔（秒）。看门狗自己也要走一遍 FindSpawnPos，实测峰值 108ms，所以要限流", FCVAR_NOTIFY, true, 0.5, true, 60.0);
	g_cKeepFar     = CreateConVar("ltt_sispawn_keep_far", "1", "【v1.26.0】1=保底点超过硬上限时不再丢弃，而是照刷出来并交给滞留看门狗兜（实测每图能丢 400+ 只）｜0=旧行为（丢弃）", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cLockCfg = CreateConVar("ltt_sispawn_lock_cfg", "1", "【v1.26.1】挡位档案是否覆盖数值 cvar（上限/尝试/窗口放大/两档 flow）。1=覆盖（并把旧值打进日志）｜0=不覆盖，尊重 cfg 与手改值", FCVAR_NOTIFY, true, 0.0, true, 1.0);
	g_cNoSafeRoom = CreateConVar("ltt_sispawn_nosaferoom", "1", "【v1.22.0】1=队伍离开安全屋后，不再把特感刷在【起点安全屋内部】（门关了 AI 出不来，会永久占槽位）｜0=旧行为", FCVAR_NOTIFY, true, 0.0, true, 1.0);

	// ---- v1.8.2 方向A：本波已用落点（blocksize 3 = x/y/z）----
	if (g_aWavePos == null)
		g_aWavePos = new ArrayList(3);

	LoadBotFactories();

	// 【v1.30.0】救援关第二路判定：照朋友 L4D2_rescue_vehicle.sp 的做法 ——
	// 这三个事件【只在救援关触发】（他的插件注释写明，且咱服 2026-10-02 08:56/21:04/22:41/22:50
	// 的 [RescueVehicle] 日志证明确实会响），所以只要响了就确认"本图是救援关"，
	// 不依赖 L4D_IsMissionFinalMap()（那个原生老版 left4dhooks 可能没有）。
	HookEvent("finale_start",       Event_FinaleBegin, EventHookMode_PostNoCopy);
	HookEvent("finale_radio_start", Event_FinaleBegin, EventHookMode_PostNoCopy);
	HookEvent("finale_rush",        Event_FinaleBegin, EventHookMode_PostNoCopy);
	HookEvent("round_start",        Event_RoundReset,  EventHookMode_PostNoCopy);
	HookEvent("round_end",          Event_RoundReset,  EventHookMode_PostNoCopy);

	AutoExecConfig(true, "ltt_si_spawner");
	g_cClasses.AddChangeHook(OnCvarChanged);
	g_cMin.AddChangeHook(OnCvarChanged);
	g_cMax.AddChangeHook(OnCvarChanged);
	g_cClassLimit.AddChangeHook(OnCvarChanged);
	g_cTankClasses.AddChangeHook(OnCvarChanged);
	g_cMode.AddChangeHook(OnCvarChanged);   // 【v1.8.2修订6】挡位切换
	g_cRescueOff.AddChangeHook(OnCvarChanged);     // 【v1.30.1】救援关不刷特：改了立刻生效
	g_cRescueForce.AddChangeHook(OnCvarChanged);   // 【v1.30.1】同上（测试用强制项）
	ParseClasses();
	ParseAllClassLimits();

	// 【v1.23.0】帧/跳间隔监测（只读计时，不改任何行为）
	// 说明：OnGameFrame 每次服务端帧/跳都会调；只做浮点减法与比较，成本可忽略。
	// 阈值 25ms/50ms 与 framelog 的"单帧卡顿"口径一致，便于两边对照。
	// （OnGameFrame 由 SM 每帧调用，无需也不应重复注册。）
	HookEvent("round_start",           Event_RoundStart,    EventHookMode_PostNoCopy);
	HookEvent("round_end",             Event_RoundEnd,      EventHookMode_PostNoCopy);
	HookEvent("entity_killed",         Event_EntityKilled,  EventHookMode_Post);
	// 【v1.18.2】人数变化 → 生效值可能变 → 重算并按需播报。
	// 原来只挂了上面三个事件，所以第 5 个人进服时有效值静默变化、没有任何提示
	// （对照参考实现 specialspawner，它挂了 player_team + OnClientDisconnect）。
	HookEvent("player_team",           Event_PlayerTeam,    EventHookMode_PostNoCopy);

	RegAdminCmd("sm_sispawn_status", Cmd_Status, ADMFLAG_GENERIC, "查看刷特插件当前状态");
	RegAdminCmd("sm_sispawn_slots",  Cmd_Slots,  ADMFLAG_GENERIC, "列出所有客户端槽位状态");
	RegAdminCmd("sm_sispawn_burst",  Cmd_Burst,  ADMFLAG_GENERIC, "立刻连刷 N 只特感（跳过离开安全区判断）");
	// 【v1.48.0】按职业点单（训练图/练枪用）：sm_sispawn_class <职业> [数量]
	RegAdminCmd("sm_sispawn_class",  Cmd_Class,  ADMFLAG_GENERIC, "【v1.48.0】立刻刷 N 只指定职业的特感：sm_sispawn_class <烟鬼|胖子|猎人|毒妇|骑师|牛|英文名|1~6> [数量=1]");
	RegAdminCmd("sm_sispawn_clear",  Cmd_Clear,  ADMFLAG_GENERIC, "清空场上所有特感假人（真人特感永不碰）—— 管理员菜单用");
	RegAdminCmd("sm_sispawn_wd",     Cmd_Wd,     ADMFLAG_GENERIC, "【v1.20.0】只读看板：滞留看门狗阈值/在追踪几只/疑似滞留/本图处理次数");
	RegAdminCmd("sm_sispawn_announce", Cmd_Announce, ADMFLAG_GENERIC, "【v1.28.6】再播报一次出门刷特提示（距离档/距离偏好/挡位）");
	RegAdminCmd("sm_sispawn_dbg", Cmd_Dbg, ADMFLAG_GENERIC, "【v1.49.11】游戏内调试播报：0=关 1=每波汇总 2=+每只（聊天框输入 !sdbg 同效）");
	RegAdminCmd("sm_sdbg",        Cmd_Dbg, ADMFLAG_GENERIC, "【v1.49.11】sm_sispawn_dbg 的短命令");

	// 唯一的常驻定时器：全程只有这一个句柄，不串联、不反复 delete。
	// TIMER_FLAG_NO_MAPCHANGE 必须加：SourceMod 默认会在换图时回收定时器，
	// 不加这个标记的话换一张图插件就再也不工作了。
	g_hTick = CreateTimer(TICK_INTERVAL, Timer_Tick, _, TIMER_REPEAT | TIMER_FLAG_NO_MAPCHANGE);

	// 【v1.29.2 / v1.29.4】延迟再套一次挡位档案 + 挡位展开（幂等）。
	// 【v1.29.4】补 ApplyMode()：见 Timer_ReapplyProfile 上方注释（reload 后 cfg 残留值会盖掉挡位）。
	// 为什么需要：`sm plugins reload` 会重新 exec 本插件的 cfg，但【不会】再调 OnConfigsExecuted，
	// 而 ApplyModeProfile() 只挂在 OnConfigsExecuted / OnMapStart / 切挡位 三处 ⇒ cfg 里那两行
	// searchms/tickbudget（12/20）会把挡位档案（挡位0 = 10/16）盖掉，然后没人再套回来。
	// 实测 2026-10-02 18:57：reload 后是 12/20 而挡位=0 应是 10/16。2 秒足够 cfg exec 完。
	CreateTimer(2.0, Timer_ReapplyProfile, _, TIMER_FLAG_NO_MAPCHANGE);
}

/** 注意：AutoExecConfig 是在 OnConfigsExecuted 之后才真正 exec 配置文件的，
 *  在本回调里直接读 cvar 拿到的还是旧值/默认值，所以延后 0.2 秒再打日志。 */
public void OnConfigsExecuted()
{
	LoadBlacklist();   // 【v1.27.0】黑名单盒：热重载后也要能读到（OnMapStart 不会被重放）
	// 【v1.27.2】挡位档案必须在这里再套一次：SourceMod 的顺序是
	// OnMapStart → 执行 cfg → OnConfigsExecuted，
	// 只在 OnMapStart 套用的话，紧接着执行的 cfg（AutoExecConfig 写的旧值）会把它盖回去，
	// 表现就是"日志说尝试 10→4，实际还是 10"。
	ApplyModeProfile();
	ParseClasses();
	ApplyMode();                 // 【v1.8.2修订6】cfg 执行完再展开挡位（否则读到的还是默认值）
	// 【v1.30.0】救援关（终局图）不刷特：命中时改为把引擎并发上限/找位区间还原成原值
	ApplyRescueGate();
	CreateTimer(0.2, Timer_LogStartup);

	// 【v1.8.2】补一个中途重载的自愈：插件在换图之后才被加载/重载时，
	// SourceMod 不会重放 OnMapStart，导航缓存就永远是空的 —— 自建落点、
	// 落点分散、窗口自适应会全部静默失效（而且不报错，很难发现）。
	// 正常换图流程里 OnMapStart 已经排过定时器了，靠 pending 标志避免重复建。
	if (!g_bNavReady && !g_bNavTimerPending)
	{
		g_bNavTimerPending = true;
		CreateTimer(2.0, Timer_BuildNav, _, TIMER_FLAG_NO_MAPCHANGE);
		LogMessage("[SISpawn] 检测到导航缓存为空（插件中途加载/重载）→ 已补排一次构建");
	}
}

public Action Timer_LogStartup(Handle timer)
{
	ParseClasses();
	LogMessage("[SISpawn] v%s 就绪 | 总开关=%d 每波=%d 上限=%d 间隔=%.0fs 距离=%.0f~%.0f 尝试=%d",
		PLUGIN_VERSION, g_cEnable.IntValue, g_cWave.IntValue, g_cCap.IntValue,
		g_cTime.FloatValue, g_cMin.FloatValue, g_cMax.FloatValue, g_cTries.IntValue);
	LogMessage("[SISpawn] v%s 可达性=%d（原生%s）｜滞留看门狗=%d 动作=%s｜老判据=存活>%.0fs 且 从未靠近 %.0f 以上 且 现距>%.0f｜【v1.33.0】新判据=静止>=%.1fs 且（贴脸<=%.0f 或 已被整队超过=%d）｜冷却=%.0fs 上限=%d 日志=%d", PLUGIN_VERSION,
		g_cNeedPath.IntValue, g_bHasTravel ? "有" : "缺失/降级",
		g_cWatchdog.IntValue, g_cWdAct.BoolValue ? "传送到合格落点" : "只记账不动作",
		g_cWdAfter.FloatValue, g_cWdGain.FloatValue, g_cWdFar.FloatValue,
		g_cWdStill.FloatValue, g_cWdNear.FloatValue, g_cWdPassed.IntValue,
		g_cWdCool.FloatValue, g_cWdMax.IntValue, g_cWdLog.IntValue);
	LogMessage("[SISpawn] v%s 等待降级=%d（等 0.8 秒后每 1 秒放宽 1.0 倍，上限 %.1f 倍）｜只放宽「太远」上限，硬约束与「太近」下限一律不放宽", PLUGIN_VERSION,
		g_cWaitRelax.IntValue, g_cRelaxMax.FloatValue);
	LogMessage("[SISpawn] v%s 安全屋内部不刷=%d（属性判据%s + 坐标精判%s）｜保底硬上限也参与等待降级", PLUGIN_VERSION,
		g_cNoSafeRoom.IntValue, g_bHasSpawnAttr ? "有" : "缺", g_bHasCpPos ? "有" : "缺");
	LogMessage("[SISpawn] v%s 保底点已补硬闸（安全屋/密封空间/导航属性/可达性）｜挡位档案覆盖=lock_cfg %d｜相位归因改读快照", PLUGIN_VERSION,
		g_cLockCfg.IntValue);
	LogMessage("[SISpawn] v%s 看门狗找位限流=%.1fs ｜ 保底超硬上限=不再丢（keep_far=%d）｜ 挡位档案=开图/换图时套用并打印", PLUGIN_VERSION,
		g_cWdSearchGap.FloatValue, g_cKeepFar.IntValue);
	LogMessage("[SISpawn] v%s 帧内耗时归因已启用：相位=找位生成/踢人回收/看门狗/其它｜单 tick >=20ms 打拆分日志（每图限 300 条）｜间隔 >=25ms 打归因日志，判定法：间隔≫我方耗时=不怪刷特", PLUGIN_VERSION);
	LogMessage("[SISpawn] 方式=%s 直连工厂=%d/6 必须留空=%d(设的值 %d) 回收死特感=%d(延迟%.1fs) 满员守卫=%d 身后限制=%d | MaxClients=%d 当前有效上限=%d",
		g_cMethod.IntValue == 1 ? "直连NextBotCreatePlayerBot" : "引擎原生ZombieManager",
		g_bDirectReady ? MAX_CLASS : 0, KeepFreeSlots(), g_cReserve.IntValue,
		g_cRecycle.IntValue, g_cRecycleDelay.FloatValue, g_cGuard.IntValue,
		g_cAhead.IntValue, MaxClients, GetEffCap());
	char sLimits[64], sTankLimits[64];
	g_cClassLimit.GetString(sLimits, sizeof(sLimits));
	g_cTankClasses.GetString(sTankLimits, sizeof(sTankLimits));

	LogMessage("[SISpawn] 职业均衡=%d 每种上限=%s | 坦克期切换=%d 坦克上限=%d 坦克每种上限=%s | 日志级别=%d 生还者=%d 缩放增量=%d",
		g_cBalance.IntValue, sLimits,
		g_cTankAction.IntValue, g_cTankCap.IntValue, sTankLimits,
		g_cDebug.IntValue, CountSurvivors(), GetScaleStep());
	char sMNL[96];
	ModeName(g_cMode.IntValue, sMNL, sizeof(sMNL));
	LogMessage("[SISpawn] v%s 挡位=%d【%s】| 自建落点=%d 视野档位=%d 引擎查视野=%d 分散=%.0f 位置日志=%d 槽位停机=%d | 候选池=%d 窗口上限=%.0f", PLUGIN_VERSION,
		g_cMode.IntValue, sMNL,
		g_cNavSearch.IntValue, g_cNavVis.IntValue, g_cVisEngine.IntValue,
		g_cSpread.FloatValue, g_cPosLog.IntValue, g_cSlotStop.IntValue,
		MAX_NAV_CAND, g_cFallbackMax.FloatValue);
	// 【v1.8.2修订7】高度过滤 + flow>0 强制
	LogMessage("[SISpawn] 特性·修订7 高度过滤: 向下=%.0f 向上=%.0f（0=不限）| 强制 flow>0 = %d",
		g_cMaxDZ.FloatValue, g_cMaxDZUp.FloatValue, g_cNeedFlow.IntValue);
	// 【v1.8.2修订8】远档 + 引擎搜索区间解耦
	LogMessage("[SISpawn] v%s 参考 SS_SpawnPositioner：藏点=掩体后(flow<%.0f，无直线下限) ｜ 可见=必须 直线>%.0f 且 flow<%.0f ｜ 引擎 z_spawn_range=%.0f 我方窗口=%.0f~%.0f", PLUGIN_VERSION,
		g_cFlowNoLos.FloatValue, g_cVisMin.FloatValue, g_cFlowLos.FloatValue,
		g_cEngineRange.FloatValue, g_cMin.FloatValue, g_cMax.FloatValue);
	// 【v1.8.2修订9】墙里/越界过滤 + 碰撞盒检查
	LogMessage("[SISpawn] 特性·修订9 墙里过滤=%d（导航属性原生 %s）｜ 碰撞盒检查=%d",
		g_cNavAttr.IntValue, g_bHasNavAttr ? "有" : "无",
		g_cClearance.IntValue);
	// 【v1.8.2修订10】炸服修复
	// 【v1.11.0】这条用来确认"引擎 PVS 原生到底有没有被探测到" ——
	// 如果打的是"无→自动退回射线"，说明服务器 left4dhooks 还是旧版。
	LogMessage("[SISpawn] v%s 择优=档位 → %s → 同档内比分散（ltt_sispawn_nearbias=%d）", PLUGIN_VERSION,
		g_cNearBias.BoolValue ? "距离档就近优先(500/900/1400)" : "距离偏好已关(只比分散)", g_cNearBias.IntValue);
	LogMessage("[SISpawn] v%s 路程判据=%s（导航路程原生 %s）", PLUGIN_VERSION,
		(g_cUseTravel.BoolValue && g_bHasTravel) ? "真实导航路程" : "|Δflow|近似",
		g_bHasTravel ? "有" : "无→自动退回近似");
	LogMessage("[SISpawn] v%s 可见性口径=%d（0=射线 1=区域级PVS 2=PVS粗筛+逐点精判）｜严格叠加射线=%d ｜可见点兜底=%d ｜区域PVS原生 %s ｜点级原生 %s", PLUGIN_VERSION,
		g_cVisMode.IntValue, g_cVisStrict.IntValue, g_cAllowVisible.IntValue,
		g_bHasEngineVis ? "有" : "无→一律退回射线",
		g_bHasVisPlayer ? "有" : "无→退回区域级");
	LogMessage("[SISpawn] 特性·修订10 硬性最小间距=%.0f（防两个玩家实体叠在同一坐标导致引擎段错误）",
		g_cMinSI.FloatValue);
	// 【v1.8.2修订11】参考实现 specialspawner
	LogMessage("[SISpawn] 特性·修订11 参考实现三招：蹲着出生+Z抬5=%d ｜ 引擎方向偏好=%d（0关/1大空间/2前方/3自动，跑图阈值=%.0f）｜ z_discard_range=%s",
		g_cCrouch.IntValue, g_cDir.IntValue, g_cRushDist.FloatValue,
		!g_bHasDiscard ? "服务器无此cvar" : (g_cDiscardRange.FloatValue > 0.0 ? "已设" : "不干预"));
	// 【v1.30.0】救援关闸门现状（开图时打一条，事后查"这张图为什么没特感"靠它）
	LogMessage("[SISpawn] %s 救援关不刷特=%d（0关/1整张/2救援开始后）｜本图救援关=%s（原生判定=%s 强制=%d）｜本图刷特=%s",
		PLUGIN_VERSION, g_cRescueOff.IntValue,
		g_bRescueMap ? "是" : "否", g_bHasFinaleMap ? "可用" : "无此原生",
		g_cRescueForce.IntValue, g_bRescueBlockedNow ? "已关闭" : "开");
	return Plugin_Stop;
}

public void OnPluginEnd()
{
	// 故意不 delete 定时器：换图时引擎可能已经回收了这个句柄，再 delete 会抛
	// "Handle is invalid"。插件卸载时 SourceMod 会自动清理它自己的所有句柄。
	g_hTick = null;

	// 但引擎 cvar 是我们改的，必须还回去（找位区间 + 三个并发上限）
	RestoreEngineSpawnRange();
	RestoreEngineLimits();
}

/** 每次换图都无条件重建驱动定时器。
 *  实测即使加了 TIMER_FLAG_NO_MAPCHANGE，换图后句柄依然会被回收并抛
 *  "Handle is invalid"，若只依赖 OnPluginStart 建一次，插件会在换图后静默停摆。 */
public void OnMapStart()
{
	g_flMapStartGame = GetGameTime();   // 【v1.49.7】武装延后的计时起点
	// 【v1.49.8】每图复位这些"只打一次"的日志标志（v1.49.7 漏了复位，导致只有第一张图会打）
	g_bLttArmDelayLogged = false;
	g_bLttIntroLogged = false;
	g_bLttIntroDoneLogged = false;
	g_bLttSomeoneMoved = false;
	g_bLttMoveLogged = false;
	g_bLttMoveTimeoutLogged = false;
	for (int i = 1; i <= MaxClients; i++)
	{
		g_bLttRefValid[i] = false;
		g_vLttRefPos[i][0] = g_vLttRefPos[i][1] = g_vLttRefPos[i][2] = 0.0;
	}
	g_bLttAnnounced = false;   // 【LTT 补丁】每图重置播报标志
	g_hTick = CreateTimer(TICK_INTERVAL, Timer_Tick, _, TIMER_REPEAT | TIMER_FLAG_NO_MAPCHANGE);

	// 【v1.32.0】突击脉冲定时器 —— 与 g_hTick 同一个坑：即使加了
	// TIMER_FLAG_NO_MAPCHANGE，换图后句柄照样被回收（见上面 OnMapStart 注释），
	// 所以必须在这里无条件重建，绝不能只靠 OnPluginStart 建一次。
	// 用 REPEAT + 间隔，而不是"每次刷特后挂一个一次性定时器"：
	// 「放完技能就跑了」发生在特感的整个生命周期里，不只在出生那一刻。
	// 间隔改成 0.3 秒也不会重建（cvar 变化在下一次回调读值），所以不需要 ChangeHook。
	g_bAssaultLogged = false;
	CreateTimer(g_cAssaultGap.FloatValue, Timer_AssaultPulse, _, TIMER_REPEAT | TIMER_FLAG_NO_MAPCHANGE);

	// 【v1.9.0 · 同类问题一次清干净】`GetGameTime()` 换图会重置回接近 0，
	// 于是**换图前用旧时间基准写下的时间戳会落到"很远的未来"**。
	// 实测后果最严重的是踢人冷却（整局不刷特感，见 NoteKickHappened 注释）；
	// 下面这几个"已踢/已死/守卫"的时间戳是同一个病根，一起清零，
	// 免得它们让"该踢的踢不掉""该死的回收不了"这类隐性失效。
	for (int i = 0; i <= MAXPLAYERS; i++)
	{
		g_flKickAt[i]     = 0.0;
		g_flDeadSince[i]  = 0.0;
		g_flTrackTime[i]  = 0.0;
		g_bTrackSolid[i]   = false;
		g_bTrackOutside[i] = false;
		g_fTrackTgtDist[i] = 0.0;
		// 【v1.20.0】滞留看门狗簿记：g_fTrackTravel 必须是 -1（"未量过"），
		// 不能用 0 —— 0 在这里会被当成"引擎说路程为 0"，日志会骗人。
		g_fTrackTravel[i] = -1.0;
		g_fWdBest[i]      = -1.0;
		g_fWdBase[i]      = -1.0;
		g_flWdAt[i]       = 0.0;
		g_iWdCount[i]     = 0;
		// 【v1.33.0】"卡住不动"判据的三个量也要清（否则换图后第一拍会拿上一张图的位置比）
		g_fWdStill[i]     = 0.0;
		g_fWdVertTime[i]  = 0.0;   // 【v1.49.4】垂直判据的持续计时同理
		g_bWdPosValid[i]  = false;
		g_fWdLastPos[i][0] = 0.0;
		g_fWdLastPos[i][1] = 0.0;
		g_fWdLastPos[i][2] = 0.0;
	}
	// 【v1.20.0】换图重置看门狗巡检时刻与"每图"累计
	g_flWdNextCheck = 0.0;
	// 【v1.49.0 · 顺序修正】先把本图地图名取回来，**再**套用挡位档案：
	//   原来 ApplyModeProfile() 在 GetCurrentMap() 之前调，而坏导航图档要按 `g_sMap` 判定
	//   ⇒ OnMapStart 这一次用的是**上一张图**的名字（离开 tgxl 后的第一张图会被误判成坏导航图，
	//   而且是自检 FallbackGateSelfCheck() 读到的那一次）。虽然后面 OnConfigsExecuted 会纠正，
	//   但开图瞬间会出现"误放宽 + 误告警"。这里把取名字提前，一处修好两个症状。
	GetCurrentMap(g_sMap, sizeof(g_sMap));
	// 【v1.26.0】套用"挡位档案"：每个挡位自带一套参数（并打印生效值），避免全局参数跨挡位乱套
	ApplyModeProfile();

	// 【v1.37.0】引擎每职业上限（z_*_limit）必须**在开图之后**才设得住。
	//   起因（2026-10-04 实测）：为了验证"找不到落点里 Smoker 占 34.5%（是别职业 3 倍）是不是被
	//   z_smoker_limit=1 卡的"，我把 6 个 z_*_limit 写进了 server.cfg 并 sm_cvar 设成 2；
	//   结果**重启服务器后全部回到 1** —— 日志里没有任何"changed cvar"记录，也没有别的插件在改
	//   （NekoSpecials/specialspawner 已不在加载列表，`ss_*` cvar 全不存在）。
	//   ⇒ 是引擎在地图初始化时把这些 cheat cvar 重置回默认值，写在 cfg 里保不住。
	//   所以只能在插件里、于**每次开图后**重新设一遍。
	ApplyZLimits();

	// 【v1.24.0】记下当前地图名，并在日志里打一条显眼的头（同一张图跑第二次时，直接按这个名字抓）
	LogMessage("[SISpawn] ========== 本图开始 地图=%s ==========", g_sMap);
	LoadBlacklist();   // 【v1.27.0】加载本图刷点黑名单盒
	// 【v1.43.0】保底/降级路径硬闸自检：必须在 LoadBlacklist() 之后（要用 g_iBlackCount）
	FallbackGateSelfCheck();

	// 【v1.20.0】出生点几何自检的累计计数，按图重置
	g_iBornSolid   = 0;
	g_iBornOutside = 0;
	g_iTotWdAct    = 0;
	g_iTotWdMoved  = 0;
	g_iTotNoPath   = 0;
	g_iSafeSkip    = 0;
	// 【v1.49.4】出生点三闸的每图计数
	g_iGateWaterSkip   = 0;
	g_iGateOutsideSkip = 0;
	g_iGateVertSkip    = 0;
	g_iTankPurge   = 0;   // 【v1.31.0】坦克期策略 3 的清场标记，按图重置
	g_iFb0Relax    = 0;   // 【v1.31.1】挡位 0 保底放宽计数，按图重置
	// 【v1.21.0】等待降级：倍数回 1.0、计数清零
	g_fRuleRelax   = 1.0;
	g_iTotRelax    = 0;
	// 【v1.23.0】帧内耗时归因，按图重置
	for (int k = 0; k < 4; k++)
	{
		g_flPhaseSum[k]  = 0.0;
		g_flPhasePeak[k] = 0.0;
		g_iPhaseOver20[k] = 0;
		g_flLastPhase[k] = 0.0;
		g_flPhaseSnap[k] = 0.0;
	}
	g_flLastTickTotal = 0.0;
	g_flFrameLast = 0.0; g_flFrameSum = 0.0; g_flFrameMax = 0.0;
	g_flWdSearchAt = 0.0; g_iTotFarKeep = 0;   // 【v1.26.0】
	g_iFrameCount = 0; g_iFrameOver25 = 0; g_iFrameOver50 = 0;
	g_iFrameLogLeft = 300;
	g_flGuardAt       = 0.0;
	g_flNoSpawnUntil  = 0.0;
	g_bCooldownLogged = false;
	// 【v1.30.0】救援关状态按图重置（真正的判定在 OnConfigsExecuted / 延迟重套里做）
	g_bRescueMap        = false;
	g_bRescueBlockedNow = false;
	g_bRescueAnnounced  = false;
	g_bFinaleStarted    = false;
	g_flRecycleAt    = 0.0;   // 【v1.14.0】原来漏了这一个 —— 换图后 GetGameTime() 归零
	                             // 而它还留着旧的大值，导致新图前期"死亡特感回收"失效

	// 【v1.18.2】新图重置"上次播报过的生效值" —— 否则第一波人数变化时
	// 会拿上一张图的数字比较，可能误判成"没变"而不播报。同时立刻刷新一次镜像。
	g_iLastAnnWave = -1;
	g_iLastAnnCap  = -1;
	g_iLastAnnTime = -1;
	g_hEffAnnounce = null;
	RefreshEffMirror();

	// 导航区缓存必须等 OnMapStart 之后至少 1 帧才有效，延后 2 秒重建
	g_bNavReady = false;
	g_iNavCount = 0;
	g_bNavTimerPending = true;
	g_iNavRetry = 0;      // 【v1.29.1】每张图重新给 3 次机会
	CreateTimer(2.0, Timer_BuildNav, _, TIMER_FLAG_NO_MAPCHANGE);
}

// ------------------------------------------------------------------ 【v1.30.0】救援关闸门

/** "开启救援"事件（finale_start / finale_radio_start / finale_rush）——
 *  只在救援关会响，因此它响了就【确认本图是救援关】，并立刻重算闸门。
 *  这样即使地图判定原生不可用/三方图任务表不规范，也能在救援开始的那一刻停刷。 */
public void Event_FinaleBegin(Event event, const char[] name, bool dontBroadcast)
{
	g_bFinaleStarted = true;
	if (!g_bRescueMap)
	{
		g_bRescueMap = true;
		if (LogNormal())
			LogMessage("[SISpawn] 收到事件 %s ⇒ 确认本图是救援关（地图判定原生=%s）",
				name, g_bHasFinaleMap ? "可用" : "无此原生");
	}
	g_bRescueAnnounced = false;   // 允许再播报一次（挡位 2 就是靠这一刻才生效的）
	ApplyRescueGate();
}

/** 回合开始/结束 → 复位"救援已开启"标记（换图另由 OnMapStart 复位）。 */
public void Event_RoundReset(Event event, const char[] name, bool dontBroadcast)
{
	g_bFinaleStarted = false;
	g_bRescueAnnounced = false;
	ApplyRescueGate();
}

/** 本图是不是救援关（终局图）。
 *  判定用 left4dhooks 的 L4D_IsMissionFinalMap()：它按任务表判定"最后一图"，官方图与三方图通用。
 *  老版 left4dhooks 缺这个原生时，只能靠 ltt_sispawn_rescue_force 强制验证。 */
void DetectRescueMap()
{
	// 【v1.44.0】坏导航图名单里的图**豁免救援关闸门**：这类单图战役（tgxl）常被 L4D_IsMissionFinalMap()
	//   判成"终局图"，于是 rescue_off=1 会把整张图停掉 —— 实测连手动 burst 都被拒。
	//   它们本来就是训练/娱乐图，没有"救援阶段"这回事。
	if (IsBadNavMap(g_sMap))
	{
		g_bRescueMap = false;
		return;
	}
	g_bRescueMap = g_cRescueForce.BoolValue
		|| (g_bHasFinaleMap && L4D_IsMissionFinalMap());
}

/** 按 ltt_sispawn_rescue_off 判断"当前该不该停刷"。 */
bool IsRescueBlocked()
{
	int m = g_cRescueOff.IntValue;
	if (m <= 0 || !g_bRescueMap)
		return false;

	if (m == 1)
		return true;      // 整张救援关停刷

	// m == 2：只在"救援开始"之后停刷。
	// 【v1.30.0】两个来源取或：①朋友那套三个事件（finale_start/radio/rush，最准最早）
	// ②L4D_IsFinaleEscapeInProgress()（逃生已在进行，含载具已在路上/已离开）。
	return (g_bFinaleStarted || (g_bHasFinaleEscape && L4D_IsFinaleEscapeInProgress()));
}

/** 幂等：停刷时把引擎并发上限/找位区间还原成原值；不停刷时按原逻辑抬高。
 *  OnConfigsExecuted（开图/换图）与延迟重套（reload 自愈）各调一次；
 *  挡位 2 的中途翻转由 TimerTickBody 在状态变化时再调一次。 */
void ApplyRescueGate()
{
	DetectRescueMap();
	bool blocked = IsRescueBlocked();
	g_bRescueBlockedNow = blocked;

	if (blocked)
	{
		RestoreEngineLimits();
		RestoreEngineSpawnRange();
	}
	else
	{
		EnsureEngineLimits();
		ApplyEngineSpawnRange();
	}

	if (blocked && !g_bRescueAnnounced)
	{
		g_bRescueAnnounced = true;
		if (LogNormal())
			LogMessage("[SISpawn] 救援关=是（原生判定=%s 强制=%d）⇒ 按 ltt_sispawn_rescue_off=%d 本图停刷特感：引擎并发上限与找位区间已还原成原值（导演也回到原版行为）",
				g_bHasFinaleMap ? "可用" : "无此原生", g_cRescueForce.IntValue, g_cRescueOff.IntValue);
		if (g_cAnnounce.BoolValue)
			PrintToChatAll("\x01[\x05刷特\x01] 救援关：按设置 \x04本图不刷特感\x01，安心打救援。");
	}
}

/** 【v1.29.2】插件加载/重载 2 秒后重套挡位档案（此时 cfg 已经 exec 完）。幂等，只为自愈。
 *  【v1.29.4 · 2026-10-03 补】必须**同时**重套挡位展开 ApplyMode()。
 *  实测证据（2026-10-03 23:30，reload 后）：
 *    23:30:41 挡位=0 → 自建落点=0 引擎查视野=0 分散=0      ← ApplyMode 跑过，是对的
 *    23:30:41 启动汇总读到 自建落点=1 引擎查视野=1 分散=350  ← cfg 紧接着 exec，把三个开关盖回挡位 1
 *    23:30:46 sm_sispawn_status 仍然显示 1/1/350            ← 没有任何东西再改回来
 *  原因：cfg 里残留 4 行挡位 1 的值且排在 ltt_sispawn_mode 之前，第二次 exec 时 mode 没变化，
 *        AddChangeHook 不会触发 ⇒ ApplyMode 只在「mode 值真的变了」时才会跑。这里补一次幂等重套。 */
public Action Timer_ReapplyProfile(Handle timer)
{
	ApplyModeProfile();
	ApplyMode();          // 【v1.29.4】cfg exec 完之后把三个行为开关也按挡位重套一遍
	ApplyRescueGate();    // 【v1.30.0】救援关闸门也重套（cfg 里的 rescue_off 可能刚被改）
	return Plugin_Stop;
}

public Action Timer_BuildNav(Handle timer)
{
	g_bNavTimerPending = false;
	BuildNavCache();

	// 【v1.29.1 · 2026-10-02 深度审核修复】导航缓存失败必须重试。
	// left4dhooks.inc 原文警告：Can only be called 1 frame after OnMapStart at the earliest
	// otherwise the addresses are invalid … will block these calls and log an error ⇒
	// 换图卡顿/首帧异常时 L4D_GetAllNavAreas 可能返回 0 个，BuildNavCache 只 LogError 一次就放弃，
	// 后果是【整张图的自建落点全程失效】（mode 1/2 都靠它），日志里却只有一条 error 很不显眼。
	// 现在最多再试 3 次（每次 2 秒），仍失败就保持原行为。
	if (!g_bNavReady && ++g_iNavRetry <= 3)
	{
		if (LogNormal())
			LogMessage("[SISpawn] 地图=%s 导航区缓存为空，重试第 %d/3 次", g_sMap, g_iNavRetry);
		g_bNavTimerPending = true;
		CreateTimer(2.0, Timer_BuildNav, _, TIMER_FLAG_NO_MAPCHANGE);
	}
	return Plugin_Stop;
}

public void OnCvarChanged(ConVar convar, const char[] oldV, const char[] newV)
{
	if (convar == g_cClasses)
	{
		ParseClasses();
		return;
	}
	if (convar == g_cClassLimit || convar == g_cTankClasses)
	{
		ParseAllClassLimits();
		return;
	}
	// 【v1.37.0】z_*_limit 目标值改了 → 立刻重设一次（方便 A/B 与回滚，不用等开图）
	if (convar == g_cZLimit)
	{
		ApplyZLimits();
		return;
	}
	// 【v1.8.2修订6】挡位改了 → 立刻把三个子 cvar 一起改掉，并记日志（方便对比）
	if (convar == g_cMode)
	{
		// 【v1.28.2】原来只调 ApplyMode()（三个行为开关），数值档案要等下次开图才套用
		// ⇒ 表现是"切了挡位但 tries/窗口/上限 还是旧档的"，服主 2026-10-02 实测踩到。
		ApplyModeProfile();
		ApplyMode();
		char sMN[96];
		ModeName(g_cMode.IntValue, sMN, sizeof(sMN));
		PrintToChatAll("\x01[\x05刷特\x01] 刷特挡位切到 \x04%d\x01：%s", g_cMode.IntValue, sMN);
		return;
	}
	// 【v1.30.1】救援关开关改了 → 立刻重算闸门（这样 sm_cvar 一改就生效，不用等换图/重载）
	if (convar == g_cRescueOff || convar == g_cRescueForce)
	{
		g_bRescueAnnounced = false;   // 让"改设置"能重新播报/记一次日志
		ApplyRescueGate();
		return;
	}
	// min / max 改动后立刻同步给引擎的找位区间
	ApplyEngineSpawnRange();
}

/** 【v1.48.2 · 服主 2026-10-05】允许刷的特感职业：**兼容两种写法**。
 *
 *  背景（子代理审查抓到的、差点变成线上事故的一条）：`ltt_si_spawner` 原本只认
 *  **逗号分隔的职业表**（"1,2,3,4,5,6"），而 `ltt_si_menu` 新加的"特感游戏模式"项按
 *  **位掩码**写值（63=全部六种、53=烟鬼+猎人+骑师+牛）。两者一对不上，
 *  菜单只要写一次 63，`ExplodeString` 就把 "63" 解析成职业 63（超范围）⇒ `g_bClassAllowed` 全 false
 *  ⇒ **本波没有可用职业 ⇒ 一只特感都不刷**。而菜单在"换图套用存档/投票生效/空服还原"三处都会写它。
 *  修法（只改这一处，两边都不用再迁就对方）：
 *    · 含逗号 → 照旧按职业表解析（老 cfg、手改值都保持原样）；
 *    · **纯数字** → 当作位掩码：第 k 类 = bit(k-1)（1烟鬼 2胖子 4猎人 8毒妇 16骑师 32牛），
 *      63 = 全六种、53 = 烟鬼+猎人+骑师+牛。
 *  ⚠ 掩码为 0 或解析出"一个职业都没有"时，这里会打一条 WARNING —— 那种状态等于停刷，
 *    必须能在日志里一眼看到（否则又变成"菜单改了一下，Server 就不刷特感了"这种幽灵故障）。 */
void ParseClasses()
{
	for (int i = 0; i <= MAX_CLASS; i++)
		g_bClassAllowed[i] = false;

	char buf[64];
	g_cClasses.GetString(buf, sizeof(buf));

	// 纯数字 → 位掩码
	if (StrContains(buf, ",") < 0)
	{
		int mask = StringToInt(buf);
		if (mask > 0)
		{
			for (int c = 1; c <= MAX_CLASS; c++)
			{
				if (mask & (1 << (c - 1)))
					g_bClassAllowed[c] = true;
			}
		}
	}
	else
	{
		// 逗号分隔的职业表（原始格式）
		char parts[16][8];
		int n = ExplodeString(buf, ",", parts, sizeof(parts), sizeof(parts[]));
		for (int i = 0; i < n; i++)
		{
			int c = StringToInt(parts[i]);
			if (c >= 1 && c <= MAX_CLASS)
				g_bClassAllowed[c] = true;
		}
	}

	int allowed = 0;
	for (int c = 1; c <= MAX_CLASS; c++)
		if (g_bClassAllowed[c])
			allowed++;

	if (allowed == 0 && LogNormal())
		LogMessage("[SISpawn] ⚠ ltt_sispawn_classes=\"%s\" 解析出【0 个可用职业】⇒ 本图一只特感都不会刷！请检查这个值（合法写法：\"1,2,3,4,5,6\" 或位掩码 \"63\"）", buf);
}

// ------------------------------------------------------------------ 日志分级

/** 0=只记异常 1=常规(每波一条汇总) 2=详细(每只特感都记) */
bool LogNormal() { return g_cDebug.IntValue >= 1; }
bool LogDetail() { return g_cDebug.IntValue >= 2; }

// ------------------------------------------------------------------ 每种特感上限

/** 解析 "烟鬼,胖子,猎人,毒妇,骑师,牛" 这种逗号分隔的每种上限；0=不限 */
void ParseClassLimit(const char[] s, int out[MAX_CLASS + 1])
{
	for (int i = 0; i <= MAX_CLASS; i++)
		out[i] = 0;

	char parts[MAX_CLASS][8];
	int n = ExplodeString(s, ",", parts, MAX_CLASS, sizeof(parts[]));
	for (int i = 0; i < n && i < MAX_CLASS; i++)
	{
		int v = StringToInt(parts[i]);
		if (v < 0)
			v = 0;
		out[i + 1] = v;
	}
}

void ParseAllClassLimits()
{
	char buf[128];
	g_cClassLimit.GetString(buf, sizeof(buf));
	ParseClassLimit(buf, g_iClassLimit);

	g_cTankClasses.GetString(buf, sizeof(buf));
	ParseClassLimit(buf, g_iTankLimit);
}

// ------------------------------------------------------------------ 导航网格自建落点

/** 换图时重建导航区缓存。
 *  注意 L4D_GetAllNavAreas 文档要求"至少 OnMapStart 之后 1 帧"才有效，
 *  left4dhooks 1.133 起会拦截过早的调用并报错，所以延后 2 秒。 */
void BuildNavCache()
{
	g_bNavReady = false;
	g_iNavCount = 0;

	ArrayList areas = new ArrayList();
	L4D_GetAllNavAreas(areas);

	int n = areas.Length;
	if (n <= 0)
	{
		delete areas;
		LogError("[SISpawn] 导航区缓存失败：L4D_GetAllNavAreas 返回 0 个（自建落点不可用）");
		return;
	}

	if (g_aNavPos != null)  { delete g_aNavPos;  g_aNavPos  = null; }
	if (g_aNavFlow != null) { delete g_aNavFlow; g_aNavFlow = null; }
	if (g_aNavAddr != null) { delete g_aNavAddr; g_aNavAddr = null; }
	// 【v1.18.3】拍平镜像改成固定大小全局数组了，不需要释放，但要把"可用"标志清掉
	g_bNavFlat = false;

	g_aNavPos  = new ArrayList(3);
	g_aNavFlow = new ArrayList();
	g_aNavAddr = new ArrayList();

	int k = 0;
	int nFlowZero = 0;                                // 【v1.8.2修订7】flow<=0 的孤立区计数
	int nClip = 0;                                    // 【v1.8.2修订9】被 playerclip 盖住（=墙里）
	int nOutside = 0;                                 // 【v1.8.2修订9】越界（地图外）
	int nObstacle = 0;                                // 【v1.8.2修订9】落在障碍物顶上（只统计不拒）
	int nRescue = 0;                                  // 【v1.8.2修订11】救生舱/救援车（密封空间）
	float fFlowMin = 999999.0, fFlowMax = -999999.0;
	for (int i = 0; i < n; i++)
	{
		Address area = view_as<Address>(areas.Get(i));
		if (area == Address_Null)
			continue;

		float c[3];
		L4D_GetNavAreaCenter(area, c);

		// 【v1.8.2修订9 · 修"刷在墙里面"】
		// 2026-09-24 12:26 服主报三联图有特感刷在墙里面。查下来是同一个老毛病的新变种：
		// 我们的"藏点偏好"在奖励**不合法的地方** —— 被 playerclip 盖住的导航区
		// （playerclip 就是地图作者放的隐形墙，导航区落在它里面 = 在墙里）永远看不见，
		// 所以在择优里永远排第一。和修订7 的"地下"是完全同一类错误。
		//
		// 判据来自 left4dhooks 的 NAV_BASE_* 属性位：
		//   NAV_BASE_PLAYERCLIP   (1<<18) = 该导航区被 playerclip 覆盖 → 墙里/不可达
		//   NAV_BASE_OUTSIDE_WORLD(1<<28) = 该导航区在地图外
		// 这两个直接在建缓存时就剔掉，**零运行时开销**（反正这里本来就要遍历全图）。
		// 注意：只统计不拒 OBSTACLE_TOP —— 车顶/箱顶刷出来顶多看着怪，不是bug。
		if (g_bHasNavAttr)
		{
			int attr = L4D_GetNavArea_AttributeFlags(area);
			if (attr & NAV_BASE_OUTSIDE_WORLD)
			{
				nOutside++;
				continue;
			}
			if (attr & NAV_BASE_PLAYERCLIP)
			{
				nClip++;
				continue;
			}
			if (attr & NAV_BASE_OBSTACLE_TOP)
				nObstacle++;
		}

		// 【v1.8.2修订11 · 参考 fdxx l4d2_si_spawn_control 的 IsValidFlags】
		// 排除【救生舱】和【救援车】这两类密封空间 —— 刷在里面特感永远出不来。
		// 注意 fdxx 的规则是"没有标记的区照样用"（`if (!iFlags) return true;`），
		// 只排除带这两个位的，所以不会把候选池砍光。
		if (g_bHasSpawnAttr)
		{
			int sa = L4D_GetNavArea_SpawnAttributes(area);
			if (sa != 0 && (sa & (TERROR_NAV_RESCUE_CLOSET | TERROR_NAV_RESCUE_VEHICLE)))
			{
				nRescue++;
				continue;
			}
			// 【v1.22.0】起点安全屋（检查点）整块不进候选池：门一关 AI 出不来，
			// 刷在里面的特感会永久占着槽位（server2 bdp_bunker04 的"卡安全门里面"）。
			// 在这里筛掉最省 —— 缓存之后所有自建落点都不必再判一次。
			if ((sa & NAV_SPAWN_CHECKPOINT) != 0)
			{
				g_iSafeSkip++;
				continue;
			}
		}

		float fl = L4D2Direct_GetTerrorNavAreaFlow(area);
		if (fl <= 0.0)
			nFlowZero++;
		if (fl < fFlowMin) fFlowMin = fl;
		if (fl > fFlowMax) fFlowMax = fl;

		g_aNavPos.PushArray(c, 3);
		g_aNavFlow.Push(fl);
		// 【坑】L4D_FindRandomSpot 的参数会被当成 ThisPtr 用，必须传【地址】。
		// 传 L4D_GetNavAreaID() 的小区号会被当野指针 → "Invalid ThisPtr address" 异常。
		g_aNavAddr.Push(view_as<int>(area));
		k++;
	}
	delete areas;

	g_iNavCount = k;
	g_bNavReady = (k > 0);

	// 【v1.18.3 · 找位耗时优化】把 ArrayList 拍平成固定数组（一生一次，换图重做）。
	// 这一步本身要 5×k 次 native 调用（本图 ≈ 6000 次，一次性、在地图加载期），
	// 换来的是之后**每一只特感**都省下 4×1216 次 native 调用。
	// 数据来源、顺序、类型全部参考，所以 BuildNavCand 的判定结果逐位不变。
	g_bNavFlat = (k > 0 && k <= MAX_NAV_CACHE);
	if (g_bNavFlat)
	{
		for (int i = 0; i < k; i++)
		{
			g_fNavXs[i]    = view_as<float>(g_aNavPos.Get(i, 0));
			g_fNavYs[i]    = view_as<float>(g_aNavPos.Get(i, 1));
			g_fNavZs[i]    = view_as<float>(g_aNavPos.Get(i, 2));
			g_fNavFl[i]    = view_as<float>(g_aNavFlow.Get(i));
			g_iNavAddrs[i] = g_aNavAddr.Get(i);
		}
		LogMessage("[SISpawn] v%s 导航区已拍平 %d 个（找位热循环改用普通数组读取）", PLUGIN_VERSION, k);
	}
	else
	{
		// 只有"导航区数超过 MAX_NAV_CACHE"或"0 个"才会走到这里。
		// 这时候不是"结果变了"，只是"这次优化没生效"，仍旧走原来的 ArrayList 路径。
		LogError("[SISpawn] v1.18.3 导航区数 %d 超出拍平上限 %d（或为 0）→ 本次不启用拍平优化，找位仍走 ArrayList（结果不受影响，只是慢）", k, MAX_NAV_CACHE);
	}

	LogMessage("[SISpawn] 导航区缓存 %d 个（全地图，自建落点已就绪）", g_iNavCount);
	// 【v1.8.2修订7】这条用来判断 needflow=1 会不会卡太死：
	// flow<=0 的比例越小，说明"拒掉孤立区"越安全。
	LogMessage("[SISpawn] 特性·修订7 导航流统计：flow<=0 的孤立区 %d / %d = %.1f%%（若比例过高，把 ltt_sispawn_needflow 设 0）",
		nFlowZero, k, (k > 0) ? (100.0 * nFlowZero / k) : 0.0);
	if (k > 0)
		LogMessage("[SISpawn] 特性·修订7 导航流范围：最小 %.0f 最大 %.0f",
			(fFlowMin > 900000.0) ? 0.0 : fFlowMin, (fFlowMax < -900000.0) ? 0.0 : fFlowMax);

	// 【v1.8.2修订9】被剔除的"不合法导航区"统计 —— 这就是"刷在墙里面"的来源
	if (!g_bHasNavAttr)
	{
		LogMessage("[SISpawn] 特性·修订9 属性过滤：不可用（服务器 left4dhooks 没有 L4D_GetNavArea_AttributeFlags）→ 墙里/越界过滤已跳过");
	}
	else
	{
		LogMessage("[SISpawn] 特性·修订9 属性过滤：剔除【playerclip 盖住=墙里】%d 个、【地图外】%d 个；另发现【障碍物顶】%d 个（只统计不拒）｜ 保留 %d 个",
			nClip, nOutside, nObstacle, k);
		// 【v1.8.2修订11】救生舱 / 救援车
		LogMessage("[SISpawn] 特性·修订11 密封空间过滤：剔除【救生舱/救援车】%d 个（生成属性原生 %s）",
			nRescue, g_bHasSpawnAttr ? "有" : "无");
	}
}

/**
 *  自己遍历导航网格找一个落点。
 *  和引擎的区别：不看"可刷特属性"，任何导航区都能用（这正是 Neko 可变模式的做法）。
 *  返回 true 表示 out 里是合格的点。
 */
// ------------------------------------------------------------------ v1.8.2 落点分散辅助

/** 清空本波落点记忆（每波开始时调用） */
void ResetWavePositions()
{
	if (g_aWavePos == null)
		g_aWavePos = new ArrayList(3);
	else
		g_aWavePos.Clear();

	g_iSpreadSkip  = 0;
	g_iSpreadRelax = 0;
	g_iWinGrow     = 0;
	g_iVisSkip     = 0;
}

/** 记下一个真正用掉的落点（生成成功后调用，不是"候选"）。 */
void RememberSpawnPos(const float pos[3])
{
	if (g_aWavePos == null)
		g_aWavePos = new ArrayList(3);

	g_aWavePos.Push(pos[0]);
	g_aWavePos.Push(pos[1]);
	g_aWavePos.Push(pos[2]);
}

/** 【v1.8.2修订2】刷新"当前存活特感"的位置快照。
 *  每次 FindSpawnPos 开头调一次就够（一个 MaxClients 循环，31 次 native），
 *  不要在候选循环里反复调 —— 那样每次找位会变成上千次 native。 */
void RefreshAliveSIPositions()
{
	g_iAliveSIN = 0;
	for (int i = 1; i <= MaxClients && g_iAliveSIN < MAX_ALIVE_SI; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_INFECTED || !IsPlayerAlive(i))
			continue;
		GetClientAbsOrigin(i, g_fAliveSI[g_iAliveSIN]);
		g_iAliveSIN++;
	}

	// 【v1.8.2修订10】顺带刷存活生还者快照（硬性最小间距要避开他们）。
	// 同一次循环里做完，不额外增加 native 调用次数。
	g_iAliveSurvN = 0;
	for (int i = 1; i <= MaxClients && g_iAliveSurvN <= MAXPLAYERS; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_SURVIVOR || !IsPlayerAlive(i))
			continue;
		GetClientAbsOrigin(i, g_fAliveSurv[g_iAliveSurvN]);
		g_iAliveSurvN++;
	}
}

/** 【v1.8.2修订10】该点到【任意存活生还者】的最小距离。
 *  用于硬性最小间距：引擎把两个玩家实体放在同一个坐标上会段错误炸服，
 *  "另一个生还者正好站在落点上"是同一类危险（我们只按【目标生还者】算过距离）。 */
float MinDistToSurvivors(const float pos[3])
{
	float best = 999999.0;
	for (int k = 0; k < g_iAliveSurvN; k++)
	{
		float d = GetVectorDistance(pos, g_fAliveSurv[k]);
		if (d < best)
			best = d;
	}
	return best;
}

/** 该点与"本波已用落点 + 当前存活特感"的最小距离。
 *  本波还没用过、场上也没有存活特感时返回一个足够大的数。
 *
 *  【别改这里】这里用的是【单参数】Get(i*3+c)，那是【元素索引】；
 *  而 Get(index, block) 是【块索引】—— 两者语义完全不同，别混。
 *  g_aWavePos 用 3 次单值 Push 推入，所以下标就是 (点序号*3 + 分量)，单参数形式正确。
 *  （2026-09-23 真人实测用 POS 坐标独立复算过：插件报的间距与真实最近邻距离
 *   713/713 完全吻合，确认这里读的是对的。）
 *  对照：g_aNavPos 用的是 PushArray(c,3)，所以那边读法必须是 Get(点序号, 分量)。 */
float MinDistToUsed(const float pos[3])
{
	float best = 999999.0;

	// (1) 当前存活的特感 —— 这是玩家真正会看到的"彼此挨不挨着"
	for (int k = 0; k < g_iAliveSIN; k++)
	{
		float d = GetVectorDistance(pos, g_fAliveSI[k]);
		if (d < best)
			best = d;
	}

	// (2) 本波已用落点 —— 兜住"刚刷出就被踢掉、已不在场"的边界情况
	if (g_aWavePos != null && g_aWavePos.Length >= 3)
	{
		int n = g_aWavePos.Length / 3;
		for (int i = 0; i < n; i++)
		{
			float p[3];
			p[0] = view_as<float>(g_aWavePos.Get(i * 3 + 0));
			p[1] = view_as<float>(g_aWavePos.Get(i * 3 + 1));
			p[2] = view_as<float>(g_aWavePos.Get(i * 3 + 2));
			float d = GetVectorDistance(pos, p);
			if (d < best)
				best = d;
		}
	}

	return best;
}

/** 【v1.8.2修订8】有效的"远档"上限。
 *
 *  为什么要有这个函数而不是直接读 cvar：
 *    mode 0 的承诺是「真复刻 v1.7.1 纯引擎」，那时候没有远档。
 *    如果 mode 0 还允许退到 1500，手感就跟 v1.7.1 不一样了 —— 承诺就破了。
 *    所以这里统一收口：mode 0 → 远档 == 近档（等于关闭）；
 *    farmax 没设或比 max 还小 → 也归一到 max（同样等于关闭）。
 *  所有读"远档"的地方都走这里，避免各处各判一次。 */
float GetFarMax()
{
	float far  = g_cFarMax.FloatValue;
	float near = g_cMax.FloatValue;

	if (g_cMode.IntValue == 0 || far < near)
		far = near;

	return far;
}

/** 【v1.9.1 / v1.18.1 更正】算一只落点属于哪一档。
 *    vis = 这一瞬间是否被任一存活生还者看得见；d = 与目标生还者的距离。
 *
 *  `只要不是凭空刷` 是服主定的验收口径，所以排序是：
 *      **藏点（看不见，最优） → 可见（会被看到，最差）**
 *  原文这里的「可见·远 / 可见·近」是 v1.10.0 之前的旧三档；现在只有两档，
 *  远近的区分交给 `DistBand()` 在档内做，可见点另外还受 `PassSpawnRule` 的 500~900 带约束。
 *  另：`ltt_sispawn_visfar` 这个 cvar 早已删除（v1.10.0），别再按它理解。 */
int TierOf(bool vis)
{
	return vis ? TIER_VISIBLE : TIER_HIDDEN;
}

/** 【v1.10.0 · 参考 SS_SpawnPositioner::IsValidSpawn】
 *
 *  判据（原文逐条对应）：
 *    有视线：`survivor_proximity > ss_spawn_proximity_min(500)`
 *         且 `flow_dist_survivors < ss_spawn_proximity_flow_dist_LOS(900)`
 *    无视线：`flow_dist_survivors < ss_spawn_proximity_flow_dist_no_LOS(500)`
 *
 *  @param vis        这一瞬间是否被任一存活生还者看得见
 *  @param d          与目标生还者的【直线】距离
 *  @param flowDelta  与目标生还者的【流距离】之差（沿路径的距离，比直线更能排除"隔着墙的近点"）
 *  @return           true = 这个候选点合法
 *
 *  【为什么可见那一档要卡上限】只卡下限的话，"可见但 1349 单位" 依然是凭空刷。
 *  参考实现用 flow < 900 把它拉回 500~900 这个带里 —— 这是 v1.9.2 缺的那一半。 */
/** 【v1.12.0】算"落点离目标生还者的路程"。
 *  优先用引擎真实导航路程 `L4D2_NavAreaTravelDistance(from, to, ignoreNavBlockers)`；
 *  原生缺失、或返回 <= 0（走不通/不在网格上）时，退回调用方给的 `|Δflow|` 近似。
 *
 *  【坑】这个原生的参数是 **非 const** 的 `float startPos[3]`（和
 *  `L4D2Direct_GetTerrorNavArea` 一样），所以必须先把 const 数组拷进本地数组，
 *  否则报 error 035 argument type mismatch。 */
float TravelDistTo(const float from[3], const float to[3], float fallback)
{
	if (g_cUseTravel.BoolValue && g_bHasTravel)
	{
		float a[3], b[3];
		a[0] = from[0]; a[1] = from[1]; a[2] = from[2];
		b[0] = to[0];   b[1] = to[1];   b[2] = to[2];

		float tv = L4D2_NavAreaTravelDistance(a, b, true);
		if (tv > 0.0)
			return tv;
	}
	return fallback;
}

/** 【v1.20.0】候选点"到底走不走得通"。
 *
 *  为什么需要它：`TravelDistTo` 在引擎返回 <=0（不在导航网格上/走不通）时会**退回 |Δflow| 近似**，
 *  而 |Δflow| 只知道"流图上的先后"，不知道"中间是不是断的"。于是一个和生还者隔着一道单向落差、
 *  或者干脆在另一块孤立导航区上的点，也会被判合格并刷出特感 —— 它此后只能在那一小片里打转，
 *  直到玩家自己走回去才被打死（2026-09-29 服主报的"口水和hunter卡住了"就是这个）。
 *
 *  降级原则（与本插件其它探测一致）：原生缺失 → 一律放行，绝不因为探测不到就把刷特卡死。
 *  成本：一次 `L4D2_NavAreaTravelDistance`，只在 needpath=1 时调用。 */
bool NavPathOk(const float from[3], const float to[3])
{
	if (!g_bHasTravel || !g_cNeedPath.BoolValue)
		return true;

	float a[3], b[3];
	a[0] = from[0]; a[1] = from[1]; a[2] = from[2];
	b[0] = to[0];   b[1] = to[1];   b[2] = to[2];

	// 【v1.25.0 修正】只保留"同一个导航区 → 放行"这一条。
	// 原来还有一条"直线距离 < 300 就放行"，**那条正是漏洞**：
	// 2026-09-30 03:07 实测抓到 —— 自建落点 `距目标=234/294`（很近）但 `出生于路程=-1`（引擎说走不通），
	// 特感站了 34~77 秒不动，最后靠玩家走过去才打死（bdp_bunker04 的高台/电梯井就是这种：
	// 直线很近、中间是空的/有落差，没有可行走路径）。⇒ 近 ≠ 通，靠近这一条不能豁免可达性。
	if (L4D2Direct_GetTerrorNavArea(a) == L4D2Direct_GetTerrorNavArea(b))
		return true;

	return (L4D2_NavAreaTravelDistance(a, b, true) > 0.0);
}

bool PassSpawnRule(bool vis, float d, float flowDelta)
{
	// 【v1.21.0 · 等待降级】`g_fRuleRelax` 由等待队列按"已经等了多久"给出（1.0 = 不放宽）。
	// 【只放宽上限（太远），绝不放宽下限（太近）】—— 宁可比理想位置远一点，
	// 也不能让特感贴脸凭空冒出来（那是玩家最恨的）。
	float losMax   = g_cFlowLos.FloatValue   * g_fRuleRelax;
	float noLosMax = g_cFlowNoLos.FloatValue * g_fRuleRelax;

	if (vis)
	{
		if (g_cVisMin.FloatValue > 0.0 && d <= g_cVisMin.FloatValue)
			return false;                 // 太近：在脸上凭空变出来
		if (g_cFlowLos.FloatValue > 0.0 && flowDelta >= losMax)
			return false;                 // 太远：远处凭空变出来
		return true;
	}

	// 藏点（掩体后）：没有直线下限 —— 服主要的就是"掩体后的近距离特感"
	if (g_cFlowNoLos.FloatValue > 0.0 && flowDelta >= noLosMax)
		return false;
	return true;
}

/** 【v1.22.0】候选点是不是落在【起点检查点 = 安全屋】内部。
 *
 *  为什么必须挡：队伍一离开安全屋，**门就关了**，而 L4D2 的 AI 不会开门 ⇒ 刷在里面的特感
 *  只能在屋里打转，玩家也不会回头，于是它**永久占着特感槽位**（"越卡越多"的另一种形态）。
 *  2026-09-29 情况：server2 的 bdp_bunker04 上服主报"一堆特感卡安全门里面"；
 *  我们服 20:50 那批"出生距目标 800~1240、存活 2~4.6 分钟、位移极小"的也很可能是同一个成因
 *  （安全屋在身后、屋内是天然藏点，正好落进"藏点档"的合格条件里）。
 *
 *  两道判据一起用（任一命中即拒）：
 *    ① 导航区生成属性带 `NAV_SPAWN_CHECKPOINT`（免费：这个属性本来就已经读出来了）；
 *    ② left4dhooks 有 `L4D_IsPositionInFirstCheckpoint` 时按坐标精判（覆盖属性没标的图）。
 *  只在本插件【已经开刷】（`g_bArmed` = 有人离开安全区）之后才拒 —— 开局队伍还在屋里时
 *  刷在屋里是正常的（就近埋伏），不用挡。 */
bool IsInStartSafeRoom(const float pos[3], int spawnAttr)
{
	if (!g_cNoSafeRoom.BoolValue)
		return false;

	if ((spawnAttr & NAV_SPAWN_CHECKPOINT) != 0)
		return true;

	if (g_bHasCpPos)
	{
		float p[3];
		p[0] = pos[0]; p[1] = pos[1]; p[2] = pos[2];
		if (L4D_IsPositionInFirstCheckpoint(p))
			return true;
	}
	return false;
}

/** 【v1.21.0】等待降级系数：等得越久，允许"太远"的上限越宽。
 *
 *  为什么要有它：2026-09-29 实测，刷不满的波里绝大多数不是"没地方"，而是
 *  **保底点也被规则判不合格 → 进等待队列 → 等满 3 秒放弃**。
 *  zc1_m1 一天里 `保底落点不合格/进入等待队列` 422 次、`找位耗时(失败)` 301 次，
 *  这些失败重试全部压在游戏线程上（Timer_Tick 峰值就是它们贡献的），最后还是刷不出来。
 *  与其"守着一个够不到的完美位置、等到放弃"，不如**等久了就放宽上限、先把特感放出来**：
 *  多特服的体验是"特感得在场上"，位置差一点远比"少一只"可接受。
 *
 *  曲线：`relax_at`（默认 0.8 秒）之前 = 1.0；之后每过 1 秒 +1.0，上限 `relax_max`（默认 3.0）。
 *  也就是说：等 0.8 秒 → 1.0×，等 1.8 秒 → 2.0×，等 2.8 秒 → 3.0×（此时离 3 秒放弃只剩 0.2 秒）。
 *  硬约束（导航网格/碰撞盒/世界外/硬性最小间距/可达性）**一律不放宽** —— 那几条是防炸服与防卡几何的。 */
float RuleRelaxFromWait(int stallTicks)
{
	if (!g_cWaitRelax.BoolValue)
		return 1.0;

	float waited = float(stallTicks) * 0.1;
	if (waited < 0.8)
		return 1.0;

	float f = 1.0 + (waited - 0.8);
	float cap = g_cRelaxMax.FloatValue;
	if (cap < 1.0)
		cap = 1.0;
	if (f > cap)
		f = cap;
	return f;
}

/** 【v1.9.2 · A】两个候选谁更好。规则是一个字典序：
 *    ① 档位小的赢（藏点 > 可见远 > 可见近）
 *    ② 同档位时：
 *         · 藏点档 → 比 `sep`（离其它特感/生还者更远 = 更分散），和以前一致
 *         · 可见档 → 比 `dist`（离目标生还者更远）
 *  ②的第二条是 v1.9.2 加的：以前可见档也按 `sep` 挑，结果挑出一堆 183 单位的贴脸点。
 *  既然躲不掉视线，那至少让它在更远的地方出现。 */
/** 【v1.13.0】把"离目标生还者的距离"离散成 4 档。数字越小越近、越优先。
 *  分档是为了让"优先就近"和"离其它特感更远"这两个冲突目标各管一层，
 *  不再需要靠容差去调和（见 IsBetter 的注释）。 */
int DistBand(float d)
{
	if (d < 500.0)  return 0;
	if (d < 900.0)  return 1;
	if (d < 1400.0) return 2;
	return 3;
}

bool IsBetter(int tier, float sep, float dist, int bestTier, float bestSep, float bestDist)
{
	if (bestTier == TIER_NONE)
		return true;
	if (tier != bestTier)
		return (tier < bestTier);

	// 【v1.34.0 · 2026-10-03 服主定稿】"别堆在同一个掩体"优先于"就近"。
	//   服主原话：「狭窄地形直接不要求特别分散了吧……只要不要左边掩体刷十几只就 ok」。
	//   旧顺序是 档位 → 距离档 → 间距，而"就近优先"会把「300 单位、sep=0（跟已放的那只挤在一起）」
	//   排在「800 单位、sep=400」前面 ⇒ 特感全挤在离生还者最近的那一个掩体上。
	//   现在插入一层：先看有没有达到硬下限(spread_min)，达到的优先；两边都没达到才回去比距离档。
	//   ⚠ 只在 spread>0（sep 才有意义）时生效 ⇒ 挡位 0（spread=0）行为完全不变。
	if (g_cSpread.FloatValue > 0.0 && g_cSpreadMin.FloatValue > 0.0)
	{
		// 【v1.43.0】这一层用【生效下限】EffSpreadFloor()：等待降级（等久了）会把硬下限一起放宽，
		//   让"再等下去就要被丢掉"的那只可以先挤一点出来，而不是整只不刷（§206.4 杠杆2）。
		float floorSep = EffSpreadFloor();
		bool bNow  = (sep     >= floorSep);
		bool bBest = (bestSep >= floorSep);
		if (bNow != bBest)
			return bNow;
	}

	// 【v1.13.0 · 距离分档，取代"容差"】
	//
	// 前三版都在用一个阈值去调和两个互相冲突的目标，两次都没调对：
	//   v1.10.1 容差 50  → 间距中位 245 → 153（"距离近"压死了"分散"）
	//   v1.12.0 容差 150 → 间距中位 153 → 161（几乎没用：候选跨 202~1851，
	//                      绝大多数候选对的距离差都 >150，"距离优先"每次都生效）
	//
	// 根子是**拿一个连续量去调和两个离散目标**。正确做法是分档：
	//   先把候选按距离分进 [200,500) / [500,900) / [900,1400) / [1400,∞) 四档
	//   → 优先落进更近的档（服主要"优先就近"）
	//   → **同一档内再比谁离其它特感更远**（不再被距离压死）
	// 这样"近"和"不扎堆"就同时成立，也不需要任何容差魔数。
	//
	// 档边界取 500 / 900 / 1400：前两个正好是判据里的 vis_min(500) 与 flow_los(900)，
	// 第三个是"250 单位贴脸上限"之外的合理过渡。
	// 【v1.28.4】距离偏好开关：关掉后不再"越近的档越优先"，同档位直接比分散
	if (g_cNearBias.BoolValue)
	{
		int band     = DistBand(dist);
		int bestBand = DistBand(bestDist);
		if (band != bestBand)
			return (band < bestBand);
	}
	return (sep > bestSep);
}

/** 【已删除 · v1.8.2修订】原"硬阈值 + 放宽备胎"方案的 RelaxOffer() 已被移除。
 *  实测证明硬阈值方案在 26 只时会把视野过滤挤掉（可见率 56%、间距中位 215），
 *  已改为 TryNavSpot 内部的 farthest-point 择优，不再需要外部备胎。 */

/**
 *  筛出"合法候选导航区"，用【蓄水池抽样】取最多 MAX_NAV_CAND 个。
 *
 *  【v1.8.2 方向C】以前是"缓存顺序里的前 256 个合格区域"，而缓存顺序是
 *  L4D_GetAllNavAreas 的枚举序（哈希桶序，不是空间序）—— 等于每次都固定丢掉
 *  其余合格区域，形成稳定的空间偏置。蓄水池抽样让每个合格区域等概率入选，
 *  消除这个偏置。纯算术，零 native 调用，只是不再提前 break（扫满全图而已）。
 *
 *  @param cand        输出：导航区【地址】数组（注意不是 ID，见 L4D_FindRandomSpot 的坑）
 *  @param tp          目标生还者坐标
 *  @param targetFlow  目标流距离（<=0 表示不做"身后"过滤）
 *  @param minD/maxD   距离窗口（maxD<=0 表示不限）
 *  @return            实际入选个数
 */
int BuildNavCand(int[] cand, const float tp[3], float targetFlow, float minD, float maxD)
{
	// 【v1.18.9】扫描计时。本函数只有一个出口（末尾 return n），所以包一层就够。
	float tScan = GetEngineTime();

	int n    = 0;
	int seen = 0;

	// 【v1.18.3 · 找位耗时优化】循环不变量外提。
	// 这三行原来写在循环体里，等于每刷一只特感多调 3×1216 ≈ 3600 次 ConVar native。
	// cvar 在【一次函数调用内】不可能变（SourceMod 单线程，中途没有回调），
	// 所以外提后的判定与原来逐条完全相同。
	// 注意不能用 const：SourcePawn 的 const 只接受常量表达式（error 008）。
	float cMaxDZ    = g_cMaxDZ.FloatValue;
	float cMaxDZUp  = g_cMaxDZUp.FloatValue;
	bool  bNeedFlow = g_cNeedFlow.BoolValue;

	for (int i = 0; i < g_iNavCount; i++)
	{
		// 【v1.29.1 · 2026-10-02 深度审核修复】全图扫描是插件里【唯一没有预算检查的重循环】：
		// 本服导航区实测最高 11576（MAX_NAV_CACHE=16384），mode 2 下每只特感最多跑 5 遍全图
		// （约 5.8 万次迭代），而 ltt_sispawn_searchms 只在 TryNavSpot 的评估阶段生效 ⇒
		// 预算已经耗尽的那一 tick 里这几遍照样白付。每 512 次查一次（足够便宜）。
		// 注意：到点 break 会让这一遍的蓄水池抽样结果与“扫完”不同 —— 这是可接受的取舍
		// （只在预算已耗尽时发生，继续扫下去才是真正的伤害）。
		if ((i & 511) == 0 && SearchTimeUp())
			break;

		// 【v1.18.3】优先读拍平数组（普通数组读取），拍平不可用时按原样读 ArrayList。
		// 两条路径取值完全一致，所以判定结果与改前逐位相同。
		// （ArrayList.Get 是纯读取、无副作用，所以即使多读一次 addr 也不改变行为。）
		float nx, ny, nz, f;
		int   addr;
		if (g_bNavFlat)
		{
			nx   = g_fNavXs[i];
			ny   = g_fNavYs[i];
			nz   = g_fNavZs[i];
			f    = g_fNavFl[i];
			addr = g_iNavAddrs[i];
		}
		else
		{
			nx   = view_as<float>(g_aNavPos.Get(i, 0));
			ny   = view_as<float>(g_aNavPos.Get(i, 1));
			nz   = view_as<float>(g_aNavPos.Get(i, 2));
			f    = view_as<float>(g_aNavFlow.Get(i));
			addr = g_aNavAddr.Get(i);
		}

		float dx = tp[0] - nx;
		float dy = tp[1] - ny;
		float dz = tp[2] - nz;
		float d  = SquareRoot(dx * dx + dy * dy + dz * dz);

		if (d < minD)
			continue;
		if (maxD > 0.0 && d > maxD)
			continue;

		// 【v1.8.2修订7-A】高度过滤。dz = 目标高度 - 落点高度，dz>0 表示落点更低。
		// 地下/夹层导航区永远"看不见"，会被藏点偏好主动选中，所以必须显式拒掉。
		if (cMaxDZ > 0.0 && dz > cMaxDZ)
			continue;
		if (cMaxDZUp > 0.0 && -dz > cMaxDZUp)
			continue;

		{
			// 【v1.10.0】按视线分档的硬判据（与自建路径同一套，见 PassSpawnRule）
		// 放在 flow 读取块里复用同一个 area，避免多调一次原生。
		// 【v1.8.2修订7-B】flow<=0 = 孤立/不可达导航区（地下导航岛基本都是）。
			// 旧写法 `f > 0.0 && f < targetFlow-200` 对 flow==0 反而放行 —— 这就是洞。
			if (bNeedFlow && f <= 0.0)
				continue;

			if (targetFlow > 0.0 && f > 0.0 && f < targetFlow - 200.0)
				continue;             // 在队伍后面
		}

		seen++;
		if (n < MAX_NAV_CAND)
		{
			cand[n++] = addr;
		}
		else
		{
			// 蓄水池抽样（Algorithm R）：第 seen 个以 MAX_NAV_CAND/seen 的概率
			// 替换掉池中随机一个 —— 扫完后池内就是全体的等概率样本。
			// 【注意】GetRandomInt 的调用次数与顺序和改前完全一致，
			// 所以抽样结果不变，落点分布不会因为这次优化而变化。
			int j = GetRandomInt(0, seen - 1);
			if (j < MAX_NAV_CAND)
				cand[j] = addr;
		}
	}

	// 【v1.18.9】扫描段累计（本函数唯一出口）
	g_fFindScanSec += GetEngineTime() - tScan;
	return n;
}

bool FindSpawnPosByNav(int target, float out[3], int &outTier)
{
	if (!g_bNavReady || g_iNavCount <= 0)
		return false;

	float tp[3];
	GetClientAbsOrigin(target, tp);

	float targetFlow = (g_cAhead.BoolValue) ? L4D2Direct_GetFlowDistance(target) : 0.0;
	float minD    = g_cMin.FloatValue;
	// 【v1.9.1】搜索窗口上限。GetFarMax() 在 mode 0 或 farmax<max 时会归一到 max，
	// 所以它同时也承担了"mode 0 下窗口不许放宽"的约束。
	float farMax  = GetFarMax();
	float minSep  = g_cSpread.FloatValue;

	float hardMax = g_cFallbackMax.FloatValue;
	if (hardMax <= 0.0)
		hardMax = 3000.0;             // 0=不限时给个实际天花板，别无限外扩

	// 本波一共几只 → 需要多少候选才算"够分"（每只留 2 个候选的余量）
	int need = g_iQueueLen * 2;
	if (need < 24)
		need = 24;
	if (need > MAX_NAV_CAND)
		need = MAX_NAV_CAND;

	// 【v1.8.2修订8】候选池**一次就开到远档上限**（默认 1500），
	// 近/远的选择交给 TryNavSpot 的档位择优去做。
	// 原来先按 900 建池、不够再翻倍扩的做法有个副作用：扩窗只服务于"间距"，
	// 完全不服务于"视野" —— 于是"900 内找不到藏点"就地妥协成可见点，
	// 而不是退到 1500 再找个藏点（实测可见点距离中位 659、不可见 870，正是这个副作用）。
	int cand[MAX_NAV_CAND];
	int n = BuildNavCand(cand, tp, targetFlow, minD, farMax);

	// 【v1.8.2修订8 · C 项】地形太窄的观测点。
	// 2026-09-24 实测：某些区域「前方 900 内 16 个候选区 → 放大到 1350 得 16 个 →
	// 放大到 1800 得 16 个」，也就是整张导航网格在那块只有 16 个区。
	// 26 只塞进 16 个区必然挤成间距 0 —— 这不是参数问题，是地形问题。
	// 先只如实记录频率，不动行为（降量涉及难度，得服主拍板）。
	if (n < need)
	{
		g_iNarrowCount++;
		if (LogNormal())
			LogMessage("[SISpawn] 本波地形偏窄：%.0f 内只有 %d 个候选区（本波 %d 只，理想 %d 个）—— 这一波特感可能挤在一起（累计第 %d 次）",
				farMax, n, g_iQueueLen, need, g_iNarrowCount);
	}

	// 【v1.8.2修订8】候选池太小仍可继续往外要空间（上限 hardMax）。
	// 只做廉价算术重扫，不额外打射线，所以不会推高找位耗时。
	for (int grow = 0; grow < 3 && minSep > 0.0 && n < need && farMax < hardMax; grow++)
	{
		float next = farMax * 1.5;
		if (next > hardMax)
			next = hardMax;
		if (next <= farMax)
			break;

		int n2 = BuildNavCand(cand, tp, targetFlow, minD, next);
		if (LogDetail())
			LogMessage("[SISpawn] 自建落点：前方 %.0f 内只有 %d 个候选区（本波 %d 只，需要 %d 个），窗口放大到 %.0f → 得 %d 个",
				farMax, n, g_iQueueLen, need, next, n2);

		farMax = next;
		n     = n2;
		g_iWinGrow++;
	}

	if (n == 0)
		return false;

	// 【v1.8.2修订8】优先级：**不凭空刷 > 别刷太远 > 间距**。
	// 先在整个窗口（近+远）里找"藏点"，藏点一个都没有才放宽视野。
	// 档位由 TryNavSpot 内部算（藏点近/藏点远/可见近/可见远），这里只接收结果。
	float gotSep = 0.0;
	int   gotTier = TIER_NONE;
	bool  ok = false;

	if (g_cNavVis.IntValue >= 1)
	{
		ok = TryNavSpot(cand, n, tp, minD, farMax, targetFlow, true, out, gotSep, gotTier);
		// 【v1.18.1 修】这句原来写死「放宽为任意导航区」，但 v1.17.0 起"放宽"只在
		// `ltt_sispawn_allow_visible=1` 时才发生。默认 allow_visible=0 下它**不放宽**，
		// 却照样打着"已放宽" —— 2026-09-25 窄图那一轮打了 **651 次**，
		// 会把复盘的人往"它退让成可见点了"这个错方向带。现在按开关现状如实说。
		if (!ok && LogDetail())
			LogMessage("[SISpawn] 自建落点：%.0f 内没有任何『不在视野内』的候选点%s",
				farMax, g_cAllowVisible.BoolValue
					? "，放宽为任意导航区（allow_visible=1）"
					: " → 本只进等待队列（allow_visible=0，不放宽）");
	}
	// 【v1.17.0】可见点兜底：默认【关】。找不到藏点时宁可这一只不刷（进等待队列），
	// 也不要把特感放到生还者看得见的地方 —— 实测可见落点 100% 落在 500~900，
	// 也就是 10~17 米外当着脸出现，那正是服主说的「凭空刷」。
	// 想开回来：ltt_sispawn_allow_visible 1（RCON，即时生效，不用换图）。
	if (!ok && g_cAllowVisible.BoolValue)
		ok = TryNavSpot(cand, n, tp, minD, farMax, targetFlow, false, out, gotSep, gotTier);

	// 【v1.8.2修订3 · 关键】间距没达标 → 直接跳到更大的窗口再找一次。
	//
	// 为什么必须单独加这一条：原来"扩窗"只在【候选池不够分】时才触发，
	// 而 2026-09-23 真人 26 特实测显示 `窗口放大 = 0 次` —— 候选池一直够大，
	// 扩窗逻辑永远没被叫醒。于是 26 只挤在领跑者前方 900 内时，间距只能塌掉：
	//   同时存活 ≥20 只时，间距中位只剩 113、<80 占 36%（全部落点是 294 / 8%）。
	// 也就是说：**池子够大 ≠ 池子里有"离现有特感足够远"的点**，必须往外要空间。
	//
	// 只做一轮（一次跳到上限），不做增量迭代 —— 找位成本在 26 特下已经是
	// P95 8.8ms / 最大 12.9ms，不能无限翻倍。
	//
	// 【v1.8.2修订8】目标窗口取 max(farmax, growmax)：修订8 起候选池默认已经开到
	// farmax(1500) 了，growmax(1200) 比它还小 → 这条通常不会再触发。
	// 保留它是为了"growmax 设得比 farmax 更大"那种手动调参场景。
	// 【v1.34.0】触发条件从「没达到 spread 目标(350)」改成「没达到硬下限 spread_min(120)」。
	//
	//   为什么必须改（服主 2026-10-03 实报"狭窄地形也要求特别分散"）：
	//   实测 L20261003 挡位1 一场 336 波里，这条分支触发了 **436 次**（窗口放大），
	//   而每次放大 = 又一遍 BuildNavCand 全图扫描 + 一遍 TryNavSpot 评估，
	//   于是单次找位峰值正好顶在 tickbudget(20ms) 上被 SearchTimeUp() 掐断
	//   ⇒「找不到落点，本只放弃」319 次、刷满率掉到 55%（09-30 用无预算的 tries=10/扩窗 2500 时是 86~88%）。
	//   狭窄地形里"再往外找"往往根本没有更远的合格点，纯烧预算。现在只在下限都没达到时才愿意付这笔钱；
	//   "不要堆在同一个掩体"改由 IsBetter 里的下限优先级保证（见 v1.34.0 注释）。
	if (ok && minSep > 0.0 && gotSep < EffGrowSep() && g_cGrowMax.FloatValue > farMax)
	{
		float far = g_cGrowMax.FloatValue;
		if (far > hardMax)
			far = hardMax;

		int nFar = BuildNavCand(cand, tp, targetFlow, minD, far);
		if (nFar > 0)
		{
			float sepFar = 0.0;
			float posFar[3];
			int   tierFar = TIER_NONE;
			bool  okFar = false;

			if (g_cNavVis.IntValue >= 1)
				okFar = TryNavSpot(cand, nFar, tp, minD, far, targetFlow, true, posFar, sepFar, tierFar);
			if (!okFar && g_cAllowVisible.BoolValue)   // 【v1.17.0】同上：兜底默认关
				okFar = TryNavSpot(cand, nFar, tp, minD, far, targetFlow, false, posFar, sepFar, tierFar);

			if (okFar)
			{
				g_iWinGrow++;
				if (LogDetail())
					LogMessage("[SISpawn] 自建落点：%.0f 内最远只到 %.0f（目标 %.0f）→ 窗口扩到 %.0f 重找，得 %.0f",
						farMax, gotSep, minSep, far, sepFar);
				// 【修订8】先比档位，档位相同才比间距 —— 别为了间距把藏点换成可见点
				if (tierFar < gotTier || (tierFar == gotTier && sepFar > gotSep))
				{
					out[0] = posFar[0]; out[1] = posFar[1]; out[2] = posFar[2];
					gotSep  = sepFar;
					gotTier = tierFar;
				}
			}
		}
	}

	if (ok)
	{
		if (minSep > 0.0 && gotSep < minSep)
			g_iSpreadRelax++;      // 尽力了还是不够远，如实统计（不再丢特感）

		// 【v1.34.0】连硬下限都没到 = 这只确实和别的特感挤在一起了（唯一该担心的口径）
		if (g_cSpreadMin.FloatValue > 0.0 && gotSep < g_cSpreadMin.FloatValue)
			g_iTotSpreadFloorMiss++;

		// 【v1.43.0】诊断"失败前降级重试"到底救了多少只：
		//   生效下限被放宽过（< 基准值）且这只的间距没到基准值 ⇒ 没有这条杠杆它会被判"太挤"。
		//   统计口径仍按基准值（上面那行不变），这条只是单独计数，别混进质量指标。
		if (g_cSpreadMin.FloatValue > 0.0 && gotSep < g_cSpreadMin.FloatValue
			&& EffSpreadFloor() < g_cSpreadMin.FloatValue)
			g_iLastChanceRelax++;

		outTier = gotTier;
		return true;
	}
	return false;
}

/**
 *  生还者能不能直接看到这个点。
 *
 *  为什么不用 left4dhooks 的 L4D_IsPotentiallyVisibleToTeam：
 *    服务器上装的 left4dhooks（169713 字节）是旧版，**没有这个原生**
 *    （实测报 "Native L4D_IsPotentiallyVisibleToTeam was not found"）。
 *    本地包里的新版 left4dhooks（172346）才有，但那是核心依赖，
 *    为了一个可见性判断去升级它风险太大。
 *
 *  改用 sdktools 的射线：从每个存活生还者的眼睛打一条线到候选点，
 *  一路没有遮挡就说明"看得见"。零新依赖，而且比 PVS 粗判更准
 *  （PVS 是预计算的"可能可见"，射线是当下真实视线）。
 */
bool IsSpotVisibleByRay(const float pos[3])
{
	float aim[3];
	aim[0] = pos[0];
	aim[1] = pos[1];
	aim[2] = pos[2] + 40.0;      // 抬到胸口高度，别对着地面打

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || !IsPlayerAlive(i) || GetClientTeam(i) != TEAM_SURVIVOR)
			continue;

		float eye[3];
		GetClientEyePosition(i, eye);

		TR_TraceRayFilter(eye, aim, MASK_VISIBLE, RayType_EndPoint, TraceFilter_NotTarget, i);

		// fraction 到 1.0 = 一路打到终点都没被挡住 → 这个人看得见
		if (TR_GetFraction() >= 0.99)
			return true;
	}
	return false;
}

/** 射线过滤器：忽略生还者自己，其它实体照常遮挡 */
public bool TraceFilter_NotTarget(int entity, int contentsMask, any data)
{
	if (entity == data)
		return false;
	if (entity >= 1 && entity <= MaxClients)
		return false;            // 别人的身体不算遮挡（不然队友挡一下就算看不见）
	return true;
}

/** 【v1.11.0 · 引擎 PVS 版】这个点是不是"生还者完全看不见"。
 *
 *  用 left4dhooks 新版（172346 起）的 `L4D_IsPotentiallyVisibleToTeam(navArea, team)`：
 *    "Returns true if any portion of the NavArea is visible to anyone on the given team"
 *  —— 也就是**这个导航区只要有一部分能被看到，就返回 true**。
 *  所以 `!它` = 整个区都看不见 = 一个合法的藏点。
 *
 *  ⚠️【v1.15.0 更正】这段原来说「这是最严格的一档」是**错的** ——
 *  恰恰相反：「区里有一小块被看到就算可见」是**过近似**，比按点判定宽松得多。
 *  2026-09-25 实测可见率 218/816 = 26.7% 卡住降不下来，根因就在这里。
 *  因此它只配当第一级粗筛，真正的判定交给 IsSpotVisibleByPvsPoint()。
 *
 *  为什么比自己打射线好：
 *    · 成本：每个候选从"最多 4 条射线"降到 1 次 PVS 位图查询
 *      （26 特时一次找位原来最多 18×4 = 72 条射线，现在 18 次查询）
 *    · 口径：用的是**引擎自己判断"这个区会不会被看到"**的同一套数据，
 *      不再是我们自己用"眼睛→点位"的直线遮挡去猜
 *
 *  【注意】它只认导航区。点不在导航网格上时（GetTerrorNavArea 返回空），
 *  保守地当成"可见"（宁可判可见、换一个点，也不要把特感放在网格外）。
 *  （调用点此前都已经过了 `L4D2Direct_GetTerrorNavArea(p) != Address_Null` 的复核。） */
bool IsSpotVisibleByPvs(const float pos[3])
{
	// 【坑】新版 left4dhooks 的 `L4D2Direct_GetTerrorNavArea(float pos[3], ...)`
	// 参数【不是 const】（旧版 include 是 const）—— 直接传 const 数组会报
	// error 035 argument type mismatch。所以先拷到本地数组再传。
	float p[3];
	p[0] = pos[0]; p[1] = pos[1]; p[2] = pos[2];

	Address area = L4D2Direct_GetTerrorNavArea(p);
	if (area == Address_Null)
		return true;             // 不在导航网格上 → 保守判可见

	return L4D_IsPotentiallyVisibleToTeam(view_as<int>(area), TEAM_SURVIVOR);
}

/** 【v1.15.0 · 两级可见性】先按【导航区】粗筛，再按【点】精判。
 *
 *  为什么需要它（2026-09-25 实测：可见率 218/816 = 26.7%，卡住降不下来）：
 *    上面那个 `L4D_IsPotentiallyVisibleToTeam` 的口径是
 *      "any portion of the NavArea is visible to anyone on the given team"
 *    —— 导航区里【只要有一小块】能被看到就返回 true。这是**过近似**：
 *    开阔地形的大导航区几乎从不「整区全隐」，于是大量**实际被掩体挡住**的点
 *    被误判成可见，藏点池被它挤空 → 藏点档找不到人 → 只能退到可见档。
 *
 *  修法：把「可见」的结论推迟到第二级，用引擎自己的战术服务**逐生还者按点**判。
 *    · 第一级（粗筛，1 次查询）：整区不可见 → 铁定是藏点，直接返回 false。
 *    · 第二级（精判，每人最多 1 次）：区域潜在可见时，再问「这个人能不能真看到这个点」。
 *      left4dhooks 文档：比 TR_TraceRayFilterEx 还快，且与 AI 用的是同一套战术服务。
 *
 *  方向性（重要）：本改动只可能把「可见」改判成「藏点」，**不会**反过来把藏点
 *  改判成可见 —— 所以它不可能让「凭空刷」变多，最坏情况是退回旧行为。
 *  一键关掉：`ltt_sispawn_vis_mode 1`（RCON，即时生效，无需换图）。 */
bool IsSpotVisibleByPvsPoint(const float pos[3])
{
	float p[3];
	p[0] = pos[0]; p[1] = pos[1]; p[2] = pos[2];

	Address area = L4D2Direct_GetTerrorNavArea(p);
	if (area == Address_Null)
		return true;                       // 不在导航网格上 → 保守判可见

	int iArea = view_as<int>(area);

	// —— 第一级：区域级粗筛。整区都没人看得见 → 铁定是藏点，连点级都不用问。
	if (!L4D_IsPotentiallyVisibleToTeam(iArea, TEAM_SURVIVOR))
		return false;

	// —— 第二级：逐生还者点级精判。有一个真看得见就算可见。
	//    调用惯例与 inf_pos_find.sp / timers.sp / infected_teleport.sp 一致：
	//    (client, 客户端队伍, 目标点所属队伍, 目标导航区, 目标坐标)
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || !IsPlayerAlive(i) || GetClientTeam(i) != TEAM_SURVIVOR)
			continue;

		if (L4D2_IsVisibleToPlayer(i, TEAM_SURVIVOR, TEAM_INFECTED, iArea, p))
			return true;
	}

	return false;
}

/** 【v1.11.0】可见性判定的统一入口。
 *  默认走引擎 PVS；开关关掉、或服务器缺原生时自动退回自打射线。
 *  这样换实现不会因为"服务器 left4dhooks 版本不对"而把插件搞挂。 */
bool IsSpotVisible(const float pos[3])
{
	int  mode = g_cVisMode.IntValue;
	bool v;

	if (mode == 0 || !g_bHasEngineVis)
		v = IsSpotVisibleByRay(pos);
	else if (mode == 2 && g_bHasVisPlayer)
		v = IsSpotVisibleByPvsPoint(pos);   // 【v1.15.0】区域粗筛 + 点级精判
	else
		v = IsSpotVisibleByPvs(pos);        // 【v1.11.0】区域级

	// 【v1.17.0 · 严格口径】再加一道独立几何射线：任一判「可见」即算可见。
	// 依据（VISCHK 实测 681 样本）：点级说「藏」而射线有清晰视线占 21.6%，
	// 反向只有 1.0% —— 说明点级原生在本服务器【少报】可见点。只信它的话，
	// 会持续把可见点当藏点刷出来（日志写「藏点」、眼睛看到「当面刷」）。
	// 主判定已经说「可见」时不再重复打射线，省掉一大半开销。
	if (!v && g_cVisStrict.BoolValue)
		v = IsSpotVisibleByRay(pos);

	return v;
}

/** 【v1.8.2修订11 · 参考 fdxx l4d2_si_spawn_control 的 WillStuck】
 *
 *  为什么需要它：`L4D_FindRandomSpot` 返回的是导航区内的**随机点**，可能正好落在
 *  多边形边缘 —— 特感碰撞盒（约 32×32×71）会有一半嵌进旁边的墙里，玩家看到的就是
 *  「刷在墙里面」。引擎给的候选点同理：原生只保证"在可刷特导航区上"，
 *  不管那个点的碰撞盒放不放得下。
 *
 *  【为什么推翻修订9 的写法】修订9 我自己写的是 `!TR_StartSolid()`，当时刻意避开
 *  `TR_DidHit()`，理由是"零长度 hull 射线会把脚下地面也算成命中，那样每个点都会被拒"。
 *  实测结果：`碰撞盒` 只拒掉 34/1103 —— **太宽松了**，只拦住"整个身子埋进去"，
 *  没拦住"贴墙边半个身子在墙里"，而这才是玩家实际看到的那个现象。
 *
 *  fdxx 的成熟实现用的是 `TR_DidHit()`，说明当初那个担心是多余的（顶多少量误判，
 * 反正本来就会换点重试）。所以直接参考它的参数与判据：
 *    · 碰撞盒 ±16 × 0~71（它注释里写明"引擎里所有客户端一样大"）
 *    · 过滤器同时忽略【所有客户端】和【无效实体】
 *    · `TR_TraceHullFilterEx` 要 2 参数的过滤器（与 3 参数的 `TR_TraceHullFilter` 不同）
 */
bool IsSpotClear(const float pos[3])
{
	static const float fMin[3] = { -16.0, -16.0,  0.0 };
	static const float fMax[3] = {  16.0,  16.0, 71.0 };

	Handle hTrace = TR_TraceHullFilterEx(pos, pos, fMin, fMax, MASK_PLAYERSOLID, TraceFilter_Clearance);
	bool bHit = TR_DidHit(hTrace);
	delete hTrace;

	return !bHit;
}

/** 与 IsSpotClear 配套：忽略所有客户端和无效实体（参考 fdxx 的 TraceFilter_Stuck）。
 *  注意 `TR_TraceHullFilterEx` 的过滤器签名是【两个参数】。 */
public bool TraceFilter_Clearance(int entity, int contentsMask)
{
	if (entity <= MaxClients || !IsValidEntity(entity))
		return false;
	return true;
}

/**
 *  从候选导航区里随机抽几个、用引擎的 FindRandomSpot 取点并复核。
 *
 *  【v1.8.2 修订 · 重要 · 第一版是错的】
 *  第一版把间距做成【硬约束】（sep < minSep 就 continue）。2026-09-23 真人 26 特实测
 *  证明这会造成灾难性失效：350 单位的排除圈很快把可用区域占满 →
 *    · 引擎路径 10 个候选全被拒，引擎成功率掉到 2%（171 个落点里只有 3 个来自引擎）；
 *    · 自建落点的"藏点 + 间距"那一遍也全被拒 → 频繁落到"放宽视野"分支；
 *    · 结果【间距没做到（中位 215、最小 96），可见率反而飙到 56%】——
 *      "分散"这个硬约束把"凭空刷"放大了，比不加还差。
 *
 *  新做法：**不做硬拒绝**，改成在【所有合法候选里挑"离本波已用落点最远"的那一个】
 *  （farthest-point / max-min 采样）。好处：
 *    · 永远不会"因为间距而找不到点"，不需要"放宽悬崖"；
 *      稀疏时自然拉得开、稠密时自然收紧，26 只也不会崩；
 *    · 视野过滤回到最高优先级：先在"藏点"里挑最远的，一个藏点都没有才放宽视野；
 *    · 达到目标间距就提前退出 → 常见情况反而比第一版更省射线。
 *
 *  @param bNeedHidden  是否要求"生还者看不见"（第 1、2 段专用）
 *  @param maxD         搜索窗口上限（ltt_sispawn_farmax / 扩窗后的上限）
 *  @param bestSep      输出：选中点与本波已用落点的最小距离（spread=0 时为 0）
 *  @param outTier      输出：【v1.8.2修订8】选中的档位（TIER_*），调用方要拿它去和
 *                      引擎路径的候选比大小
 *
 *  【v1.8.2修订8 · 择优口径变了 / v1.18.1 更正】
 *  原口径是「藏点/可见」两层 × 「间距最大」，修订8 起改成字典序比较：
 *      **档位（0 藏点 < 1 可见） → 距离档 → 同档内比间距**
 *  （原文写的 `TIER_VISIBLE_FAR/NEAR` 那套四段在 v1.10.0 就收敛成两档了，常量已删。）
 *  为什么把"远"排在"可见"前面：2026-09-24 三联图实测，可见落点距离中位 659、
 *  不可见 870 —— 旧的「藏点@900 → 可见@900 →（才扩窗）」顺序让 28% 的落点
 *  在玩家脸上就近妥协了，而它们从没被给过"退远一点找个藏点"的机会。
 *  宁可多跑 200~600 单位，也别在开阔地当面变出来。
 *  （mode 0 下 GetFarMax() 归一到 max → 窗口不会放宽，行为与 v1.7.1 一致。）
 */
// 注意 `int[] cand` 是"数组参数"的新式写法。
// 写成 C 风格的 `int cand[]` 会被这个编译器当成"缺长度的固定数组声明"而报 error 183。
bool TryNavSpot(int[] cand, int n, const float tp[3], float minD, float maxD, float targetFlow,
                bool bNeedHidden, float out[3], float &bestSep, int &outTier)
{
	// 【v1.18.9】评估计时。本函数有 3 个出口（两处 return true、一处 return false），
	// 每处都要结算，否则会漏计（漏计会让"评估"看起来比实际便宜）。
	float tEval = GetEngineTime();

	int   tries  = bNeedHidden ? 18 : 10;    // 比第一版(14/8)多几个，因为现在要"择优"
	float target = g_cSpread.FloatValue;
	bool  needSep = (target > 0.0);
	bool  checkVis = (g_cNavVis.IntValue >= 1);
	// 【v1.49.4·三闸】最近生还者的高度只算一次（候选循环里只做比较，零额外开销）
	float lttNearZ  = 0.0;
	bool  lttNearOk = LttNearestSurvivorZ(tp, lttNearZ);

	bool  found  = false;
	float best   = -1.0;      // 藏点档用：与已用落点的最小距离
	float bestD  = -1.0;      // 【v1.9.2】可见档用：与目标生还者的距离
	int   bestT  = TIER_NONE;

	for (int k = 0; k < tries; k++)
	{
		// 【v1.28.0】单次找位超预算 → 立刻停手（这一只留到下一 tick）
		if (SearchTimeUp())
			break;
		// 注意：这里存的是【导航区地址】。L4D_FindRandomSpot 的 int 参数会被当成
		// ThisPtr 用，传 L4D_GetNavAreaID() 的小区号会被当野指针（踩过，见 §9）。
		int addr = cand[GetRandomInt(0, n - 1)];

		// 【v1.29.1 · 2026-10-02 深度审核修复】必须显式清零：
		// left4dhooks.inc 对 L4D_FindRandomSpot 只承诺“成功时写入 vecPos”（@noreturn），
		// 失败时不保证写 (0,0,0)。旧代码依赖“失败会留 0”这个假设 + 下一行判断兜底。
		float p[3] = {0.0, 0.0, 0.0};
		L4D_FindRandomSpot(addr, p);

		// 取点失败时它不报错（也不保证写 0），这里靠“显式清零 + 判 0”双保险
		if (p[0] == 0.0 && p[1] == 0.0 && p[2] == 0.0)
			continue;

		float dx = tp[0] - p[0];
		float dy = tp[1] - p[1];
		float dz = tp[2] - p[2];
		float d  = SquareRoot(dx * dx + dy * dy + dz * dz);

		if (d < minD)
			continue;
		if (maxD > 0.0 && d > maxD)
			continue;

		// 复核：这个点必须真的落在导航网格上（否则特感会卡在几何里）
		if (L4D2Direct_GetTerrorNavArea(p) == Address_Null)
			continue;

		// 【v1.20.0】还得【真的走得通】：引擎说这条路不存在（<=0）时不再退回 |Δflow| 近似放行。
		// 这是"刷在身后却永远走不过来"的直接来源（见 NavPathOk 的注释）。
		if (!NavPathOk(tp, p))
		{
			g_iTotNoPath++;
			continue;
		}

		// 【v1.8.2修订7-A】在【最终坐标】上再卡一次高度。
		// 候选池筛的是导航区【中心】的高度，而 L4D_FindRandomSpot 返回的是区内
		// 【随机点】—— 大区/多层区两者能差几十上百单位，只筛中心挡不住地下点
		// （2026-09-24 00:34 那只刷在 z=-373 的 Jockey 就是这么漏过来的）。
		if (g_cMaxDZ.FloatValue > 0.0 && dz > g_cMaxDZ.FloatValue)
			continue;
		if (g_cMaxDZUp.FloatValue > 0.0 && -dz > g_cMaxDZUp.FloatValue)
			continue;

		// 【v1.49.4 · 出生点三闸】与既有硬约束（硬间距 / 碰撞盒）同级同层：
		//   ① 水里 ② 世界之外 ③ 与最近生还者高度差超标。判据与注释见 LttGateInWater 上方。
		if (LttGateInWater(p))     { g_iGateWaterSkip++;   continue; }
		if (LttGateOutside(p))     { g_iGateOutsideSkip++; continue; }
		if (LttGateVertBad(p, lttNearOk, lttNearZ)) { g_iGateVertSkip++; continue; }

		// 【v1.8.2修订9】碰撞盒放得下吗（专治"贴墙边刷出来、半个身子在墙里"）
		if (g_cClearance.BoolValue && !IsSpotClear(p))
		{
			g_iHullSkip++;
			continue;
		}

		// 【v1.8.2修订10 · 炸服修复】硬性最小间距 —— 硬拒绝，不是择优。
		// 池子小的时候（实测那波 1500 内只有 5 个候选区、本波 12 只），
		// 择优逻辑会把同一个点反复挑出来，两个特感叠在同一坐标上 → 引擎段错误。
		float floorD = g_cMinSI.FloatValue;
		if (floorD > 0.0)
		{
			float dNear = MinDistToUsed(p);
			float dSurv = MinDistToSurvivors(p);
			if (dSurv < dNear)
				dNear = dSurv;
			if (dNear < floorD)
			{
				g_iCloseSkip++;
				continue;
			}
		}

		bool vis = checkVis ? IsSpotVisible(p) : false;
		if (bNeedHidden && vis)
			continue;                       // 会被看到，换一个

		// 【v1.10.0】按视线分档的硬判据（参考 SS_SpawnPositioner）
		// 流距离：用这个导航区的 flow 与目标生还者 flow 之差。
		// （参考实现是对【所有】生还者取最小差值；我们只对目标算 —— 目标本来就是
		//   领跑者，且这条判据是"别太远"的上限，用领跑者当基准偏保守，安全。）
		if (targetFlow > 0.0)
		{
			Address carea = L4D2Direct_GetTerrorNavArea(p);
			if (carea != Address_Null)
			{
				float cf = L4D2Direct_GetTerrorNavAreaFlow(carea);
				if (cf > 0.0 && !PassSpawnRule(vis, d, TravelDistTo(tp, p, FloatAbs(cf - targetFlow))))
				{
					g_iRuleSkip++;
					continue;
				}
			}
		}

		// 【v1.9.1 / v1.18.1 更正】档位：藏点 → 可见。（原写"三段式"，v1.10.0 起只有两档。）
		// checkVis=false（navsearch_vis=0）时 vis 恒为 false → 全部算"藏点"，
		// 与旧行为一致。
		int tier = TierOf(vis);

		float sep = needSep ? MinDistToUsed(p) : 0.0;

		// 【v1.18.0】这个计数器以前【没有任何自增点】→ 波次日志里
		// 「因『离已用落点太近』被拒 N 个候选」恒为 0，会让人误以为"间距从来不是问题"。
		// 注意：间距是【择优】不是拒绝（见本函数上方的说明），所以这里数的是
		// "没达到 spread 目标的候选个数"，这才是那个日志文案真正想表达的东西。
		if (needSep && sep < target)
			g_iSpreadSkip++;

		// 【v1.38.0】提前收工的条件收紧：只有"理想点"才收工。
		//
		// 旧条件（v1.8.2 起）只看【档位 + 间距】，**完全不看距离** ⇒ 循环在导航缓存
		// （哈希枚举序 ≈ 随机）里撞到的第一个"藏点且间距达标"的点就直接 return，
		// 那个点可能远得要命。后果（2026-10-04 服主实测反馈"距离偏好根本没生效"）：
		//   距离档开 200~2000 时，落点中位常年 1100~1200、<500 只占 8~12%，
		//   而"就近优先"（DistBand 那一层）**永远没机会参与比较**。
		// 新条件：额外要求这个点落在**最近一档（<500）**才算"理想"，才提前收工；
		//   否则继续扫（仍受 tries 上限约束）把更近的候选比出来。
		// 代价：多扫几个候选（有 searchms/tickbudget 兜着），换来"就近优先"真正生效。
		// 想回到旧行为：`ltt_sispawn_findbest 0`。
		bool bIdeal = (tier == TIER_HIDDEN && (!needSep || sep >= target));
		if (bIdeal && g_cFindBest.BoolValue)
			bIdeal = (DistBand(d) == 0);

		if (bIdeal)
		{
			out[0] = p[0]; out[1] = p[1]; out[2] = p[2];
			bestSep = sep;
			outTier = TIER_HIDDEN;
			g_fFindEvalSec += GetEngineTime() - tEval;   // 【v1.18.9】出口①
			return true;
		}

		// 没达标/不是最好档不算失败：记住目前更好的那个（见 IsBetter 的规则）
		if (!found || IsBetter(tier, sep, d, bestT, best, bestD))
		{
			found = true;
			bestT = tier;
			best  = sep;
			bestD = d;
			out[0] = p[0]; out[1] = p[1]; out[2] = p[2];
		}
	}

	if (!found)
	{
		g_fFindEvalSec += GetEngineTime() - tEval;   // 【v1.18.9】出口②
		return false;
	}

	bestSep = best;
	outTier = bestT;
	g_fFindEvalSec += GetEngineTime() - tEval;       // 【v1.18.9】出口③
	return true;
}

// ------------------------------------------------------------------ 直连刷特工厂

/**
 *  从本插件自己的 gamedata 里取 6 个 NextBotCreatePlayerBot<T> 静态函数。
 *  拿到之后就能绕开 ZombieManager 的预建特感池。
 *  （原文写"那个池子固定 MaxClients/2 只" —— 该结论 2026-09-23 已被推翻，见 `GetEffCap()`。）
 *  取不到也没关系：g_bDirectReady=false，自动回退到引擎原生方式。
 */
void LoadBotFactories()
{
	for (int i = 0; i <= MAX_CLASS; i++)
		g_hBot[i] = null;
	g_bDirectReady = false;

	GameData gd = LoadGameConfigFile("ltt_si_spawner");
	if (gd == null)
	{
		LogError("[SISpawn] 载入 gamedata/ltt_si_spawner.txt 失败 —— 直连刷特不可用，将回退引擎原生（最多 9 只）");
		return;
	}

	int ready = 0;
	char key[64];
	for (int c = 1; c <= MAX_CLASS; c++)
	{
		Format(key, sizeof(key), "NextBotCreatePlayerBot<%s>", g_sClassName[c]);

		StartPrepSDKCall(SDKCall_Static);
		if (!PrepSDKCall_SetFromConf(gd, SDKConf_Signature, key))
		{
			EndPrepSDKCall();   // 收尾，避免 prep 泄漏（返回值必然是 null）
			LogError("[SISpawn] gamedata 缺签名 %s", key);
			continue;
		}
		PrepSDKCall_AddParameter(SDKType_String, SDKPass_Pointer);
		PrepSDKCall_SetReturnInfo(SDKType_CBasePlayer, SDKPass_Pointer);
		g_hBot[c] = EndPrepSDKCall();
		if (g_hBot[c] != null)
			ready++;
	}
	delete gd;

	g_bDirectReady = (ready == MAX_CLASS);
	LogMessage("[SISpawn] 直连刷特工厂就绪 %d/%d（%s）", ready, MAX_CLASS,
		g_bDirectReady ? "可突破 9 只上限" : "不完整，将回退引擎原生");
}

/**
 *  参考 rygive / ProdigySim DirectInfectedSpawn 的 InitializeSpecial。
 *  比原版多做一件事：补写 m_zombieClass。
 *  引擎原生路径是 ZombieManager 帮我们写好的，直连创建的 bot 不会写，
 *  不补的话 CountAliveSI() 会认为它"不属于 1~6 号职业"而不计数 → 越刷越多。
 */
void InitSpecial(int ent, int zclass, const float pos[3], const float ang[3])
{
	ChangeClientTeam(ent, TEAM_INFECTED);
	SetEntProp(ent, Prop_Send, "m_usSolidFlags", 16);
	SetEntProp(ent, Prop_Send, "movetype", 2);
	SetEntProp(ent, Prop_Send, "deadflag", 0);
	SetEntProp(ent, Prop_Send, "m_lifeState", 0);
	SetEntProp(ent, Prop_Send, "m_iObserverMode", 0);
	SetEntProp(ent, Prop_Send, "m_iPlayerState", 0);
	SetEntProp(ent, Prop_Send, "m_zombieState", 0);
	SetEntProp(ent, Prop_Send, "m_zombieClass", zclass);
	DispatchSpawn(ent);
	SetEntProp(ent, Prop_Send, "m_zombieClass", zclass);
	TeleportEntity(ent, pos, ang, NULL_VECTOR);
	ApplySpawnTweaks(ent);          // 【修订11】蹲着出生（见函数注释）
}

/** 【v1.8.2修订11 · 参考实现 specialspawner v1.3.7】出生瞬间的"防嵌"处理。
 *
 *  参考实现（豆瓣酱 specialspawner）在生成前后做了两件事：
 *    · `vPos[2] += 5.0`                     —— 抬高 5 单位再生成，避开地面/台阶
 *    · `m_bDucked = 1` + `FL_DUCKING`        —— 让它【蹲着出生】
 *
 *  第二招是关键：**蹲姿的碰撞盒小得多**，所以即使落点正好贴在墙边，
 *  身体也不会嵌进墙里 —— 玩家看到的就是"刷在墙里面"。
 *  这正是我们这个问题的另一条解法：
 *    · 我们目前：`IsSpotClear()` 检测到嵌进去 → 换一个点（治本，但会漏）
 *    · 参考实现：让它根本卡不进去（治标，但零漏）
 *  两个叠加最稳，所以 `ltt_sispawn_clearance` 和 `ltt_sispawn_crouch` 都保留。
 *
 *  注：L4D2 的 AI 会在需要时自己站起来，这个标记只是保证"出生那一刻"的碰撞盒小。 */
void ApplySpawnTweaks(int ent)
{
	if (!g_cCrouch.BoolValue)
		return;
	if (ent < 1 || ent > MaxClients || !IsClientInGame(ent))
		return;

	SetEntProp(ent, Prop_Send, "m_bDucked", 1);
	SetEntityFlags(ent, GetEntityFlags(ent) | FL_DUCKING);
}

/** 【v1.8.2修订11】是否"有人在跑图"：最前与最后的存活生还者路程差超过阈值。
 *  对齐参考实现的 `ss_rush_distance 1500`（它据此决定要不要把特感刷到队伍前方）。 */
bool IsAnyoneRushing()
{
	float hi = -1.0, lo = 999999.0;
	int   n  = 0;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_SURVIVOR || !IsPlayerAlive(i))
			continue;
		if (GetEntProp(i, Prop_Send, "m_isIncapacitated") == 1)
			continue;                       // 倒地的不算（对齐参考实现）

		float f = L4D2Direct_GetFlowDistance(i);
		if (f <= 0.0 || f == -9999.0)
			continue;

		if (f > hi) hi = f;
		if (f < lo) lo = f;
		n++;
	}

	if (n < 2 || hi < 0.0 || lo > 900000.0)
		return false;

	return ((hi - lo) > g_cRushDist.FloatValue);
}

/** 【v1.8.2修订11】算出这一只该给引擎什么方向偏好（写进 PreferredSpecialDirection）。
 *
 *  为什么值得抄这一招：引擎自己的刷特选区会**尊重**这个脚本值。
 *  参考实现靠它把落点往"大空间"和"队伍前方"引导 —— 完全不碰导航网格，
 *  但落点质量比"随便挑一个可刷特区"好得多。我们的引擎路径占比只有 3.7%，
 *  这一招不改占比，但能让引擎给出的那 3.7% 更靠前、更开阔。 */
int ResolvePreferredDir()
{
	int d = g_cDir.IntValue;

	if (d == 1) return 9;      // SPAWN_LARGE_VOLUME        大空间优先
	if (d == 2) return 7;      // SPAWN_IN_FRONT_OF_SURVIVORS 队伍前方优先
	if (d == 0) return -1;     // 不干预

	// d == 3 自动（对齐参考实现的分支顺序）
	if (g_iWaveFail > 0)   return 9;    // 本波已经失败过 → 去更大的空间找
	if (IsAnyoneRushing()) return 7;    // 有人在跑图 → 刷到队伍前方
	return -1;                          // 否则不指定，交给引擎
}

// ------------------------------------------------------------------ 唯一的驱动循环

// 【v1.18.13 · 只加计量，一行行为都不改】Timer_Tick 的计时外壳。
// 为什么包一层而不是在每个 return 前插计时：这个函数有 8 个 return
// （7 个 Plugin_Continue + 1 个 Plugin_Stop），逐个插计时正是最容易漏掉的那种改动
// —— 漏一个出口就会把那次耗时算成 0。包一层只有【一个】测量点，永远不会漏。
public Action Timer_Tick(Handle timer)
{
	float tTick = GetEngineTime();
	Action  act = TimerTickBody(timer);
	float   dt  = GetEngineTime() - tTick;

	g_iTickCount++;
	g_fTickSumSec += dt;
	if (dt >= 0.010) g_iTickOver10++;
	if (dt >= 0.020) g_iTickOver20++;
	if (dt >= 0.030) g_iTickOver30++;

	// 【v1.23.0】相位结算：把"这个 tick 我方花了多少、花在哪"记下来。
	// 总耗时 dt 里减去三个已计时相位，剩下的全算"其它"（镜像/满员守卫/播报/波次调度…）。
	{
		float phased = g_flLastPhase[0] + g_flLastPhase[1] + g_flLastPhase[2];
		float misc   = dt - phased;
		if (misc < 0.0)
			misc = 0.0;                          // 计时误差保护
		g_flLastPhase[3] = misc;

		for (int k = 0; k < 4; k++)
		{
			float v = g_flLastPhase[k];
			g_flPhaseSum[k] += v;
			if (v > g_flPhasePeak[k]) g_flPhasePeak[k] = v;
			if (v >= 0.020) g_iPhaseOver20[k]++;
		}
		// 【v1.25.1 修正】这里才是“给 OnGameFrame 的快照”：
		// v1.23.0 初版把快照写进了“每图重置”那一段（等于没用），
		// 而真正每 tick 清零的这一段没存 ⇒ g_flPhaseSnap 永远是 0，
		// 日志里就出现“总耗时 19.5 ms 但四个相位全是 0.0”这种不可能的行。
		for (int k = 0; k < 4; k++)
			g_flPhaseSnap[k] = g_flLastPhase[k];
		g_flLastTickTotal = dt;

		// 单 tick 我方耗时 >=20ms 就留一条带相位拆分的日志（每图限流，免得刷爆日志）
		if (dt >= 0.020 && g_iFrameLogLeft > 0 && LogNormal())
		{
			g_iFrameLogLeft--;
			LogMessage("[SISpawn] 帧内耗时归因 我方 %.1f ms = 找位生成 %.1f + 踢人回收 %.1f + 看门狗 %.1f + 其它 %.1f ｜ 第 %d 波 场上特感 %d 客户端 %d",
				dt * 1000.0,
				g_flLastPhase[0] * 1000.0, g_flLastPhase[1] * 1000.0,
				g_flLastPhase[2] * 1000.0, g_flLastPhase[3] * 1000.0,
				g_iWaveNo, CountAliveSI(), GetClientCount(false));
		}
		// 【快照】先把本 tick 各相位存一份给 OnGameFrame，再清零累加器
		for (int k = 0; k < 4; k++)
		{
			g_flPhaseSnap[k] = g_flLastPhase[k];
			g_flLastPhase[k] = 0.0;
		}

		// 注意：清零放在打日志之后 —— 上面那条日志要打的是【本 tick】的拆分。
		// g_flLastPhase 同时被 OnGameFrame 读，所以这里清完，OnGameFrame 看到的是
		// "刚结束那个 tick"的最终值（它在下一个 tick 到来前执行）。
	}

	if (dt > g_fTickPeakSec)
	{
		g_fTickPeakSec  = dt;
		g_iTickPeakWave = g_iWaveNo;
		g_iTickPeakSI   = g_iLastSpawned + g_iLastFailed;
		// 只在创纪录时数一次客户端（32 次 IsClientInGame，可忽略）
		int n = 0;
		for (int i = 1; i <= MaxClients; i++)
			if (IsClientInGame(i)) n++;
		g_iTickPeakClients = n;
	}
	return act;
}

/** 【v1.23.0】帧/跳间隔监测 + 卡顿归因。
 *
 *  SM 的 OnGameFrame 每次服务端帧/跳都会回调。这里只做三件轻活：
 *    ① 记下两次回调的间隔（累计/峰值/超阈值次数）；
 *    ② 间隔 >=25ms 时，把**上一 tick 我方各相位耗时**一起打出来 —— 这是判断
 *       "卡顿是不是刷特造成的"最直接的一行：间隔 ≫ 我方耗时 ⇒ 不怪刷特；
 *    ③ 每图汇总里给出 `次数/本图时长/平均间隔`，用来自证这个回调的实际频率。
 *  成本：每 tick 一次浮点减法 + 比较，可忽略；日志每图限流 g_iFrameLogLeft 条。 */
public void OnGameFrame()
{
	float now = GetEngineTime();

	if (g_flFrameLast > 0.0)
	{
		float dt = now - g_flFrameLast;
		// 换图/暂停/读盘会给出巨大或负的间隔，直接丢掉，别污染统计
		if (dt > 0.0 && dt < 1.0)
		{
			g_iFrameCount++;
			g_flFrameSum += dt;
			if (dt > g_flFrameMax) g_flFrameMax = dt;
			if (dt >= 0.025) g_iFrameOver25++;
			if (dt >= 0.050) g_iFrameOver50++;

			if (dt >= 0.025 && g_iFrameLogLeft > 0 && LogNormal())
			{
				g_iFrameLogLeft--;
				LogMessage("[SISpawn] 卡顿归因 间隔 %.1f ms ｜ 上一 tick 我方总耗时 %.1f ms（找位生成 %.1f + 踢人回收 %.1f + 看门狗 %.1f + 其它 %.1f）｜ 第 %d 波 场上特感 %d 客户端 %d",
					dt * 1000.0, g_flLastTickTotal * 1000.0,
					g_flPhaseSnap[0] * 1000.0, g_flPhaseSnap[1] * 1000.0,
					g_flPhaseSnap[2] * 1000.0, g_flPhaseSnap[3] * 1000.0,
					g_iWaveNo, CountAliveSI(), GetClientCount(false));
			}
		}
	}
	g_flFrameLast = now;
}

public Action TimerTickBody(Handle timer)
{
	// 自愈保护：换图时 OnMapStart 会无条件重建定时器（实测 TIMER_FLAG_NO_MAPCHANGE
	// 并不能阻止引擎回收句柄）。万一旧的那个也活了下来，它会在这里发现
	// 自己已不是当前登记的定时器，于是自行退出 —— 避免两个 0.1 秒定时器
	// 同时跑导致双倍刷特。
	if (timer != g_hTick)
		return Plugin_Stop;

	// 【v1.18.2】把"实际生效值"同步到只读镜像 cvar（供别的插件软连接读取）。
	// 放在所有分支之前、独立于总开关 —— 即使刷特被暂停，"当前生效值"也该是准的。
	// 成本：4 次 int 读取比较，可忽略。
	RefreshEffMirror();

	// 【v1.20.0】滞留看门狗：独立于总开关（它是"已经刷出来的特感别站桩"的补救，不是生成逻辑）。
	// 每 0.5 秒才真巡检一次（内部节流），平时只是一次浮点比较。
	{
		float tPh = GetEngineTime();
		WdCheck();
		float dPh = GetEngineTime() - tPh;
		g_flLastPhase[2] += dPh;                 // 【v1.23.0】相位：看门狗
	}

	// 0) 满员守卫，独立于总开关 —— 它是"服务器别死锁在 18/18"的安全措施，
	//    管理员手动刷满时也要生效，否则菜单会彻底失效。
	TrimToKeepFree(false);

	// 【v1.30.0】救援关闸门。挡位 2（只在"救援开始后"不刷）会在局中翻转，
	// 所以这里每 tick 只做一次布尔比较，真翻转时才调 ApplyRescueGate()（幂等）。
	if (g_cRescueOff.IntValue == 2 && g_bRescueMap && IsRescueBlocked() != g_bRescueBlockedNow)
		ApplyRescueGate();

	if (!g_cEnable.BoolValue || g_bRescueBlockedNow)
		return Plugin_Continue;

	// 0.5) 定期回收死亡的特感假人，腾出客户端槽位。
	//      直连方式刷出来的特感是"真客户端"，死了不会自己释放槽位。
	{
		float tPh = GetEngineTime();
		RecycleDeadSI(false);
		float dPh = GetEngineTime() - tPh;
		g_flLastPhase[1] += dPh;                 // 【v1.23.0】相位：踢人回收
	}

	// 0) 【v1.49.9】先更新"生还者动过没有"（冻结/过场中动不了 ⇒ 动了就是解冻了）
	LttUpdateMovedFlag();

	// 1) 等生还者离开安全区
	if (!g_bArmed)
	{
		// 【v1.49.8】双重保险①：开场过场还没放完，一律不开刷（所有图都管）。
		// 只有"过了安全上限"才忽略这一闸，避免原生异常把刷特永久堵死。
		if (g_bHasIntroNative && g_cIntroGuard.BoolValue)
		{
			float flElapsed = GetGameTime() - g_flMapStartGame;
			if (flElapsed <= g_cIntroGuardMax.FloatValue && L4D_IsInIntro())
			{
				if (LogNormal() && !g_bLttIntroLogged)
				{
					g_bLttIntroLogged = true;
					LogMessage("[SISpawn] v1.49.8 开场过场进行中 => 暂不开刷（已等 %.0f 秒；最多等 %.0f 秒后强制放行）",
						flElapsed, g_cIntroGuardMax.FloatValue);
				}
				return Plugin_Continue;
			}
			if (LogNormal() && g_bLttIntroLogged && !g_bLttIntroDoneLogged)
			{
				g_bLttIntroDoneLogged = true;
				LogMessage("[SISpawn] v1.49.8 开场过场已结束（用时 %.0f 秒）=> 恢复武装判定", flElapsed);
			}
		}

		// 【v1.49.9】双重保险②：必须有人真的动过（位移超过 arm_move），除非已过兜底时间。
		// 好处：不依赖地图白名单，任何图（含不报 IsInIntro 的自制图）都自动适用。
		if (g_cArmMove.FloatValue > 0.0 && !g_bLttSomeoneMoved)
		{
			float flEl = GetGameTime() - g_flMapStartGame;
			if (flEl <= g_cArmMoveMax.FloatValue)
			{
				if (LogNormal() && !g_bLttMoveLogged)
				{
					g_bLttMoveLogged = true;
					LogMessage("[SISpawn] v1.49.9 还没有生还者移动（阈值 %.0f 单位）=> 暂不开刷（最多等到 %.0f 秒）",
						g_cArmMove.FloatValue, g_cArmMoveMax.FloatValue);
				}
				return Plugin_Continue;
			}
			if (LogNormal() && !g_bLttMoveTimeoutLogged)
			{
				g_bLttMoveTimeoutLogged = true;
				LogMessage("[SISpawn] v1.49.9 已等满 %.0f 秒仍无人移动 => 兜底放行（忽略「动过」要求）", g_cArmMoveMax.FloatValue);
			}
		}

		// 【v1.49.7】名单里的图（无起点安全屋，例：ch01_jupiter 开场是长过场）：
		// 开图后先等 ltt_sispawn_arm_delay 秒，否则过场还没放完特感就开刷。
		if (g_cArmDelay.FloatValue > 0.0 && LttMapInArmDelayList())
		{
			float flWait = g_cArmDelay.FloatValue - (GetGameTime() - g_flMapStartGame);
			if (flWait > 0.0)
			{
				if (LogNormal() && !g_bLttArmDelayLogged)
				{
					g_bLttArmDelayLogged = true;
					char sMapD[64];
					GetCurrentMap(sMapD, sizeof(sMapD));
					LogMessage("[SISpawn] v1.49.7 本图在武装延后名单里（%s）：开图后先等 %.0f 秒再开刷（还剩 %.0f 秒）",
						sMapD, g_cArmDelay.FloatValue, flWait);
				}
				return Plugin_Continue;
			}
		}

		if (!L4D_HasAnySurvivorLeftSafeArea())
			return Plugin_Continue;

		g_bArmed      = true;
		g_flNextSpawn = GetGameTime() + g_cFirst.FloatValue;
		g_iWaveNo     = 0;

		if (LogNormal())
			LogMessage("[SISpawn] 有人离开安全区，%.1f 秒后刷第一波", g_cFirst.FloatValue);

		AnnounceSettings(true, false);
		return Plugin_Continue;
	}

	// 2) 先把待生成队列发完（每 tick 生成 batch 只）
	if (g_iQueuePos < g_iQueueLen)
	{
		// 【v1.18.8 · 找位重试节流】位置不合格时不要每 0.1 秒就重跑一次完整找位。
		// ⚠ 这里【必须 return】，理由同下面 spawnevery 那段的长注释（fall through 会踩卡住保护）。
		// ⚠ 跳过期间【照样】++g_iStallTicks —— 卡住保护是"墙钟 3 秒"的语义（30 个 tick）。
		//   如果跳过不计时，放弃阈值会被拉长成 N 倍，那就等于"重试总次数一点没少、只是拖长了"，
		//   而重试总次数正是我们要砍的东西。加了这个 ++ 之后：尝试 tick 和跳过 tick
		//   各自恰好贡献 1 次自增 ⇒ 仍然是 30 个 tick = 3 秒放弃，重试次数降到 1/N。
		if (g_iRetryWait > 0)
		{
			g_iRetryWait--;
			if (++g_iStallTicks > 30)
			{
				if (LogNormal())
					LogMessage("[SISpawn] 队列卡住 3 秒（等不到合格落点 / 或槽位占满且没有可牺牲的特感假人），放弃本波剩余 %d 只（累计第 %d 次，共丢掉 %d 只）",
						g_iQueueLen - g_iQueuePos, g_iWaitGiveUp, g_iWaitGiveUpSI);
				g_iWaitGiveUp++;
				g_iWaitGiveUpSI += (g_iQueueLen - g_iQueuePos);
				g_iQueueLen   = 0;
				g_iQueuePos   = 0;
				g_iStallTicks = 0;
				g_iRetryWait  = 0;
			}
			return Plugin_Continue;
		}

		// 【v1.18.6】生成节流：每 N 个 tick 才发一批，把一整波摊平。
		// ⚠ 这里【必须 return】，不能只是把 perTick 设成 0 往下走 ——
		//   下面有"队列卡住 3 秒"保护（`g_iQueuePos == before` → `++g_iStallTicks > 30`
		//   就丢弃整波剩余）。每跳过 1 次就给它 +1，N=5 时 32 个 tick 就会误判成
		//   "卡住 3 秒"，把这一波剩下的特感全丢掉。这种坑不看全函数是发现不了的。
		//   波次调度本来就在"队列清空后"才做（见本函数末尾），所以 return 与旧行为一致。
		int every = g_cSpawnEvery.IntValue;
		if (every < 1)
			every = 1;

		g_iSpawnPhase++;
		if (g_iSpawnPhase < every)
			return Plugin_Continue;
		g_iSpawnPhase = 0;

		int perTick = g_cBatch.IntValue;
		int before  = g_iQueuePos;

		// 【v1.21.0】先按"已经等了多久"定好本次的降级倍数，再进找位。
		// 放在循环外：一次 tick 内这批发的是同一档放宽，行为可解释、日志好对照。
		g_fRuleRelax = RuleRelaxFromWait(g_iStallTicks);
		float tSpawnPh = GetEngineTime();        // 【v1.23.0】相位：找位+生成

		for (int k = 0; k < perTick && g_iQueuePos < g_iQueueLen; k++)
		{
			g_bSlotFull    = false;
			g_bPosTooClose = false;
			g_bSpawnCooldown = false;
			if (!SpawnOne(g_iQueue[g_iQueuePos]))
			{
				// 【v1.8.2修订10】刚踢完人、还在冷却 → 等一下就行，别当成失败
				// （绝不能让下面的 slotstop 分支因此取消整波）。
				if (g_bSpawnCooldown)
					break;

				// 【v1.8.2修订10 · 炸服修复】"附近没有空位"要和"槽位满"一样立刻收手。
				// 继续死磕只会反复挑到同一个点、两个特感叠在同一坐标 →
				// 2026-09-24 12:45:51 就是这么把服务器搞段错误的。
				if (g_bPosTooClose && g_cSlotStop.BoolValue)
				{
					if (LogNormal())
						LogMessage("[SISpawn] 附近已无合格空位（其它特感/生还者都太近）→ 取消本波剩余 %d 只，下一波补上",
							g_iQueueLen - g_iQueuePos);
					g_iQueueLen   = 0;
					g_iQueuePos   = 0;
					g_iStallTicks = 0;
					break;
				}
				// 【v1.8.2修订4 · 服主 2026-09-23 定稿】"刷到槽位上限就停止，没满就下一波补上"
				//
				// 旧行为：停在原地等下一 tick 重试（10 次/秒），连续 3 秒一只都放不进去才放弃。
				// 而每次重试都会走 SpawnOne 的失败分支 → TrimToKeepFree(true) 踢一个假人。
				// 实测代价：**生成失败 434/千只 + 满员守卫踢人 555/千只**（26特/5秒）。
				// 新行为：槽位满 → 本波剩余【立刻取消】，交给下一波（默认 5 秒后）补。
				// 反正下一波会重算 room（cap-alive 与 槽位余量 取小），没满就补上。
				if (g_bSlotFull && g_cSlotStop.BoolValue)
				{
					if (LogNormal())
						LogMessage("[SISpawn] 槽位已满 → 取消本波剩余 %d 只，下一波补上（客户端占用 %d/%d，存活特感 %d/%d）",
							g_iQueueLen - g_iQueuePos, GetClientCount(false), MaxClients,
							CountAliveSI(), GetEffCap());
					g_iQueueLen   = 0;
					g_iQueuePos   = 0;
					g_iStallTicks = 0;
				}
				break;
			}

			g_iQueuePos++;
		}
		g_flLastPhase[0] += GetEngineTime() - tSpawnPh;   // 【v1.23.0】相位：找位+生成

		if (g_iQueuePos >= g_iQueueLen)
		{
			g_iQueueLen   = 0;
			g_iQueuePos   = 0;
			g_iStallTicks = 0;
			g_iRetryWait  = 0;   // 【v1.18.8】队列清了，重试节流一并清
			g_fRuleRelax  = 1.0; // 【v1.21.0】队列清空 → 回到不放宽
		}
		else if (g_iQueuePos == before)
		{
			// 【v1.18.8】这一 tick 一只都没放进去 → 把下一次重试推迟 gap 个 tick。
			// 旧行为是"下一 tick 立刻又跑一次完整找位"（10 次/秒），位置一直不合格时
			// 就是 10 × 13.6ms ≈ 136ms/秒 全压在游戏线程上。
			int gap = g_cRetryGap.IntValue;
			g_iRetryWait = (gap > 1) ? (gap - 1) : 0;

			// 卡住保护：连续 3 秒一只都放不进去（场上全是真人/生还者，没东西可牺牲）
			if (++g_iStallTicks > 30)
			{
				if (LogNormal())
					LogMessage("[SISpawn] 队列卡住 3 秒（等不到合格落点 / 或槽位占满且没有可牺牲的特感假人），放弃本波剩余 %d 只（累计第 %d 次，共丢掉 %d 只）",
						g_iQueueLen - g_iQueuePos, g_iWaitGiveUp, g_iWaitGiveUpSI);
				g_iWaitGiveUp++;
				g_iWaitGiveUpSI += (g_iQueueLen - g_iQueuePos);
				g_iQueueLen   = 0;
				g_iQueuePos   = 0;
				g_iStallTicks = 0;
				g_iRetryWait  = 0;
			}
		}
		else
		{
			g_iStallTicks = 0;
			g_iRetryWait  = 0;   // 【v1.18.8】有进展 → 恢复正常节奏
		}

		return Plugin_Continue;
	}

	// 2.5) 【v1.31.0】坦克期策略 2/3：坦克活着时停刷（3 还要清掉场上已有的特感）
	{
		bool tankAlive = IsTankAlive();

		if (!tankAlive)
		{
			g_iTankPurge = 0;      // 坦克走了 → 下一次坦克出现可以再清一遍
		}
		else if (g_cTankAction.IntValue >= 2)
		{
			if (g_cTankAction.IntValue >= 3 && g_iTankPurge == 0)
			{
				int pkicked = PurgeAllSI("ltt_si_spawner: tank_action 3");
				g_iTankPurge = 1;
				if (LogNormal())
					LogMessage("[SISpawn] 坦克期策略=3：坦克在场，已清掉场上特感 %d 只", pkicked);
			}

			// 停刷期间不推进波次；坦克一走按正常间隔重新开波（不会连刷好几波）
			g_flNextSpawn = GetGameTime() + CalcNextInterval();
			return Plugin_Continue;
		}
	}

	// 3) 队列空了，看是否该开新一波
	//
	// 【v1.32.0】补员模式（ltt_sispawn_refill）：服主 2026-10-04 实测「4 特 10 秒跟假的一样，
	//   根本没见到同时有 4 只特感」。日志证据：POS 行"场上存活"绝大多数是 1~3，
	//   特感存活中位数只有 8.9 秒。原逻辑"每 time 秒开一整波"在特感被秒杀时永远追不上
	//   —— 一波被打掉只剩 1 只，却还要干等 10 秒才来下一整波。
	//   这里改成"少于目标就立刻补缺口"，不再受 time 约束：
	//     目标 = 1 → 每波数（4 特 = 始终维持 4 只在场）
	//     目标 = 2 → 上限（一直补到满）
	//   缺口数量交给 DoOneWave(n)：它内部仍会按 room（上限 − 场上 / 槽位）夹取，不会溢出。
	if (g_cRefill.IntValue > 0)
	{
		int aliveR  = CountAliveSI();
		int targetR = (g_cRefill.IntValue >= 2) ? GetEffCap() : GetEffWave();
		int needR   = targetR - aliveR;

		if (needR > 0 && GetGameTime() >= g_flNextSpawn)
		{
			if (LogNormal())
				LogMessage("[SISpawn] 补员模式=%d：场上 %d < 目标 %d → 立刻补 %d 只（不等 %.0f 秒）",
					g_cRefill.IntValue, aliveR, targetR, needR, g_cTime.FloatValue);

			DoOneWave(needR);
			// 补员用短间隔（避免同一秒内重复补），time 只用于"第一波延迟"
			g_flNextSpawn = GetGameTime() + g_cRefillGap.FloatValue;
		}
		return Plugin_Continue;
	}

	if (GetGameTime() >= g_flNextSpawn)
	{
		DoOneWave();
		g_flNextSpawn = GetGameTime() + CalcNextInterval();
	}

	return Plugin_Continue;
}

/** 出门时在聊天框播报当前刷特设置（用引擎原生色码，不依赖 Multi-Colors） */
/** 【v1.8.2修订6】刷特挡位名称。
 *
 *  服主 2026-09-23 定稿：三档，一键切换，且必须【出门播报 + 日志记录】，
 *  这样他近期开服跑不同挡位时能直接对比。
 *
 *  设计要点：`mode` 是【权威值】—— 设它会连带把下面三个子 cvar 一起改掉，
 *  子 cvar 仍可单独微调，但下次换图 / 改 mode 会被重新覆盖（这是刻意的，
 *  否则"现在到底是哪一档"会变得说不清）。 */
#define MODE_COUNT 3
static const char g_sModeName[MODE_COUNT][] =
{
	"原版引擎点位（复刻 v1.7.1：纯引擎，不查视野、不管间距）",
	"引擎+视野+分散（默认，推荐日常）",
	"自建落点优先（最凶，接近 Neko 可变模式）"
};

/** 取挡位显示名。
 *  注意 SourcePawn 【不支持函数直接返回数组】，所以用 out-buffer 形式。 */
void ModeName(int m, char[] buf, int maxlen)
{
	strcopy(buf, maxlen, (m >= 0 && m < MODE_COUNT) ? g_sModeName[m] : "未知");
}

/** 【v1.32.3】挡位的【短名】—— 只给"出门播报"用。
 *  为什么要单独一张表而不是"把长名的括号截掉"：
 *    · 截字符串要靠找括号，遇到新名字就得改代码；显式表更不容易出意外；
 *    · 短名与 `ltt_si_menu`（!si 菜单）里的名字保持一致，玩家在两个地方看到的是同一个词。
 *  长名（含解释）继续用于 `sm_sispawn_status` 等管理员自查输出，不受影响。 */
static const char g_sModeShort[MODE_COUNT][] =
{
	"原版引擎点位",
	"引擎+视野+分散",
	"自建落点优先"
};

/** 【v1.32.3】取挡位短名（out-buffer 形式 —— SourcePawn 不能把数组当返回值）。 */
void ShortModeName(int m, char[] buf, int maxlen)
{
	strcopy(buf, maxlen, (m >= 0 && m < MODE_COUNT) ? g_sModeShort[m] : "未知");
}
/** 把挡位展开成三个子 cvar。mode 改了 / 每次 cfg 执行后都会跑一次。 */
void ApplyMode()
{
	int m = g_cMode.IntValue;
	if (m < 0) m = 0;
	if (m >= MODE_COUNT) m = MODE_COUNT - 1;

	// 0 = 真复刻 v1.7.1：纯引擎，自建落点关掉、引擎不查视野、不做分散
	// 1 = 引擎优先，但引擎路径要查视野 + 做分散（日常推荐）
	// 2 = 自建落点优先（最凶）
	int    nav = 1;
	int    vis = 1;
	float  spr = 350.0;

	switch (m)
	{
		case 0: { nav = 0; vis = 0; spr = 0.0;   }   // SourcePawn 的 case 多语句必须包花括号
		case 1: { nav = 1; vis = 1; spr = 350.0; }
		case 2: { nav = 2; vis = 1; spr = 350.0; }
	}

	// 【v1.32.2】navsearch_lock=1 时【真的】不动 navsearch（尊重手改值），
	// 并且下面把"实际生效值"和"本档想要的值"都打出来 —— 日志不许说一套做一套。
	if (!g_cNavSearchLock.BoolValue && g_cNavSearch.IntValue != nav)
		g_cNavSearch.SetInt(nav);
	if (g_cVisEngine.IntValue != vis)
		g_cVisEngine.SetInt(vis);
	if (g_cSpread.FloatValue != spr)
		g_cSpread.SetFloat(spr);

	if (LogNormal())
	{
		char sMN[96];
		ModeName(m, sMN, sizeof(sMN));
		LogMessage("[SISpawn] 挡位=%d【%s】→ 自建落点=实际 %d（本档想要 %d%s）引擎查视野=%d 分散=%.0f",
			m, sMN, g_cNavSearch.IntValue, nav,
			g_cNavSearchLock.BoolValue ? "，被 navsearch_lock 钉住" : "", vis, spr);
	}
}

/** 【v1.18.2】把"实际生效值"同步到只读镜像 cvar。
 *
 *  生效值 = 设的值 + 人数缩放，而别的插件（ltt_svote / ltt_si_menu）只通过
 *  FindConVar 软连接读 cvar。没有镜像时它们只有两条烂路：
 *    · 读到"设的值" —— 口径不一致（`!v 查看本局` 一直这么显示，第 5 人进服后数字就不对了）
 *    · 各自复制一遍缩放公式 —— 三份公式必然漂
 *  发布成 cvar 就让"哪个数字才是真的"只有一个来源，且 `sm_cvar` 可直接查。 */
void RefreshEffMirror()
{
	if (g_cEffWave == null || g_cEffCap == null)
		return;

	int w = GetEffWave();
	int c = GetEffCap();
	if (g_cEffWave.IntValue != w)
		g_cEffWave.SetInt(w);
	if (g_cEffCap.IntValue != c)
		g_cEffCap.SetInt(c);
}

/** 【v1.18.2】人数变化后的重算 + 按需播报。
 *
 *  判据参考参考实现 `specialspawner::SetSpawnCount()`：
 *    `if (limit == g_iSILimit && spawnSize == g_iSpawnSize) return;`
 *  —— **只在生效值真的变了才播报**，否则每次有人进出队伍都刷一条重复消息。 */
void EffAnnounceIfChanged()
{
	RefreshEffMirror();

	int w = GetEffWave();
	int c = GetEffCap();
	int t = RoundToNearest(g_cTime.FloatValue);

	if (w == g_iLastAnnWave && c == g_iLastAnnCap && t == g_iLastAnnTime)
		return;

	g_iLastAnnWave = w;
	g_iLastAnnCap  = c;
	g_iLastAnnTime = t;

	if (!g_cAnnounce.BoolValue || !g_cEnable.BoolValue)
		return;

	// 文案与 AnnounceSettings() 用同一个 [刷特] 风格（不混入参考实现的 [SS] 风格）。
	// 与出门那句的分工：出门那句报"完整设置 + 挡位"，这句只报"因为人数变了，数字成了这样"。
	PrintToChatAll("\x01[\x05刷特\x01] \x04%d 人\x01 → 每波 \x05%d 只\x01 | 上限 \x05%d 只\x01 | 间隔 \x05%d 秒",
		CountSurvivors(), w, c, t);

	if (LogNormal())
		LogMessage("[SISpawn] 人数变化播报: %d 人 → 每波=%d 上限=%d 间隔=%d（设 wave=%d cap=%d time=%.0f，缩放步长=%d）",
			CountSurvivors(), w, c, t,
			g_cWave.IntValue, g_cCap.IntValue, g_cTime.FloatValue, GetScaleStep());
}

/** 【v1.18.2】合并触发：同一秒里多个人进出时只算一次，避免刷一串。 */
void ScheduleEffAnnounce()
{
	if (g_hEffAnnounce != null)
		return;
	g_hEffAnnounce = CreateTimer(1.0, Timer_EffAnnounce);
}

public Action Timer_EffAnnounce(Handle timer)
{
	g_hEffAnnounce = null;
	EffAnnounceIfChanged();
	return Plugin_Stop;
}

/** 【v1.18.2】有人进出队伍 → 人数变了 → 生效值可能变。 */
public void Event_PlayerTeam(Event event, const char[] name, bool dontBroadcast)
{
	ScheduleEffAnnounce();
}

/** 【v1.18.2】断线不一定触发 player_team（实测有时候不触发），所以补一个。 */
public void OnClientDisconnect(int client)
{
	ScheduleEffAnnounce();
}

/** 【v1.28.6】再播报一次当前刷特设置（出门提示没看清时用）。纯播报，不动任何设置。 */
public Action Cmd_Dbg(int client, int args)
{
	if (args < 1)
	{
		ReplyToCommand(client, "[SISpawn] 调试档=%d（0=关 1=每波汇总 2=+每只）｜用法: sm_sispawn_dbg <0|1|2>", g_cDbg.IntValue);
		return Plugin_Handled;
	}
	char a[8];
	GetCmdArg(1, a, sizeof(a));
	int v = StringToInt(a);
	if (v < 0) v = 0;
	if (v > 2) v = 2;
	g_cDbg.SetInt(v);
	PrintToChatAll("\x01[\x05刷特\x01] 调试播报切到 \x04%d\x01（0=关 1=每波 2=+每只）", v);
	return Plugin_Handled;
}

/** 【v1.49.11】游戏内调试播报（所有人可见）。 */
public Action Cmd_Announce(int client, int args)
{
	if (!g_cEnable.BoolValue || !g_cAnnounce.BoolValue)
	{
		ReplyToCommand(client, "[SISpawn] 播报已关闭（ltt_sispawn_enable=0 或 ltt_sispawn_announce=0）");
		return Plugin_Handled;
	}

	AnnounceSettings(false, true);

	if (client > 0)
		ReplyToCommand(client, "[SISpawn] 已重新播报当前设置（日志里也有同一条『播报:』记录）");

	return Plugin_Handled;
}

/** 【v1.28.5】读 ltt_si_menu 的"距离档"存档，把档位名字取出来（出门提示用）。
 *  【v1.28.9】存档读不到时（空服 300 秒自动还原会清存档）用当前 min/max 反推档位 ——
 *             否则出门提示那行会被跳过、日志里打出 `距离档=` 空值（2026-10-02 17:47 实测）。
 *             反推口径与 ltt_si_menu 的 DistIndexFromCvars 一致（同一张 5 档表）。
 *  两路都失败才返回 false。 */
bool ReadMenuDistBand(char[] out, int maxlen)
{
	out[0] = '\0';

	// 与 ltt_si_menu 的 g_sDistName[5] / g_iDistMin / g_iDistMax 保持一致（改那边记得改这里）
	static const char sBands[5][] = {
		"贴脸 100~500", "近 200~600", "中 200~900", "远 400~1500", "开阔 200~2000"
	};
	static const int sBandMin[5] = { 100, 200, 200, 400, 200 };
	static const int sBandMax[5] = { 500, 600, 900, 1500, 2000 };

	char p[PLATFORM_MAX_PATH];
	BuildPath(Path_SM, p, sizeof(p), "data/ltt_si_menu.txt");

	KeyValues kv = new KeyValues("ltt_si_menu");
	bool bLoaded = kv.ImportFromFile(p);
	int d = bLoaded ? kv.GetNum("dist", -1) : -1;
	delete kv;

	if (d < 0 || d >= 5)
	{
		// 没有存档（刚空服还原过 / 玩家还没调过）：按当前距离区间反推
		d = -1;
		int mn = g_cMin.IntValue, mx = g_cMax.IntValue;
		for (int i = 0; i < 5; i++)
		{
			if (mn == sBandMin[i] && mx == sBandMax[i])
			{
				d = i;
				break;
			}
		}
		if (d < 0)
			return false;
	}

	Format(out, maxlen, "%s", sBands[d]);
	return true;
}

/** 【v1.49.10 · 车主 2026-11-06 定稿】出门提示。
 *  玩家反馈"弹出这条时完全不知道自己已经出了安全区"，所以先单独一行说明原因。
 *  正文两行照车主定的文案：
 *    ① `4 特 / 10 秒（同时最多 4 只）｜距离 200~2000`
 *    ② `找点算法：自建落点优先（挡位 2）｜就近优先`
 *  bJustArmed：只在"真的刚武装"那一刻传 true（多印"已离开安全区 → 刷特开始"那行）。
 *  bForce    ：无视"每回合只播一次"的守卫（给 sm_sispawn_announce 用）。
 *              【v1.49.10 修】原来那个命令在同一回合内二次播报是静默的 —— 守卫先 return 了。 */
void AnnounceSettings(bool bJustArmed, bool bForce)
{
	if (!g_cAnnounce.BoolValue || !g_cEnable.BoolValue)
		return;

	// 【LTT 补丁 2026-10-07】团灭重启不再重复刷：每回合只播一次（车主：播报只在出门提示就够了）
	if (g_bLttAnnounced && !bForce)
		return;
	g_bLttAnnounced = true;

	int step = GetScaleStep();
	int m    = g_cMode.IntValue;

	// 【v1.49.10】先把"为什么现在弹这条"说清楚：玩家不知道自己已经出了安全区。
	if (bJustArmed)
	{
		PrintToChatAll("\x01[\x05刷特\x01] \x04已离开安全区 → 刷特开始\x01（第一波 \x05%.0f 秒\x01后）",
			g_cFirst.FloatValue);
	}

	char sModeShort[32];
	ShortModeName(m, sModeShort, sizeof(sModeShort));
	char sBand[32];
	ReadMenuDistBand(sBand, sizeof(sBand));   // 只给日志用（换图后菜单还没就绪时可能读不到）

	// 第一行：几特 / 几秒 / 同时存活上限 / 距离窗口（>4 人时补"人数已加成"）
	// 【v1.49.11】末尾补「补偿」规则：解释有时候一波会刷出 5~6 只
	char sComp[48];
	if (!g_cCarry.BoolValue)
		Format(sComp, sizeof(sComp), "补偿 关（每波严格 %d 只）", GetEffWave());
	else if (g_cCarryStep.IntValue > 0)
		Format(sComp, sizeof(sComp), "补偿 开（每波≤+%d）", g_cCarryStep.IntValue);
	else
		Format(sComp, sizeof(sComp), "补偿 开（不限）");
	if (step > 0)
	{
		PrintToChatAll("\x01[\x05刷特\x01] \x04%d 特 / %.0f 秒\x01（同时最多 \x04%d 只\x01）｜距离 %.0f~%.0f｜%s｜\x03%d 人已加成",
			GetEffWave(), g_cTime.FloatValue, GetEffCap(),
			g_cMin.FloatValue, g_cMax.FloatValue, sComp, CountSurvivors());
	}
	else
	{
		PrintToChatAll("\x01[\x05刷特\x01] \x04%d 特 / %.0f 秒\x01（同时最多 \x04%d 只\x01）｜距离 %.0f~%.0f｜%s",
			GetEffWave(), g_cTime.FloatValue, GetEffCap(),
			g_cMin.FloatValue, g_cMax.FloatValue, sComp);
	}

	// 第二行：找点算法 + 距离偏好
	PrintToChatAll("\x01[\x05刷特\x01] 找点算法：\x04%s\x01（挡位 %d）｜%s",
		sModeShort, m, g_cNearBias.BoolValue ? "就近优先" : "均衡");

	// 【v1.32.0】补员模式开着时，上面那句"间隔 N 秒"就是误导（补员根本不看间隔），必须补一句
	if (g_cRefill.IntValue > 0)
	{
		PrintToChatAll("\x01[\x05刷特\x01] 补员模式：\x04保持场上 %d 只\x01（被打掉就补，不看间隔 %.0f 秒）",
			(g_cRefill.IntValue >= 2) ? GetEffCap() : GetEffWave(), g_cTime.FloatValue);
	}

	if (LogNormal())
		LogMessage("[SISpawn] 播报: 挡位=%d 每波=%d 上限=%d 间隔=%.0f 距离=%.0f~%.0f 生还者=%d 距离档=%s 距离偏好=%d 补员=%d 突击脉冲=%d 第一波=%.0f 刚出门=%d",
			m, GetEffWave(), GetEffCap(), g_cTime.FloatValue,
			g_cMin.FloatValue, g_cMax.FloatValue, CountSurvivors(),
			sBand, g_cNearBias.IntValue, g_cRefill.IntValue, g_cAssault.IntValue,
			g_cFirst.FloatValue, bJustArmed);
}

public void Event_RoundStart(Event event, const char[] name, bool dontBroadcast)
{
	g_bArmed    = false;
	g_bLttSomeoneMoved = false;      // 【v1.49.9】每回合重新判定"动过"
	g_bLttMoveLogged = false;
	g_bLttMoveTimeoutLogged = false;
	for (int i = 1; i <= MaxClients; i++)
	{
		g_bLttRefValid[i] = false;
	}
	g_iQueueLen = 0;
	g_iQueuePos = 0;
	g_iWaveNo   = 0;
	g_iStallTicks = 0;

	// 【v1.49.5 · 车主 2026-10-08 报障修复】播报守卫改为"每回合"复位。
	//   现象："我出门发现没提示刷特的提示"——他今天连着团灭重开（重开 1 → 2），
	//   而 g_bLttAnnounced 原**只在 OnMapStart 重置** ⇒ 同一张图**只有第一次出门**会播设置摘要，
	//   之后每次重开再出门都是静默的。AnnounceSettings() 的调用点是"有人离开安全区"那一下
	//   （g_bArmed false→true），而这个函数正是同一时刻的复位点 ⇒ 放这里就是"每次出门播一次"。
	g_bLttAnnounced = false;
	g_bLoggedMaxSpecials = false;
	g_bLoggedCommonLimit = false;   // 【v1.18.7】每图允许再报一次拦截

	// 【v1.8.2】新回合 = 新一波的落点记忆，避免沿用上一局用过的点
	ResetWavePositions();

	for (int i = 0; i <= MaxClients; i++)
	{
		g_iTrackWave[i] = 0;
		g_bTrackDone[i] = false;
		g_flDeadSince[i] = 0.0;
		g_flKickAt[i] = 0.0;
	}
}

public void Event_RoundEnd(Event event, const char[] name, bool dontBroadcast)
{
	g_bArmed    = false;
	g_iQueueLen = 0;
	g_iQueuePos = 0;
	g_iStallTicks = 0;
	ResetWavePositions();     // 【v1.8.2】同上
}

float CalcNextInterval()
{
	int alive  = CountAliveSI();
	float base = g_cTime.FloatValue;
	float step = g_cTimeStep.FloatValue;

	switch (g_cTimeMode.IntValue)
	{
		case 1:  base += step * float(alive);
		case 2:  base -= step * float(alive);
	}

	if (base < 1.0)
		base = 1.0;
	return base;
}

// ------------------------------------------------------------------ 满员守卫

/** 至少要留几个空客户端槽位。
 *  0 是绝对不行的：18/18 时 CreateFakeClient 返回 NULL，
 *  NextBotCreatePlayerBot 返回 -1，之后不管是我们刷还是管理员菜单刷，
 *  一只也建不出来 —— 2026-09-23 实测踩过（管理员刷满后菜单彻底失效）。
 *  留 1 个空位既能保证刷得出来，真人也照样能进服，代价只是少 1 只特感。 */
int KeepFreeSlots()
{
	int want = g_cReserve.IntValue;
	return (want < 1) ? 1 : want;
}

/**
 *  满员守卫：占用槽位太多时，踢掉"最老的特感假人"腾位。
 *  优先牺牲没有被本插件登记过的（= 管理员用 rygive 手动刷出来的），
 *  其次是本插件刷得最早的那只。真人玩家和生还者永远不碰。
 */
int TrimToKeepFree(bool bForce)
{
	if (!g_cGuard.BoolValue)
		return 0;

	float now = GetGameTime();
	if (!bForce)
	{
		if (now < g_flGuardAt)
			return 0;
		g_flGuardAt = now + 0.1;
	}

	int wantFree = KeepFreeSlots();
	int free     = MaxClients - GetClientCount(false);
	if (free >= wantFree)
		return 0;

	int   victim = -1;
	int   bestPri = 99;
	float bestT   = 1.0e9;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientConnected(i))
		{
			g_flKickAt[i] = 0.0;
			continue;
		}

		// 已经发过 KickClient、还在等引擎把槽位收回去 → 别重复踢
		if (g_flKickAt[i] > 0.0)
		{
			if (now - g_flKickAt[i] < 5.0)
				continue;
			g_flKickAt[i] = 0.0;   // 5 秒还没踢掉，放弃标记重新评估
		}

		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_INFECTED)
			continue;
		if (!IsFakeClient(i))   // 真人玩家永远不碰
			continue;

		// 牺牲优先级：
		//   0 = 已经死了的（最没价值，而且这时候它还在占槽位，连真人都会被挡在门外）
		//   1 = 活着但没被本插件登记过的（= 管理员用 rygive 手动刷出来的）
		//   2 = 活着且是本插件刷的，挑最老的那只
		int   pri;
		float t;
		if (!IsPlayerAlive(i))                { pri = 0; t = 0.0; }
		else if (g_flTrackTime[i] <= 0.0)     { pri = 1; t = 0.0; }
		else                                  { pri = 2; t = g_flTrackTime[i]; }

		if (pri < bestPri || (pri == bestPri && t < bestT))
		{
			victim  = i;
			bestPri = pri;
			bestT   = t;
		}
	}

	if (victim == -1)
		return 0;   // 场上没有可牺牲的特感假人（全是真人/生还者）→ 不硬来

	KickClient(victim, "ltt_si_spawner: keep slot free");
	g_flKickAt[victim] = now;
	g_iTrackWave[victim] = 0;
	g_flTrackTime[victim] = 0.0;
	g_bTrackDone[victim] = true;
	g_flDeadSince[victim] = 0.0;

	if (LogDetail())
		LogMessage("[SISpawn] 满员守卫：踢掉特感假人 #%d 腾位（占用 %d/%d，要求空 %d）",
			victim, GetClientCount(false), MaxClients, wantFree);

	NoteKickHappened(1);          // 【修订10】设创建冷却，别在同 tick 里建新客户端

	return 1;
}

// ------------------------------------------------------------------ 回收死亡特感

/**
 *  直连刷特（NextBotCreatePlayerBot）造出来的是"真客户端"，
 *  被打死后槽位不会像 ZombieManager 那样自动还回去。
 *  所以每 0.5 秒扫一遍：感染方 + 假人 + 已经死了 + 死了超过 recycledelay 秒 → 踢掉。
 *  真人玩家（哪怕在感染方）永远不会被踢。
 *  死后再等一会儿是为了让引擎的自动重生逻辑先跑，不跟它抢。
 */
int RecycleDeadSI(bool bForce)
{
	if (!g_cRecycle.BoolValue)
		return 0;

	float now = GetGameTime();
	if (!bForce)
	{
		if (now < g_flRecycleAt)
			return 0;
		g_flRecycleAt = now + 0.5;
	}

	float delay = g_cRecycleDelay.FloatValue;
	int kicked = 0;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientConnected(i))
		{
			g_flKickAt[i] = 0.0;
			g_flDeadSince[i] = 0.0;
			continue;
		}

		if (g_flKickAt[i] > 0.0)
		{
			if (now - g_flKickAt[i] < 5.0)
				continue;
			g_flKickAt[i] = 0.0;
		}

		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_INFECTED || !IsFakeClient(i))
		{
			g_flDeadSince[i] = 0.0;
			continue;
		}

		if (IsPlayerAlive(i))
		{
			g_flDeadSince[i] = 0.0;
			continue;
		}

		if (g_flDeadSince[i] <= 0.0)
		{
			g_flDeadSince[i] = now;
			continue;
		}

		if (now - g_flDeadSince[i] < delay)
			continue;

		KickClient(i, "ltt_si_spawner: recycle dead SI");
		g_flKickAt[i] = now;
		g_flDeadSince[i] = 0.0;
		kicked++;
	}

	if (kicked > 0 && LogDetail())
		LogMessage("[SISpawn] 回收死亡特感假人 %d 个，客户端占用 %d/%d",
			kicked, GetClientCount(false), MaxClients);

	NoteKickHappened(kicked);     // 【修订10】设创建冷却，别在同 tick 里建新客户端

	return kicked;
}

/** 【v1.8.2修订10】每次真的踢了人（回收或满员守卫）就设置创建冷却。
 *  见 SpawnOne 顶部注释：踢人异步 + 同 tick 建新客户端 = 引擎段错误。
 *
 *  【v1.9.0 · 关键修复】这里必须用 `GetEngineTime()`，【不是】`GetGameTime()`！
 *  2026-09-24 18:23 实测整局刷不出特感：换图时 `GetGameTime()` 重置回接近 0，
 *  而换图【前】用旧时间基准写下的 `g_flNoSpawnUntil` 落在了"很远的未来" →
 *  `SpawnOne` 每一 tick 都判定"还在冷却"、静默 `return false` →
 *  连续 30 tick 后触发"队列卡住 3 秒"，**一只特感都刷不出来**。
 *  因为那条 return 当时没打日志，查了很久才定位（教训：静默失败最贵）。
 *  `GetEngineTime()` 是引擎启动至今的累计时间，换图不重置。 */
void NoteKickHappened(int kicked)
{
	if (kicked > 0)
	{
		g_flNoSpawnUntil  = GetEngineTime() + 0.5;
		g_bCooldownLogged = false;     // 新的一次冷却，允许再记一条日志
	}
}

// ------------------------------------------------------------------ 一波

/**
 * 【v1.19.0 · 正式版新增】每图末质量汇总（零行为改动：只加一行日志）
 *
 * 为什么加：自建/引擎占比、间距达成率、放宽次数、波次刷满率这些"质量指标"，
 * 以前只能靠离线解析 POS 日志算出来（脚本 spawner_quality.py / wave_fill_report.py）。
 * 写进插件后每张图自己报一次，数据自证，不用再等人工分析。
 *
 * 开销说明：所有累加点都在**本来就要算**的位置（POS 日志那一段的 sep/vis），
 * 没有新增任何找位/射线计算，行为与 v1.18.13 完全一致。
 */
void PrintQualitySummary()
{
	int n = g_iTotSrcSelf + g_iTotSrcEngine + g_iTotSrcFallback;
	int waves = g_iTotWaveFull + g_iTotWaveShort;
	if (n <= 0 && waves <= 0)
		return;

	char sSrc[112];
	FormatEx(sSrc, sizeof(sSrc), "自建 %d（%.1f%%）/ 引擎 %d（%.1f%%）/ 保底 %d（%.1f%%）",
		g_iTotSrcSelf,     n > 0 ? 100.0 * g_iTotSrcSelf     / float(n) : 0.0,
		g_iTotSrcEngine,   n > 0 ? 100.0 * g_iTotSrcEngine   / float(n) : 0.0,
		g_iTotSrcFallback, n > 0 ? 100.0 * g_iTotSrcFallback / float(n) : 0.0);

	LogMessage("[SISpawn] v%s 地图=%s 挡位=%d 本图质量汇总：落点 %d 只 —— %s｜可见率 %.1f%%｜平均间距 %.0f（目标 %.0f，达标 %.1f%%，<200 占 %.1f%%）｜放宽分散 %d 次 / 窗口放大 %d 次 / 被拒候选 %d 个｜波次刷满 %d/%d（实刷 %d / 计划 %d）", PLUGIN_VERSION,
		g_sMap, g_cMode.IntValue, n, sSrc,
		n > 0 ? 100.0 * g_iTotVis / float(n) : 0.0,
		g_iTotSepN > 0 ? g_fTotSepSum / float(g_iTotSepN) : 0.0,
		g_cSpread.FloatValue,
		g_iTotSepN > 0 ? 100.0 * g_iTotSepGeSpread / float(g_iTotSepN) : 0.0,
		g_iTotSepN > 0 ? 100.0 * g_iTotSepLt200    / float(g_iTotSepN) : 0.0,
		g_iTotSpreadRelax, g_iTotWinGrow, g_iTotSpreadSkip,
		g_iTotWaveFull, waves, g_iTotWaveGot, g_iTotWavePlan);

	// 【v1.20.0】滞留与可达性：这两条是"卡住特感"那一类问题的直接指标。
	// 无路径被拒数偏高 = 这张图的导航数据本来就断（needpath 可能反而在帮忙筛）；
	// 判滞留次数偏高 = 还有漏网的站桩特感，看 wd_* 三个阈值是否需要调。
	LogMessage("[SISpawn] v%s 地图=%s 可达性与滞留：候选因「无导航路径」被拒 %d 个（needpath=%d）｜滞留看门狗 判滞留 %d 次、实际传送 %d 次（看门狗=%d 动作=%s）｜【v1.22.0】因「落在起点安全屋内部」被拒 %d 个（nosaferoom=%d）", PLUGIN_VERSION,
		g_sMap, g_iTotNoPath, g_cNeedPath.IntValue, g_iTotWdAct, g_iTotWdMoved,
		g_cWatchdog.IntValue, g_cWdAct.BoolValue ? "传送" : "只记账",
		g_iSafeSkip, g_cNoSafeRoom.IntValue);

	// 【v1.49.4】出生点三闸的每图战果 ——"装了三闸"必须能看见它到底拦了多少。
	// 判读：水面/世界外闸拦得多 ⇒ 这张图确实有水下/图外落点（c3 丛林就是）；
	//       垂直闸拦得多而掉刷满率 ⇒ 把 ltt_sispawn_gate_vert 调大（默认 200）。
	LogMessage("[SISpawn] v%s 地图=%s 出生点三闸：水面闸拒 %d 个（gate_water=%d）｜世界外闸拒 %d 个（gate_outside=%d）｜垂直闸拒 %d 个（gate_vert=%.0f）",
		PLUGIN_VERSION, g_sMap, g_iGateWaterSkip, g_cGateWater.IntValue,
		g_iGateOutsideSkip, g_cGateOutside.IntValue, g_iGateVertSkip, g_cGateVert.FloatValue);

	// 【v1.34.0】分散拆成两层口径后必须单独报一次。
	//   否则"平均间距 428 / 达标 64%"这两个数字会让人误以为"分散没做到" —— 实际上
	//   狭窄地形达不到 350 目标是**正常且被允许**的（服主 2026-10-03 定稿），
	//   真正该担心的是"连硬下限 120 都没到"（=真的堆在同一处、能被一个人架枪清完）。
	LogMessage("[SISpawn] v%s 地图=%s 分散两层口径：目标 %.0f 达标 %d 只（%.1f%%）｜硬下限 %.0f 未达到 %d 只（%.1f%%）｜为凑下限而扩窗 %d 次",
		PLUGIN_VERSION, g_sMap,
		g_cSpread.FloatValue, g_iTotSepGeSpread,
		g_iTotSepN > 0 ? 100.0 * g_iTotSepGeSpread / float(g_iTotSepN) : 0.0,
		g_cSpreadMin.FloatValue, g_iTotSpreadFloorMiss,
		g_iTotSepN > 0 ? 100.0 * g_iTotSpreadFloorMiss / float(g_iTotSepN) : 0.0,
		g_iTotWinGrow);

	// 【v1.39.0】缺口顺延：单独一行，回答"每波漏的特感到底补回来没有"
	LogMessage("[SISpawn] v%s 地图=%s 缺口顺延：本图累计欠下 %d 只 → 补回 %d 只（欠账峰值 %d，剩余 %d）｜开关=%d 上限=%d",
		PLUGIN_VERSION, g_sMap, g_iTotCarryShort, g_iTotCarryUsed, g_iCarryPeak, g_iCarry,
		g_cCarry.IntValue, g_cCarryMax.IntValue);
	// 【v1.40.0】分波消化：单独一行，避免破坏上面那行的既有格式（老分析脚本还在按它解析）
	if (g_cCarryStep.IntValue > 0)
		LogMessage("[SISpawn] v%s 地图=%s 缺口顺延(分波)：每波最多补 %d 只｜本图因分波而推迟认领累计 %d 只（换图未认领完的会随本图清零）",
			PLUGIN_VERSION, g_sMap, g_cCarryStep.IntValue, g_iCarryStepped);
	// 【v1.41.0】引擎兜底统计：这条修复到底在哪些图救了场
	if (g_cEngineMin.IntValue > 0)
		LogMessage("[SISpawn] v%s 地图=%s 引擎兜底：本图有 %d 次找位是「预算已被自建预跑烧光、靠 engine_min=%d 才跑到引擎」的（旧版这些次数会直接变成『找不到落点』）",
			PLUGIN_VERSION, g_sMap, g_iEngForced, g_cEngineMin.IntValue);
	// 【v1.42.0】自建预跑子预算统计
	if (g_cNavPct.IntValue > 0 && g_cNavPct.IntValue < 100)
	{
		int navms = RoundToNearest(g_cSearchMs.FloatValue * float(g_cNavPct.IntValue) / 100.0);
		LogMessage("[SISpawn] v%s 地图=%s 自建预跑限时：nav_pct=%d%%（预跑最多 %d ms，其余留给引擎）｜本图有 %d 次预跑被这条子预算截断",
			PLUGIN_VERSION, g_sMap, g_cNavPct.IntValue, navms, g_iNavCut);
	}
	// 【v1.43.0】保底护栏 + 两条新杠杆的每图汇总
	LogMessage("[SISpawn] v%s 地图=%s 保底护栏：本图放行 %d 个保底/降级点，独立复核未通过硬闸 %d 个｜开机自检不生效的闸 %d 道%s",
		PLUGIN_VERSION, g_sMap, g_iFbAudit, g_iFbViolation, g_iFbGateInactive,
		(g_iFbViolation > 0) ? "  ⚠⚠ 说明保底分支漏了闸门，请看本图上面的告警行" : "（0 = 这批点全部合规）");
	if (g_iLastChanceRelax > 0 || g_iCarryBudgetFind > 0)
		LogMessage("[SISpawn] v%s 地图=%s 降级杠杆：失败前降级重试救回 %d 只（自建路径口径，开关=%d 地板=%.0f）｜欠账>0 时放大找位预算 %d 次（倍数 %.2f）",
			PLUGIN_VERSION, g_sMap, g_iLastChanceRelax, g_cLastChance.IntValue,
			g_cLastChanceFloor.FloatValue, g_iCarryBudgetFind, g_cCarryBudget.FloatValue);

	// 【v1.23.0】帧内耗时归因汇总：相位峰值 + 帧/跳间隔（平均间隔用来自证回调频率）
	LogMessage("[SISpawn] v%s 地图=%s 帧内耗时归因：相位峰值 找位生成 %.1f / 踢人回收 %.1f / 看门狗 %.1f / 其它 %.1f ms｜各相位 >=20ms 次数 %d/%d/%d/%d｜峰值 tick %.1f ms", PLUGIN_VERSION,
		g_sMap, g_flPhasePeak[0] * 1000.0, g_flPhasePeak[1] * 1000.0,
		g_flPhasePeak[2] * 1000.0, g_flPhasePeak[3] * 1000.0,
		g_iPhaseOver20[0], g_iPhaseOver20[1], g_iPhaseOver20[2], g_iPhaseOver20[3],
		g_fTickPeakSec * 1000.0);
	// 【v1.26.3 修】原格式串带「地图=%s」却没有传 g_sMap ⇒ 实参比占位符少 1 个，
	// 这句 LogMessage 每次图末必抛 "String formatted incorrectly"，**异常发生在后面的计数器清零之前**，
	// 导致「本图质量汇总」其实是从插件加载起的累计值，而且「帧/跳间隔」这行从来没打出来过。
	LogMessage("[SISpawn] v%s 地图=%s 帧/跳间隔：OnGameFrame %d 次（本图累计 %.1f 秒 → 平均间隔 %.2f ms）｜最大 %.1f ms｜>=25ms %d 次｜>=50ms %d 次（阈值与 framelog 对齐）", PLUGIN_VERSION, g_sMap,
		g_iFrameCount, g_flFrameSum, (g_iFrameCount > 0 ? g_flFrameSum / float(g_iFrameCount) * 1000.0 : 0.0),
		g_flFrameMax * 1000.0, g_iFrameOver25, g_iFrameOver50);

	LogMessage("[SISpawn] v%s 地图=%s 挡位=%d 保底超硬上限：仍然刷出 %d 只（keep_far=%d）｜看门狗找位限流间隔=%.1fs", PLUGIN_VERSION,
		g_sMap, g_cMode.IntValue, g_iTotFarKeep, g_cKeepFar.IntValue, g_cWdSearchGap.FloatValue);

	// 【v1.21.0】等待降级：这一图有多少只是"等久了、放宽上限才刷出来"的。
	// 数大 = 规则本身偏紧/这张图地形太窄；数小 = 位置质量好。配合"队列卡住丢弃"一起看。
	// 【v1.26.4 修】与「帧/跳间隔」同一个病：格式串有「地图=%s」却漏传 g_sMap ⇒
	// 图末抛 "String formatted incorrectly - parameter 8 (total 7)"，
	// 异常点又在计数器清零之前 ⇒ 图末汇总再次变成累计值、这行也永远不打印。
	LogMessage("[SISpawn] v%s 地图=%s 等待降级：靠放宽「太远」上限刷出 %d 只（开关=%d，上限 %.1f 倍）｜因等满 3 秒放弃 %d 次 / 丢掉 %d 只", PLUGIN_VERSION, g_sMap,
		g_iTotRelax, g_cWaitRelax.IntValue, g_cRelaxMax.FloatValue, g_iWaitGiveUp, g_iWaitGiveUpSI);

	// 打完就清零：这些累计是"每张图"的口径，不清会跨图累加
	g_iTotSrcSelf = 0; g_iTotSrcEngine = 0; g_iTotSrcFallback = 0;
	g_iTotSepN = 0; g_fTotSepSum = 0.0; g_iTotSepGeSpread = 0; g_iTotSepLt200 = 0;
	g_iTotVis = 0;
	g_iTotSpreadSkip = 0; g_iTotSpreadRelax = 0; g_iTotWinGrow = 0;
	g_iTotSpreadFloorMiss = 0;   // 【v1.34.0】同一处清零，保证口径是"每张图"
	g_iTotWavePlan = 0; g_iTotWaveGot = 0; g_iTotWaveFull = 0; g_iTotWaveShort = 0;
	g_iCurWavePlan = 0;
	// 【v1.20.0】"每图"口径的滞留/可达性计数
	g_iTotNoPath = 0; g_iTotWdAct = 0; g_iTotWdMoved = 0; g_iSafeSkip = 0;
	g_iGateWaterSkip = 0; g_iGateOutsideSkip = 0; g_iGateVertSkip = 0;   // 【v1.49.4】三闸
	// 【v1.39.0】缺口顺延的做账也要按图清零（否则换图后第一波会背上上一张图的欠账）
	g_iCarry = 0; g_iCarryPeak = 0; g_iTotCarryShort = 0; g_iTotCarryUsed = 0;
	g_iCarryStepped = 0;   // 【v1.40.0】分波消化的推迟计数同口径清零
	g_iEngForced = 0;      // 【v1.41.0】引擎兜底强行次数同口径清零
	g_iFbAudit = 0; g_iFbViolation = 0; g_iFbGateInactive = 0;   // 【v1.43.0】保底护栏
	g_iLastChanceRelax = 0; g_iCarryBudgetFind = 0;              // 【v1.43.0】最后机会 / 欠账预算
	g_bBadNavLog = false;                                        // 【v1.46.0】坏导航图日志只打一次
	g_iNavCut = 0;         // 【v1.42.0】自建预跑被截断次数同口径清零
	g_bCarrySettled = false;
	// 【v1.33.2】"正在控人被拦下"的计数与节流时间戳也要按图清零。
	// g_flWdSkipLog 必须清：GetGameTime 在换图后回到小值，留着上一张图的时间戳
	// 会让新图里第一只控人特感的"跳过日志"被误判成"10 秒内刚打过"而整段不写日志。
	g_iTotWdSkipPin = 0;
	for (int i = 0; i <= MaxClients; i++)
	{
		g_flWdSkipLog[i] = 0.0;
		g_flWdDomAt[i] = 0.0;      // 【v1.36.0】控人时刻也要按图清零（GetGameTime 换图后回小值）
	}
	// 【v1.21.0】等待降级
	g_fRuleRelax = 1.0; g_iTotRelax = 0;

	// 【v1.28.8 · 2026-10-02 源码审核修复】补齐"找位耗时 / Timer_Tick / 各类峰值 / 可见 / 窄地形 /
	// 放弃 / 保底放行"这七组计数器的按图清零。它们原来【自插件加载起只增不减】，
	// 却被"本图质量汇总""找位拆分累计""Timer_Tick 峰值"这些行当本图数据打印 ⇒
	// 连续跑图数小时后，本图的峰值被历史峰值盖住、平均值被稀释（越跑越钝），
	// 而长期跑三方图正是要靠这几个数字找问题。清零后口径统一为"本图"。
	g_fTotFindSec = 0.0; g_iTotFindN = 0; g_iTotFindFail = 0;
	g_fTotScanSec = 0.0; g_fTotEvalSec = 0.0; g_fTotEngSec = 0.0; g_fTotNavSec = 0.0;
	g_fFindScanSec = 0.0; g_fFindEvalSec = 0.0; g_fFindEngineSec = 0.0; g_fFindNavSec = 0.0;
	g_iTickCount = 0; g_iTickOver10 = 0; g_iTickOver20 = 0; g_iTickOver30 = 0;
	g_fTickSumSec = 0.0; g_fTickPeakSec = 0.0;
	g_iTickPeakWave = 0; g_iTickPeakClients = 0; g_iTickPeakSI = 0;
	g_fFindPeakSec = 0.0; g_bFindPeakFail = false;
	g_fFindPeakScanMs = 0.0; g_fFindPeakEvalMs = 0.0; g_fFindPeakEngMs = 0.0; g_fFindPeakNavMs = 0.0;
	g_iVisibleUsed = 0; g_iNarrowCount = 0;
	g_iWaitGiveUp = 0; g_iWaitGiveUpSI = 0;
	g_iTotFarKeep = 0;
}

/** 【v1.26.0 · 挡位档案】把当前挡位的"自带参数"写进对应 cvar，并打印生效值。
 *  为什么：2026-09-30 实测 mode 0（纯引擎）被全局放开的窗口/tries 套上后，
 *  找位峰值从 79ms 涨到 155ms、>=20ms 达 321 次 —— 挡位必须自带参数上限，不能共用一套全局值。 */
void ApplyModeProfile()
{
	int m = g_cMode.IntValue;
	float gm, fl, fn;          // 【v1.28.3】mx 已移除：max 归 ltt_si_menu 管
	float sm, tb;          // 【v1.28.2】找位耗时预算：单次上限 / 每 tick 总量
	int   tr;

	if (m <= 0)          // 0 = 原版引擎点位：便宜优先，不跑窗口放大
	{
		tr = 10; gm = 0.0;    fl = 900.0;  fn = 2000.0;
		sm = 10.0;   tb = 16.0;   // 纯引擎：每次找位就是几次原生调用，预算可以小
	}
	else if (m == 1)     // 1 = 引擎+视野+分散（日常生产值）
	{
		// 【v1.27.1】2026-10-01 10:18 bdp_bunker04 实测：等待队列里每 0.1 秒重试一次完整找位
		// （tries=10 + 窗口放大 2500），单 tick 我方耗时冲到 35~90 ms ⇒ 掉 tick。
		// 每次找位的代价直接由 tries × 窗口决定，故日常档把 tries 降到 4、窗口放大降到 1200：
		// 单 tick 开销降一个量级（实测 >=20ms 的 tick 从 63 次/分钟 → 0），代价是极端窄地图
		// 偶尔少刷几只（有保底点与等待降级兜底）。
		// 【v1.28.1 · 2026-10-01 M4 验收后回调】v1.27.1+v1.28.0 把 M4 的掉 tick 从 288 次/17 分钟压到 8 次，
		// 但刷满率从 95.4% 掉到 84.4%（波次全满率 79.4%→54.5%）。原因：候选评估数（tries）与窗口放大太小 +
		// searchms=8ms 让稀疏区"再找一会儿本来能找到"的点被放弃（等待降级"等满 3 秒放弃"从 0 变 2）。
		// 折中：tries 4→6、窗口放大 1200→1800，配合 searchms 8→12ms / tickbudget 12→20ms。
		//
		// 【v1.35.0 · 2026-10-03 服主报"挡位1 增城以前轻松 90+"，回查确认为真，本档回调】
		//   对比（同图增城 zc1_m3、同档位1）：
		//     v1.19.0 / 09-30：tries=10、**全程没有"找位预算"**（日志 grep"找位预算" 0 条）
		//        → 波次刷满 745/865 = 86.1%、实刷 4404/4781 = **92.1%**、间距 496、找位峰值 35~66 ms
		//     v1.33.x / 10-03：tries=6、searchms=12 / tickbudget=20
		//        → 刷满 **55.3%**、实刷 83.8%、放弃 319 次、"找位峰值"**正好顶在 20.0 ms 上**（=被预算掐断）
		//   机制：每波只数被"进人加特感"推到 7~8 只（7~8 人生还者）⇒ `need = 队列×2 = 14~16`，
		//   而 2000 单位内凑不够 16 个候选区就触发"窗口放大"（每次=一遍全图 1.1 万导航区重扫），
		//   单次找位因此冲到 20 ms 被 `SearchTimeUp()` 截断 ⇒「找不到落点，本只放弃」。
		//   ⇒ 本档把 tries 6→10、预算 12/20→30/40 ms（先取中间档：比 v1.19.0 收敛，比今天宽松）。
		//     若刷满率仍不达标，下一步是 `sm_cvar ltt_sispawn_searchms 0; tickbudget 0`（=v1.19.0 原样，无上限），
		//     代价是找位峰值会回到 35~66 ms、峰值 tick 曾达 141 ms（见设计稿 §201.9）。
		//   ⚠ 更正一条我自己写错的归因：v1.34.0 以为"为凑 350 分散"触发了扩窗，其实那条分支的前置条件
		//     `g_cGrowMax(1800) > farMax(2000)` 为假（farmax 1500 < max 2000 ⇒ GetFarMax() 归一到 2000），
		//     所以"为分散扩窗"根本没被调用过，v1.34.0 的 `EffGrowSep()` 在当前参数下是空转。
		//     真正触发扩窗的是上面那条"候选池不够"（`n < need`）。
		// 【v1.43.0 · 服主 2026-10-05 定「直接做」】窗口放大 1800 → **2500**：
		//   §202.6 原话"这是目前唯一还没补回 10-01 的那一项" —— 09-30（无找位预算、扩窗 2500）
		//   挡位1 增城实测 23.13 只/分、刷满 86~88%；10-03 那次退化（扩窗 1800 + 预算 12/20）
		//   掉到 16.18 只/分、55.3%。预算已在 v1.35.0 回到 30/40，扩窗这一步现在补上。
		//   为什么敢放大：真正触发扩窗的是"候选池不够"（`n < need`），而扩窗本身受
		//   `SearchTimeUp()/TickBudgetUp()` 双闸保护（单次找位 30ms、每 tick 40ms）⇒ 不会无限重扫。
		tr = 10; gm = 2500.0; fl = 900.0;  fn = 2500.0;
		sm = 30.0;   tb = 40.0;   // 【v1.35.0】回归 v1.19.0 的产量（tries=10 + 宽预算）
	}
	else                 // 2 = 自建优先·最凶：只有这一档才用重参数
	{
		tr = 15; gm = 3000.0; fl = 900.0;  fn = 2500.0;
		// 【v1.28.2】重参数档必须配重预算：原来共用 12/20，搜索被 12ms 砍断，
		// 反而"找不到点"（2026-10-02 实测 M4 挡位2：放弃 10 次 / 丢 71 只）。
		// 【v1.39.0 · 2026-10-04 服主实测反馈后对齐】原来 22/35，反而比挡位1 的 30/40 更紧，
		//   而挡位2 现在要扫的候选更多（自建优先 + findbest 不再提前收工）⇒ 明显不合理。
		//   实测（11:00 那把）：找不到落点放弃 242 次、缺口 228 只。对齐并放宽到 32/48。
		sm = 32.0;   tb = 48.0;
	}

	// 【v1.26.1 · 子代审查 M2/P0】挡位档案原来无条件覆盖手改值且不提示 ⇒ "改了没生效"。
	// 现在：① `ltt_sispawn_lock_cfg 0` 可整体关掉覆盖；② 覆盖时把 旧值→新值 打进日志（不再静默）。
	if (!g_cLockCfg.BoolValue)
	{
		LogMessage("[SISpawn] v%s 挡位档案：lock_cfg=0 → 跳过套用，尊重 cfg/手改值（挡位只影响行为开关，不改数值）", PLUGIN_VERSION);
		ApplyBadNavProfile();   // 【v1.44.0】坏导航图档与 lock_cfg 无关：它是"图坏了"的兜底，不是挡位数值
		return;
	}

	float oMax = g_cMax.FloatValue, oGm = g_cGrowMax.FloatValue, oFl = g_cFlowLos.FloatValue, oFn = g_cFlowNoLos.FloatValue;
	float oSm  = g_cSearchMs.FloatValue, oTb = g_cTickBudget.FloatValue;
	int   oTr  = g_cTries.IntValue;

	// 【v1.28.3 · 写入权整改】不再写 ltt_sispawn_max —— 距离上限的权威是 ltt_si_menu 的"距离档"
	// （贴脸/近/中/远/开阔）。挡位想往远处伸，靠下面的"窗口放大 growmax"（它是找位的真正上限）。
	// 旧行为会导致：切到挡位 2（max 写 2500）把玩家在菜单里选的距离悄悄改掉。
	g_cTries.SetInt(tr);
	g_cGrowMax.SetFloat(gm);
	g_cFlowLos.SetFloat(fl);
	g_cFlowNoLos.SetFloat(fn);
	g_cSearchMs.SetFloat(sm);        // 【v1.28.2】预算随挡位走
	g_cTickBudget.SetFloat(tb);

	char sChg[256];
	FormatEx(sChg, sizeof(sChg), "上限 %.0f（归 ltt_si_menu，本档不改）｜ 尝试 %d→%d ｜ 窗口放大 %.0f→%.0f ｜ 可见档 %.0f→%.0f ｜ 藏点档 %.0f→%.0f ｜ 预算 %.0f→%.0f/%.0f→%.0f ms",
		oMax, oTr, tr, oGm, gm, oFl, fl, oFn, fn, oSm, sm, oTb, tb);
	LogMessage("[SISpawn] v%s 挡位档案：%s（想禁止覆盖就 ltt_sispawn_lock_cfg 0）", PLUGIN_VERSION, sChg);

	char sM[16];
	ModeName(m, sM, sizeof(sM));
	LogMessage("[SISpawn] v%s 挡位档案已套用：挡位=%d【%s】→ 距离上限=%.0f（菜单管）尝试=%d 窗口放大=%.0f 可见档flow<%.0f 藏点档flow<%.0f ｜ 找位预算=%.0f/%.0f ms", PLUGIN_VERSION,
		m, sM, oMax, tr, gm, fl, fn, sm, tb);

	// 【v1.44.0】坏导航图档放在**档案之后**：它要盖掉上面的 flow 上下限（残片图里 flow 全是 -9999）
	ApplyBadNavProfile();
}

/** 【v1.44.0 · 坏导航图档】给"自带 .nav 是残片"的三方图兜底（首个案例：终极特感训练 tgxl）。
 *
 *  现象与证据（2026-10-05 空服实测，见设计稿 §215）：
 *    · tgxl 的 `maps/tgxl.nav` 是**与 bsp 不匹配的陈旧残片**：导航区 **38 个**，其中
 *      **flow<=0 的孤立区 37/38 = 97.3%**（对照官方 c1m1_hotel：1156 区 / 26.9%）；
 *      29 个 `info_zombie_spawn` 里 28 个不在网格上、刷怪阵距最近导航区 1989 单位。
 *    · 于是我们两条取点路径全部失效：自建扫描被 `needflow=1` 把 97.3% 的区踢光；
 *      问引擎要落点（`L4D_GetRandomPZSpawnPosition`）同样给不出点 ⇒ **一只都刷不出来**，
 *      实测把救援闸门也放开（rescue_off=0）之后仍然"Boomer 找不到落点，本只放弃"。
 *  做法：只对**名单里的图**放宽三条"依赖导航质量"的判据，其余图一个字不改：
 *    needflow 0（允许 flow<=0 的孤立区）｜needpath 0（跳过真实导航路径判定）
 *    allow_visible 1（训练场没有掩体，只刷藏点等于不刷）｜fallbackmax 0（不限距）
 *    min 100（场地可能很小）｜flow 上下限抬成 1e5（残片图 flow=-9999，任何差值都会超限）
 *    ahead 0（"不许刷在身后"也是按 flow 判的）
 *  另外名单里的图**豁免救援关闸门**：这类单图战役常被判成"终局图"，一停就是整张图
 *    （tgxl 实测 `救援关=是 ⇒ 本图刷特=已关闭`，连手动 burst 都被拒）。
 *  可逆性：这些值**只在名单命中时写**，而 SourceMod 每张图都会重新 exec cfg（AutoExecConfig）
 *    ⇒ 换到任何别的图，值自然回到 cfg 里那份，不会污染。
 *  名单：`ltt_sispawn_badnav_maps`（逗号分隔，默认 "tgxl,tgxlbf"）。清空 = 完全关掉这条。 */
void ApplyBadNavProfile()
{
	g_bBadNavMap = IsBadNavMap(g_sMap);

	// 【v1.49.1 · 修"坏导航图档漏到下一张图"】
	//   起因（2026-10-05 23:15 实测）：tgxl → changelevel c1m1_hotel 之后，开机自检报
	//   `可达性 ✗（原生有,needpath=0）` —— 因为这份档案改的 6 个 cvar 里，
	//   needflow/needpath/allow_visible/ahead/min/fallbackmax **不属于挡位档案**（挡位只管
	//   flow 上下限等），所以没人会在换图时把它们还原 ⇒ 之后每一张普通图都跑在"坏导航图"的
	//   放宽参数下（放宽可达性/允许可见/保底不限距），刷点质量会静默变差。
	//   修法：第一次套用前把这 6 项的当前值存档，换到非坏导航图时还原并打日志。
	if (!g_bBadNavMap)
	{
		if (g_bBnSnap)
		{
			// ⚠ 不能只信快照：若快照本身取自已污染的状态（例如插件重载时上一张坏导航图的放宽值还在），
			//   还原出来还是错的（2026-10-06 00:16 实测踩到：needpath 被"还原"成 0）。
			//   ⇒ 这 5 项按【插件出厂口径】显式还原；fallbackmax 用快照，但快照 <=0（=坏导航图的
			//   "不限距"放宽值）时改用出厂 2800。
			g_cNeedFlow.SetInt(1);
			g_cNeedPath.SetInt(1);
			g_cAllowVisible.SetInt(0);
			g_cAhead.SetInt(1);
			g_cMin.SetFloat(200.0);
			float fbm = g_fBnSnapF[0];
			if (fbm <= 0.0)
				fbm = 2800.0;
			g_cFallbackMax.SetFloat(fbm);
			g_bBnSnap = false;
			LogMessage("[SISpawn] v%s 地图=%s 坏导航图档已【还原】上一次放宽的 6 项：needflow=%d needpath=%d allow_visible=%d ahead=%d fallbackmax=%.0f min=%.0f（上一张图是坏导航图，不放宽这几条就一只都刷不出来；换图后必须还回去）",
				PLUGIN_VERSION, g_sMap, g_cNeedFlow.IntValue, g_cNeedPath.IntValue,
				g_cAllowVisible.IntValue, g_cAhead.IntValue, g_cFallbackMax.FloatValue, g_cMin.FloatValue);
		}
		return;
	}

	// 第一次命中坏导航图：先存档（只存一次，之后所有坏导航图共用这份"原始值"）
	if (!g_bBnSnap)
	{
		g_iBnSnapI[0] = g_cNeedFlow.IntValue;
		g_iBnSnapI[1] = g_cNeedPath.IntValue;
		g_iBnSnapI[2] = g_cAllowVisible.IntValue;
		g_iBnSnapI[3] = g_cAhead.IntValue;
		g_fBnSnapF[0] = g_cFallbackMax.FloatValue;
		g_fBnSnapF[1] = g_cMin.FloatValue;
		g_bBnSnap = true;
	}

	g_cNeedFlow.SetInt(0);
	g_cNeedPath.SetInt(0);
	g_cAllowVisible.SetInt(1);
	g_cFallbackMax.SetFloat(0.0);
	g_cMin.SetFloat(100.0);
	g_cFlowLos.SetFloat(100000.0);
	g_cFlowNoLos.SetFloat(100000.0);
	g_cAhead.SetInt(0);

	// 【v1.45.0 · 服主 2026-10-05】只在这张图上把导演放出来，让**地图自带的按钮 / info_zombie_spawn /
	//   commentary_zombie_spawner（走导演人口实体 SpawnZombie）**也能出特感。
	// 为什么不能全局开：`director_no_specials 0` 会让导演在所有图上自己刷特感，与我们的直连刷特叠起来
	//   （我们 purge_foreign=0，不会踢掉它），场上数量/难度都会失控。
	// 可逆性同其它几项：server.cfg 每张图都会重新 exec（日志里有 basecommands 重设 cvar 的记录），
	//   所以换到别的图自然回到 1。
	ConVar cNoSpec = FindConVar("director_no_specials");
	if (cNoSpec != null && cNoSpec.IntValue != 0)
	{
		cNoSpec.SetInt(0);
		LogMessage("[SISpawn] v%s 地图=%s 坏导航图档：把 director_no_specials 1→0（只本图生效）—— 让这张图自带的训练按钮/人口实体也能出特感",
			PLUGIN_VERSION, g_sMap);
	}

	char sList[256];
	g_cBadNavMaps.GetString(sList, sizeof(sList));
	LogMessage("[SISpawn] v%s 地图=%s ★坏导航图档已套用（名单=%s）：needflow=0 needpath=0 允许可见点=1 保底不限距 min=100 flow上下限=1e5 身后限制=0，并豁免救援关闸门 —— 这张图的 .nav 是残片，不放宽这几条就一只都刷不出来",
		PLUGIN_VERSION, g_sMap, sList);
}

/** 当前地图名是否在坏导航图名单里（逗号分隔，大小写不敏感，允许两边留空格）。 */
bool IsBadNavMap(const char[] map)
{
	if (g_cBadNavMaps == null || map[0] == '\0')
		return false;

	char list[256];
	g_cBadNavMaps.GetString(list, sizeof(list));
	if (list[0] == '\0')
		return false;

	char parts[16][64];
	int n = ExplodeString(list, ",", parts, sizeof(parts), sizeof(parts[]));
	for (int i = 0; i < n; i++)
	{
		TrimString(parts[i]);
		if (parts[i][0] == '\0')
			continue;
		if (StrEqual(parts[i], map, false))
			return true;
	}
	return false;
}

public void OnMapEnd()
{
	PrintQualitySummary();
}

// ------------------------------------------------------------------ 突击脉冲（v1.32.0）

/** 【v1.32.0】挑一个"能下发客户端命令"的入口客户端。
 *
 *  CheatCommand() 需要一个客户端上下文（它内部按客户端命令执行）。
 *  参考实现里 asiai.sp 用的是特感自己、AI_HardSI.sp 用的是随机生还者 ——
 *  两种都能用，说明 nb_assault 本身是"服务器级"的，客户端只是执行入口。
 *  我们优先挑真人（最稳），没有真人再退到任意在场的假人。 */
int PickCommandClient()
{
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && !IsFakeClient(i))
			return i;
	}

	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i))
			return i;
	}

	return 0;
}

/** 【v1.32.0】定期给特感下发引擎命令 nb_assault。
 *
 *  为什么不能只靠 ltt_si_ai 改脚本值：
 *    ① ltt_si_ai 管的是"引擎问『要不要往生还者推进 / 要不要突击』时怎么回答"，
 *       属于【行为倾向】；
 *    ② nb_assault 是引擎自己的 NextBot 突击命令，属于【当场下令】。
 *       本服参考的两个成熟实现（asiai.sp：特感出生后 0.3 秒发一次；
 *       AI_HardSI.sp：从离开安全区起每 0.3 秒无限重复）都靠它把特感钉在进攻状态。
 *    ③ 服主反馈「特感放完技能就跑了」—— 那正是"倾向"之外的"当场退回去"，
 *       所以这一层单独补，与 ltt_si_ai 互补而不是替代。
 *
 *  实现要点：
 *    · 用官方原生 GetCommandFlags/SetCommandFlags 临时摘掉 nb_assault 的 FCVAR_CHEAT
 *      再以客户端身份 FakeClientCommand —— 抄的是 AI_HardSI.sp 的 BypassAndExecuteCommand。
 *      【注意】这仍然不是内存补丁：改的是 ConCommand 的旗标位，属于 SourceMod 官方 API。
 *    · ⚠ 不能抄 asiai.sp 的 `CheatCommand(client,"nb_assault")` —— 实测
 *      SourceMod 1.12.0.7253 的 console.inc 里【没有 CheatCommand 这个原生】
 *      （spcomp 直接 error 017: undefined symbol）。那个源文件在本机根本编译不过。
 *    · 场上没有存活特感就不发（空服/清场后不白跑）。
 *    · 日志只打第一条，不刷屏；累计条数在 sm_sispawn_status 里看。 */
public Action Timer_AssaultPulse(Handle timer)
{
	if (!g_cEnable.BoolValue || !g_cAssault.BoolValue)
		return Plugin_Continue;

	if (CountAliveSI() <= 0)
		return Plugin_Continue;

	int holder = PickCommandClient();
	if (holder <= 0)
		return Plugin_Continue;

	IssueAssault(holder);
	return Plugin_Continue;
}

/** 真正下发一次 nb_assault。失败/命令不存在都在这里显式记账（不静默）。 */
void IssueAssault(int holder)
{
	int flags = GetCommandFlags("nb_assault");
	if (flags == -1)
	{
		// 命令在本服不存在 → 自动关掉并说清楚原因，不留"开着但没用"的假象
		if (!g_bAssaultMissing)
		{
			g_bAssaultMissing = true;
			LogMessage("[SISpawn] 本服没有 nb_assault 这条命令 → 突击脉冲自动停用并把 ltt_sispawn_assault 置 0");
			g_cAssault.SetInt(0);
		}
		return;
	}

	if (!g_bAssaultLogged)
	{
		g_bAssaultLogged = true;
		LogMessage("[SISpawn] 突击脉冲开始下发 nb_assault（间隔 %.1f 秒，执行入口=#%d，原旗标=%d）—— 关：ltt_sispawn_assault 0",
			g_cAssaultGap.FloatValue, holder, flags);
	}

	SetCommandFlags("nb_assault", flags & ~FCVAR_CHEAT);
	FakeClientCommand(holder, "nb_assault");
	SetCommandFlags("nb_assault", flags);
	g_iAssaultSent++;
}

/** 开一波（或补员）。
 *  【v1.32.0】新增 forceCount：>0 时本波只排这么多只，而不是 GetEffWave()。
 *  补员模式用它"只补缺口"（场上 3 只、目标 4 只 ⇒ 只排 1 只），
 *  否则每次补员都排一整波，4 特就会变成 4+4=8，反而把"同时 4 只"搞成"同时 8 只"。
 *  仍然会被下面的 room（上限 − 场上 / 槽位）二次夹取，宁少不多。 */
void DoOneWave(int forceCount = -1)
{
	// 【v1.19.0】结算上一波（计划 vs 实刷）并把"放宽分散/窗口放大/被拒候选"计入本图累计。
	// 放在函数最开头、任何 return 之前 —— 否则"场上已满/没有目标"这两条 return 会漏结算。
	// 此刻 g_iLastSpawned 还是上一波的值（它在下面本波初始化时才清零）。
	if (g_iCurWavePlan > 0)
	{
		g_iTotWavePlan += g_iCurWavePlan;
		g_iTotWaveGot  += g_iLastSpawned;
		if (g_iLastSpawned >= g_iCurWavePlan)
			g_iTotWaveFull++;
		else
			g_iTotWaveShort++;
	}

	// 【v1.39.0 · 缺口顺延】结算上一波的**缺口**，累加进"欠账"，由下一波补上。
	//
	// 服主 2026-10-04 提出：「刷满率能不能抬一下？每波都漏特感难度也会降低」。
	// 数据：那把缺口 228 只，而失败原因里"因等满 3 秒放弃"只有 7 次 ⇒ 不是等不及，
	//   而是那一刻窗口内确实没有合格点（被 allow_visible=0 / needpath=1 两条硬闸门杀光）。
	//   所以加 tries/预算收益很小、放宽闸门又要牺牲质量 —— **唯一不牺牲质量的路就是"顺延"**：
	//   本波没刷出来的名额不丢，累加到下一波的计划里（仍受 room = 上限−场上 夹取）。
	// 口径：只在"真的要开一波"时结算（下面 return 的跳过路径不会结算），
	//   并用 g_bCarrySettled 保证同一波只结算一次（避免每 tick 重复累加）。
	if (g_cCarry.BoolValue && !g_bCarrySettled && g_iCurWavePlan > 0)
	{
		g_bCarrySettled = true;
		int short = g_iCurWavePlan - g_iLastSpawned;
		if (short > 0)
		{
			int capC = g_cCarryMax.IntValue;
			if (capC < 1) capC = 1;
			int before = g_iCarry;
			g_iCarry += short;
			if (g_iCarry > capC)
				g_iCarry = capC;                  // 防"场长期满 → 一次爆一大波"
			g_iTotCarryShort += short;
			if (g_iCarry > g_iCarryPeak)
				g_iCarryPeak = g_iCarry;
			if (LogNormal())
				LogMessage("[SISpawn] 缺口顺延：上一波计划 %d 实刷 %d → 欠 %d 只；累计欠账 %d→%d（上限 %d）",
					g_iCurWavePlan, g_iLastSpawned, short, before, g_iCarry, capC);
		}
	}
	g_iTotSpreadSkip  += g_iSpreadSkip;
	g_iTotSpreadRelax += g_iSpreadRelax;
	g_iTotWinGrow     += g_iWinGrow;

	SweepTracked();

	int alive = CountAliveSI();
	int cap   = GetEffCap();

	if (alive >= cap)
	{
		if (LogDetail())
			LogMessage("[SISpawn] 场上 %d 只，已达上限 %d，本波跳过", alive, cap);
		return;
	}

	// 【v1.8.2修订11】本波失败计数清零（自动方向据此切到"大空间优先"）
	g_iWaveFail = 0;

	int target = PickTarget();
	if (target <= 0)
	{
		if (LogDetail())
			LogMessage("[SISpawn] 没有可用的生还者目标，本波跳过");
		return;
	}

	// 【v1.8.2修订4 · 服主 2026-09-23 定稿】"刷到槽位上限就停止，没满就下一波补上"
	//
	// 为什么必须要这一步：原逻辑只在"场上特感数 >= cap"时跳过，
	// **完全没看客户端槽位**。而 26 特场景下槽位是被【生还者 + 特感 + 旁观者】一起吃的，
	// 槽位先于 cap 耗尽 → 队列每 tick 重试一次（10 次/秒）、每次重试都调
	// TrimToKeepFree(true) 踢一个假人，持续 3 秒才放弃。
	// 实测代价：**生成失败 434/千只 + 满员守卫踢人 555/千只**。
	// 现在提前按"真实可用槽位"夹一次性入队数量，槽位不够就不入队，交给下一波补。
	int room  = cap - alive;
	int slotRoom = MaxClients - GetClientCount(false) - KeepFreeSlots();
	if (slotRoom < room)
		room = slotRoom;

	if (room <= 0)
	{
		if (LogNormal())
			LogMessage("[SISpawn] 本波跳过：可用槽位不足（场上特感 %d/%d，客户端占用 %d/%d，需留空 %d）→ 等下一波补",
				alive, cap, GetClientCount(false), MaxClients, KeepFreeSlots());
		return;
	}

	// 【v1.32.0】补员模式会传 forceCount（只补缺口），普通波次传 -1 走每波数量
	int n = (forceCount > 0) ? forceCount : GetEffWave();
	int nBase = n;                                   // 【v1.39.0】本波"基础每波数"（不含欠账）

	// 【v1.39.0 · 缺口顺延】把累计欠账加进本波计划（仍受 room 夹取；没夹到的留在欠账里）。
	// 【v1.40.0】carry_step>0 时每波只认领这么多，剩下的留给后面的波（分波消化，避免挤成一个大波）。
	if (g_cCarry.BoolValue && forceCount <= 0 && g_iCarry > 0)
	{
		int add = g_iCarry;
		int step = g_cCarryStep.IntValue;
		if (step > 0 && add > step)
		{
			add = step;
			g_iCarryStepped += (g_iCarry - step);
		}
		n += add;
	}

	if (n > room)
		n = room;

	int claimed = n - nBase;                          // 本波真正认领到的欠账数
	if (claimed > 0)
	{
		if (claimed > g_iCarry)
			claimed = g_iCarry;
		g_iCarry -= claimed;
		g_iTotCarryUsed += claimed;
		if (LogNormal())
			LogMessage("[SISpawn] 缺口顺延：本波计划 %d = 每波 %d + 补欠账 %d（补后仍欠 %d）",
				n, nBase, claimed, g_iCarry);
	}
	else if (g_iCarry > 0 && n >= room && LogNormal())
	{
		LogMessage("[SISpawn] 缺口顺延：本波已被上限夹满（room=%d），欠账 %d 只留到下一波", room, g_iCarry);
	}

	g_bCarrySettled = false;   // 【v1.39.0】本波尚未结算，等下一波开头结算它
	g_iCurWavePlan = n;      // 【v1.19.0】记下本波计划数量，下一波开头结算进本图累计

	// 【v1.8.2 方向A/B】结算上一波的落点分散情况，然后重开本波的落点记忆。
	// 放在这里而不是波次结束时：队列是跨 tick 异步抽干的，这里才是"上一波真的结束了"。
	if (g_iSpreadSkip > 0 || g_iSpreadRelax > 0 || g_iWinGrow > 0)
	{
		if (LogNormal())
			LogMessage("[SISpawn] 上一波落点分散：因『离已用落点太近』被拒 %d 个候选 | 放宽分散 %d 次 | 窗口放大 %d 次",
				g_iSpreadSkip, g_iSpreadRelax, g_iWinGrow);
	}
	// 【v1.8.2修订8 / v1.18.0 改写】可见档使用情况 —— 直接量"用距离换隐蔽"的代价。
	// 原来这里读 g_iFarUsed，而那个变量全文零自增点、零清零点，恒为 0；
	// 档位收敛成两档之后"远档"已不存在，改为统计【可见档被选中的次数】。
	if (g_iVisibleUsed > 0 || g_iNarrowCount > 0 || g_iBornSolid > 0 || g_iBornOutside > 0
		|| g_iTotFindN > 0)
	{
		// 【v1.32.1】补员模式把"每波汇总"变成"每次补员汇总"：
		//   2026-10-03 03:01 线上实测（4 个真人 + 补员模式 1）：补员每 1.5~3 秒触发一次，
		//   于是这几行"累计/峰值"跟着每 1.5 秒打一遍（那一段日志被刷爆）。
		//   这几行都是【本图累计】值，本来就只该偶尔看一眼 ⇒ 补员模式下加 30 秒节流。
		//   正常模式（每 time 秒一整波）保持原样，一行都不少，不动他现有的审计口径。
		bool bSum = true;
		if (g_cRefill.IntValue > 0)
		{
			float nowSum = GetGameTime();
			if (nowSum - g_flLastSummary < 30.0)
				bSum = false;
			else
				g_flLastSummary = nowSum;
		}

		if (!bSum)
		{
			// 被节流：跳过下面整段汇总（行为一行不改，只是不打日志）
		}
		else if (LogNormal())
			LogMessage("[SISpawn] v%s 累计：可见档落点 %d 次（allow_visible=%d，该开关为 0 时此处应趋近 0）| 地形偏窄(候选区不足) %d 次 | 【v1.18.3】出生在实心几何 %d 次 | 出生在世界外 %d 次", PLUGIN_VERSION,
				g_iVisibleUsed, g_cAllowVisible.IntValue, g_iNarrowCount,
				g_iBornSolid, g_iBornOutside);

		// 【v1.18.9 · 找位拆分累计】这是决定"优化扫描还是优化评估"的那一行。
		// 用累计而不是单次，是因为 GetEngineTime() 单次差值的量化误差在十几毫秒上占比不小。
		// 失败次数单独列出来 —— v1.18.9 之前失败路径完全没被量过。
		// ⚠【v1.18.10 修单位】下面所有量都是【秒】，必须 ×1000 才是 ms。
		//   v1.18.9 漏了这个 ×1000，日志出现 `n=225 … 总计 1 ms … 平均每只 0.00 ms`
		//   这种一眼假的数据（比例是对的，绝对值小 1000 倍）。
		if (bSum && LogNormal() && g_iTotFindN > 0)
		{
			float tot  = g_fTotFindSec;
			float rest = tot - g_fTotScanSec - g_fTotEvalSec;
			LogMessage("[SISpawn] v%s 找位拆分累计：n=%d（其中失败 %d）｜总计 %.0f ms｜扫描 %.0f ms（%.1f%%）｜评估 %.0f ms（%.1f%%）｜其余 %.0f ms（%.1f%%）｜平均每只 %.2f ms", PLUGIN_VERSION,
				g_iTotFindN, g_iTotFindFail, tot * 1000.0,
				g_fTotScanSec * 1000.0, tot > 0.0 ? 100.0 * g_fTotScanSec / tot : 0.0,
				g_fTotEvalSec * 1000.0, tot > 0.0 ? 100.0 * g_fTotEvalSec / tot : 0.0,
				rest * 1000.0,          tot > 0.0 ? 100.0 * rest           / tot : 0.0,
				tot * 1000.0 / float(g_iTotFindN));

			// 【v1.18.11】把"其余"再拆开。
			// ⚠⚠【v1.18.11 上线后实测到的 BUG，v1.18.12 修】⚠⚠
			//   线上真数据：`引擎路径 2737ms(36.1%)｜自建导航 4429ms(58.4%)｜仍未归类 -4004ms(-52.8%)`
			//   —— **"仍未归类"是负数**，一眼就是错的。原因：
			//   `FindSpawnPosByNav()` 内部【就是】调 `BuildNavCand` 和 `TryNavSpot`，
			//   所以 `g_fTotNavSec` 与 `g_fTotScanSec + g_fTotEvalSec` **是同一段时间，重复计量**。
			//   实测印证：自建导航 4429 ms ≈ 扫描 1635 + 评估 2833 = 4468 ms（差 1%）。
			//   ⇒ **"自建导航"不能从"其余"里再扣一次**，只能当"它=扫描+评估的另一种口径"来读。
			//   正确的分解（三段互不重叠）：
			//     总计 = 扫描 + 评估 + 引擎路径 + 真正没归类的
			//     即 其余(3192) = 引擎路径(2737) + 未归类(455)
			float unaccounted = rest - g_fTotEngSec;
			LogMessage("[SISpawn] v%s 其余拆分累计：总计 %.0f ms = 扫描 %.0f + 评估 %.0f + 引擎路径 %.0f + 未归类 %.0f ms｜自建导航 %.0f ms（= 扫描+评估 的另一种口径，不参与相加）", PLUGIN_VERSION,
				tot * 1000.0, g_fTotScanSec * 1000.0, g_fTotEvalSec * 1000.0,
				g_fTotEngSec * 1000.0, unaccounted * 1000.0, g_fTotNavSec * 1000.0);

			// 【v1.18.13】峰值两行 —— 这才是"贵帧"的直接证据
			// （平均值看不到极值；sv 忽低就是被偶发极值带偏的）
			LogMessage("[SISpawn] v%s Timer_Tick 峰值：单次最大 %.1f ms（第 %d 波，客户端 %d，本次处理 %d 只）｜平均 %.2f ms｜>=10ms %d 次｜>=20ms %d 次｜>=30ms %d 次（共 %d 次 tick）", PLUGIN_VERSION,
				g_fTickPeakSec * 1000.0, g_iTickPeakWave, g_iTickPeakClients, g_iTickPeakSI,
				g_iTickCount > 0 ? g_fTickSumSec * 1000.0 / float(g_iTickCount) : 0.0,
				g_iTickOver10, g_iTickOver20, g_iTickOver30, g_iTickCount);

			LogMessage("[SISpawn] v%s 找位峰值：单次最大 %.1f ms（第 %d 波%s）｜其中 扫描 %.1f + 评估 %.1f + 引擎路径 %.1f + 自建导航合计 %.1f ms", PLUGIN_VERSION,
				g_fFindPeakSec * 1000.0, g_iFindPeakWave, g_bFindPeakFail ? "·失败" : "",
				g_fFindPeakScanMs, g_fFindPeakEvalMs, g_fFindPeakEngMs, g_fFindPeakNavMs);
		}
	}
	ResetWavePositions();

	// 【v1.49.11】调试：上一波结果（此刻 g_iCurWavePlan / g_iLastSpawned 还是上一波的）
	if (g_cDbg.IntValue >= 1 && g_iCurWavePlan > 0)
		PrintToChatAll("\x01[\x05刷特调试\x01] 第 \x04%d\x01 波：计划 \x04%d\x01 实刷 \x05%d\x01 %s｜欠账 \x05%d\x01",
			g_iWaveNo, g_iCurWavePlan, g_iLastSpawned,
			(g_iLastSpawned < g_iCurWavePlan) ? "缺" : "满", g_iCarry);

	g_iWaveNo++;
	g_iTarget   = target;
	g_iQueueLen = 0;
	g_iQueuePos = 0;
	g_iStallTicks = 0;
	g_iLastSpawned = 0;
	g_iLastFailed  = 0;

	for (int i = 0; i < n; i++)
	{
		int c = PickClass();
		if (c <= 0)
			break;
		g_iQueue[g_iQueueLen++] = c;
	}

	if (g_iQueueLen == 0)
	{
		LogMessage("[SISpawn] 本波没有可用职业（检查 ltt_sispawn_classes）");
		return;
	}

	if (LogNormal())
		LogMessage("[SISpawn] 第 %d 波开始：挡位=%d 目标=%N 场上=%d/%d 本波=%d 只",
			g_iWaveNo, g_cMode.IntValue, target, alive, cap, g_iQueueLen);

	// 【v1.49.11】调试：本波开始
	if (g_cDbg.IntValue >= 1)
		PrintToChatAll("\x01[\x05刷特调试\x01] 第 \x04%d\x01 波开始：计划 \x04%d\x01 场上 \x05%d/%d\x01",
			g_iWaveNo, g_iQueueLen, alive, cap);

	LogRoster();
}

int PickTarget()
{
	int best = L4D_GetHighestFlowSurvivor();
	if (best > 0 && IsClientInGame(best) && IsPlayerAlive(best) && GetClientTeam(best) == TEAM_SURVIVOR)
		return best;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && IsPlayerAlive(i) && GetClientTeam(i) == TEAM_SURVIVOR)
			return i;
	}
	return -1;
}

int PickClass()
{
	// 【v1.48.0】手动点单：`sm_sispawn_class` 期间只认指定职业（其它逻辑一律跳过）。
	//   为什么要在这里短路：职业上限/均衡/允许列表都是给"自动波次"用的，管理员想练某个职业时
	//   不该被"这类到顶了"挡掉（他要的就是连着来几只牛）。用完 QueueBurst 会立刻还原。
	if (g_iForceClass >= 1 && g_iForceClass <= MAX_CLASS)
		return g_iForceClass;

	// 【v1.7.0】统计"场上有多少 + 队列里已经排了多少"，按职业分开。
	// 必须把队列算进去：建队列时特感还没生成，只看场上会导致一整波全挑同一个职业。
	int tally[MAX_CLASS + 1];
	for (int i = 0; i <= MAX_CLASS; i++)
		tally[i] = 0;

	// 场上存活的
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_INFECTED || !IsPlayerAlive(i))
			continue;
		int cls = GetEntProp(i, Prop_Send, "m_zombieClass");
		if (cls >= 1 && cls <= MAX_CLASS)
			tally[cls]++;
	}

	// 队列里还没生成的
	for (int k = g_iQueuePos; k < g_iQueueLen; k++)
	{
		int c = g_iQueue[k];
		if (c >= 1 && c <= MAX_CLASS)
			tally[c]++;
	}

	// 当前生效的每种上限（坦克期间用坦克那套）
	bool bTank = IsTankAlive();
	int  limit[MAX_CLASS + 1];
	for (int c = 0; c <= MAX_CLASS; c++)
		limit[c] = (bTank && g_cTankAction.BoolValue) ? g_iTankLimit[c] : g_iClassLimit[c];

	// 先按硬上限筛一遍可用职业
	int pool[MAX_CLASS + 1];
	int n = 0;
	int fewest = 9999;

	for (int c = 1; c <= MAX_CLASS; c++)
	{
		if (!g_bClassAllowed[c])
			continue;
		if (limit[c] > 0 && tally[c] >= limit[c])
			continue;                    // 这一类到顶了
		if (tally[c] < fewest)
			fewest = tally[c];
		n++;
	}

	if (n == 0)
		return -1;                       // 所有允许的职业都被硬上限卡住了

	// 自动均衡：只从"数量最少"的那几类里随机（并列的都有机会）
	int m = 0;
	for (int c = 1; c <= MAX_CLASS; c++)
	{
		if (!g_bClassAllowed[c])
			continue;
		if (limit[c] > 0 && tally[c] >= limit[c])
			continue;
		if (!g_cBalance.BoolValue || tally[c] == fewest)
			pool[m++] = c;
	}

	if (m == 0)
		return -1;
	return pool[GetRandomInt(0, m - 1)];
}

/** 场上是否有存活的坦克（职业 8）。用于坦克期间切换刷特参数。 */
bool IsTankAlive()
{
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || !IsPlayerAlive(i) || GetClientTeam(i) != TEAM_INFECTED)
			continue;
		if (GetEntProp(i, Prop_Send, "m_zombieClass") == 8)
			return true;
	}
	return false;
}

// ------------------------------------------------------------------ 生成

/** 生成一只。返回 false 表示"因为槽位没了而没放下"，调用方应该下一 tick 重试。 */
/** 【v1.18.9】把一次找位计入累计，并在超阈值时打一条【找位耗时】拆分行。
 *
 *  为什么成功和失败都要调：v1.18.9 之前，失败路径在 	Find` 结算【之前】就 return 了，
 *  也就是说"失败的找位耗时从来没被量过" —— 而失败正是会被每 0.1 秒反复重试的那批
 *  （「进入等待队列」日志 3730 条 vs 成功的耗时日志 3086 条）。不覆盖失败就等于漏掉主因。
 *
 *  为什么要累计而不是只看单次：GetEngineTime() 是 float 秒，单次十几毫秒的差值
 *  量化误差相对不小；累加到大数后相对误差可忽略 ⇒「扫描 vs 评估」的比例才可信。
 *  累计值由每图末的 `v1.18.0 累计` 行打印（不按波重置，与既有累计口径一致）。
 *
 *  "其余" = 找位总耗时里既不属于 BuildNavCand 也不属于 TryNavSpot 的部分，
 *  主要是【引擎路径】(L4D_GetRandomPZSpawnPosition × tries) 和保底/降级路径。
 */
void AccumFindCost(float tFind, bool bFail)
{
	g_fTotScanSec   += g_fFindScanSec;
	g_fTotEvalSec   += g_fFindEvalSec;
	g_fTotEngSec    += g_fFindEngineSec;   // 【v1.18.11】把"其余"拆开
	g_fTotNavSec    += g_fFindNavSec;      // 【v1.18.11】
	g_fTotFindSec += tFind;
	g_iTotFindN++;
	if (bFail)
		g_iTotFindFail++;

	// 【v1.18.13 · 只加计量】单次找位的历史最大值 + 那一次的组成。
	// 为什么需要：v1.18.10/11 只有【平均】和"超阈值单次"两类数据，而"贵帧"是由
	// 【偶发的单次极值】造成的（实测单次最高 38.6 ms，而平均只有 4.4 ms）。
	// 平均值永远看不到极值，所以必须单独记一个"历史最大"。
	// 这里是最合适的唯一测量点：成功和失败两条路径都会走到 AccumFindCost，
	// 而且此刻 g_fFindScanSec/EvalSec/EngineSec/NavSec 还是【本次】的累计值
	// （它们由 SpawnOne 在每次找位前清零，下一次找位才会被覆盖）。
	if (tFind > g_fFindPeakSec)
	{
		g_fFindPeakSec    = tFind;
		g_iFindPeakWave   = g_iWaveNo;
		g_bFindPeakFail   = bFail;
		g_fFindPeakScanMs = g_fFindScanSec   * 1000.0;
		g_fFindPeakEvalMs = g_fFindEvalSec   * 1000.0;
		g_fFindPeakEngMs  = g_fFindEngineSec * 1000.0;
		g_fFindPeakNavMs  = g_fFindNavSec    * 1000.0;
	}

	if (g_cCostLog.IntValue <= 0)
		return;

	float limit = float(g_cCostLog.IntValue) / 1000.0;
	if (tFind < limit)
		return;

	LogMessage("[SISpawn] 找位耗时%s：总计 %.1f ms = 扫描 %.1f + 评估 %.1f + 其余 %.1f（导航区 %d｜tries=%d）",
		bFail ? "(失败)" : "", tFind * 1000.0,
		g_fFindScanSec * 1000.0, g_fFindEvalSec * 1000.0,
		(tFind - g_fFindScanSec - g_fFindEvalSec) * 1000.0,
		g_iNavCount, g_cTries.IntValue);
}

/** 【v1.27.0】读 configs/ltt_si_spawner_blacklist.cfg。格式（一行一个盒，逗号分隔）：
 *     地图名,x1,y1,z1,x2,y2,z2
 *  例： bdp_bunker04,150,-1650,20,1300,-100,250
 *  只加载当前地图的盒；`//` 或 `#` 开头为注释；文件不存在 = 没有黑名单。
 *  为什么用坐标盒：保底点按设计不看路径（宁可刷出来也别断供），只能靠"这块区域不许刷"兜底。
 */
void LoadBlacklist()
{
	g_iBlackCount = 0;
	// 现取当前地图名：热重载时 SourceMod 不会重放 OnMapStart，g_sMap 可能还是空的
	char sCur[64];
	GetCurrentMap(sCur, sizeof(sCur));
	if (!sCur[0])
		return;
	char sPath[PLATFORM_MAX_PATH];
	BuildPath(Path_SM, sPath, sizeof(sPath), "configs/ltt_si_spawner_blacklist.cfg");
	File f = OpenFile(sPath, "r");
	if (f == null)
		return;

	char sLine[256];
	while (!f.EndOfFile() && f.ReadLine(sLine, sizeof(sLine)))
	{
		TrimString(sLine);
		if (!sLine[0] || sLine[0] == '/' || sLine[0] == '#')
			continue;

		char p[7][32];
		if (ExplodeString(sLine, ",", p, 7, 32) != 7)
			continue;
		TrimString(p[0]);
		if (!StrEqual(p[0], sCur))
			continue;
		if (g_iBlackCount >= MAX_BLACKBOX)
			break;

		float a[6];
		for (int i = 0; i < 6; i++)
			a[i] = StringToFloat(p[i + 1]);

		// 排成 min/max，写配置时不必在意先后
		g_fBlackBox[g_iBlackCount][0] = (a[0] < a[3]) ? a[0] : a[3];
		g_fBlackBox[g_iBlackCount][3] = (a[0] < a[3]) ? a[3] : a[0];
		g_fBlackBox[g_iBlackCount][1] = (a[1] < a[4]) ? a[1] : a[4];
		g_fBlackBox[g_iBlackCount][4] = (a[1] < a[4]) ? a[4] : a[1];
		g_fBlackBox[g_iBlackCount][2] = (a[2] < a[5]) ? a[2] : a[5];
		g_fBlackBox[g_iBlackCount][5] = (a[2] < a[5]) ? a[5] : a[2];
		g_iBlackCount++;
	}
	delete f;

	if (g_iBlackCount > 0)
		LogMessage("[SISpawn] v%s 本图黑名单盒 %d 个（configs/ltt_si_spawner_blacklist.cfg）",
			PLUGIN_VERSION, g_iBlackCount);
}

/** 命中任一黑名单盒 → 这个落点不许用 */
bool IsBlacklisted(const float pos[3])
{
	for (int i = 0; i < g_iBlackCount; i++)
	{
		if (pos[0] >= g_fBlackBox[i][0] && pos[0] <= g_fBlackBox[i][3]
		 && pos[1] >= g_fBlackBox[i][1] && pos[1] <= g_fBlackBox[i][4]
		 && pos[2] >= g_fBlackBox[i][2] && pos[2] <= g_fBlackBox[i][5])
			return true;
	}
	return false;
}

bool SpawnOne(int zclass)
{
	// 【v1.8.2修订10 · 炸服修复 第二半】踢人之后必须等引擎真的把槽位收回，
	// 不能在同一个 tick 里"踢完就建"。
	//
	// 2026-09-24 12:45:51 崩溃日志的最后两行就是：
	//     回收死亡特感假人 2 个，客户端占用 26/32
	//     Segmentation fault
	// 而 Timer_Tick 的顺序是 `RecycleDeadSI()`（踢）→ 紧接着抽队列（建），
	// **同一个 tick 内完成**。KickClient 是异步的：槽位还没释放，
	// NextBotCreatePlayerBot 就在同一个槽位上建新客户端 —— 引擎在这种
	// "边销毁边创建"的状态下会段错误。
	//
	// 这里只是把创建推迟 0.5 秒（5 个 tick），对刷特节奏毫无影响，
	// 但把这条竞态彻底掐掉。注意用独立标记返回：这是"等一下"，
	// 不是"失败"，队列抽干逻辑不能因此取消整波。
	//
	// 【v1.9.0 · 两道保险，都是被 18:23 那次卡死逼出来的】
	//  ① 用 `GetEngineTime()`（换图不重置）。用 GetGameTime() 会在换图后
	//     把旧时间戳变成"很远的未来"，冷却永不解除 → 整局不刷特感。
	//  ② 脏数据兜底：一个超过 5 秒的"未来"时间戳不可能是真的冷却，
	//     直接清掉。万一时间基准又出什么幺蛾子，这条能自愈。
	//  ③ 打日志（节流）：那次卡死就是因为这里【静默 return false】，
	//     30 个 tick 一条日志都没有，只能靠排除法猜。静默失败代价最高。
	float now = GetEngineTime();

	if (g_flNoSpawnUntil - now > 5.0)
	{
		if (LogNormal())
			LogMessage("[SISpawn] 检测到异常的踢人冷却时间戳（%.1f 秒后，远超 0.5 秒）→ 判定为脏数据，已清除",
				g_flNoSpawnUntil - now);
		g_flNoSpawnUntil = 0.0;
	}

	if (now < g_flNoSpawnUntil)
	{
		g_bSpawnCooldown = true;
		if (!g_bCooldownLogged && LogNormal())
		{
			g_bCooldownLogged = true;
			LogMessage("[SISpawn] 踢人冷却中（剩 %.1f 秒）→ 本 tick 不生成，下一 tick 再试", g_flNoSpawnUntil - now);
		}
		return false;
	}

	// 【v1.28.0】本 tick 的找位预算用完 → 这次不生成，下一 tick 再试（不丢特感）
	if (TickBudgetUp())
	{
		if (LogNormal())
			LogMessage("[SISpawn] 本 tick 找位预算已用完（已花 %.1f ms / 上限 %.0f ms）→ 暂停生成本 tick，下一 tick 继续",
				g_flTickWorkMs, g_cTickBudget.FloatValue);
		return false;
	}

	int target = g_iTarget;
	if (target <= 0 || !IsClientInGame(target) || !IsPlayerAlive(target))
	{
		target = PickTarget();
		g_iTarget = target;
	}
	if (target <= 0)
		return true;   // 没有目标 → 丢掉这一只，别把队列卡死

	float pos[3], ang[3];
	ang[0] = 0.0; ang[1] = 0.0; ang[2] = 0.0;

	// 【v1.7.1 埋点】分别量"找落点"和"造客户端"两段的耗时。
	// 起因：服主实测 8特10秒 时真实 tick 掉到 95，而 26 特满员不动时是 99~100。
	// 差异不在特感数量，怀疑在"每 10 秒重建一批假人客户端"这条 churn 路径上。
	// 这两段是唯一可能贵的地方，量出来就知道该优化哪一边：
	//   找位段 = L4D_GetRandomPZSpawnPosition × tries + 导航流查询
	//   生成段 = CreateFakeClient/SDKCall + InitSpecial 的一串 SetEntProp + DispatchSpawn
	float tFindStart = GetEngineTime();
	// 【v1.18.9】本次找位的两段计时清零（BuildNavCand / TryNavSpot 各自往里累加）
	g_fFindScanSec = 0.0;
	g_fFindEvalSec = 0.0;
	// 【v1.18.11】"其余"的两段也要清零
	g_fFindEngineSec = 0.0;
	g_fFindNavSec    = 0.0;

	if (!FindSpawnPos(target, zclass, pos))
	{
		g_iLastFailed++;
		g_iWaveFail++;          // 【修订11】找不到落点也算本波失败（自动方向据此切"大空间优先"）

		// 【v1.18.9】失败路径原来在 	Find` 结算【之前】就 return —— 等于失败的找位耗时
		// 从来没被量过。而失败正是"每 0.1 秒重试"的那批，不量它就等于漏掉主因。
		// 【v1.29.0 · 审核修复】失败也要记"本 tick 预算"，不能只记累计。
		// 理由同 v1.28.7 修的黑名单那条：不涨 g_flTickWorkMs ⇒ TickBudgetUp() 永远为假
		// ⇒ "候选荒 → 每 0.1 秒重试一次完整找位"这条【最贵】的路径完全不受 tickbudget 约束。
		float tFail = GetEngineTime() - tFindStart;
		NoteSearchCost(tFail * 1000.0);
		AccumFindCost(tFail, true);

		// 【v1.10.2】两种失败要分开处理（服主定稿）：
		//   · 位置不合格（可见/太近/太远被判据拒掉）→ 【等待队列】：
		//     return false，队列下一 tick(0.1 秒) 重试，一旦有合格位置立刻刷。
		//     连续 3 秒等不到才放弃本波剩余（复用已有的 stall 保护）。
		//   · 真的找不到落点（候选池根本没有合法点）→ 丢掉这一只，return true，
		//     不影响本波其余特感（这才是原来的行为）。
		if (g_bPosWait)
		{
			if (LogNormal())
				LogMessage("[SISpawn] %s 目前没有合格落点 → 进入等待队列（每 0.1 秒重试，找到立刻刷）", g_sClassName[zclass]);
			return false;
		}

		if (LogNormal())
			LogMessage("[SISpawn] %s 找不到落点，本只放弃（可调大 tries 或放宽距离区间）", g_sClassName[zclass]);
		return true;   // 这是落点问题，守卫帮不上忙，丢掉别重试
	}

	// 【v1.27.0】黑名单盒：命中就当作"这一只暂时没合格落点"→ 进等待队列换点，
	// 而不是刷进电梯井这类地方（保底点不看路径，只能用坐标盒兜）。
	if (IsBlacklisted(pos))
	{
		// 【v1.28.7 · 2026-10-02 源码审核修复】丢弃也要进"找位耗时"账本。
		// 旧代码在这里直接 return false（=进重试队列，队列位置不前进），而两行记账
		// （NoteSearchCost / AccumFindCost）在它【后面】⇒ 这条重试路径完全不受
		// v1.28.0 的每 tick 找位预算约束：每次重试都是完整的 tries + 扩窗找位，
		// g_flTickWorkMs 却一点都不涨。命中黑名单盒的图（如 bdp_bunker04 电梯井）会因此出现
		// "预算显示很闲、实际每 0.3 秒做一次重活"的账实不符。
		// ⚠ 故意【不】补 g_iWaveFail / g_iLastFailed：那两个计数器驱动"自动方向切大空间优先"，
		//   补它们等于改刷特落点行为；本次只做计量与日志，行为保持原样。
		float tBlack = GetEngineTime() - tFindStart;
		NoteSearchCost(tBlack * 1000.0);
		AccumFindCost(tBlack, true);
		// 丢点属于"长期跑图必须能事后归因"的事件，不受 debug 级别限制（与生成失败同类）。
		LogMessage("[SISpawn] 地图=%s %s 落点 %.0f,%.0f,%.0f 命中【黑名单盒】→ 丢弃换点（本图 %d 个盒）",
			g_sMap, g_sClassName[zclass], pos[0], pos[1], pos[2], g_iBlackCount);
		return false;
	}

	float tFind = GetEngineTime() - tFindStart;
	NoteSearchCost(tFind * 1000.0);   // 【v1.28.0】把这次找位的耗时记进本 tick 预算
	AccumFindCost(tFind, false);   // 【v1.18.9】累计 + 超阈值时打「找位耗时」拆分行
	float tSpawnStart = GetEngineTime();

	// 两条路：
	//   method=1 直连：NextBotCreatePlayerBot 造个假人客户端再手工初始化成感染者。
	//                 完全绕开僵尸管理器的预建池，实测 4 生还者能同时存在 14 只。
	//   method=0 原生：L4D2_SpawnSpecial → ZombieManager::SpawnSpecial。
	//                 原文写"受预建池限制，最多 MaxClients/2 = 9 只" —— 该结论
	//                 2026-09-23 已被推翻（那个 9 是我们自己在 GetEffCap() 里卡的，
	//                 不是引擎的），原生路线的上限同样是"槽位数 − 生还者 − 留空"。
	int zombie = -1;
	bool bDirect = (g_cMethod.IntValue == 1 && g_bDirectReady && g_hBot[zclass] != null);

	// 【v1.8.2修订11 · 参考实现】真正生成时用的坐标：抬高 5 单位，避开地面/台阶。
	// 单独用一个 spawnPos，不动 pos —— pos 还要写 POS 日志和落点记忆，
	// 保持日志里的坐标是"导航点原坐标"，分析口径不变。
	float spawnPos[3];
	spawnPos[0] = pos[0];
	spawnPos[1] = pos[1];
	spawnPos[2] = pos[2] + (g_cCrouch.BoolValue ? 5.0 : 0.0);

	// 【v1.8.2修订11】只在"真正调生成"的这一小段窗口里给引擎方向偏好。
	// PreferredSpecialDirection 是导演的全局脚本值，窗口外必须放掉。
	g_iPreferredDir = ResolvePreferredDir();
	g_bInSpawnTime  = true;

	if (bDirect)
	{
		zombie = SDKCall(g_hBot[zclass], g_sClassName[zclass]);
		// 【v1.29.0 · 2026-10-02 深度审核修复】刚创建的假人也要先校验"真在游戏里、而且是假人"。
		// 原来只判 1..MaxClients 就直接 InitSpecial（里面是 ChangeClientTeam / SetEntProp）：
		// 槽位还没 in game、或极端情况下拿到真人槽时，这些 native 会抛异常/把真人改成感染者。
		if (zombie > 0 && zombie <= MaxClients && IsClientInGame(zombie) && IsFakeClient(zombie))
			InitSpecial(zombie, zclass, spawnPos, ang);
		else if (zombie > 0 && zombie <= MaxClients)
		{
			if (LogNormal())
				LogMessage("[SISpawn] 地图=%s 直连生成校验不过：槽位 #%d 在游戏=%d 假人=%d → 放弃本次",
					g_sMap, zombie, IsClientInGame(zombie) ? 1 : 0, IsFakeClient(zombie) ? 1 : 0);
			zombie = 0;
		}
	}
	else
	{
		// 【关键】必须先立重入标志！
		// L4D2_SpawnSpecial 内部调用的就是 ZombieManager::SpawnSpecial，
		// 与 L4D_OnSpawnSpecial 拦截的是同一个函数。不立标志的话，
		// 下面这行会被本插件自己的拦截钩子挡掉，原生直接返回 0（实测踩过）。
		g_bOwnSpawn = true;
		zombie = L4D2_SpawnSpecial(zclass, spawnPos, ang);
		g_bOwnSpawn = false;
	}

	g_bInSpawnTime = false;
	g_iPreferredDir = -1;

	// 判定生成是否真的成功，必须同时满足三条：
	//   · 返回值 > 0
	//   · 该槽位有客户端（IsClientInGame）
	//   · 该槽位确实被分配成了存活的感染者（team=3 且 alive）
	// 只查 IsClientInGame 是不够的：槽位不够时 L4D2_SpawnSpecial 会返回一个
	// 【存在但未被分配的】槽位（team=1 alive=0），实测表现为日志里一堆
	// "已刷 X (#17) team=1 alive=0"，看起来成功其实没刷出来。
	// 【防御 v1.6.2】zombie 是引擎/原生返回的槽位号，必须先卡范围再喂给 IsClientInGame。
	// 实测 2026-09-23 03:30：`sv_setmax` 在运行时从 18 改成 31 的那一刻，引擎已经能造出
	// 槽位 19/20，而 SourceMod 那边 MaxClients 还停在 18 → IsClientInGame(19) 直接抛
	// "Client index 19 is invalid"。当天全服 7401 条这类异常，我们插件自己贡献 309 条。
	// 根因是"运行时改 MaxClients"（必须写进启动项 + 重启才干净），但边界检查本身也该有。
	if (zombie < 1 || zombie > MaxClients || !IsClientInGame(zombie)
		|| GetClientTeam(zombie) != TEAM_INFECTED || !IsPlayerAlive(zombie))
	{
		g_iLastFailed++;
		g_iWaveFail++;          // 【修订11】本波失败次数（自动方向据此切"大空间优先"）

		// 【v1.8.2修订4】置"槽位已满"标志，让队列抽干逻辑决定是重试还是收手。
		// 服主要的行为是：**槽位满就停止本波，未满的下一波补上** ——
		// 而不是像以前那样每 tick 重试（10 次/秒）× 3 秒，每次都踢一个假人。
		g_bSlotFull = true;

		// 立刻触发一次满员守卫（不等 0.5 秒轮询）。踢人是异步的，
		// 槽位要下一帧才真正释放。是否重试由调用方按 ltt_sispawn_slotstop 决定。
		int freed = TrimToKeepFree(true);

		// 生成失败是异常，任何日志级别都要记（不受 ltt_sispawn_debug 影响）
		int dbgTeam  = -1;
		int dbgAlive = -1;
		if (zombie > 0 && zombie <= MaxClients && IsClientInGame(zombie))
		{
			dbgTeam  = GetClientTeam(zombie);
			dbgAlive = IsPlayerAlive(zombie) ? 1 : 0;
		}

		LogMessage("[SISpawn] %s 生成失败（返回槽位 #%d，team=%d alive=%d，方式=%s）→ 客户端槽位已耗尽（占用 %d/%d，存活特感 %d/%d），满员守卫腾位=%d",
			g_sClassName[zclass], zombie, dbgTeam, dbgAlive, bDirect ? "直连" : "原生",
			GetClientCount(false), MaxClients, CountAliveSI(), GetEffCap(), freed);

		return false;   // 调用方按 g_bSlotFull + ltt_sispawn_slotstop 决定重试还是收手
	}

	g_iLastSpawned++;

	// 【修订11】原生方式（L4D2_SpawnSpecial）也要蹲着出生
	if (!bDirect)
		ApplySpawnTweaks(zombie);

	// 【v1.8.2 方向E】落点质量日志（默认关）。两个关键字段：
	//   · 间距 = 与"当前存活特感 + 本波已用落点"的【最小】距离。
	//     【v1.8.2修订2 起含义变了】不再只是"本波内"的间距，而是【跨波】的 ——
	//     因为参照系换成了"当前存活的所有特感"，这才是玩家真正看到的彼此距离。
	//     这个值是"扎堆"的直接度量：一个点挤十几只 → 会有一大片接近 0。
	//   · 可见 = 落点当下是否被任一存活生还者看得见。这是"凭空刷"的直接度量，
	//     按 来源=引擎 / 来源=自建 分开统计，就能回答"哪条路径在凭空刷"。
	// 必须在 RememberSpawnPos 之前取"间距"，否则会拿自己跟自己比（恒为 0）。
	// 【v1.49.6】档位 >0 才做落点日志（同时负责累计每图汇总用的统计量）
	if (g_cPosLog.IntValue > 0)
	{
		float sep    = MinDistToUsed(pos);
		int   vis    = IsSpotVisible(pos) ? 1 : 0;
		// 【v1.19.0】落点质量累计（每图末汇总用）—— sep/vis 本来就算好了，累计不额外花钱
		if (g_iLastPosSrc == 1)      g_iTotSrcSelf++;
		else if (g_iLastPosSrc == 2) g_iTotSrcFallback++;
		else                         g_iTotSrcEngine++;
		// 【v1.21.0 修】`sep` 在本波/场上还没有别的特感时是 **999999 哨兵值**（见 MinDistToUsed）。
		// v1.19.0 的汇总把哨兵也平均进去了 → 每图汇总的"平均间距"报到 3 万~10 万（真值 ~400），
		// 这行数字是假的。现在把哨兵排除在间距统计之外（"来源"计数不受影响，照旧计）。
		if (sep < 999999.0)
		{
			g_iTotSepN++;
			g_fTotSepSum += sep;
			if (sep >= g_cSpread.FloatValue) g_iTotSepGeSpread++;
			if (sep < 200.0)                 g_iTotSepLt200++;
		}
		g_iTotVis += vis;
		int   used   = (g_aWavePos != null) ? (g_aWavePos.Length / 3) : 0;
		float tposLog[3];
		GetClientAbsOrigin(target, tposLog);
		// 【v1.8.2修订7】dz = 目标高度 - 落点高度。dz>0 表示落点比目标【低】。
		// 直接把这个值写进日志，分析时不用再靠"同波中位 z"反推地下点。
		// 【v1.8.2修订8】段 = 档位（藏点近/藏点远/可见近/可见远）。
		// 有了它就能直接量出"用距离换隐蔽"到底用了多少次、退到多远。
		// 【LTT 2026-10-07】先只记录"距最近生还者"，给"贴脸刷"取证用（车主：先加日志，判据不急）
		// 统计对象含真人+电脑队友（bot 也算"被刷在脸上"），没有队友存活时记 99999
		float fLttNear = 99999.0;
		for (int lttI = 1; lttI <= MaxClients; lttI++)
		{
			if (!IsClientInGame(lttI) || !IsPlayerAlive(lttI) || GetClientTeam(lttI) != 2) continue;
			float fLttP[3];
			GetClientAbsOrigin(lttI, fLttP);
			float fLttD = GetVectorDistance(pos, fLttP);
			if (fLttD < fLttNear) fLttNear = fLttD;
		}
		// 【v1.49.6 · A5】POSNEAR 只在 **档位 2（全量）** 时才单独打一行 ——
		// 「距最近生还」已经折进下面那行 POS，精简档不再需要它（省 ~5045 行/天）。
		if (g_cPosLog.IntValue >= 2)
		{
			LogMessage("[SISpawn] POSNEAR 距最近生还=%.0f 职业=%s 波=%d 来源=%s x=%.0f y=%.0f z=%.0f 距目标=%.0f",
				fLttNear, g_sClassName[zclass], g_iWaveNo,
				g_iLastPosSrc == 1 ? "自建" : (g_iLastPosSrc == 2 ? "保底" : "引擎"),
				pos[0], pos[1], pos[2], GetVectorDistance(pos, tposLog));
		}

		// 【v1.49.6 · A5】精简档的**唯一一行**落点记录：把原来的「距最近生还」折进来，
		// 一行就能回答"刷给谁看 / 离最近生还多近 / 可不可见 / 与别人间距多少 / 哪条路径出的"。
		LogMessage("[SISpawn] POS 挡位=%d x=%.0f y=%.0f z=%.0f dz=%.0f 段=%s 来源=%s 职业=%s 波=%d 距目标=%.0f 距最近生还=%.0f 同波已用=%d 间距=%.0f 可见=%d 场上存活=%d",
			g_cMode.IntValue, pos[0], pos[1], pos[2], tposLog[2] - pos[2],
			(g_iLastPosTier >= 0 && g_iLastPosTier < 2) ? g_sTierName[g_iLastPosTier] : "无",
			// 【v1.14.0】0/3 都是"引擎"（0=提前收工，3=档位择优胜出），2=真保底
			g_iLastPosSrc == 1 ? "自建" : (g_iLastPosSrc == 2 ? "保底" : "引擎"),
			g_sClassName[zclass], g_iWaveNo, GetVectorDistance(pos, tposLog),
			fLttNear, used, sep, vis, g_iAliveSIN);

		// 【v1.49.11】调试档 2：每生成一只播一行
		if (g_cDbg.IntValue >= 2)
			PrintToChatAll("\x01[\x05刷特调试\x01] #%d.%d %s 来源=%s 距目标=%.0f 距最近=%.0f 间距=%.0f",
				g_iWaveNo, used + 1, g_sClassName[zclass],
				g_iLastPosSrc == 1 ? "自建" : (g_iLastPosSrc == 2 ? "保底" : "引擎"),
				GetVectorDistance(pos, tposLog), fLttNear, sep);
	}

	// 【v1.16.0 · 可见性交叉校验】同一个坐标，用三套**互不相同**的算法各判一次：
	//   点级 = L4D2_IsVisibleToPlayer      ← v1.15.0 起真正用于选择的依据
	//   面积 = L4D_IsPotentiallyVisibleToTeam ← v1.11~v1.14 的依据（区域级、过近似）
	//   射线 = TR_TraceRayFilter           ← v1.11 之前的依据（独立几何实现）
	//
	// 为什么需要它：2026-09-25 出现「插件日志说可见 0%、服主眼睛说照旧当脸刷」的
	// 直接矛盾。两边不可能同时对，但只靠肉眼永远分不清是"判定错了"还是"别的东西
	// 把特感搬走了"。把它记下来，判据的可信度就变成可数的：
	//   · 点级长期 0 而射线大量 1  → 点级原生没在干活（会被当脸刷），回 ltt_sispawn_vis_mode 1
	//   · 点级/面积/射线大体一致   → 判定可信，问题在别处（例如特感出生后被搬运）
	// -1 = 该原生在本服务器不可用。
	// 【v1.49.6 · A5】VISCHK 只在**全量档**才打（它本来就是"验证判定可信度"的交叉校验，
	// 日常不需要；省 ~5045 行/天）。深度排查时 `ltt_sispawn_poslog 2` 一并打开。
	if (g_cVisXCheck.BoolValue && g_cPosLog.IntValue >= 2)
	{
		float xcT[3];
		GetClientAbsOrigin(target, xcT);

		int xPoint = -1;
		int xArea  = -1;
		if (g_bHasEngineVis)
			xArea = IsSpotVisibleByPvs(pos) ? 1 : 0;
		if (g_bHasEngineVis && g_bHasVisPlayer)
			xPoint = IsSpotVisibleByPvsPoint(pos) ? 1 : 0;

		LogMessage("[SISpawn] VISCHK 点级=%d 面积=%d 射线=%d 距目标=%.0f 职业=%s",
			xPoint, xArea, IsSpotVisibleByRay(pos) ? 1 : 0,
			GetVectorDistance(pos, xcT), g_sClassName[zclass]);
	}

	// 【v1.8.2 方向A】把真正用掉的落点记进"本波已用"，后续特感会和它拉开距离。
	RememberSpawnPos(pos);

	// 【v1.7.1 埋点 / v1.18.9 拆开】
	// v1.18.9 起「找位」由 AccumFindCost 单独打一行（含 扫描/评估/其余 拆分，成功与失败都打），
	// 这里只管「生成」段，避免同一只特感打两行重复的找位数字。
	float tSpawn = GetEngineTime() - tSpawnStart;
	if (g_cCostLog.IntValue > 0 && tSpawn >= float(g_cCostLog.IntValue) / 1000.0)
		LogMessage("[SISpawn] 生成耗时 %s：%.1f ms（同次找位 %.1f ms｜tries=%d 场上特感=%d 客户端=%d）",
			g_sClassName[zclass], tSpawn * 1000.0, tFind * 1000.0,
			g_cTries.IntValue, CountAliveSI(), GetClientCount(false));

	// 登记追踪
	g_iTrackWave[zombie] = g_iWaveNo;
	g_flTrackTime[zombie] = GetGameTime();
	g_bTrackDone[zombie]  = false;

	// 【v1.18.3】出生点几何自检。
	// 用已有的 IsSpotClear（±16×16、高 0~71 的碰撞盒 trace）——
	// 注意它的过滤器 TraceFilter_Clearance 会忽略所有客户端，
	// 所以在这里调用【不会】被刚出生的这只特感自己挡住，结果可信。
	// TR_PointOutsideWorld 则是纯粹的世界边界判定，无过滤器。
	g_fTrackPos[zombie][0] = pos[0];
	g_fTrackPos[zombie][1] = pos[1];
	g_fTrackPos[zombie][2] = pos[2];
	g_bTrackSolid[zombie]   = !IsSpotClear(pos);
	g_bTrackOutside[zombie] = TR_PointOutsideWorld(pos);
	if (g_bTrackSolid[zombie])
		g_iBornSolid++;
	if (g_bTrackOutside[zombie])
		g_iBornOutside++;

	float tpos[3];
	GetClientAbsOrigin(target, tpos);
	g_fTrackTgtDist[zombie] = GetVectorDistance(pos, tpos);   // 【v1.18.3】出生时距目标
	// 【v1.20.0】出生点的**真实导航路程**（-1 = 引擎说走不通）。这是"滞留特感到底是不是
	// 因为路不通造成的"唯一硬指标：死因定位行里会打 `出生于路程=`，与 `出生距目标=` 一比就知道
	// （路程 >> 直线 ⇒ 绕远；路程 < 0 ⇒ 根本走不通）。
	g_fTrackTravel[zombie] = (g_bHasTravel && g_cUseTravel.BoolValue)
		? L4D2_NavAreaTravelDistance(pos, tpos, true) : -1.0;
	g_fWdBest[zombie]  = -1.0;   // 【v1.20.0】滞留判据：第一次巡检时落基准（-1 = 还没量过）
	g_fWdBase[zombie]  = -1.0;
	g_flWdAt[zombie]   = 0.0;
	g_iWdCount[zombie] = 0;
	// 【v1.33.0】新刷出来的特感：静止计时从 0 起、位置样本作废（第一拍只落样本不判静止）
	g_fWdStill[zombie]    = 0.0;
	g_bWdPosValid[zombie] = false;

	// 【v1.21.0】这一次是靠"等待降级"放行的吗？（>1.0 = 放宽过上限）
	if (g_fRuleRelax > 1.01)
	{
		g_iTotRelax++;
		if (LogNormal())
			LogMessage("[SISpawn] 等待降级放行 %s (#%d)：等了 %.1f 秒 → 「太远」上限放宽到 %.2f 倍（可见档 %.0f→%.0f，藏点档 %.0f→%.0f）",
				g_sClassName[zclass], zombie, float(g_iStallTicks) * 0.1, g_fRuleRelax,
				g_cFlowLos.FloatValue, g_cFlowLos.FloatValue * g_fRuleRelax,
				g_cFlowNoLos.FloatValue, g_cFlowNoLos.FloatValue * g_fRuleRelax);
	}
	if (LogDetail())
		LogMessage("[SISpawn] 已刷 %s (#%d) team=%d alive=%d fake=%d 距 %N %.0f 处 | 场上特感=%d",
			g_sClassName[zclass], zombie, GetClientTeam(zombie), IsPlayerAlive(zombie), IsFakeClient(zombie),
			target, GetVectorDistance(pos, tpos), CountAliveSI());

	// 0.5 秒后复核：区分"生成后瞬间死掉"和"根本没创建出来"
	CreateTimer(0.5, Timer_VerifySpawn, zombie);
	return true;
}

public Action Timer_VerifySpawn(Handle timer, any zombie)
{
	if (zombie < 1 || zombie > MaxClients || !IsClientInGame(zombie))
		return Plugin_Stop;

	// 只在异常时输出：正常生成的 0.5 秒后必然还在，不用刷日志
	if (!IsPlayerAlive(zombie) || GetClientTeam(zombie) != TEAM_INFECTED)
		LogMessage("[SISpawn] 异常：复核 #%d 生成后不存活 (team=%d alive=%d)",
			zombie, GetClientTeam(zombie), IsPlayerAlive(zombie));
	return Plugin_Stop;
}

/** 【v1.8.2修订5】管理员一键清场：踢掉场上所有【特感假人】。
 *
 *  为什么放在刷特插件里而不是菜单插件里：
 *    · 踢特感假人要走本插件的追踪簿记（g_flKickAt / g_iTrackWave），
 *      否则守卫会重复踢、还会在 SweepTracked 里误报"无击杀记录就已消失"；
 *    · `ltt_si_menu` 对刷特插件是**软连接**（只 FindConVar，不引用函数），
 *      所以菜单那边用 ServerCommand("sm_sispawn_clear") 触发，架构不被破坏。
 *
 *  安全保证：**只踢 IsFakeClient 且 team=3 的**。真人（无论生还者还是真人控制的特感）
 *  一律不碰 —— `!IsFakeClient(i)` 就 continue 了。
 *  同时清掉本波队列与落点记忆，避免刚清完立刻又被补一批。 */
/** 【v1.31.0 · 共用】踢掉场上所有【特感假人】（真人特感永不碰），并清空本波队列与落点记忆。
 *  返回踢掉的数量。管理员清场（Cmd_Clear）与"坦克期策略 3"共用这一份逻辑。 */
int PurgeAllSI(const char[] reason)
{
	int kicked = 0;
	float now = GetGameTime();

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || !IsFakeClient(i))
			continue;                        // 真人（含真人控制的特感）永不碰
		if (GetClientTeam(i) != TEAM_INFECTED)
			continue;
		if (g_flKickAt[i] > 0.0)
			continue;                        // 已经在踢了，别重复发

		// 停止追踪，避免 SweepTracked 把它们报成"无击杀记录就已消失"
		g_iTrackWave[i] = 0;
		g_bTrackDone[i]  = true;

		KickClient(i, reason);
		g_flKickAt[i] = now;
		kicked++;
	}

	// 清掉本波队列与落点记忆：刚清完不该立刻又被补一批
	g_iQueueLen   = 0;
	g_iQueuePos   = 0;
	g_iStallTicks = 0;
	ResetWavePositions();
	return kicked;
}

public Action Cmd_Clear(int client, int args)
{
	int before = GetClientCount(false);
	int kicked = PurgeAllSI("ltt_si_spawner: admin clear");

	LogMessage("[SISpawn] 管理员清场（admin=%d）：踢掉 %d 只特感假人（踢前占用 %d/%d）",
		client, kicked, before, MaxClients);
	ReplyToCommand(client, "[SISpawn] 已清空场上特感假人 %d 只（真人特感未动；本波队列已清空）", kicked);
	return Plugin_Handled;
}

// 离线也能验证并发上限：跳过"离开安全区"判断，立刻连刷 N 只
public Action Cmd_Burst(int client, int args)
{
	if (args < 1)
	{
		ReplyToCommand(client, "[SISpawn] 用法: sm_sispawn_burst <数量>");
		return Plugin_Handled;
	}

	int n = GetCmdArgInt(1);
	if (n < 1)  n = 1;
	// 【v1.43.0】24 → 32：26 特极限测试原来得"burst 24 + 等一波补 2 只"，纯粹是测试不便。
	//   上限从 32 起才够用（26 只一档）。它只影响管理员手打测试，不影响任何自动逻辑。
	if (n > 32) n = 32;

	// 【v1.30.0】救援关闸门优先报出来 —— 这样空服（没有生还者当目标）也能验证开关是否生效
	if (IsRescueBlocked())
	{
		ReplyToCommand(client, "[SISpawn] 救援关已按 ltt_sispawn_rescue_off=%d 关闭刷特，拒绝手动 burst（本图不刷特感）", g_cRescueOff.IntValue);
		return Plugin_Handled;
	}

	int target = PickTarget();
	if (target <= 0)
	{
		ReplyToCommand(client, "[SISpawn] 没有生还者可作目标");
		return Plugin_Handled;
	}

	QueueBurst(client, target, n, 0);
	return Plugin_Handled;
}

/** 【v1.48.0 · 服主 2026-10-05】按职业点单：`sm_sispawn_class <职业> [数量]`
 *
 *  为什么加：训练图（tgxl 终极特感训练）本来靠地图按钮点职业，但那张图的按钮是走导演的
 *  `info_zombie_spawn`，受"导演并发/名额"一堆条件影响（§215.9 排查了三层才通）。
 *  这条命令**绕开导演**，直接把指定职业塞进我们自己的生成队列（与 `sm_sispawn_burst` 同一条路），
 *  想练什么就点什么，比在地图里跑图按按钮稳。
 *  职业名支持中英文与数字：烟鬼/smoker/1、胖子/boomer/2、猎人/hunter/3、毒妇(口水)/spitter/4、
 *  骑师(猴子)/jockey/5、牛(牛子)/charger/6。
 *  ⚠ 这是**管理员命令**，不做地图/难度限制；每只仍然要过我们正常的找位与硬闸，
 *    所以"点 10 只"不等于"一定出 10 只"（找不到合格落点的会按放弃/等待队列处理）。 */
public Action Cmd_Class(int client, int args)
{
	if (args < 1)
	{
		ReplyToCommand(client, "[SISpawn] 用法: sm_sispawn_class <职业> [数量=1]");
		ReplyToCommand(client, "[SISpawn] 职业：烟鬼/smoker 胖子/boomer 猎人/hunter 毒妇/spitter 骑师/jockey 牛/charger（也可写 1~6）");
		return Plugin_Handled;
	}

	char sIn[32];
	GetCmdArg(1, sIn, sizeof(sIn));
	int cls = ClassFromName(sIn);
	if (cls <= 0)
	{
		ReplyToCommand(client, "[SISpawn] 认不出这个职业：「%s」——可用：烟鬼/smoker 胖子/boomer 猎人/hunter 毒妇/spitter 骑师/jockey 牛/charger（或 1~6）", sIn);
		return Plugin_Handled;
	}

	int n = (args >= 2) ? GetCmdArgInt(2) : 1;
	if (n < 1)  n = 1;
	if (n > 32) n = 32;

	if (IsRescueBlocked())
	{
		ReplyToCommand(client, "[SISpawn] 救援关已按 ltt_sispawn_rescue_off=%d 关闭刷特，拒绝手动刷特（本图不刷特感）", g_cRescueOff.IntValue);
		return Plugin_Handled;
	}

	int target = PickTarget();
	if (target <= 0)
	{
		ReplyToCommand(client, "[SISpawn] 没有生还者可作目标");
		return Plugin_Handled;
	}

	QueueBurst(client, target, n, cls);
	return Plugin_Handled;
}

/** 把 n 只（forceClass>0 时全是指定职业）排进本波队列 —— `burst` 与 `class` 两条命令共用。
 *  返回排进去的只数（0 = 一只都没排上）。 */
int QueueBurst(int client, int target, int n, int forceClass)
{
	g_bArmed    = true;
	g_iTarget   = target;
	g_iWaveNo++;
	g_iQueueLen = 0;
	g_iQueuePos = 0;
	g_iStallTicks = 0;
	ResetWavePositions();     // 【v1.8.2】手动 burst 也算一波，必须重开落点记忆，
	                          // 否则会沿用上一波用过的点，分散约束失效（这处是补的漏）

	// 【v1.48.0】forceClass：让 PickClass() 只认这一个职业（用完即还原，避免影响后续波次）
	int oldForce = g_iForceClass;
	g_iForceClass = forceClass;

	for (int i = 0; i < n; i++)
	{
		int c = PickClass();
		if (c > 0)
			g_iQueue[g_iQueueLen++] = c;
	}

	g_iForceClass = oldForce;

	// 【修】重排下一次波次时间。
	// 不重排的话：如果上一波按旧的（很长的）间隔排好了下一波，
	// 手动 burst 完之后要一直等到那个时间点才会再来一波 ——
	// 实测把间隔从 300 秒改成 5 秒后，场上刷完就空了，
	// 因为下一波还被压在 247 秒之后。重新从"现在 + 当前间隔"起算。
	g_flNextSpawn = GetGameTime() + CalcNextInterval();

	if (forceClass > 0)
		ReplyToCommand(client, "[SISpawn] 已排队 %d 只【%s】（目标=%N），接下来几秒分批生成",
			g_iQueueLen, g_sClassName[forceClass], target);
	else
		ReplyToCommand(client, "[SISpawn] 已排队 %d 只（目标=%N），将在接下来几秒内分批生成", g_iQueueLen, target);
	return g_iQueueLen;
}

/** 【v1.48.0】把玩家输入的职业名解析成 1~6（认不出返回 0）。
 *  支持：英文名、数字、中文名。
 *
 *  ⚠ 中文这里必须**双编码匹配**：玩家在游戏里敲中文时，客户端发上来的是**本地编码的字节**
 *    （简中 Windows = GBK/CP936），而源码文件是 UTF-8 —— 只写 `StrContains(b, "牛")` 永远匹配不上
 *    （2026-10-05 实测：rcon 传"牛"进来变成单个乱码字节，直接被判"认不出"）。
 *    所以每个中文别名同时给 UTF-8 字面量与 GBK 字节转义（\xC5\xA3 = GBK 的"牛"）。
 *    英文名与数字不受编码影响，是**最稳**的写法，出问题先让玩家用它们。 */
int ClassFromName(const char[] s)
{
	char b[32];
	strcopy(b, sizeof(b), s);
	TrimString(b);
	if (b[0] == '\0')
		return 0;

	// 纯数字：1~6
	if (b[0] >= '1' && b[0] <= '6' && b[1] == '\0')
		return b[0] - '0';

	// 英文名（不受编码影响，最稳）
	if (StrEqual(b, "smoker", false))  return 1;
	if (StrEqual(b, "boomer", false))  return 2;
	if (StrEqual(b, "hunter", false))  return 3;
	if (StrEqual(b, "spitter", false)) return 4;
	if (StrEqual(b, "jockey", false))  return 5;
	if (StrEqual(b, "charger", false)) return 6;

	// 中文：UTF-8 字面量 + GBK 字节（两种都匹配）
	if (StrContains(b, "烟") >= 0 || StrContains(b, "\xD1\xCC") >= 0)  return 1;   // 烟鬼
	if (StrContains(b, "胖") >= 0 || StrContains(b, "\xC5\xD6") >= 0)  return 2;   // 胖子
	if (StrContains(b, "猎") >= 0 || StrContains(b, "\xC1\xD4") >= 0)  return 3;   // 猎人
	if (StrContains(b, "毒") >= 0 || StrContains(b, "\xB6\xBE") >= 0
		|| StrContains(b, "口水") >= 0 || StrContains(b, "\xBF\xDA\xCB\xAE") >= 0) return 4;  // 毒妇/口水
	if (StrContains(b, "骑") >= 0 || StrContains(b, "\xC6\xEF") >= 0
		|| StrContains(b, "猴") >= 0 || StrContains(b, "\xBA\xEF") >= 0) return 5;   // 骑师/猴子
	if (StrContains(b, "牛") >= 0 || StrContains(b, "\xC5\xA3") >= 0)  return 6;   // 牛/牛子
	return 0;
}

// 全槽位快照：看清服务器到底有哪些客户端槽位、哪些能当特感用
// 注意：绝不能对未连接客户端调 GetClientTeam/GetClientName，会抛异常中断命令
public Action Cmd_Slots(int client, int args)
{
	int n = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i))
			n++;
	}

	ReplyToCommand(client, "[SISpawn] MaxClients=%d 实际在服客户端=%d 人类上限=%d",
		MaxClients, n, GetMaxHumanPlayers());

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i))
			continue;

		char sName[64];
		GetClientName(i, sName, sizeof(sName));
		ReplyToCommand(client, "[SISpawn]  #%d fake=%d team=%d alive=%d name=%s",
			i, IsFakeClient(i), GetClientTeam(i), IsPlayerAlive(i), sName);
	}
	return Plugin_Handled;
}

/** 【v1.18.5】把 m_zombieClass 转成能读的名字。
 *
 *  为什么需要它：MAX_CLASS 只覆盖 6 个特感（1~6），而**坦克=8、女巫=7** 落在表外，
 *  原来一律打印成 "?"。后果不只是难看 —— 2026-09-26 实测，漏网检测把【坦克】
 *  报成了"导演漏出来的多余特感"，18 次报出全是它。如果当时把
 *  `ltt_sispawn_purge_foreign` 打开，就会**每波都把坦克踢掉**（打着打着坦克消失）。
 *  这种"分不清是什么东西"的日志下次还会骗人，所以宁可多写这几行。 */
void ZombieClassName(int cls, char[] out, int maxlen)
{
	if (cls >= 1 && cls <= MAX_CLASS)
	{
		strcopy(out, maxlen, g_sClassName[cls]);
		return;
	}

	switch (cls)
	{
		case 7:  strcopy(out, maxlen, "Witch");
		case 8:  strcopy(out, maxlen, "Tank");
		default: Format(out, maxlen, "?(cls=%d)", cls);
	}
}

// 打印当前存活特感名单 + 生还者槽位，用于确认实体编号的含义
void LogRoster()
{
	if (!LogNormal())
		return;

	char sSI[256];
	sSI[0] = '\0';

	// 【v1.18.4 · 漏网特感检测】区分"我们刷的"和"导演自己刷的"。
	// 判据用本插件已有的追踪簿记：g_iTrackWave[i] > 0 且未结算 = 我们刷的。
	// 为什么必须做进插件、而不是事后挖日志：日志里带实体号的只有【死亡】记录
	// （`第 N 波的 X (#N) 被…击杀`）和这行槽位列表；"我方生成了哪几只"只有
	// debug=2 才打（`已刷`）。只拿死亡记录去比，**还活着的我方特感必然被误判
	// 成导演刷的** —— 假阳性一大片，根本比不出来。用簿记则是精确的。
	//
	// 【v1.18.5 修正】只统计"本插件负责的那 6 个特感职业"。
	// 坦克(8)/女巫(7)本来就该由导演刷 —— 原来的版本把它们也算成"漏网"，
	// 2026-09-26 实测 20 次报出**全是坦克**。要是当时开了 purge_foreign，
	// 就会每波都踢掉坦克（打着打着坦克消失）。这个坑必须先堵。
	int  nOurs    = 0;
	int  nForeign = 0;
	int  nOther   = 0;              // 坦克/女巫等不属于本插件管理范围的
	int  iForeign[MAXPLAYERS + 1];

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_INFECTED || !IsPlayerAlive(i))
			continue;

		int  cls        = GetEntProp(i, Prop_Send, "m_zombieClass");
		bool bTrackable = (cls >= 1 && cls <= MAX_CLASS);
		bool bOurs      = bTrackable && (g_iTrackWave[i] > 0 && !g_bTrackDone[i]);

		if (bOurs)
		{
			nOurs++;
		}
		else if (bTrackable)
		{
			if (nForeign <= MAXPLAYERS)
				iForeign[nForeign] = i;
			nForeign++;
		}
		else
		{
			nOther++;               // 坦克/女巫：导演刷的，正常
		}

		char sCls[16];
		ZombieClassName(cls, sCls, sizeof(sCls));

		char sOne[32];
		// 不是我们刷的用 * 标出来，一眼可辨
		Format(sOne, sizeof(sOne), " #%d(%s)%s", i, sCls, bOurs ? "" : "*");
		StrCat(sSI, sizeof(sSI), sOne);
	}

	char sSurv[128];
	sSurv[0] = '\0';
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_SURVIVOR)
			continue;

		char sOne[24];
		Format(sOne, sizeof(sOne), " #%d", i);
		StrCat(sSurv, sizeof(sSurv), sOne);
	}

	LogMessage("[SISpawn] 存活特感槽位:%s | 生还者槽位:%s",
		sSI[0] ? sSI : " (无)", sSurv[0] ? sSurv : " (无)");

	// 【v1.18.4】漏网特感：默认只报告、不擅自处理。带 * 的就是它们。
	// 【v1.18.5】只算"本插件负责的 6 个职业"；坦克/女巫正常由导演刷，不计入。
	// ⚠ 已知假阳性来源：本插件【重载】会让之前刷出的特感丢掉簿记，
	//   那一瞬间它们会被标成 *。看这条要结合"最近有没有 reload 过插件"。
	if (nForeign > 0)
	{
		char sF[128];
		sF[0] = '\0';
		for (int k = 0; k < nForeign && k <= MAXPLAYERS; k++)
		{
			char sOne[16];
			Format(sOne, sizeof(sOne), " #%d", iForeign[k]);
			StrCat(sF, sizeof(sF), sOne);
		}

		LogMessage("[SISpawn] !! 漏网检测：我们该管的特感里，场上 %d 只、本插件只登记了 %d 只 → 有 %d 只【不是本插件刷的】（导演自己刷的）：%s",
			nOurs + nForeign, nOurs, nForeign, sF);

		if (g_cPurgeForeign.BoolValue)
		{
			int kicked = 0;
			for (int k = 0; k < nForeign && k <= MAXPLAYERS; k++)
			{
				int t = iForeign[k];
				if (!IsClientInGame(t) || GetClientTeam(t) != TEAM_INFECTED)
					continue;
				KickClient(t, "ltt_si_spawner: purge director-spawned SI");
				kicked++;
			}
			NoteKickHappened(kicked);
			LogMessage("[SISpawn] 已清掉 %d 只漏网特感（ltt_sispawn_purge_foreign=1）", kicked);
		}
	}

	// 坦克/女巫单列一行：它们由导演刷是正常的，但值得让你知道场上有几只
	if (nOther > 0 && LogDetail())
	{
		LogMessage("[SISpawn] （另有 %d 只坦克/女巫在场 —— 本来就该由导演刷，不计入漏网）", nOther);
	}
}

// 击杀事件：能收到就说明是"被打死的"
public void Event_EntityKilled(Event event, const char[] name, bool dontBroadcast)
{
	int victim = event.GetInt("entindex_killed");
	if (victim < 1 || victim > MaxClients || !IsClientInGame(victim))
		return;
	if (g_iTrackWave[victim] <= 0 || g_bTrackDone[victim])
		return;

	g_bTrackDone[victim] = true;

	char sWho[64];
	// 【v1.18.10 修一个"整列数据都是假的"的字段名错误】
	//   原来读的是 `event.GetInt("userid_attacker")`。
	//   ⚠ 但 `entity_killed` 这个事件【根本没有 userid_attacker 字段】——
	//     它的字段是 entindex_killed / entindex_attacker / entindex_inflictor
	//     （人证：SM 自带 testsuite\gamerules-props.sp 用的就是 entindex_killed；
	//      物证：引擎二进制字符串表里 "entity_killed" 后面紧跟的就是
	//      entindex_killed / entindex_attacker / entindex_inflictor）。
	//   ⇒ GetInt 读不存在的字段恒返回 0 ⇒ GetClientOfUserId(0) = 0
	//     ⇒ **2026-09-27 全天 192 条击杀记录 100% 打印成"非玩家(环境/坠落/其他特感)"**，
	//        这一列诊断数据等于没有。字段名（userid_* 属于 player_death 那类事件）记牢。
	int attackerEnt = event.GetInt("entindex_attacker");
	if (attackerEnt >= 1 && attackerEnt <= MaxClients && IsClientInGame(attackerEnt))
	{
		Format(sWho, sizeof(sWho), "%N", attackerEnt);
	}
	else if (attackerEnt > 0 && IsValidEdict(attackerEnt))
	{
		// 非玩家实体：把类名打出来（例如 witch / infected / worldspawn）
		char sEntCls[48];
		GetEdictClassname(attackerEnt, sEntCls, sizeof(sEntCls));
		Format(sWho, sizeof(sWho), "%s(实体#%d)", sEntCls, attackerEnt);
	}
	else
	{
		strcopy(sWho, sizeof(sWho), "非玩家(环境/坠落)");
	}

	char sCls[16];
	int cls = GetEntProp(victim, Prop_Send, "m_zombieClass");
	strcopy(sCls, sizeof(sCls), (cls >= 1 && cls <= MAX_CLASS) ? g_sClassName[cls] : "?");

	if (LogNormal())
	{
		LogMessage("[SISpawn] 第 %d 波的 %s (#%d) 被【%s】击杀，存活 %.1f 秒",
			g_iTrackWave[victim], sCls, victim, sWho, GetGameTime() - g_flTrackTime[victim]);

		// 【v1.18.3】死因定位。判读方法（服主/我复盘时照这个读）：
		//   位移≈0 + 出生在实心=1  → 坐实"刷在墙里/地板下"，出生点非法
		//   位移≈0 + 出生在世界外=1 → 落点在世界外
		//   位移很大、死亡时距最近生还很小 → 正常交战死的，落点没问题
		//   位移中等、死亡时距最近生还仍然很大 → 没走到人跟前就死了（寻路失败/被引擎处理）
		float dpos[3];
		GetClientAbsOrigin(victim, dpos);

		float nearest = -1.0;
		for (int i = 1; i <= MaxClients; i++)
		{
			if (!IsClientInGame(i) || !IsPlayerAlive(i) || GetClientTeam(i) != TEAM_SURVIVOR)
				continue;
			float sp[3];
			GetClientAbsOrigin(i, sp);
			float dd = GetVectorDistance(dpos, sp);
			if (nearest < 0.0 || dd < nearest)
				nearest = dd;
		}

		LogMessage("[SISpawn] 死因定位 第 %d 波的 %s (#%d) 存活 %.1f 秒 | 位移=%.0f 出生z=%.0f 死亡z=%.0f | 出生距目标=%.0f 出生于路程=%.0f 死亡距最近生还=%.0f | 出生在实心=%d 出生在世界外=%d 死亡在世界外=%d | 滞留处理=%d",
			g_iTrackWave[victim], sCls, victim, GetGameTime() - g_flTrackTime[victim],
			GetVectorDistance(g_fTrackPos[victim], dpos),
			g_fTrackPos[victim][2], dpos[2],
			g_fTrackTgtDist[victim], g_fTrackTravel[victim], nearest,
			g_bTrackSolid[victim] ? 1 : 0,
			g_bTrackOutside[victim] ? 1 : 0,
			TR_PointOutsideWorld(dpos) ? 1 : 0,
			g_iWdCount[victim]);
	}
}

// 每波开始前扫一遍：登记过、但既没收到击杀事件又已经不活了的 → 引擎回收
void SweepTracked()
{
	if (!LogNormal())
		return;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (g_iTrackWave[i] <= 0 || g_bTrackDone[i])
			continue;

		// 槽位已不属于任何客户端（例如生成失败留下的无效编号）→ 直接丢弃记录，
		// 否则下面 GetEntProp 会对无效实体抛异常
		if (!IsClientInGame(i))
		{
			g_iTrackWave[i] = 0;
			continue;
		}

		if (IsPlayerAlive(i))
			continue;

		g_bTrackDone[i] = true;

		char sCls[16];
		int cls = GetEntProp(i, Prop_Send, "m_zombieClass");
		strcopy(sCls, sizeof(sCls), (cls >= 1 && cls <= MAX_CLASS) ? g_sClassName[cls] : "?");

		LogMessage("[SISpawn] !! 第 %d 波的 %s (#%d) 无击杀记录就已消失，存活仅 %.1f 秒（疑似被引擎回收）",
			g_iTrackWave[i], sCls, i, GetGameTime() - g_flTrackTime[i]);
	}
}

/** 【v1.20.0】滞留看门狗：巡检本插件刷出的特感，发现"一直不朝生还者走"的就传送到合格落点。
 *
 *  判据（三项同时满足）：
 *    ① 存活 >= ltt_sispawn_wd_after（默认 25 秒）
 *    ② **历史最近距离** 仍 > 首次量到的距离 - wd_gain（默认 250）⇒ 从头到尾就没靠近过
 *    ③ 现在距最近生还者 > wd_far（默认 1000）⇒ 确实还离得远
 *  动作：`PickTarget()` 选目标 + 现成的 `FindSpawnPos()` 找合格落点 → `TeleportEntity`。
 *        不做任何作弊/伤害，只把"站桩的那只"挪到它能打得到人的地方。
 *
 *  【为什么用"第一次量到的距离"当基准，而不是出生距离】
 *  出生距离是到**目标（领跑）生还者**的直线距离，而巡检量的是到**最近**生还者的距离，
 *  两个口径混用会让"出生时旁边就有人"的特感永远判不出滞留。所以基准取"第一次巡检量到的最近距离"，
 *  传送之后再重置一次基准 —— 语义始终是"从我第一次看到它起，它朝人靠近过吗"。
 *
 *  成本：每 0.5 秒一次；只对**本插件刷出的存活特感**逐个算最近生还者距离
 *  （最多 12 只 × 10 个真人），生还者位置直接读，不依赖可能过期的缓存。 */
void WdCheck()
{
	if (!g_cWatchdog.BoolValue)
		return;

	float now = GetGameTime();
	if (now < g_flWdNextCheck)
		return;
	g_flWdNextCheck = now + 0.5;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (g_iTrackWave[i] <= 0 || g_bTrackDone[i])
			continue;                  // 不是本插件刷的 / 已结算
		if (!IsClientInGame(i) || !IsPlayerAlive(i))
			continue;

		float pos[3];
		GetClientAbsOrigin(i, pos);
		float d = WdNearestSurvivorDist(pos);
		if (d < 0.0)
			return;                    // 没有存活生还者（或还没刷出来）→ 本轮不判

		// 【v1.33.0】"卡住不动"判定：只比特感**自己的位移**，与到生还者的距离无关。
		//   为什么必须另开一条判据：服主 2026-10-03 增城实报"一个 Smoker 在生还者前面卡住"，
		//   而下面那两条距离判据正好都把"贴着生还者"的特感排除掉了（见文件头 v1.33.0 注释）。
		float still = 0.0;
		if (g_bWdPosValid[i])
		{
			if (GetVectorDistance(pos, g_fWdLastPos[i]) < g_cWdMove.FloatValue)
				g_fWdStill[i] += 0.5;      // 这一拍没挪动 → 静止时间 +0.5 秒
			else
				g_fWdStill[i] = 0.0;       // 动过了 → 清零（蹲着瞄准的微调也会清零，宁可漏判不可误判）
		}
		g_bWdPosValid[i] = true;
		for (int k = 0; k < 3; k++)
			g_fWdLastPos[i][k] = pos[k];
		still = g_fWdStill[i];

		if (g_fWdBase[i] <= 0.0)
		{
			g_fWdBase[i] = d;          // 第一次量到它：落基准
			g_fWdBest[i] = d;
			continue;                  // 刚出生那一轮不处理（下面"存活 >= wd_after"也要等）
		}
		if (d < g_fWdBest[i])
			g_fWdBest[i] = d;          // 记录"出生以来最靠近到多少"

		float alive = now - g_flTrackTime[i];
		if (alive < g_cWdAfter.FloatValue)
			continue;

		// 【v1.33.0】两条触发路径（满足任一即处理），并记下到底是哪条 —— 日志不许含糊
		char sWhy[64] = "";
		bool bSus = false;

		// ① 老判据：离得远(>wd_far) 且 从来没靠近过(>wd_gain)
		if (d > g_cWdFar.FloatValue && g_fWdBest[i] > g_fWdBase[i] - g_cWdGain.FloatValue)
		{
			bSus = true;
			strcopy(sWhy, sizeof(sWhy), "远且从未靠近");
		}
		// ② 新判据：静止 >= wd_still，且（被整队超过 或 贴脸）
		if (!bSus && g_cWdStill.FloatValue > 0.0 && still >= g_cWdStill.FloatValue)
		{
			bool bNear   = (g_cWdNear.FloatValue > 0.0 && d <= g_cWdNear.FloatValue);
			bool bPassed = (g_cWdPassed.BoolValue && WdPassedBySurvivors(i));
			if (bNear || bPassed)
			{
				bSus = true;
				FormatEx(sWhy, sizeof(sWhy), "静止%.1fs+%s", still,
					(bNear && bPassed) ? "贴脸且被超过" : (bNear ? "贴脸" : "已被超过"));
			}
		}

		// 【v1.49.4 · 三闸③配套】第三条触发路径：与【最近生还者】的高度差持续超标。
		// 为什么必须单独一条：上面两条都是【水平距离/自我位移】口径 ——
		// 一只掉在生还者正下方 300 单位、在水里或坑里持续挪动的舌头，
		//   ① 水平 d 可能 < wd_far（够不着"远且从未靠近"），
		//   ② 它一直在动 ⇒ g_fWdStill 每次被清零（够不着"静止+贴脸"），
		// 于是永远判不出来 —— 实测 c3 丛林就是这样堆到世界底部 z=-255 被处死的。
		if (!bSus && g_cWdVert.FloatValue > 0.0)
		{
			float nz = 0.0;
			if (LttNearestSurvivorZ(pos, nz))
			{
				float vd = FloatAbs(pos[2] - nz);
				if (vd > g_cWdVert.FloatValue)
				{
					g_fWdVertTime[i] += 0.5;
					if (g_fWdVertTime[i] >= g_cWdVertStill.FloatValue)
					{
						bSus = true;
						FormatEx(sWhy, sizeof(sWhy), "垂直差%.0f持续%.1fs", vd, g_fWdVertTime[i]);
					}
				}
				else
				{
					g_fWdVertTime[i] = 0.0;
				}
			}
			else
			{
				g_fWdVertTime[i] = 0.0;
			}
		}
		if (!bSus)
			continue;

		// 【v1.33.1】判"滞留"之前先排掉**正在控人**的特感。
		// 控人期间（扑/骑/拖/撞）双方静止 + 距离极小 ⇒ 必然命中 v1.33.0 的「静止+贴脸」，
		// 不排掉就会出现"特感控住人了却被传送走"（服主 2026-10-03 实报"有点离谱"）。
		int clsNow = GetEntProp(i, Prop_Send, "m_zombieClass");
		if (WdIsDominating(i, clsNow))
		{
			// 【v1.36.0】记下"最近一次被看到在控人"的时刻 —— 控人结束后要靠它做冷静期
			g_flWdDomAt[i] = now;
			// 【v1.33.2】计数与日志都必须节流：WdCheck 每 0.5 秒一拍，控人期间每一拍都命中这里。
			// 不节流 ⇒ 一次 20 秒扑击刷 40 行；连计数一起吹大（假数字）。
			if (g_cWdLog.BoolValue
				&& (g_flWdSkipLog[i] <= 0.0 || now - g_flWdSkipLog[i] >= 10.0))
			{
				g_flWdSkipLog[i] = now;
				g_iTotWdSkipPin++;
				LogMessage("[SISpawn] 滞留跳过（正在控人，不搬）第 %d 波的 %s (#%d)：存活 %.1f 秒｜判据=%s（静止 %.1f 秒）｜现距最近生还=%.0f｜本图累计拦下 %d 次",
					g_iTrackWave[i],
					(clsNow >= 1 && clsNow <= MAX_CLASS) ? g_sClassName[clsNow] : "?", i,
					alive, sWhy, still, d, g_iTotWdSkipPin);
			}
			continue;
		}

		// 【v1.36.0】控人结束后的冷静期：舌头被砍断 / 被推开 / 被控者死亡之后，
		// 它已经不是 controlling（属性归零），但仍然是"贴脸 + 静止"⇒ 会被误判成滞留。
		// 玩家看到的是"我把舌头砍断了，Smoker 就没了"（服主 2026-10-03 转述群友实报）。
		if (g_cWdAfterDom.FloatValue > 0.0 && g_flWdDomAt[i] > 0.0
			&& (now - g_flWdDomAt[i]) < g_cWdAfterDom.FloatValue)
		{
			if (g_cWdLog.BoolValue
				&& (g_flWdSkipLog[i] <= 0.0 || now - g_flWdSkipLog[i] >= 10.0))
			{
				g_flWdSkipLog[i] = now;
				LogMessage("[SISpawn] 滞留跳过（刚控过人，冷静期 %.0f 秒内不搬）第 %d 波的 %s (#%d)：存活 %.1f 秒｜判据=%s（静止 %.1f 秒）｜距上次控人 %.1f 秒｜现距最近生还=%.0f",
					g_cWdAfterDom.FloatValue, g_iTrackWave[i],
					(clsNow >= 1 && clsNow <= MAX_CLASS) ? g_sClassName[clsNow] : "?", i,
					alive, sWhy, still, now - g_flWdDomAt[i], d);
			}
			continue;
		}

		if (g_iWdCount[i] >= g_cWdMax.IntValue)
			continue;                  // 处理次数用完了
		if (g_flWdAt[i] > 0.0 && now - g_flWdAt[i] < g_cWdCool.FloatValue)
			continue;                  // 冷却中
		// 【v1.26.0】找位限流：看门狗为了传送也要跑一遍 FindSpawnPos（实测单次 108.3ms），
		// 上一次找位之后 searchgap 秒内不再重复找 —— 少传送一次换来帧时间平稳，值得。
		if (now < g_flWdSearchAt)
			continue;

		g_iWdCount[i]++;
		g_flWdAt[i] = now;
		g_iTotWdAct++;

		char sCls[16];
		int cls = clsNow;      // 【v1.33.1】上面判"正在控人"时已读过，不重复读属性
		strcopy(sCls, sizeof(sCls), (cls >= 1 && cls <= MAX_CLASS) ? g_sClassName[cls] : "?");
		float best = g_fWdBest[i];
		float base = g_fWdBase[i];

		if (!g_cWdAct.BoolValue)
		{
			if (g_cWdLog.BoolValue)
				LogMessage("[SISpawn] 滞留(只记账) 第 %d 波的 %s (#%d)：存活 %.1f 秒｜判据=%s（静止 %.1f 秒）｜出生距目标=%.0f 出生于路程=%.0f｜首次量到=%.0f 历史最近=%.0f（门限 %.0f）｜现距最近生还=%.0f",
					g_iTrackWave[i], sCls, i, alive, sWhy, still, g_fTrackTgtDist[i], g_fTrackTravel[i],
					base, best, g_cWdGain.FloatValue, d);
			continue;
		}

		g_flWdSearchAt = now + g_cWdSearchGap.FloatValue;   // 【v1.26.0】记下这次"找位"的时刻
		int target = PickTarget();
		float out[3];

		// 【v1.29.0 · 2026-10-02 深度审核修复】看门狗这条路径的三处加固：
		//  ① 职业范围：cls 来自 m_zombieClass，可能是 8(Tank) 等；FindSpawnPos 里有 8 处
		//     g_sClassName[zclass]，而数组只有 MAX_CLASS+1=7 项 ⇒ 越界读（本函数必须挡住）。
		//     同时清掉追踪表，别让这个槽位每 tick 都重试。
		//  ② 等待降级倍数：g_fRuleRelax 是全局量，上一波放宽到 3.0 会被本路径沿用，
		//     把"保底硬上限"一起放大 3 倍（与"按等待时长降级"的设计不符）⇒ 复位 1.0。
		if (cls < 1 || cls > MAX_CLASS)
		{
			if (g_cWdLog.BoolValue)
				LogMessage("[SISpawn] 滞留处理跳过 #%d：m_zombieClass=%d 不在 1..%d（不是可刷特职业，避免越界读）",
					i, cls, MAX_CLASS);
			g_iTrackWave[i] = 0;
			continue;
		}
		g_fRuleRelax = 1.0;
		if (target <= 0 || !FindSpawnPos(target, cls, out))
		{
			if (g_cWdLog.BoolValue)
				LogMessage("[SISpawn] 滞留处理失败（找不到合格落点）第 %d 波的 %s (#%d)：存活 %.1f 秒｜出生距目标=%.0f｜现距最近生还=%.0f（本次未传送，冷却后再试）",
					g_iTrackWave[i], sCls, i, alive, g_fTrackTgtDist[i], d);
			continue;
		}

		// 【v1.29.0 · 审核修复】黑名单盒（坐标盒）也必须管住看门狗这条路径：
		// 原来只有"生成"路径查 IsBlacklisted，滞留特感被传送时可以把目标点选进盒子里
		// （v1.27.0 加坐标盒就是为了兜电梯井那类保底点，这条路等于漏了）。
		if (IsBlacklisted(out))
		{
			if (g_cWdLog.BoolValue)
				LogMessage("[SISpawn] 滞留处理放弃传送 #%d %s：目标点命中【黑名单盒】（不把特感送进盒里）", i, sCls);
			continue;
		}

		// 【v1.49.4·三闸】看门狗自己送过去的目标点也不许在水里 / 世界之外 ——
		// 否则"搬走一只卡住的"会变成"搬进水里再卡一次"。
		// （FindSpawnPos 已经过三闸，这里是看门狗这条路径的双保险，不动生成逻辑。）
		if (LttGateInWater(out) || LttGateOutside(out))
		{
			if (g_cWdLog.BoolValue)
				LogMessage("[SISpawn] 滞留处理放弃传送 #%d %s：目标点在【水里/世界之外】（不把特感搬进死地）", i, sCls);
			continue;
		}

		float newd = WdNearestSurvivorDist(out);
		TeleportEntity(i, out, NULL_VECTOR, NULL_VECTOR);
		g_fWdBase[i] = newd;           // 换基准，别再拿"没靠近出生点"重复判它
		g_fWdBest[i] = newd;
		g_fWdVertTime[i] = 0.0;        // 【v1.49.4】垂直判据计时清零，别立刻再判一次
		g_iTotWdMoved++;

		if (g_cWdLog.BoolValue)
			LogMessage("[SISpawn] 滞留处理 第 %d 波的 %s (#%d)：存活 %.1f 秒｜判据=%s（静止 %.1f 秒）｜出生距目标=%.0f 出生于路程=%.0f｜首次量到=%.0f 历史最近=%.0f｜处理前现距=%.0f → 传送到距最近生还 %.0f 处（第 %d 次｜本图累计 判滞留 %d / 传送 %d）",
				g_iTrackWave[i], sCls, i, alive, sWhy, still, g_fTrackTgtDist[i], g_fTrackTravel[i],
				base, best, d, newd, g_iWdCount[i], g_iTotWdAct, g_iTotWdMoved);
	}
}

/** 【v1.20.0】到最近存活生还者的距离；没有存活生还者时返回 -1。
 *  这里直接读客户端位置，不用 `MinDistToSurvivors` 的缓存 —— 看门狗每 0.5 秒跑一次，
 *  不能因为快照恰好没刷而误判（成本 32 次 IsClientInGame，可忽略）。 */
float WdNearestSurvivorDist(const float pos[3])
{
	float best = -1.0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_SURVIVOR || !IsPlayerAlive(i))
			continue;
		float p[3];
		GetClientAbsOrigin(i, p);
		float d = GetVectorDistance(pos, p);
		if (best < 0.0 || d < best)
			best = d;
	}
	return best;
}

// =====================================================================================
// 【v1.49.4 · 出生点三闸】车主 2026-10-07 指定"三闸先做"。
//
// 为什么加（10-06 c3 丛林实测）：Smoker 出生 z=-574/-593/-444/-205、死亡 z=-255
//（这批图的世界底部处死面），且这些点 `出生于路程=-1`（引擎说路根本走不通）。
// 查代码找到根因是【两个"算了但从来没用"】+【一个口径缺口】：
//   ① `g_bTrackOutside`（TR_PointOutsideWorld）只在结算/日志里算，**从未参与拒绝**；
//   ② 水面一次都没查过 —— 全文件不存在 water / WaterLevel 判断；
//   ③ 原有高度闸只对【目标生还者】生效（下 150 / 上 400）。目标自己也在低处时，
//      地底点与目标的 dz 很小 ⇒ 照样放行（这正是 c3 水下坑的形态）。
// 另外【绝对高度阈值不可用】有硬证据：全量 145845 条 POS 行的 z 分布从 -2000 到 +6400
//（各图地面本身就在不同高度）⇒ 垂直判据只能相对"人"算。
//
// 三闸都只在【候选评估】阶段生效：有别的候选时自动换一个，不会减少出刷数量。
// =====================================================================================

/** 三闸①：这个点在水里吗（TR_GetPointContents 返回该点的 CONTENTS 掩码）。 */
bool LttGateInWater(const float pos[3])
{
	if (!g_cGateWater.BoolValue)
		return false;
	return (TR_GetPointContents(pos) & MASK_WATER) != 0;
}

/** 三闸②：这个点在世界边界之外吗。
 *  注意 `TR_PointOutsideWorld(float pos[3])` 的参数**不带 const**（sdktools_trace.inc 原样），
 *  所以这里不能用 const 形参，否则 error 035 argument type mismatch。 */
bool LttGateOutside(float pos[3])
{
	if (!g_cGateOutside.BoolValue)
		return false;
	return TR_PointOutsideWorld(pos);
}

/** 【v1.49.4】到【最近生还者】的高度。按 3D 距离取最近（与看门狗同口径）。
 *  @return false = 场上没有活着的生还者（此时 outZ 不可用）。 */
bool LttNearestSurvivorZ(const float from[3], float &outZ)
{
	float best = -1.0;
	bool found = false;
	for (int j = 1; j <= MaxClients; j++)
	{
		if (!IsClientInGame(j) || GetClientTeam(j) != TEAM_SURVIVOR || !IsPlayerAlive(j))
			continue;
		float q[3];
		GetClientAbsOrigin(j, q);
		float dd = GetVectorDistance(from, q);
		if (!found || dd < best)
		{
			best  = dd;
			outZ  = q[2];
			found = true;
		}
	}
	return found;
}

/** 三闸③：落点与最近生还者的高度差是否超标。bHave=false（没活人）时一律放行。 */
bool LttGateVertBad(const float pos[3], bool bHave, float nearZ)
{
	if (!bHave || g_cGateVert.FloatValue <= 0.0)
		return false;
	return FloatAbs(pos[2] - nearZ) > g_cGateVert.FloatValue;
}

/** 【v1.33.1】这只特感是不是"正在控人"（扑/骑/拖/撞）。
 *
 *  为什么必须有这道闸：**正在控人的特感天然满足 v1.33.0 的滞留判据** ——
 *  扑/骑/拖/撞期间特感与被控者双方都不动，且距离往往 <50 单位，
 *  于是「静止 >= wd_still」+「d <= wd_near」同时成立 ⇒ 会被当成"卡住"传送走，
 *  表现就是"特感明明控住人了却被凭空搬走"（服主 2026-10-03 实报）。
 *
 *  实现：按职业只读**特感自己**的 victim 属性，只读 1~2 个属性、零额外遍历。
 *  ⚠ 不能无脑把 5 个 victim 属性全读一遍：属性名不在该职业的 send table 里时
 *    SourceMod 会刷 "Property not found" 并返回 -1，日志会被刷爆。
 *  属性来源（与 l4d2_skill_detect / binhooks_Other.inc 的用法一致）：
 *    Smoker=1 m_tongueVictim ｜ Hunter=3 m_pounceVictim ｜ Jockey=5 m_jockeyVictim
 *    ｜ Charger=6 m_carryVictim（抱着走）/ m_pummelVictim（按在地上砸）
 *  @param si   特感客户端
 *  @param cls  它的 m_zombieClass（调用方已经读过，避免重复读属性）
 *  @return     true = 正在控人，**不许传送** */
bool WdIsDominating(int si, int cls)
{
	switch (cls)
	{
		case 1:  return (GetEntPropEnt(si, Prop_Send, "m_tongueVictim") > 0);
		case 3:  return (GetEntPropEnt(si, Prop_Send, "m_pounceVictim") > 0);
		case 5:  return (GetEntPropEnt(si, Prop_Send, "m_jockeyVictim") > 0);
		case 6:  return (GetEntPropEnt(si, Prop_Send, "m_carryVictim")  > 0
		              || GetEntPropEnt(si, Prop_Send, "m_pummelVictim") > 0);
	}
	return false;
}

/** 【v1.33.0】这只特感是不是"已经被整支队伍超过"了（按导航路程 flow 算）。
 *
 *  语义：连**最后一名**生还者的路程位置都在它前面 ⇒ 它已经被甩在队伍后面。
 *    · 用"最小 flow"（最后一名）而不是平均/最大：只有整队都过去了才算"被超过"，
 *      避免把"夹在队伍中间"的正常特感误判成滞留。
 *    · 这一步是为了**不误伤前方蹲点等埋伏的特感**：只有"已经被超过 + 还在原地不动"
 *      才铁定是坏了（该追不追、该打不打）。
 *  读不到 flow（原生缺失/不在导航网格上）一律返回 false ⇒ 宁可不处理。 */
bool WdPassedBySurvivors(int si)
{
	float fs = L4D2Direct_GetFlowDistance(si);
	if (fs < 0.0)
		return false;

	float minFlow = -1.0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_SURVIVOR || !IsPlayerAlive(i))
			continue;
		float f = L4D2Direct_GetFlowDistance(i);
		if (f < 0.0)
			continue;
		if (minFlow < 0.0 || f < minFlow)
			minFlow = f;
	}
	if (minFlow < 0.0)
		return false;

	return (fs < minFlow - 100.0);   // 留 100 单位余量，避免在队伍旁边抖动时误判
}

/** 【v1.20.0】只读看板：一眼看出看门狗在干什么、有没有在干活 */
public Action Cmd_Wd(int client, int args)
{
	int tracked = 0, aliveN = 0, suspect = 0;
	float now = GetGameTime();

	for (int i = 1; i <= MaxClients; i++)
	{
		if (g_iTrackWave[i] <= 0 || g_bTrackDone[i] || !IsClientInGame(i))
			continue;
		tracked++;
		if (!IsPlayerAlive(i))
			continue;
		aliveN++;

		float pos[3];
		GetClientAbsOrigin(i, pos);
		float d = WdNearestSurvivorDist(pos);
		if (d < 0.0)
			continue;

		bool bSus = (now - g_flTrackTime[i] >= g_cWdAfter.FloatValue)
			&& (d > g_cWdFar.FloatValue)
			&& (g_fWdBase[i] <= 0.0 || g_fWdBest[i] > g_fWdBase[i] - g_cWdGain.FloatValue);
		if (!bSus)
			continue;

		suspect++;
		char sCls[16];
		int cls = GetEntProp(i, Prop_Send, "m_zombieClass");
		strcopy(sCls, sizeof(sCls), (cls >= 1 && cls <= MAX_CLASS) ? g_sClassName[cls] : "?");
		ReplyToCommand(client, "[SISpawn] 疑似滞留：第 %d 波 %s (#%d) 存活 %.1f 秒｜出生距目标=%.0f 出生路程=%.0f｜首次量到=%.0f 历史最近=%.0f｜现距=%.0f｜已处理 %d 次",
			g_iTrackWave[i], sCls, i, now - g_flTrackTime[i],
			g_fTrackTgtDist[i], g_fTrackTravel[i], g_fWdBase[i], g_fWdBest[i], d, g_iWdCount[i]);
	}

	ReplyToCommand(client, "[SISpawn] 滞留看门狗=%d 动作=%s｜老判据：存活>%.0fs 且 从未靠近 %.0f 以上 且 现距>%.0f｜【v1.33.0】新判据：静止>=%.1fs 且（距最近生还<=%.0f 或 已被整队超过=%d）｜冷却 %.0fs / 每只上限 %d",
		g_cWatchdog.IntValue, g_cWdAct.BoolValue ? "传送" : "只记账",
		g_cWdAfter.FloatValue, g_cWdGain.FloatValue, g_cWdFar.FloatValue,
		g_cWdStill.FloatValue, g_cWdNear.FloatValue, g_cWdPassed.IntValue,
		g_cWdCool.FloatValue, g_cWdMax.IntValue);
	ReplyToCommand(client, "[SISpawn] 在追踪 %d 只（存活 %d，疑似滞留 %d）｜本图：判滞留 %d 次 / 传送 %d 次 / 【v1.33.2】因正在控人被拦下 %d 次｜候选因「无导航路径」被拒 %d 个（needpath=%d）",
		tracked, aliveN, suspect, g_iTotWdAct, g_iTotWdMoved, g_iTotWdSkipPin, g_iTotNoPath, g_cNeedPath.IntValue);
	return Plugin_Handled;
}

bool FindSpawnPos(int target, int zclass, float out[3])
{
	// 【v1.29.0 · 2026-10-02 深度审核修复】职业下标先卡范围。
	// 本函数里有 8 处 g_sClassName[zclass]，数组只有 MAX_CLASS+1=7 项；
	// 看门狗调用方直接传 m_zombieClass（Tank=8），越界读会让 SourcePawn 抛异常或读到脏字符串。
	// 两个调用方（SpawnOne 走队列、看门狗走追踪表）现在都在外面也做了保护，这里是最后一道。
	if (zclass < 1 || zclass > MAX_CLASS)
		return false;

	// 【v1.28.0】本次找位的耗时上限（到点即放弃，交给等待队列下一 tick 再试）
	// 【v1.43.0】欠账>0 时找位预算 ×CarryBudgetMul()（§206.4 杠杆4）
	float flBudget = g_cSearchMs.FloatValue * CarryBudgetMul();
	if (flBudget > g_cSearchMs.FloatValue)
		g_iCarryBudgetFind++;
	g_flSearchDeadline = GetEngineTime() + flBudget / 1000.0;
	float targetPos[3];
	GetClientAbsOrigin(target, targetPos);

	// 【v1.6.2】"队伍后面凭空冒出一只"的根治办法 —— 用导航流距离卡一道。
	//
	// 【v1.8.2 重要更正】原注释写"引擎的 L4D_GetRandomPZSpawnPosition 只保证
	// 有合法导航 + 不在生还者视野内"。2026-09-23 查证：【前半句对，后半句错】——
	// 这个 native 只保证落点是地图标记过的"可刷特导航区"，它【不做任何视线检测】。
	// 这正是"凭空刷"的根因：引擎路径占全天刷特量的 86%，却零视野过滤。
	// 现在由 ltt_sispawn_vis_engine=1 补上（见下面 bVisEngine 那段）。
	//
	// 这里仍然用导航流距离保证落点在队伍前方（留 200 单位容差，导航区是粗粒度的，
	// 卡太死会把合法的近点也误杀）。注意这是"软偏好"：整个 tries 循环都没找到合格点时，
	// 仍然走下面的保底逻辑，绝不会因为这条规则导致某只特感彻底刷不出来。
	float targetFlow = 0.0;
	if (g_cAhead.BoolValue && target > 0)
		targetFlow = L4D2Direct_GetFlowDistance(target);

	float last[3];
	bool  hasLast = false;
	float minD = g_cMin.FloatValue;
	float minSep = g_cSpread.FloatValue;              // 【v1.8.2 方向A】同波落点最小间距
	bool  bVisEngine = g_cVisEngine.BoolValue;        // 【v1.8.2 方向D】引擎路径也查视野
	int   behind = 0;
	int   dzskip = 0;                                 // 【v1.8.2修订7】高度被拒数
	int   flowzero = 0;                               // 【v1.8.2修订7】flow<=0 被拒数
	// 【v1.8.2修订2】先刷新"当前存活特感"的位置快照 —— 分散约束的参照系。
	// 每次找位只刷一次（31 次 native），候选循环里读的是快照数组，不再调 native。
	RefreshAliveSIPositions();

	// 每次找位都重新开始收集统计，避免上一只的残留算到这一只头上
	g_iVisSkip    = 0;
	g_iHullSkip   = 0;
	g_iAttrSkip   = 0;
	g_iCloseSkip  = 0;
	g_bPosTooClose = false;
	g_iRuleSkip   = 0;           // 【v1.10.0】
	g_bPosWait    = false;       // 【v1.10.2】
	g_iLastPosSrc  = 0;                               // 0=引擎 1=自建 2=保底/降级
	g_iLastPosTier = TIER_NONE;

	// 【v1.8.2修订8】远档上限（mode 0 或 farmax<max 时等于 max，即远档关闭）
	float farMax = GetFarMax();

	// 自建候选（模式 2 的预跑结果，稍后统一比较用）
	int   navTier = TIER_NONE;
	float navPos[3];
	bool  bNavOk  = false;

	// 【v1.8.0】自建落点 · 模式 2：优先自己找（更接近 Neko 的"可变模式"，
	// 能刷在引擎不认的任意导航区，位置也更凶）。找不到再走引擎。
	//
	// 【v1.8.2修订8】这里不再是"自建说啥就是啥"：如果自建只找到【可见点】，
	// 就先留着自己不出手，等引擎也出价再按档位比 —— 否则会丢掉
	// "引擎手里那个远一点的藏点"，比旧逻辑还差。
	if (g_cNavSearch.IntValue == 2)
	{
		float tNav = GetEngineTime();                 // 【v1.18.11】自建导航计时
		// 【v1.42.0】自建预跑只能花掉 searchms 的一部分，剩下的必须留给引擎兜底。
		// 病根见 v1.41.0 注释与 §212：searchms 是"自建预跑 + 引擎循环共用一个 deadline"，
		// 开阔图上预跑会把它全部烧光（实测 bdp_bunker04 评估段中位 31.2 ms / searchms 32），
		// 于是引擎循环一次都不跑 ⇒ 保底候选（hasLast）根本没被记下 ⇒ 整只放弃。
		// v1.41.0 的 engine_min 是"事后补 3 次"，这条是从头就不让预跑吃干（两条可叠加）。
		float flFull = g_flSearchDeadline;
		int pct = g_cNavPct.IntValue;
		if (pct > 0 && pct < 100 && g_cSearchMs.FloatValue > 0.0)
		{
			// 【v1.43.0】子预算跟着 CarryBudgetMul() 一起缩放，保持"预跑 ≤pct%、引擎 ≥(100-pct)%"的比例
			float sub = GetEngineTime() + g_cSearchMs.FloatValue * CarryBudgetMul() * float(pct) / 100000.0;
			if (sub < g_flSearchDeadline)
			{
				g_flSearchDeadline = sub;
				g_iNavCut++;                          // 统计"预跑被这条子预算截断"的次数
			}
		}
		bNavOk = FindSpawnPosByNav(target, navPos, navTier);
		g_flSearchDeadline = flFull;                  // 还原：引擎兜底用剩下的预算
		g_fFindNavSec += GetEngineTime() - tNav;

		if (bNavOk && navTier <= TIER_HIDDEN)
		{
			// 藏点（近或远）→ 这就是最好的一类，不必再问引擎
			out[0] = navPos[0]; out[1] = navPos[1]; out[2] = navPos[2];
			g_iNavUsed++;
			g_iLastPosSrc  = 1;
			g_iLastPosTier = navTier;
			if (LogDetail())
				LogMessage("[SISpawn] %s：自建落点(优先模式) 距目标 %.0f（档位 %s）",
					g_sClassName[zclass], GetVectorDistance(targetPos, out), g_sTierName[navTier]);
			return true;
		}
	}

	int tries = g_cTries.IntValue;

	// 【v1.8.2修订8 / v1.18.1 更正】引擎路径也按档位收集，择优规则与自建路径完全一致：
	//     TIER_HIDDEN(0) < TIER_VISIBLE(1)
	// （原文写的是四档 `TIER_VISIBLE_FAR/NEAR` —— 那两个常量在 v1.10.0 就被删了。）
	// 每档各留一个，这样"引擎手里有个藏点、自建只找到可见点"时，能正确地选引擎那个。
	// 【v1.18.1】数组与循环从 3 收到 2 —— 档位只有 TIER_HIDDEN(0)/TIER_VISIBLE(1)，
	// `TierOf()` 永远不可能返回 2，所以第三个槽是死的（老代码留下的）。
	bool  bEngTier[2];
	float fEngPos[2][3];
	float fEngSep[2];
	float fEngDist[2];        // 【v1.9.2】每档记下与目标的距离（可见档按它择优）
	for (int t = 0; t < 2; t++)
	{
		bEngTier[t] = false;
		fEngSep[t]  = -1.0;
		fEngDist[t] = -1.0;
	}

	// 【v1.18.11】引擎路径整段计时从这里开始 —— 此前它没有任何计时，
	// 于是 `L4D_GetRandomPZSpawnPosition × tries` 的全部开销都被算进"其余"。
	float tEng = GetEngineTime();
	int iMinEng = g_cEngineMin.IntValue;          // 【v1.41.0】引擎兜底保底次数
	// 【v1.49.4·三闸】最近生还者的高度只算一次（不是每个候选都遍历客户端）
	float lttEngNearZ  = 0.0;
	bool  lttEngNearOk = LttNearestSurvivorZ(targetPos, lttEngNearZ);
	for (int i = 0; i < tries; i++)
	{
		// 【v1.29.0 · 审核修复】引擎尝试循环也必须吃预算。
		// 全文件只有 TryNavSpot 消费了搜索截止时间；这个循环原来没有任何 SearchTimeUp/TickBudget 检查。
		// 而 mode 0（纯引擎档）navsearch=0 ⇒ FindSpawnPosByNav 不被调用 ⇒ searchms 在这一档一次都不生效；
		// tries 上限 50、每个候选还要几十次 native ⇒ 最坏上万次 native/tick（"保底兜底"那条实测 108ms 就是这个量级）。
		//
		// 【v1.41.0 · 服务器实测修复】前 iMinEng 次【不受预算限制】。
		// 病根：searchms 是"整次找位（自建预跑 + 引擎）共用一个 deadline"。挡位2 是自建优先，
		//   在开阔图上自建预跑会把 32ms 全烧掉（实测 bdp_bunker04 评估阶段中位 31.2ms）⇒ 走到这里时
		//   SearchTimeUp() 已经为真 ⇒ **循环一次都不跑** ⇒ `hasLast`（保底落点）根本没被赋值
		//   ⇒ 下面的保底分支没有候选可用 ⇒ 本只直接"找不到落点，本只放弃"。
		//   2026-10-05 02:27~02:31 bdp_bunker04 最后那个开阔防守机关因此**4 分钟 0 只刷出**，
		//   占全图 232 次放弃里的 158 次；而挡位1（引擎优先，不走自建预跑）在同一段是正常的。
		// 代价测算：引擎路径整图 2232ms / 1255 次找位 = 1.8ms 一次找位（内含全部 tries），
		//   所以强行多跑 3 次约 0.4ms —— 换回"至少有一个保底候选"，非常划算。
		if (i >= iMinEng && (SearchTimeUp() || TickBudgetUp()))
			break;
		if (i == iMinEng - 1 && iMinEng > 0 && (SearchTimeUp() || TickBudgetUp()))
			g_iEngForced++;                       // 记录"确实是靠这条修复才跑起来的"

		float p[3];
		if (!L4D_GetRandomPZSpawnPosition(target, zclass, 1, p))
			continue;

		// 【v1.8.2修订7-A】高度过滤（向下 150 / 向上 400，见 cvar 说明）。
		// 引擎点也会刷到地下 —— 它一样只看"可刷特导航区"，没有高度概念。
		//
		// 【位置很关键】必须放在 hasLast 赋值【之前】。hasLast 是"引擎+自建都失败"
		// 时的保底落点，它在距离/视野/身后检查之前就记下了（故意宽松，保证能刷出来）。
		// 如果高度检查放在后面，保底落点就会绕过整道高度过滤 —— 等于留了个后门。
		float ddz = targetPos[2] - p[2];
		if (g_cMaxDZ.FloatValue > 0.0 && ddz > g_cMaxDZ.FloatValue)
		{
			dzskip++;
			continue;
		}
		if (g_cMaxDZUp.FloatValue > 0.0 && -ddz > g_cMaxDZUp.FloatValue)
		{
			dzskip++;
			continue;
		}

		// 【v1.49.4 · 出生点三闸】① 水里 ② 世界之外 ③ 与最近生还者高度差超标。
		// 【位置很关键】与上面那条高度过滤同理，必须放在 hasLast 赋值【之前】——
		// 否则保底支路会绕过三闸（本文件为此已经栽过 4 次，规则写在下面 v1.8.2修订10 注释里）。
		if (LttGateInWater(p))     { g_iGateWaterSkip++;   continue; }
		if (LttGateOutside(p))     { g_iGateOutsideSkip++; continue; }
		if (LttGateVertBad(p, lttEngNearOk, lttEngNearZ)) { g_iGateVertSkip++; continue; }

		// 【v1.8.2修订10 · 炸服修复 补充 B】硬性最小间距也必须放在 hasLast 之前！
		//
		// 2026-09-24 13:00–14:15 会话实测抓到了这个后门：全天 1103 个落点里有 5 个
		// `间距=0`，**全部是 `来源=保底 段=无`**，而且 4 条坐标完全相同
		// （x=5862 y=1212 z=-865，第 88/89/90 波）—— 也就是"保底落点"这条路径
		// 绕过了硬性间距，两个特感照样叠在一起。**这正是上次炸服的同一种条件。**
		//
		// 教训重复了一次：修订7 修高度过滤时我就发现"hasLast 在检查之前赋值 =
		// 保底绕过过滤"，当时只把高度检查挪到了它前面。这次加新约束又忘了同一件事。
		// **规则：凡是"硬约束"，一律放在 hasLast 赋值之前。软约束（距离/视野/身后）
		// 才允许被保底路径放宽。**
		{
			float floorD = g_cMinSI.FloatValue;
			if (floorD > 0.0)
			{
				float dNear = MinDistToUsed(p);
				float dSurv = MinDistToSurvivors(p);
				if (dSurv < dNear)
					dNear = dSurv;
				if (dNear < floorD)
				{
					g_iCloseSkip++;
					continue;
				}
			}
		}

		// 【v1.14.0 · 硬约束提前】碰撞盒检查必须在 hasLast 之前！
		// 参考实现 SS_SpawnPositioner.sp:161-169 的看门顺序是:
		//   navmesh -> 碰撞盒 -> flow -> LOS -> 距离   （碰撞盒是【第 2 道闸】）
		// 原来它在 hasLast 之后，于是保底落点会绕过这条硬约束 ——
		// 作者自己在 L3099-3102 写下过规则"凡硬约束一律放在 hasLast 之前"，
		// 但已被违反 4 次，最近一次导致两只特感叠在同一坐标（实测炸服条件）。
		if (g_cClearance.BoolValue && !IsSpotClear(p))
		{
			g_iHullSkip++;
			continue;
		}

		hasLast = true;
		last[0] = p[0]; last[1] = p[1]; last[2] = p[2];

		float d = GetVectorDistance(targetPos, p);
		if (d < minD)
			continue;
		// 【v1.8.2修订8】上限从 max 放宽到 farmax —— 引擎标记区常常就在 900~1500
		// 这一带（我们以前把 z_spawn_range 绑死在 900，等于连候选都不给它）。
		if (farMax > 0.0 && d > farMax)
			continue;

		// 【v1.20.0】引擎标记的"可刷区"也未必走得通（标记区只表示"允许在这里刷"）。
		// 走不通就拒 —— 与自建候选同一条标准，免得从引擎路径漏进滞留特感。
		if (!NavPathOk(targetPos, p))
		{
			g_iTotNoPath++;
			continue;
		}

		bool vis = false;

		// 【v1.8.2 方向D】给引擎路径补上视野检查（仅在 vis_engine=1 时启用）。
		// 这是"凭空刷"的正解；vis_engine=0 时 vis 恒为 false → 只剩"近/远"两档，
		// 与旧行为一致（mode 0 就是靠这条完整复刻 v1.7.1）。
		if (bVisEngine)
		{
			vis = IsSpotVisible(p);
			if (vis)
				g_iVisSkip++;
		}

		// 【v1.8.2修订7-B】flow<=0 = 孤立/不可达导航区（地下导航岛基本都是）。
		// 旧写法把整段包在 	argetFlow > 0.0` 里、条件又是 `f > 0.0 && ...`：
		// flow==0 既没被检查也没被拒 —— 这是地下点的第二个入口。
		//
		// 【v1.8.2修订9】这里同时补上"墙里/越界"的属性检查 —— 引擎的
		// `L4D_GetRandomPZSpawnPosition` **只保证"是可刷特导航区"，不保证那块区域
		// 没被 playerclip 盖住**，所以要跟自建路径用同一套判据。
		{
			Address area = L4D2Direct_GetTerrorNavArea(p);
			if (area != Address_Null)
			{
				if (g_bHasNavAttr && g_cNavAttr.BoolValue)
				{
					int attr = L4D_GetNavArea_AttributeFlags(area);
					if ((attr & NAV_BASE_OUTSIDE_WORLD) || (attr & NAV_BASE_PLAYERCLIP))
					{
						g_iAttrSkip++;
						continue;
					}
				}

				// 【v1.8.2修订11】救生舱/救援车（密封空间）也要挡 —— 引擎的候选点
				// 同样可能落在这些区里（它是"可刷特区"，但密封的也是）。
				// 【v1.29.0 · 审核修复】属性只算一次：原来下面的救生舱判据与起点安全屋判据
				// 各调一次 L4D_GetNavArea_SpawnAttributes（tries=50 时白烧 50 次 native/tick）。
				int sa = g_bHasSpawnAttr ? L4D_GetNavArea_SpawnAttributes(area) : 0;
				if (g_bHasSpawnAttr && g_cNavAttr.BoolValue)
				{
					if (sa != 0 && (sa & (TERROR_NAV_RESCUE_CLOSET | TERROR_NAV_RESCUE_VEHICLE)))
					{
						g_iAttrSkip++;
						continue;
					}
				}

				// 【v1.22.0】起点安全屋内部同样从【引擎路径】挡掉。
				// 自建路径是在 BuildNavCache 里把整块区筛掉的，引擎路径不经过那个缓存，
				// 所以必须在这里再判一次（属性 + 坐标精判双保险，见 IsInStartSafeRoom）。
				if (IsInStartSafeRoom(p, sa))
				{
					g_iSafeSkip++;
					continue;
				}

				float f = L4D2Direct_GetTerrorNavAreaFlow(area);
				if (g_cNeedFlow.BoolValue && f <= 0.0)
				{
					flowzero++;
					continue;
				}
				if (targetFlow > 0.0 && f > 0.0 && f < targetFlow - 200.0)
				{
					behind++;
					continue;
				}
				// 【v1.10.0】按视线分档判据（复用刚读到的 f）
				if (targetFlow > 0.0 && f > 0.0 && !PassSpawnRule(vis, d, TravelDistTo(targetPos, p, FloatAbs(f - targetFlow))))
				{
					g_iRuleSkip++;
					continue;
				}
			}
			else
			{
				// 【v1.29.0 · 审核修复】引擎返回"不在 TerrorNavArea 上"的坐标时，旧代码只是【跳过】这一整块
				// 判据（属性/救生舱/安全屋/flow/身后/PassSpawnRule 全在里面），然后这个点照样参与择优 ——
				// 在 mode 0（spread=0）下它会以 TIER_HIDDEN 被立刻采用，等于把"墙上/几何外"的点刷出去。
				// 与自建路径（2523 行 continue）、保底路径（5473 行 return false）统一口径：拒收 + 计数。
				g_iAttrSkip++;
				continue;
			}
		}

		// 【注意】这条已经在 hasLast 赋值【之前】做过了（见上），这里不再重复 ——
		// 放在这后面等于给保底路径留后门。

		// 【v1.9.1 / v1.18.1 更正】与自建路径同一套档位（原文写"三段式"，v1.10.0 起只有两档）
		int tier = TierOf(vis);

		float sep = (minSep > 0.0) ? MinDistToUsed(p) : 0.0;

		// 【v1.38.0】与自建路径同一条收紧规则：只有"藏点 + 间距达标 + 落在最近一档(<500)"
		// 才算理想点、才提前收工；否则继续问引擎要下一个候选，把更近的比出来。
		// （旧写法只要"藏点+间距达标"就 return，于是引擎给的第一个合格点——随机可能很远——就被采用。）
		bool bIdeal = (tier == TIER_HIDDEN && (minSep <= 0.0 || sep >= minSep));
		if (bIdeal && g_cFindBest.BoolValue)
			bIdeal = (DistBand(d) == 0);

		if (bIdeal)
		{
			out[0] = p[0]; out[1] = p[1]; out[2] = p[2];
			g_iLastPosTier = TIER_HIDDEN;
			return true;
		}

		if (!bEngTier[tier] || IsBetter(tier, sep, d, tier, fEngSep[tier], fEngDist[tier]))
		{
			bEngTier[tier] = true;
			fEngSep[tier]  = sep;
			fEngDist[tier] = d;
			fEngPos[tier][0] = p[0];
			fEngPos[tier][1] = p[1];
			fEngPos[tier][2] = p[2];
		}
	}
	g_fFindEngineSec += GetEngineTime() - tEng;   // 【v1.18.11】引擎路径整段到此为止

	if (behind > 0 && LogDetail())
		LogMessage("[SISpawn] %s：%d 个候选点落在目标身后被拒（目标 flow %.0f）",
			g_sClassName[zclass], behind, targetFlow);

	// 【v1.8.2修订7】高度过滤 / flow<=0 的拒收计数 —— 判断"是不是把可刷点卡太死"靠它
	if ((dzskip > 0 || flowzero > 0) && LogDetail())
		LogMessage("[SISpawn] %s：引擎候选因【高度差>%.0f/%.0f】被拒 %d 个、因【flow<=0 孤立区】被拒 %d 个",
			g_sClassName[zclass], g_cMaxDZ.FloatValue, g_cMaxDZUp.FloatValue, dzskip, flowzero);

	if (bVisEngine && g_iVisSkip > 0 && LogDetail())
		LogMessage("[SISpawn] %s：引擎路径本只 %d 个候选点因『生还者看得见』被拒（vis_engine=1）",
			g_sClassName[zclass], g_iVisSkip);

	// 【v1.8.2修订9】墙里/越界 与 碰撞盒 的拒收计数 —— 判断"刷在墙里面"是否被堵住靠它
	if ((g_iAttrSkip > 0 || g_iHullSkip > 0 || g_iCloseSkip > 0 || g_iRuleSkip > 0) && LogDetail())
		LogMessage("[SISpawn] %s：因【墙里/地图外】被拒 %d 个、因【碰撞盒嵌在实体里】被拒 %d 个、因【离其它特感/生还者<%.0f】被拒 %d 个、因【v1.10 视线分档判据】被拒 %d 个",
			g_sClassName[zclass], g_iAttrSkip, g_iHullSkip, g_cMinSI.FloatValue, g_iCloseSkip, g_iRuleSkip);

	// 【v1.8.0】自建落点 · 模式 1（默认）：引擎给不出落点时，自己遍历导航网格找。
	// 这一段是"找不到落点"的正解 —— 引擎只认地图标记过的可刷特区域，
	// 我们自己找则不挑区域，任何导航区都能用（Neko 可变模式的做法）。
	// 放在保底之前：保底那个点通常远得离谱，能自己找到窗口内的点就不该用它。
	//
	// 【v1.8.2修订8 · 关键改动】引擎候选和自建候选要在同一个"档位"尺度上比大小。
	// 旧逻辑是"先自建、自建没有再退引擎"，于是会出现很荒唐的结果：
	// 引擎手里明明有一个【远一点的藏点】，却因为自建"就近找到了一个可见点"而被丢掉。
	// 现在两边都算出 TIER_*，按 (档位, 间距) 择优 —— 与用户的直觉一致：
	// **宁可跑远一点，也别在脸上变出来。**
	//
	// navTier / navPos / bNavOk 已经在上面声明过：模式 2 是「预跑并可能提前返回」，
	// 模式 1 在这里补跑；两种模式下都不会重复扫两遍导航网格。
	if (g_cNavSearch.IntValue == 1)
	{
		float tNav1 = GetEngineTime();                // 【v1.18.11】自建导航计时
		bNavOk = FindSpawnPosByNav(target, navPos, navTier);
		g_fFindNavSec += GetEngineTime() - tNav1;
	}

	int   bestTier = TIER_NONE;
	float bestSep  = -1.0;
	float bestDist = -1.0;        // 【v1.9.2】
	float bestPos[3];
	int   bestSrc  = -1;                              // 1=自建 2=引擎备选

	// 引擎备选：从最优档开始找第一个有货的（同档位内已经留了间距最大的那个）
	for (int t = 0; t < 2; t++)   // 【v1.18.1】档位只有 2 个（原为 3，第三个槽是死的）
	{
		if (!bEngTier[t])
			continue;
		bestTier = t;
		bestSep  = fEngSep[t];
		bestDist = fEngDist[t];
		bestPos[0] = fEngPos[t][0]; bestPos[1] = fEngPos[t][1]; bestPos[2] = fEngPos[t][2];
		bestSrc  = 2;
		break;
	}

	// 自建候选：档位更优、或同档位间距不更差，就顶掉引擎那个
	if (bNavOk)
	{
		float navSep  = (minSep > 0.0) ? MinDistToUsed(navPos) : 0.0;
		float navDist = GetVectorDistance(targetPos, navPos);

		if (bestSrc < 0 || IsBetter(navTier, navSep, navDist, bestTier, bestSep, bestDist))
		{
			bestTier = navTier;
			bestSep  = navSep;
			bestDist = navDist;
			bestPos[0] = navPos[0]; bestPos[1] = navPos[1]; bestPos[2] = navPos[2];
			bestSrc  = 1;
		}
	}

	// 【v1.10.0】"可见且贴脸就不刷"那个临时规则（v1.9.2 的 B）已经删掉了 ——
	// 它只是"下限"，管不住"可见但 1349 单位"的远处凭空刷。
	// 现在上下限都由 PassSpawnRule() 在候选阶段硬过滤，不需要出口再补一刀。

	if (bestSrc > 0)
	{
		out[0] = bestPos[0]; out[1] = bestPos[1]; out[2] = bestPos[2];
		g_iLastPosTier = bestTier;

		// 【v1.10.0】只剩两档：藏点 / 可见。可见的条数就是要盯的指标
		// （它现在已经被 PassSpawnRule 夹在 500~900 带里，不再是"贴脸"或"1349 凭空刷"）。
		if (bestTier == TIER_VISIBLE)
			g_iVisibleUsed++;

		if (bestSrc == 1)
		{
			g_iNavUsed++;
			g_iLastPosSrc = 1;
			if (LogDetail())
				LogMessage("[SISpawn] %s：引擎没给出可用点 → 自建落点救回，距目标 %.0f（档位 %s，累计救回 %d 次）",
					g_sClassName[zclass], GetVectorDistance(targetPos, out),
					g_sTierName[bestTier], g_iNavUsed);
		}
		else
		{
			g_iLastPosSrc = 3;
			if (LogNormal())
				LogMessage("[SISpawn] %s：采用引擎备选（档位 %s，间距 %.0f，目标 %.0f）",
					g_sClassName[zclass], g_sTierName[bestTier], bestSep, minSep);
		}

		if (minSep > 0.0 && bestSep < minSep)
			g_iSpreadRelax++;      // 尽力了还是不够远，如实统计（不再丢特感）
		// 【v1.34.0】引擎/自建联合择优这条出口也要计入"硬下限未达标"，
		// 否则每图那行「硬下限未达标 N 只」只统计了自建路径的落点（口径不全 ⇒ 会低估扎堆）。
		if (g_cSpreadMin.FloatValue > 0.0 && bestSep < g_cSpreadMin.FloatValue)
			g_iTotSpreadFloorMiss++;
		return true;
	}

	// 保底：引擎给过位置就用，避免"一只都刷不出来"。
	// 但必须加硬上限 —— 实测引擎在目标附近找不到合法导航点时，会返回几千
	// 单位外的坐标（观测到最远 5188），照单全收就会出现"特感从地图另一头
	// 跑过来"的荒诞落点。宁可这一只不刷，也不要那种落点。
	if (hasLast)
	{
		// 【v1.26.1 · 子代审查 C2】保底点必须过【硬闸】才能用！
		// 原来 `hasLast = true` 在这些检查之前赋值，导致保底点可以落在
		// 墙里 / 救生舱 / **起点安全屋内部**（门关了 AI 出不来 → 永久占槽位）。
		// 服主报的"特感卡安全门里、越卡越多"就是这个口子；v1.26.0 的 keep_far 又把它放大到每图 400+ 只。
		// 这里在保底分支入口补一遍同样的硬闸（等价于把 hasLast 挪到硬闸之后，但改动面更小、更安全）。
		{
			Address fa = L4D2Direct_GetTerrorNavArea(last);
			if (fa == Address_Null)
			{
				// 【v1.29.0 · 审核修复】保底点被拒必须留痕：这三道闸原来只 return、不计数不打日志，
				// 事后只能看到"本只放弃"，根本分不清是 5 道闸里的哪一道在拒（长期跑图无法归因）。
				g_iAttrSkip++;
				if (LogNormal())
					LogMessage("[SISpawn] 地图=%s %s 保底点被拒：不在导航网格上（坐标 %.0f,%.0f,%.0f）",
						g_sMap, g_sClassName[zclass], last[0], last[1], last[2]);
				return false;
			}
			if (!NavPathOk(targetPos, last))
			{
				g_iTotNoPath++;
				return false;
			}
			int fsa = g_bHasSpawnAttr ? L4D_GetNavArea_SpawnAttributes(fa) : 0;
			if (g_bHasSpawnAttr && g_cNavAttr.BoolValue)
			{
				if (fsa != 0 && (fsa & (TERROR_NAV_RESCUE_CLOSET | TERROR_NAV_RESCUE_VEHICLE)))
				{
					g_iAttrSkip++;
					if (LogNormal())
						LogMessage("[SISpawn] 地图=%s %s 保底点被拒：落在救生舱/救援车密封区（坐标 %.0f,%.0f,%.0f）",
							g_sMap, g_sClassName[zclass], last[0], last[1], last[2]);
					return false;
				}
			}
			if (IsInStartSafeRoom(last, fsa))
			{
				g_iSafeSkip++;
				return false;
			}
			if (g_bHasNavAttr && g_cNavAttr.BoolValue)
			{
				int fattr = L4D_GetNavArea_AttributeFlags(fa);
				if ((fattr & NAV_BASE_OUTSIDE_WORLD) || (fattr & NAV_BASE_PLAYERCLIP))
				{
					g_iAttrSkip++;
					if (LogNormal())
						LogMessage("[SISpawn] 地图=%s %s 保底点被拒：墙里/地图外（playerclip=%d outside=%d，坐标 %.0f,%.0f,%.0f）",
							g_sMap, g_sClassName[zclass], (fattr & NAV_BASE_PLAYERCLIP) ? 1 : 0,
							(fattr & NAV_BASE_OUTSIDE_WORLD) ? 1 : 0, last[0], last[1], last[2]);
					return false;
				}
			}
		}

		float hardMax = g_cFallbackMax.FloatValue;
		// 【v1.22.0】等待降级也作用于这条硬上限：等久了（g_fRuleRelax > 1）就把硬上限一起放大。
		// 为什么：2026-09-29 server2 的 bdp_bunker04 上，一轮 8 只特感的"保底落点"全是 2300~3350，
		// 被硬上限 1800 一次性全部拒掉 ⇒ **整波 8 只全丢**（日志里 8 连"本只放弃"）。
		// 与其守着一个够不到的上限把整波丢光，不如放宽上限、让它们远一点也先出来
		// （v1.20.0 的可达性过滤保证了"远"≠"走不过来"）。
		if (hardMax > 0.0 && g_fRuleRelax > 1.01)
			hardMax *= g_fRuleRelax;
		if (hardMax > 0.0)
		{
			float d = GetVectorDistance(targetPos, last);
			if (d > hardMax)
			{
				// 【v1.26.0】默认不再"本只放弃"：硬上限只是"理想距离"，不是安全线；
				// 超过它就丢掉，代价是每图 400+ 只（实测 bunker04 一轮 148 次），而丢掉的正是
				// "地图上没有近点"时唯一可用的位置。改成一律放出来 + 交给滞留看门狗兜（15 秒判据）。
				if (g_cKeepFar.BoolValue)
				{
					g_iTotFarKeep++;
					if (LogNormal())
						LogMessage("[SISpawn] 保底落点距目标 %.0f 超过硬上限 %.0f（%.2f 倍后）→ 仍然刷出（keep_far=1，交给看门狗兜）",
							d, hardMax, g_fRuleRelax);
				}
				else
				{
					if (LogNormal())
						LogMessage("[SISpawn] 保底落点距目标 %.0f，超过硬上限 %.0f（等待降级 %.2f 倍后）本只放弃（引擎附近无合法导航点）",
							d, hardMax, g_fRuleRelax);
					return false;
				}
			}
		}

		// 【v1.10.2 · 把 hasLast 后门钉死（同一个小坑的第三次）】
		//
		// `hasLast`（保底落点）是在所有检查【之前】赋值的（故意宽松，"保证能刷出来"）。
		// 修订7 修高度过滤、修订10 修硬性最小间距，都是被这个后门绕过；这一次轮到
		// "按视线分档判据" —— 实测 `段=无 来源=保底` 的落点确实还在可见/超距离地刷。
		//
		// 服主定稿：**不满足就直接不刷**，但**进等待队列**：返回 false 让队列下一 tick
		// （0.1 秒）重试，一旦找到合格位置立刻刷；连续 3 秒都等不到才放弃本波剩余。
		// （保底路径只在"引擎和自建都没给出可用点"时才会走到，所以这里的额外射线很便宜。）
		if (g_cMode.IntValue == 0)
		{
			// 【v1.31.1 · 2026-10-04 服主实测修复】挡位 0 = "复刻原版纯引擎：不查视野、不管间距"，
			// 但下面那段保底判据还在套「可见>vis_min & flow<los / 藏点 flow<nolos」两道【质量】判据
			// ⇒ 引擎给不出点时，最后一道兜底被自己掐掉。
			// 实测 zc1_m1 一局：13 波计划 52 只、实刷 40 只，缺口 12 只【全部】是保底点被这两条拒掉后
			// "本只放弃"（保底落点不合格 19 次）。这与既有设计冲突 —— 我们的原则是
			// "保底是宁可刷出来也别断供"（同一条原则当年也让保底点豁免了 needpath 过滤）。
			// ⇒ 挡位 0 下保底只走【硬闸】：安全屋 / 密封空间 / 导航属性 / 可达性 / 碰撞盒 / 世界外 /
			//   硬性最小间距 —— 那几条是防炸服与防卡几何的，一条都不放宽。
			if (g_iFb0Relax == 0 && LogNormal())
				LogMessage("[SISpawn] 挡位 0：保底点跳过「可见/藏点」质量判据（硬闸仍全部生效）");
			g_iFb0Relax++;
		}
		else
		{
			float lf = 0.0;
			Address larea = L4D2Direct_GetTerrorNavArea(last);
			if (larea != Address_Null)
				lf = L4D2Direct_GetTerrorNavAreaFlow(larea);

			bool  lvis = IsSpotVisible(last);
			float ld   = GetVectorDistance(targetPos, last);

			// 【v1.13.1】读不到 flow（lf<=0）不再"放行"，而是当成【不合格】。
			// 原来写成 `lf > 0.0 && !PassSpawnRule(...)` —— 读不到 flow 时整条判据被跳过，
			// 点无条件通过。实测 20:38 场有 25 只（2.0%）`段=无 来源=保底`，
			// 而且在第 136/137 波精确重复同一坐标：那个"读不到 flow 的点"是固定的，
			// 所以不是偶发漏一只，是反复从同一处刷。
			bool lOk = false;
			if (lf > 0.0)
				lOk = PassSpawnRule(lvis, ld, TravelDistTo(targetPos, last, FloatAbs(lf - targetFlow)));

			if (!lOk)
			{
				g_bPosWait = true;
				g_iRuleSkip++;
				if (LogNormal())
					LogMessage("[SISpawn] %s：保底落点不合格（可见=%d 距目标 %.0f 流差 %.0f，不满足 可见>%.0f&flow<%.0f / 藏点flow<%.0f）→ 进等待队列，找到合格位置立刻刷",
						g_sClassName[zclass], lvis ? 1 : 0, ld, FloatAbs(lf - targetFlow),
						g_cVisMin.FloatValue, g_cFlowLos.FloatValue, g_cFlowNoLos.FloatValue);
				return false;
			}
		}

		// 【v1.43.0 · 保底/降级路径通用护栏（服主 2026-10-05「直接做」）】
		// 背景：这条保底路径上的硬闸被"漏掉"已经复发 3 次（修订7 高度 / 修订10 硬性最小间距 /
		//   v1.10.2 视线分档），每次都是先出现"特感卡安全门里/刷进墙里/叠在一起"，事后才靠人肉翻日志发现。
		// 做法：放行前用一份**独立的复核**再走一遍同一批硬闸（不是复述注释，是真调函数）。
		//   复核失败 ⇒ 打一条 WARNING + 本图计数，图末汇总一行 ⇒「又漏了」变成开机/每图就能看见。
		// 只告警、不改行为（放行照旧）—— 护栏不该在没验证过的情况下改变线上行为。
		FallbackGateAudit(last, targetPos, zclass);

		g_iLastPosSrc = 2;
		out[0] = last[0]; out[1] = last[1]; out[2] = last[2];
		return true;
	}

	// 【v1.8.2修订10 · 炸服修复】实在找不到落点，而且这一只【曾经因为离其它特感/
	// 生还者太近被硬拒过】→ 标记"附近没有空位"。
	// 队列抽干逻辑看到这个标记就会【取消本波剩余】，而不是继续死磕 ——
	// 死磕的结果就是反复挑到同一个点、两个实体叠在一起、引擎段错误。
	// 反正下一波（默认 40 秒后）会重算，没满就补上。
	if (g_iCloseSkip > 0)
		g_bPosTooClose = true;

	return false;
}

// ------------------------------------------------------------------ 多人缩放（默认关）
//
// 规则照搬 specialspawner 的 SetSpawnCount()：
//     数 team 2 全员（含 bot）→ 减去基础 4 人 → 得到"多出来的人数"
//     每多 1 人：每波 +perplayer 只，存活上限 +perplayer×2
/**
 * 注意：这个算法在【只有 1 个真人】时恒为 0（1 真人 + 3 bot = 4），
 * 不会缩放；但服主确认热门三方图上经常 >4 人，那时 team 2 会超过 4，
 * 缩放就会正常生效。所以这里保持和参考实现一致，不去改成"只数真人"。
 */
int CountSurvivors()
{
	int n = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && IsPlayerAlive(i) && GetClientTeam(i) == TEAM_SURVIVOR)
			n++;
	}
	return n;
}

int GetScaleStep()
{
	if (!g_cScaling.BoolValue)
		return 0;

	int extra = CountSurvivors() - 4;
	if (extra < 1)
		return 0;

	return extra * g_cPerPlayer.IntValue;
}

int GetEffWave()
{
	int n = g_cWave.IntValue + GetScaleStep();
	return (n < 1) ? 1 : n;
}

int GetEffCap()
{
	int n;

	if (IsTankAlive() && g_cTankAction.BoolValue)
	{
		// 【v1.7.0】坦克期间改用单独一套（参考 specialspawner 的 ss_tankstatus_action）。
		// 这里【不】跟 GetEffWave() 取大 —— 坦克模式下我们就是要"更少"，取大会把它顶回去。
		n = g_cTankCap.IntValue;
	}
	else
	{
		n   = g_cCap.IntValue + GetScaleStep() * 2;
		int min = GetEffWave();
		if (n < min)
			n = min;
	}

	// 硬上限 = 引擎客户端槽位 - 生还者实际占用的槽位 - 必须留出的空位。
	// 注意不能写死减 4：7 个生还者时特感位只有 18-7=11 个。
	// KeepFreeSlots() 至少是 1：留 0 个空位时 18/18 会建不出客户端，
	// 连我们自己也刷不出来（满员守卫 TrimToKeepFree 会维持这个空位）。
	// reserve 越大 = 给真人留的越多 = 特感上限越低。
	int hard = MaxClients - CountSurvivorSlots() - KeepFreeSlots();
	if (hard < 1)
		hard = 1;

	// 【2026-09-23 修正，推翻旧结论】以前这里写死 MaxClients/2（18 槽位时=9），
	// 理由是"引擎原生 SpawnSpecial 受预建特感池限制，池子恒为 MaxClients/2"。
	// 实测证明那是错的 —— 那个 9 就是这里自己卡出来的：
	//   · MaxClients=18、关掉守卫、纯原生路线连刷 24：场上 14、成功 14 失败 0
	//     （正好 18-4，一个都没失败）
	//   · MaxClients=31：原生路线和直连路线都到 27（正好 31-4）
	// 结论：同时存活特感上限 = MaxClients - 生还者占用槽位 - 要留的空位，
	// 与刷特方式、cm_MaxSpecials、z_* 系列 cvar 全无关。
	// 既然 hard 已经按槽位算好了，这里不能再额外砍一半。

	if (n > hard)
		n = hard;

	return n;
}

/** 生还者占用的客户端槽位（含已倒地的，槽位不会因为倒地而释放） */
int CountSurvivorSlots()
{
	int n = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && GetClientTeam(i) == TEAM_SURVIVOR)
			n++;
	}
	return n;
}

int CountAliveSI()
{
	int n = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != TEAM_INFECTED || !IsPlayerAlive(i))
			continue;

		int cls = GetEntProp(i, Prop_Send, "m_zombieClass");
		if (cls >= 1 && cls <= MAX_CLASS)
			n++;
	}
	return n;
}

/** 已经死了、但客户端槽位还没释放的特感假人数量（回收逻辑要清理的就是它们） */
int CountDeadSIBots()
{
	int n = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && GetClientTeam(i) == TEAM_INFECTED
			&& IsFakeClient(i) && !IsPlayerAlive(i))
			n++;
	}
	return n;
}

// ------------------------------------------------------------------ 自查命令

public Action Cmd_Status(int client, int args)
{
	char next[32];
	if (g_bArmed)
	{
		float left = g_flNextSpawn - GetGameTime();
		if (left < 0.0) left = 0.0;
		Format(next, sizeof(next), "%.0f 秒后", left);
	}
	else
	{
		strcopy(next, sizeof(next), "未开始(还没人离开安全区)");
	}

	ReplyToCommand(client, "[SISpawn] 开关=%d 已开始=%s 下一波=%s 场上=%d/%d 队列=%d/%d 上一波成功=%d 失败=%d",
		g_cEnable.IntValue, g_bArmed ? "是" : "否", next,
		CountAliveSI(), GetEffCap(), g_iQueuePos, g_iQueueLen,
		g_iLastSpawned, g_iLastFailed);
	// 【v1.30.0】救援关闸门现状 —— 一眼看出"本图为什么不刷特"
	ReplyToCommand(client, "[SISpawn] 救援关=%s（原生判定=%s 强制=%d）｜不刷特设置=%d（0关/1整张/2救援开始后）｜本图刷特=%s",
		g_bRescueMap ? "是" : "否",
		g_bHasFinaleMap ? "可用" : "无此原生",
		g_cRescueForce.IntValue, g_cRescueOff.IntValue,
		g_bRescueBlockedNow ? "已关闭" : "开");

	char tgt[64];
	int t = PickTarget();
	if (t > 0)
		Format(tgt, sizeof(tgt), "%N", t);
	else
		strcopy(tgt, sizeof(tgt), "无可刷目标");

	// 报"有效值"而不是原始 cvar —— 人数缩放和引擎硬上限都会改动它们，
	// 只看 cvar 会以为设置没生效
	// 【v1.18.1 修】原来在"非直连"时打印 `MaxClients / 2` —— 那是**已被推翻的旧结论**
	// （见 GetEffCap 上方 2026-09-23 的修正）。引擎原生的硬上限同样受槽位夹取，
	// 两种方式没有区别，所以不再按方式分支。
	ReplyToCommand(client, "[SISpawn] 有效: 每波=%d 上限=%d（原始 %d / %d，缩放增量 %d，槽位硬上限 %d）",
		GetEffWave(), GetEffCap(), g_cWave.IntValue, g_cCap.IntValue,
		GetScaleStep(),
		MaxClients - CountSurvivorSlots() - KeepFreeSlots());
	ReplyToCommand(client, "[SISpawn] 方式=%s(直连工厂 %d/6) 必须留空=%d(设的值 %d) 回收=%d/%.1fs 守卫=%d | 占用槽位 %d/%d 空 %d 死亡特感假人 %d",
		(g_cMethod.IntValue == 1) ? "直连" : "原生", g_bDirectReady ? MAX_CLASS : 0,
		KeepFreeSlots(), g_cReserve.IntValue, g_cRecycle.IntValue, g_cRecycleDelay.FloatValue,
		g_cGuard.IntValue, GetClientCount(false), MaxClients,
		MaxClients - GetClientCount(false), CountDeadSIBots());
	ReplyToCommand(client, "[SISpawn] 间隔=%.0fs 距离=%.0f~%.0f（保底硬上限 %.0f）尝试=%d 生还者=%d 目标=%s",
		g_cTime.FloatValue, g_cMin.FloatValue, g_cMax.FloatValue,
		g_cFallbackMax.FloatValue, g_cTries.IntValue, CountSurvivors(), tgt);

	// 【v1.32.0】补员 + 突击脉冲现状 —— 这两项是"看得到 4 只/特感会不会主动上"的直接开关
	if (g_cRefill.IntValue > 0)
	{
		int aliveNow = CountAliveSI();
		int targetNow = (g_cRefill.IntValue >= 2) ? GetEffCap() : GetEffWave();
		ReplyToCommand(client, "[SISpawn] 补员模式=%d（目标 %d 只，最小间隔 %.1fs）｜当前场上 %d 只 → %s",
			g_cRefill.IntValue, targetNow, g_cRefillGap.FloatValue, aliveNow,
			(aliveNow < targetNow) ? "正在补" : "已达标");
	}
	else
	{
		ReplyToCommand(client, "[SISpawn] 补员模式=0（关：每 %.0f 秒开一整波）｜想「同时保持 N 只」：ltt_sispawn_refill 1",
			g_cTime.FloatValue);
	}

	ReplyToCommand(client, "[SISpawn] 突击脉冲=%d（间隔 %.1fs，已下发 %d 次）｜nb_assault 让特感放完技能继续压，0=关 1=开",
		g_cAssault.IntValue, g_cAssaultGap.FloatValue, g_iAssaultSent);

	// 【v1.8.2】落点质量相关的现场状态
	ReplyToCommand(client, "[SISpawn] v%s 落点分散=%.0f（本波已用 %d 个点｜拒 %d 个候选｜放宽 %d 次｜窗口放大 %d 次）",
		PLUGIN_VERSION, g_cSpread.FloatValue,
		(g_aWavePos != null) ? (g_aWavePos.Length / 3) : 0,
		g_iSpreadSkip, g_iSpreadRelax, g_iWinGrow);
	// 【v1.29.5 修】原来这行标签写"自建档位"但打的是 g_cNavVis（视野口径档位），
	// 挡位 0 时它仍然是 1 ⇒ 极易误读成"挡位没生效"（2026-10-03 我自己就被它骗过一次）。
	// 现在把两个概念分开打：自建落点 = g_cNavSearch（挡位管），视野档位 = g_cNavVis（与挡位无关）。
	ReplyToCommand(client, "[SISpawn] 自建落点=%d（挡位管%s）｜视野档位=%d（与挡位无关）｜引擎路径查视野=%d｜导航缓存=%s(%d 区)｜位置日志=%d",
		g_cNavSearch.IntValue, g_cNavSearchLock.BoolValue ? "，但已被 navsearch_lock 钉住" : "",
		g_cNavVis.IntValue, g_cVisEngine.IntValue,
		g_bNavReady ? "已就绪" : "未就绪", g_iNavCount, g_cPosLog.IntValue);

	return Plugin_Handled;
}

// ------------------------------------------------------------------ 拦截引擎

public Action L4D_OnSpawnSpecial(int &zombieClass, const float vecPos[3], const float vecAng[3])
{
	if (!g_cEnable.BoolValue)
		return Plugin_Continue;

	// 本插件自己发起的生成一律放行（否则自己拦自己）
	if (g_bOwnSpawn)
		return Plugin_Continue;

	// 只接管 1~6 号普通特感；坦克(8)和女巫(7)继续由导演自己刷
	if (zombieClass < 1 || zombieClass > MAX_CLASS)
		return Plugin_Continue;

	// 【v1.46.0 · 服主 2026-10-05 实测反馈】坏导航图（tgxl 终极特感训练）**放行导演特感**。
	//
	// 服主原话：「只有我们刷特插件是这情况，之前用 neko 刷特还有其他刷特插件都不会出现按按钮
	//   不出特感的情况」—— 这条对比直接指到了这里。
	// 机制：那张图的训练按钮 → `info_zombie_spawn` 的 `SpawnZombie` 输入 → **走导演**生成特感。
	//   我们除了把 `director_no_specials` 设 1，还在这个 forward 里**第二次**把它们拦掉
	//   （源码注释原本就写着"双重挡掉"）⇒ 按钮彻底失效。Neko 不碰导演，所以它的按钮正常。
	// 为什么放行不会变成"自动刷"：这张图自带的 vscript（	gxl_off_dir.nut`）把
	//   `DirectorOptions` 的六职业上限全设成 0 —— 导演**自己**不会刷特感，只有按钮显式要求的那几只出来。
	//   这正是地图作者的设计（"导演关掉、按钮开"），我们只需要别挡路。
	if (g_bBadNavMap)
	{
		if (!g_bBadNavLog)
		{
			g_bBadNavLog = true;
			LogMessage("[SISpawn] v%s 地图=%s 坏导航图档：放行导演特感（L4D_OnSpawnSpecial 不再拦截）—— 让这张图自带的训练按钮能出特感（该图 vscript 已把 DirectorOptions 六职业上限设 0，所以只有按钮点出来的才会出）",
				PLUGIN_VERSION, g_sMap);
		}
		return Plugin_Continue;
	}

	return Plugin_Handled;
}

// ------------------------------------------------------------------ 放开导演的并发特感上限
//
// 这是实测踩出来的最关键的坑：
//   每波刷 4 只时只有前 3 只能落到 #5 #6 #7，第 4 只永远被丢到一个空槽上
//   （L4D2_SpawnSpecial 返回 8 但什么都没创建），场上永远卡 3 只。
//   引擎 cvar 已排除：z_max_player_zombies=31、z_minion_limit=31、
//   maxplayers=18、sm_reserved_slots=0、z_*_limit 清零后依然卡 3。
//   → 剩下的唯一可能就是【导演的 Squirrel 脚本值】。
//
// 接口选择（踩坑记录）：
//   必须用 L4D2_OnGetScriptValueInt，不能用 L4D_OnGetScriptValueInt。
//   left4dhooks.inc 明确警告旧接口 "may not fire on some keys due to C inline
//   feature" —— specialspawner 用的就是旧接口，在本地静默失效，一条日志都没有。
//
// 下面同时把导演所有 int 脚本键打印一遍，方便直接定位真正的上限键。
#define MAX_KEYLOG 64

static char g_sKeys[MAX_KEYLOG][64];
static int  g_iKeyCount;

/** 【v1.18.7】z_common_limit 变了就更新缓存 —— 拦截时要用最新值。 */
public void OnCommonLimitChanged(ConVar convar, const char[] oldValue, const char[] newValue)
{
	g_iCommonLimit = convar.IntValue;
}

public Action L4D2_OnGetScriptValueInt(const char[] key, int &retVal, int hScope)
{
	if (!g_cEnable.BoolValue)
		return Plugin_Continue;

	// 首次出现的键全部记下来（一次性，方便定位上限键）；hScope 一并打印
	bool seen = false;
	for (int i = 0; i < g_iKeyCount; i++)
	{
		if (StrEqual(g_sKeys[i], key, false))
		{
			seen = true;
			break;
		}
	}
	if (!seen && g_iKeyCount < MAX_KEYLOG)
	{
		strcopy(g_sKeys[g_iKeyCount], sizeof(g_sKeys[]), key);
		g_iKeyCount++;
		LogMessage("[SISpawn] 导演脚本键 #%d: %s = %d (scope=%d)", g_iKeyCount, key, retVal, hScope);
	}

	// 【v1.8.2修订11 · 参考实现 specialspawner】
	// 把方向偏好喂给引擎。参考实现 hook 的是【旧】接口 L4D_OnGetScriptValueInt，
	// 而 left4dhooks 明确警告旧接口 "may not fire on some keys due to C inline
	// feature" —— 我们本地就实测过旧接口对 cm_MaxSpecials 静默失效。
	// 所以这里**两个接口都挂**，哪个能触发都不至于漏。
	//
	// 【v1.9.0 修正】只在"确实要干预"时才 Plugin_Handled。
	// 实测引擎问这个键时给的原值是 6，而我们以前在"不干预"时也返回 -1 并 Handled
	// —— 那等于把引擎自己的 6 强行改成"不指定"，**是帮倒忙**。
	// 现在 `g_iPreferredDir < 0` 就走 Plugin_Continue，让引擎保留它自己的值。
	if (g_bInSpawnTime && g_iPreferredDir >= 0 && StrEqual(key, "PreferredSpecialDirection", false))
	{
		retVal = g_iPreferredDir;
		return Plugin_Handled;
	}

	// 【v1.18.7】导演脚本 CommonLimit 拦截。必须放在下面 MaxSpecials 那个
	// early-return【之前】—— 否则 key 不是 MaxSpecials 时就直接 return 了，
	// CommonLimit 永远轮不到。这种"插在 early-return 后面等于没插"的坑，
	// 光看 diff 是发现不了的。
	if (g_cCommonLimitBlock.BoolValue && StrEqual(key, "CommonLimit", false))
	{
		if (retVal >= g_iCommonLimit)
		{
			if (!g_bLoggedCommonLimit && LogNormal())
			{
				g_bLoggedCommonLimit = true;
				LogMessage("[SISpawn] 导演脚本把 CommonLimit 抬到 %d（≥ z_common_limit %d）→ 压回 %d（ltt_sispawn_commonlimit_block=1）",
					retVal, g_iCommonLimit, g_iCommonLimit);
			}
			retVal = g_iCommonLimit;
			return Plugin_Handled;
		}
	}

	if (!StrEqual(key, "MaxSpecials", false) && !StrEqual(key, "cm_MaxSpecials", false))
		return Plugin_Continue;

	// 【v1.47.0 · 服主 2026-10-05 隔离测试的直接结论】坏导航图：把导演 MaxSpecials 抬到 cap+8。
	//
	// 实测链：把本插件整个卸掉（`director_no_specials 0`）→ 服主按训练按钮**能出特感**
	//   （引擎日志：`"Hunter<14><BOT><Unassigned>" joined team "Infected"` + `setpos_exact`）；
	//   装回来就不出。差别只剩"我们的特感占不占导演名额"。
	// 机制：导演的 `MaxSpecials` **是按玩家僵尸（player zombie）总数算的，不区分是谁刷的**。
	//   我们直连刷的 8 只也计入 ⇒ 单靠 `g_cRaiseMaxSpecials`（抬到 cap=8）时预算正好被占满，
	//   导演要加第 9 只（按钮点的那只）直接拒绝 —— 按钮看起来就是"坏的"。
	//   （本服 `ltt_sispawn_raise_maxspecials` 是 0，导演上限一直是脚本原值 2，更早爆。）
	// 所以这张图必须留出余量：抬到 `cap + 8`。其它图一个字不改（那个开关的历史理由仍成立：
	//   抬太高会让导演的 `UpdateSpecialSpawns()` 白烧 CPU，只在训练图上值这个代价）。
	if (g_bBadNavMap)
	{
		int want = g_cCap.IntValue + 8;
		if (retVal >= 0 && retVal < want)
		{
			if (!g_bLoggedMaxSpecials && LogNormal())
			{
				g_bLoggedMaxSpecials = true;
				LogMessage("[SISpawn] 坏导航图档：导演 %s 上限 %d → 抬到 %d（本图按钮靠导演生成，而我们的特感也占它的名额；cap=%d）",
					key, retVal, want, g_cCap.IntValue);
			}
			retVal = want;
			return Plugin_Handled;
		}
	}

	// 【v1.18.7 补充 · 2026-09-26 实测纠正了一条错注释】
	// 这里原来写着「实测 cm_MaxSpecials 原值就是 -1（无限）」。**这条是错的。**
	// 服务器日志实测原值是 **2**：
	//     `导演脚本键 #1: MaxSpecials = 2 (scope=...)`
	//     `导演 MaxSpecials 上限 2 偏低 → 抬到 6（每回合只报一次）`
	// 也就是我们每回合都在把导演上限从 2 抬到我们的 cap（当时 6）。
	//
	// 代价在 vprof 抓取里看得很清楚（61 秒采样）：
	//     `1236.02 ms / 6322 calls / 峰值 5.51 ms   UpdateSpecialSpawns()`
	// 那是导演自己的"维持特感数量"循环，约 104 次/秒。我们刷的特感不走导演那套，
	// 导演想刷到 6 只却刷不出来（漏网检测只报出坦克），于是它一直在那儿试 ——
	// **这部分 CPU 是我们自己叫醒的**。
	//
	// 所以加开关做 A/B：
	//   1（默认 = 旧行为）= 照旧把偏低的上限抬到 cap
	//   0 = 完全不干预，让导演保留它自己的值（本服是 2）
	// 预期：设 0 后 UpdateSpecialSpawns() 开销应显著下降，且不会有额外特感冒出来。
	if (g_cRaiseMaxSpecials.BoolValue && retVal >= 0 && retVal < g_cCap.IntValue)
	{
		if (!g_bLoggedMaxSpecials && LogNormal())
		{
			g_bLoggedMaxSpecials = true;
			LogMessage("[SISpawn] 导演 %s 上限 %d 偏低 → 抬到 %d（每回合只报一次）", key, retVal, g_cCap.IntValue);
		}
		retVal = g_cCap.IntValue;
		return Plugin_Handled;
	}
	return Plugin_Continue;
}

// 旧接口保留一份（实测 cm_MaxSpecials 只有它会触发）
public Action L4D_OnGetScriptValueInt(const char[] key, int &retVal)
{
	if (!g_cEnable.BoolValue)
		return Plugin_Continue;

	// 【v1.8.2修订11】方向偏好（旧接口也挂一份，见上一条注释）
	// 【v1.9.0 修正】同样只在确实要干预时才 Handled（见 L4D2_OnGetScriptValueInt 注释）
	if (g_bInSpawnTime && g_iPreferredDir >= 0 && StrEqual(key, "PreferredSpecialDirection", false))
	{
		retVal = g_iPreferredDir;
		return Plugin_Handled;
	}

	// 【v1.18.7】旧接口也挂一份 CommonLimit 拦截（见 L4D2_ 那份的说明）。
	// 原作者只挂了旧接口；我们两个接口都挂 —— left4dhooks 警告旧接口"某些键不触发"，
	// 而我们本地实测过它对 cm_MaxSpecials 就是静默失效的。宁多勿漏。
	if (g_cCommonLimitBlock.BoolValue && StrEqual(key, "CommonLimit", false))
	{
		if (retVal >= g_iCommonLimit)
		{
			if (!g_bLoggedCommonLimit && LogNormal())
			{
				g_bLoggedCommonLimit = true;
				LogMessage("[SISpawn] 导演脚本把 CommonLimit 抬到 %d（≥ z_common_limit %d）→ 压回 %d（旧接口命中）",
					retVal, g_iCommonLimit, g_iCommonLimit);
			}
			retVal = g_iCommonLimit;
			return Plugin_Handled;
		}
	}

	if (!StrEqual(key, "MaxSpecials", false) && !StrEqual(key, "cm_MaxSpecials", false))
		return Plugin_Continue;

	// 【v1.47.0】坏导航图同样要留导演余量（旧接口这份；理由见 L4D2_OnGetScriptValueInt 那段长注释）
	if (g_bBadNavMap)
	{
		int want = g_cCap.IntValue + 8;
		if (retVal >= 0 && retVal < want)
		{
			if (!g_bLoggedMaxSpecials && LogNormal())
			{
				g_bLoggedMaxSpecials = true;
				LogMessage("[SISpawn] 坏导航图档（旧接口）：导演 %s 上限 %d → 抬到 %d", key, retVal, want);
			}
			retVal = want;
			return Plugin_Handled;
		}
	}

	// 【v1.18.7】旧接口这份也要跟着 g_cRaiseMaxSpecials 走（见 L4D2_ 那份的长注释：
	// 我们实测原值是 2 不是 -1，抬高会让导演的 UpdateSpecialSpawns 白烧 CPU）。
	if (g_cRaiseMaxSpecials.BoolValue && retVal >= 0 && retVal < g_cCap.IntValue)
	{
		if (!g_bLoggedMaxSpecials && LogNormal())
		{
			g_bLoggedMaxSpecials = true;
			LogMessage("[SISpawn] 导演 %s 上限 %d 偏低 → 抬到 %d（每回合只报一次）", key, retVal, g_cCap.IntValue);
		}
		retVal = g_cCap.IntValue;
		return Plugin_Handled;
	}
	return Plugin_Continue;
}
// 引擎自身的并发上限保险：只往上抬，绝不往下压。
// 实测这几个 cvar 其实不是特感数量的真正限制（真正的墙是客户端槽位数），
// 但它们是"导演自己要刷特"时的判断依据，抬着没坏处。
// 关键：动之前先记下原值/原上限，卸载时由 RestoreEngineLimits() 还回去。
void EnsureEngineLimits()
{
	for (int i = 0; i < ENGINE_CVAR_COUNT; i++)
	{
		ConVar cv = FindConVar(g_sEngineCvars[i]);
		if (cv == null)
		{
			if (LogNormal())
				LogMessage("[SISpawn] 找不到引擎 cvar %s（跳过）", g_sEngineCvars[i]);
			continue;
		}

		if (cv.IntValue >= MaxClients)
			continue;

		if (!g_bEngineTouched[i])
		{
			g_iEngineOldValue[i] = cv.IntValue;
			g_bEngineHadUpper[i] = GetConVarBounds(cv, ConVarBound_Upper, g_fEngineOldUpper[i]);
			g_bEngineTouched[i] = true;
		}

		cv.SetBounds(ConVarBound_Upper, true, float(MaxClients));
		cv.SetInt(MaxClients);
		if (LogNormal())
			LogMessage("[SISpawn] 引擎 cvar %s 抬到 %d（原值 %d，原上限 %s%.0f；卸载时还原）",
				g_sEngineCvars[i], MaxClients, g_iEngineOldValue[i],
				g_bEngineHadUpper[i] ? "" : "无/", g_fEngineOldUpper[i]);
	}
}

/** 把 EnsureEngineLimits() 抬过的三个引擎 cvar 还原成原值 + 原上限 */
void RestoreEngineLimits()
{
	for (int i = 0; i < ENGINE_CVAR_COUNT; i++)
	{
		if (!g_bEngineTouched[i])
			continue;

		ConVar cv = FindConVar(g_sEngineCvars[i]);
		if (cv == null)
			continue;

		SetConVarInt(cv, g_iEngineOldValue[i], true, false);
		cv.SetBounds(ConVarBound_Upper, g_bEngineHadUpper[i], g_fEngineOldUpper[i]);

		if (LogNormal())
			LogMessage("[SISpawn] 已还原引擎 cvar %s = %d（上限恢复 %s%.0f）",
				g_sEngineCvars[i], g_iEngineOldValue[i],
				g_bEngineHadUpper[i] ? "" : "无/", g_fEngineOldUpper[i]);
	}
}

// ------------------------------------------------------------------ 真正控制"刷多远"
//
// 之前 min/max 形同虚设的原因：
//   引擎的原生找位函数 L4D_GetRandomPZSpawnPosition 内部就被两个 cvar 约束住，
//   它只会在这两个值划定的区间里给候选点，跟我们在外面怎么过滤无关。
//       z_spawn_safety_range = 最小刷新距离（本服默认 550）
//       z_spawn_range        = 最大刷新距离（本服默认 1500）
//   所以日志里 min=200 一次都没拦下过东西，而落点全挤在 550~1500 之间，
//   特感永远是从老远跑过来的活靶子。
//
// 解法（参考实现 specialspawner 用的就是这一套）：把这两个 cvar 直接绑到
// ltt_sispawn_min / ltt_sispawn_max 上，让引擎自己就在我们要的区间里选点。
//
// 【v1.8.2修订8 · 重要修正】上面这条"绑死 max"的做法**过头了**，副作用在 2026-09-24
// 暴露出来：`z_spawn_range = 900` 之后，**引擎自己也只被允许在 200~900 里找标记区**，
// 于是开阔地形上引擎几乎必然失败 —— 实测 646 只里引擎只贡献 32 只（5.0%），
// 而引擎那批"地图作者标好的天然藏点"在本场**可见率是 0%（32/32 都不可见）**。
// 等于我们亲手扔掉了手里最好的一批落点，把 95% 的量全压给自建路径。
//
// 现在拆成两个概念：
//   · `ltt_sispawn_engine_range`（默认 1500 = 原版值）→ 写进 `z_spawn_range`，
//     这是【引擎自己的】搜索上限，放开它，让引擎把它认识的候选点都拿出来。
//   · `ltt_sispawn_min/max/farmax` → 这是【我们自己的】取舍窗口，一层不变。
// 放宽前者只是"让引擎多给候选"，后者仍会把远处的点按档位排序 → 落点不会因此变远。
void ApplyEngineSpawnRange()
{
	ConVar cRange = FindConVar("z_spawn_range");
	if (cRange != null)
	{
		if (g_iOrigSpawnRange < 0)
			g_iOrigSpawnRange = cRange.IntValue;
		g_bOrigRangeLowerSet = GetConVarBounds(cRange, ConVarBound_Lower, g_fOrigRangeLower);   // 【v1.18.0】
		cRange.SetBounds(ConVarBound_Lower, true, 0.0);
		cRange.SetInt(RoundToNearest(g_cEngineRange.FloatValue));
	}

	ConVar cSafe = FindConVar("z_spawn_safety_range");
	if (cSafe != null)
	{
		if (g_iOrigSafeRange < 0)
			g_iOrigSafeRange = cSafe.IntValue;
		g_bOrigSafeLowerSet = GetConVarBounds(cSafe, ConVarBound_Lower, g_fOrigSafeLower);   // 【v1.18.0】
		cSafe.SetBounds(ConVarBound_Lower, true, 0.0);
		cSafe.SetInt(RoundToNearest(g_cMin.FloatValue));
	}

	// 【v1.8.2修订11 · 参考实现 specialspawner】
	// 参考实现还把 `z_discard_range` 设成 `z_spawn_range + 500`。
	// 它是"多远之外的特感就不再算数/该被丢弃"的判据 —— 抬着它，
	// 远处刷出来的特感不会被导演当成"跑丢了"而丢掉。
	// 我们以前完全没碰过这个 cvar，属于白丢的一项。
	ConVar cDiscard = FindConVar("z_discard_range");
	g_bHasDiscard = (cDiscard != null);
	if (cDiscard != null && g_cDiscardRange.FloatValue > 0.0)
	{
		if (g_iOrigDiscardRange < 0)
			g_iOrigDiscardRange = cDiscard.IntValue;
		g_bOrigDiscardLowerSet = GetConVarBounds(cDiscard, ConVarBound_Lower, g_fOrigDiscardLower);   // 【v1.18.0】
		cDiscard.SetBounds(ConVarBound_Lower, true, 0.0);
		cDiscard.SetInt(RoundToNearest(g_cDiscardRange.FloatValue));
	}

	if (LogNormal())
		LogMessage("[SISpawn] 引擎找位区间已设为 %.0f~%.0f（z_spawn_safety_range / z_spawn_range）｜我方取舍窗口 %.0f~%.0f（远档到 %.0f）｜ z_discard_range=%s",
			g_cMin.FloatValue, g_cEngineRange.FloatValue,
			g_cMin.FloatValue, g_cMax.FloatValue, GetFarMax(),
			!g_bHasDiscard ? "服务器无此cvar"
				: (g_cDiscardRange.FloatValue > 0.0 ? "已设" : "不干预"));
}

void RestoreEngineSpawnRange()
{
	// 【v1.18.0】值和【下界】都要还原。
	// 原来只 SetInt 恢复值，而 ApplyEngineSpawnRange 把下界改成了 0 —— 那条改动再也回不去，
	// 插件卸载后这三个 cvar 的下界会永久停在 0（值是对的、界限不对）。
	ConVar cRange = FindConVar("z_spawn_range");
	if (cRange != null && g_iOrigSpawnRange >= 0)
	{
		cRange.SetInt(g_iOrigSpawnRange);
		cRange.SetBounds(ConVarBound_Lower, g_bOrigRangeLowerSet, g_fOrigRangeLower);
	}

	ConVar cSafe = FindConVar("z_spawn_safety_range");
	if (cSafe != null && g_iOrigSafeRange >= 0)
	{
		cSafe.SetInt(g_iOrigSafeRange);
		cSafe.SetBounds(ConVarBound_Lower, g_bOrigSafeLowerSet, g_fOrigSafeLower);
	}

	ConVar cDiscard = FindConVar("z_discard_range");
	if (cDiscard != null && g_iOrigDiscardRange >= 0)
	{
		cDiscard.SetInt(g_iOrigDiscardRange);
		cDiscard.SetBounds(ConVarBound_Lower, g_bOrigDiscardLowerSet, g_fOrigDiscardLower);
	}

	// 【v1.18.0】把"记录到什么、还原成什么"打出来。
	// 理由：卸载后才能观测，而"值回来了、下界还是 0"这种现象有两种解释 ——
	//   (a) 引擎原始下界本来就是 (set=0, 无下界)，我们的还原是对的；
	//   (b) 记录读到了但还原没生效。
	// 只靠 RCON 看 `min.` 区分不了这两者，所以必须有这条日志当凭证。
	// 这也是"写引擎 cvar 必须成对记录 + 还原"那条规范要求的留痕。
	if (LogNormal())
		LogMessage("[SISpawn] 引擎 cvar 已还原：z_spawn_range=%d（下界 set=%d 值=%.0f）｜ z_spawn_safety_range=%d（下界 set=%d 值=%.0f）｜ z_discard_range=%d（下界 set=%d 值=%.0f）",
			g_iOrigSpawnRange, g_bOrigRangeLowerSet, g_fOrigRangeLower,
			g_iOrigSafeRange, g_bOrigSafeLowerSet, g_fOrigSafeLower,
			g_iOrigDiscardRange, g_bOrigDiscardLowerSet, g_fOrigDiscardLower);
}

// ============================================================
// 【v1.49.7 · 2026-10-31】武装延后名单（无起点安全屋的自制图用）
// ============================================================
/** 当前地图是否在 ltt_sispawn_arm_delay_maps 名单里（逗号分隔、精确匹配、大小写不敏感）。 */
bool LttMapInArmDelayList()
{
	if (g_cArmDelayMaps == null)
		return false;

	char sList[256], sMap[64];
	g_cArmDelayMaps.GetString(sList, sizeof(sList));
	if (sList[0] == '\0')
		return false;

	GetCurrentMap(sMap, sizeof(sMap));

	// 按逗号切分并逐项比较（去掉首尾空格）
	char sItems[16][64];
	int  nItems = ExplodeString(sList, ",", sItems, sizeof(sItems), sizeof(sItems[]));
	for (int i = 0; i < nItems; i++)
	{
		TrimString(sItems[i]);
		if (sItems[i][0] == '\0')
			continue;
		if (StrEqual(sItems[i], sMap, false))
			return true;
	}
	return false;
}

// ============================================================
// 【v1.49.9 · 2026-11-02】"生还者动过没有"判定
//   冻结/开场过场里玩家动不了 ⇒ 只要有一名生还者位移超过阈值，
//   就说明已经解冻/过场结束，可以进入武装判定。
//   死亡、换队、重生都会作废该人的基准位置，重生后重新记录
//   （避免"一复活就算动过"）。
// ============================================================
void LttUpdateMovedFlag()
{
	float flThr = g_cArmMove.FloatValue;
	if (flThr <= 0.0 || g_bLttSomeoneMoved)
		return;

	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientInGame(i) || GetClientTeam(i) != 2 || !IsPlayerAlive(i))
		{
			g_bLttRefValid[i] = false;
			continue;
		}

		float pos[3];
		GetClientAbsOrigin(i, pos);

		if (!g_bLttRefValid[i])
		{
			g_vLttRefPos[i][0] = pos[0];
			g_vLttRefPos[i][1] = pos[1];
			g_vLttRefPos[i][2] = pos[2];
			g_bLttRefValid[i] = true;
			continue;
		}

		float ref[3];
		ref[0] = g_vLttRefPos[i][0];
		ref[1] = g_vLttRefPos[i][1];
		ref[2] = g_vLttRefPos[i][2];

		if (GetVectorDistance(pos, ref) > flThr)
		{
			g_bLttSomeoneMoved = true;
			if (LogNormal())
				LogMessage("[SISpawn] v1.49.9 检测到生还者已移动（阈值 %.0f 单位）=> 冻结/过场视为结束", flThr);
			return;
		}
	}
}
