// （asiai.sp 里那句 CheatCommand(client,"nb_assault") 在本机编译直接 error 017），
// 所以突击脉冲走的是 AI_HardSI.sp 那套"临时摘掉 FCVAR_CHEAT 旗标"的做法。
#include <console>

#define PLUGIN_VERSION "1.49.12"
#define TEAM_SURVIVOR   2
#define TEAM_INFECTED   3
