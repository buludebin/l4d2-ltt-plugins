       g_cAnnounce, g_cScaling, g_cPerPlayer, g_cFallbackMax,
       g_cMethod, g_cReserve, g_cRecycle, g_cRecycleDelay, g_cGuard, g_cAhead,
       g_cBalance, g_cClassLimit, g_cTankAction, g_cTankCap, g_cTankClasses, g_cCostLog,
       g_cNavVis, g_cNavSearch,
